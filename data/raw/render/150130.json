{"parse": {"title": "衣着/最强音", "pageid": 150130, "text": "<div class=\"mw-parser-output\"><div class=\"character-skin-page\"><div class=\"character-base-info\"><div class=\"character-img-box0 tabber\" style=\"margin-bottom:20px\"><div class=\"character-img-box1\"><div class=\"tabber-item hide-m\" data-isl2d=\"1\" data-tabberimg=\"Skin_bg-302507.webp\" data-tabberimgclass=\"img-fit-height\" style=\"position:absolute; right:0; height:100%;display:none;\"></div><div class=\"character-img-box2 no-select\"><img alt=\"Zhujiemian you di.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/b/bc/Zhujiemian_you_di.png\" decoding=\"async\" width=\"508\" height=\"612\" class=\"img-fit notpageimage\" data-file-width=\"508\" data-file-height=\"612\" /></div><div class=\"character-img-box2 tabber-item hide-pc\" data-id=\"302507\" data-isl2d=\"0\" data-tabberimg=\"Portrait-302507.webp\" data-tabberimgclass=\"img-fit\"></div><div class=\"character-img-box2 tabber-item hide-m\" data-id=\"302507\" data-isl2d=\"0\" data-tabberimg=\"Portrait-302507.webp\" data-tabberimgclass=\"img-fit\" data-tabberimglink=\"File:Portrait-302507.webp\"></div><div class=\"character-img-box2 tabber-item hide-pc\" data-isl2d=\"1\" data-tabberimg=\"L2d_static-302507_xtyg.webp\" data-tabberimgclass=\"img-fit\" style=\"display:none\"></div><div class=\"character-img-box2 tabber-item hide-m\" data-isl2d=\"1\" data-tabberimg=\"L2d_static-302507_xtyg.webp\" data-tabberimgclass=\"img-fit\" data-tabberimglink=\"File:L2d_static-302507_xtyg.webp\" style=\"display:none\"></div></div><div class=\"character-desc-offset\"><div class=\"character-img-button-group\"><div class=\"tabber-filter l2d-button-group\"><div class=\"l2d-button\"><img alt=\"Btm lihui.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/4/4d/Btm_lihui.png\" decoding=\"async\" width=\"84\" height=\"84\" class=\"img-fit\" data-file-width=\"84\" data-file-height=\"84\" /></div><div class=\"tabber-item\" data-isl2d=\"0\"><div class=