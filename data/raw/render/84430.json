08/Bgequip6.png/150px-Bgequip6.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/200px-Bgequip6.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\" style=\"width:60%; padding-top:7%;\"><a href=\"/wiki/%E7%BA%A2%E5%BC%A9%E7%AE%AD\" title=\"红弩箭\"><img alt=\"红弩箭\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/76/HeadIconSmall-300401.png/100px-HeadIconSmall-300401.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/7/76/HeadIconSmall-300401.png 1.5x\" data-file-width=\"136\" data-file-height=\"136\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E7%BA%A2%E5%BC%A9%E7%AE%AD\" title=\"红弩箭\">红弩箭</a></span></span></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">实装版本：</span>2.3</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:3em\">来源：</span>银行</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">所属系列：</span>雾都锦标赛</div></div><div><div class=\"grey-small test-hide hide-m\">编号ID：300404</div></div></div></div><div class=\"skin-video tabber\"><h2><span id=\".E8.A7.86.E9.A2.91.E9.A2.84.E8.A7.88\"></span><span class=\"mw-headline\" id=\"视频预览\">视频预览</span></h2><div class=\"tabber-filter\" style=\"margin:0 -3px 4px -3px\"><div class=\"tabber-filter-item filter-button selected\" data-type=\"videoId\" data-videoid=\"5\">大招</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"4\">技能1</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"3\">技能2</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"2\">追击</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"1\">入场</div></div><div class=\"skin-video--single tabber-item\" data-videoid=\"5\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/大招.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/大招 - frame at 0m0s.jpg\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"4\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/技能一.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/技能一 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"3\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/技能二.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/技能二 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"2\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/追击.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/追击 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"1\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/入场.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3004/300404/入场 - frame at 0m0s.jpg\" style=\"display:none\"></div></div><h2><span id=\".E7.AA.97.E4.B8.AD.E4.BE.A7.E5.86.99_Garment_Display\"></span><span class=\"mw-headline\" id=\"窗中侧写_Garment_Display\">窗中侧写<small style=\"color: grey\"> <span style=\"display:inline-block\">Garment Display</span></small></span></h2><div class=\"infopad\">首席裁判记录简报<br />事件：水怪竞速赛场，出现魔精暴动。<br />处理记录：已打晕，交由后勤部处置。<br />Ps：没打选手！8号选手晕厥原因：从魔精背部摔下。<br /><br />事件：叩门飞匙赛，4号选手串通道具筹备组，使用磁铁作弊。<br />处理记录：在场地内飞了一圈，所有携带磁铁的翼造门匙已被吸附于蜂鸣喇叭。违规道具已取证。<br /><br />事件：15kg级负重竞速，选手因大雾偏离赛道。<br />处理记录：已取消选手该场成绩，撞碎裁判酒瓶一个。<s>为什么我不能找他赔？</s><br />Ps：该选手已因酒精过敏送至医疗组</div><div id=\"崭新单品\"></div><h2><span id=\".E5.B4.AD.E6.96.B0.E5.8D.95.E5.93.81_All-new_Item\"></span><span class=\"mw-headline\" id=\"崭新单品_All-new_Item\">崭新单品<small style=\"color: grey\"> <span style=\"display:inline-block\">All-new Item</span></small></span></h2><div class=\"char-item-box0 tabber\"><div class=\"char-item-box1 tabber-item\" data-skinid=\"300404\"><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-300407.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/d/dc/Belonging-300407.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">裁判员服饰<div class=\"grey-small\" style=\"text-wrap:wrap\">Officiator's Attire</div></div></div><div><img alt=\"利齿子儿\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/62/Value-2.png/27px-Value-2.png\" decoding=\"async\" title=\"利齿子儿\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/6/62/Value-2.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />11<hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>伦敦高空竞技赛裁判员的专用服饰。拉风的墨镜虽无法提供与专业护目镜媲美的保护性，但却拥有更值得信赖的防眩光功能。“更重要的是，它真的非常拉风！”受访者的某位海盗朋友也如此评价。</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-300408.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/a/a3/Belonging-300408.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">蜂鸣喇叭<div class=\"grey-small\" style=\"text-wrap:wrap\">Blaring Fanfare</div></div></div><div>无估值<div class=\"grey-small\" style=\"float: right;\">信任达到60%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>原本是用于“远距离听测”的神秘术道具，但也作为裁判员的发令枪使用。据受访者介绍，它所发出的具有节奏感的“嗡——嗡嗡呜”声响非常嘹亮，可用于驱赶在比赛场上捣蛋的魔精们。<br /><br /></div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-300409.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/8/80/Belonging-300409.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">裁判用具套组<div class=\"grey-small\" style=\"text-wrap:wrap\">Officiator's Toolset</div></div></div><div><img alt=\"利齿子儿\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/62/Value-2.png/27px-Value-2.png\" decoding=\"async\" title=\"利齿子儿\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/6/62/Value-2.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />22.2<div class=\"grey-small\" style=\"float: right;\">信任达到100%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>为竞技裁判准备的皮质腰包，用于收纳各类神秘术道具。侧旁配备了装满烈酒的精致玻璃酒瓶，尽管做工和造型都无可挑剔，但考虑到受访者的使用习惯，有理由相信它只是一只用完即弃的消耗品。</div></div></div></div></div><div id=\"全新语音\"></div><h2><span id=\".E5.85.A8.E6.96.B0.E8.AF.AD.E9.9F.B3_New_Voice\"></span><span class=\"mw-headline\" id=\"全新语音_New_Voice\">全新语音<small style=\"color: grey\"> <span style=\"display:inline-block\">New Voice</span></small></span></h2><div><table class=\"wikitable responsive voice-table\" style=\"margin:0; --size: 23px; width:100%\"><tbody><tr class=\"hide-m\" style=\"vertical-align:middle\"><td style=\"text-align:center\"><img alt=\"Tupo xindiantu.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/107px-Tupo_xindiantu.png\" decoding=\"async\" width=\"107\" height=\"30\" class=\"img-fit\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/161px-Tupo_xindiantu.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/214px-Tupo_xindiantu.png 2x\" data-file-width=\"740\" data-file-height=\"208\" /></td><th>EN</th><th>中</th><th class=\"not-zh\">日</th><th class=\"not-zh\">한</th><th>文本</th></tr><tr><th>入队</th><td><span cla