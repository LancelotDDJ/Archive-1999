-thumb.huijistatic.com/res1999/uploads/thumb/d/d7/Item_heroskin-308603.png/200px-Item_heroskin-308603.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E8%A1%A3%E7%9D%80/%E7%94%9F%E5%A6%82%E8%A1%8C%E6%A3%8B\" title=\"衣着/生如行棋\">生如行棋</a><span class=\"tooltips-content\" style=\"text-align:left;\">我愿为先驱。</span></span></span></td></tr><tr><td class=\"source-text\"><span class=\"item-link\" data-itemid=\"308303\"><span class=\"item-link-frame\"><span class=\"item-link-rare\"><a href=\"/wiki/%E8%A1%A3%E7%9D%80/%E5%A3%81%E4%B8%8A%E6%A1%83%E6%BA%90\" title=\"衣着/壁上桃源\"><img alt=\"Bgequip6.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/100px-Bgequip6.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit notpageimage\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/150px-Bgequip6.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/200px-Bgequip6.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\"><a href=\"/wiki/%E8%A1%A3%E7%9D%80/%E5%A3%81%E4%B8%8A%E6%A1%83%E6%BA%90\" title=\"壁上桃源\"><img alt=\"壁上桃源\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/9f/Item_heroskin-308303.png/100px-Item_heroskin-308303.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/9f/Item_heroskin-308303.png/150px-Item_heroskin-308303.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/9f/Item_heroskin-308303.png/200px-Item_heroskin-308303.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E8%A1%A3%E7%9D%80/%E5%A3%81%E4%B8%8A%E6%A1%83%E6%BA%90\" title=\"衣着/壁上桃源\">壁上桃源</a><span class=\"tooltips-content\" style=\"text-align:left;\">画中无甲子，同酌酒一杯。</span></span></span></