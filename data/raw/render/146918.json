px-Bgequip6.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/200px-Bgequip6.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\" style=\"width:60%; padding-top:7%;\"><a href=\"/wiki/%E5%93%91%E8%B0%9C\" title=\"哑谜\"><img alt=\"哑谜\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/e/e1/HeadIconSmall-314301.png/100px-HeadIconSmall-314301.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/e/e1/HeadIconSmall-314301.png 1.5x\" data-file-width=\"136\" data-file-height=\"136\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E5%93%91%E8%B0%9C\" title=\"哑谜\">哑谜</a></span></span></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">实装版本：</span>3.9</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:3em\">来源：</span>银行</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">所属系列：</span>梅尔特米晴风</div></div><div><div class=\"grey-small test-hide hide-m\">编号ID：314303</div></div></div></div><div class=\"skin-video tabber\"><h2><span id=\".E8.A7.86.E9.A2.91.E9.A2.84.E8.A7.88\"></span><span class=\"mw-headline\" id=\"视频预览\">视频预览</span></h2><div class=\"tabber-filter\" style=\"margin:0 -3px 4px -3px\"><div class=\"tabber-filter-item filter-button selected\" data-type=\"videoId\" data-videoid=\"4\">1技能</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"3\">2技能</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"2\">大招</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"1\">入场</div></div><div class=\"skin-video--single tabber-item\" data-videoid=\"4\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜skill1.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜born.mp4_20260811_162514.452.png\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"3\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜skill2.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜born.mp4_20260811_162514.452.png\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"2\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜unique.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜born.mp4_20260811_162514.452.png\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"1\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜born.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3143/314303/哑谜born.mp4_20260811_162514.452.png\" style=\"display:none\"></div></div><h2><span id=\".E7.AA.97.E4.B8.AD.E4.BE.A7.E5.86.99_Garment_Display\"></span><span class=\"mw-headline\" id=\"窗中侧写_Garment_Display\">窗中侧写<small style=\"color: grey\"> <span style=\"display:inline-block\">Garment Display</span></small></span></h2><div class=\"infopad\">是谁把这个动力单元和仿生潜水套装放在哑谜桌上的？没人承认，但大部分人都猜是X研究员。这些东西出现的时间过于巧合，正是哑谜被强制休假之前。<br />尽管哑谜本人称穿上这身行头时，“可笑性远大于实用性”，然而面对深海——这个巨大的、自行运转亿万年的实验室，一点微不足道的尴尬情绪便自动为科研人员的探索精神让步了。<br />他的确收获颇丰。不止有一手研究资料，还有涤荡疲惫后的宁静。哑谜本人显然不会承认这些，他只是在假期结束后回到拉普拉斯，对X说一句：“我没因为你的奇怪发明在海里变成鱼饲料算我命大，但这创意不错。”</div><div id=\"崭新单品\"></div><h2><span id=\".E5.B4.AD.E6.96.B0.E5.8D.95.E5.93.81_All-new_Item\"></span><span class=\"mw-headline\" id=\"崭新单品_All-new_Item\">崭新单品<small style=\"color: grey\"> <span style=\"display:inline-block\">All-new Item</span></small></span></h2><div class=\"char-item-box0 tabber\"><div class=\"char-item-box1 tabber-item\" data-skinid=\"314303\"><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-314304.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/a/ab/Belonging-314304.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">拟态尾鳍推进器<div class=\"grey-small\" style=\"text-wrap:wrap\">Caudal Fin Propeller</div></div></div><div>无估值<hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>模仿鲨鱼尾鳍制作出的潜水推进器，尚处于实验状态的原型机，仅此一台。<br />这套装置并非为融入鲨鱼族群所制。他称这是仿生学的一种，自然界用残酷的衍化筛选使生物的结构得出了一个极度优化的解，而他所做的，就是借助自然界的启发，写出属于科学和神秘学的语言。</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-314305.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/b/b4/Belonging-314305.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">集合调节器<div class=\"grey-small\" style=\"text-wrap:wrap\">Integrated Regulator</div></div></div><div><img alt=\"雨滴\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/b/bb/Value-1.png/27px-Value-1.png\" decoding=\"async\" title=\"雨滴\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/b/bb/Value-1.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />589.3<div class=\"grey-small\" style=\"float: right;\">信任达到60%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>根据自身的使用习惯，受访者将给氧功能与尾鳍推进器的调节功能集合为一体。<br />虽然是多功能集成的调节器，但管线的配置却达到了最精准简单的状态，这本该是一件相当“麻烦”的事情，可受访者本人不以为意。</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-314306.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/a/ab/Belonging-314306.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">深海中的凭依<div class=\"grey-small\" style=\"text-wrap:wrap\">Succor in the Deep</div></div></div><div><img alt=\"利齿子儿\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/62/Value-2.png/27px-Value-2.png\" decoding=\"async\" title=\"利齿子儿\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/6/62/Value-2.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />30<div class=\"grey-small\" style=\"float: right;\">信任达到100%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>经由受访者改造的呼吸器咬嘴。<br />无论是潜入海中十米还是一百米，人们赖以生存的氧气都是通过它稳定地流入躯体之中，在进化出鳃之前，它是受访者在海中最重要的凭依之一。</div></div></div></div></div><div id=\"全新语音\"></div><h2><span id=\".E5.85.A8.E6.96.B0.E8.AF.AD.E9.9F.B3_New_Voice\"></span><span class=\"mw-headline\" id=\"全新语音_New_Voice\">全新语音<small style=\"color: grey\"> <span style=\"display:inline-block\">New Voice</span></small></span></h2><div><table class=\"wikitable responsive voice-table zh-only\" style=\"margin:0; --size: 23px; width:100%\"><tbody><tr class=\"hide-m\" style=\"vertical-align:middle\"><td style=\"text-align:center\"><img alt=\"Tupo xindiantu.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/107px-Tupo_xindiantu.png\" decoding=\"async\" width=\"107\" height=\"30\" class=\"img-fit\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/161px-Tupo_xindiantu.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/214px-Tupo_xindiantu.png 2x\" data-file-width=\"740\" data-file-height=\"208\" /></td><th>EN</th><th>中</th><th class=\"not-zh\">日</th><th class=\"not-zh\">한</th><th>文本</th></tr><tr><th>入队</th><td><span class=\"hide-pc\">EN </span><i class=\"audio-control style1\" data-audio=\"En_play_hero314303_fightingvoc_56.mp3\" title=\"play_hero314303_fightingvoc_56\"></i><i class=\"hide-pc\" style=\"margin:10px;\"><i class=\"verticalline\"></i></i><span class=\"hide-pc\">中 <i class=\"audio-control style1\" data-audio=\"Zh_play_hero314303_