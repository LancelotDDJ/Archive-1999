th: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_9_1.png\" class=\"image\"><img alt=\"Loading 9 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/46/Loading_9_1.png/230px-Loading_9_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/46/Loading_9_1.png/345px-Loading_9_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/46/Loading_9_1.png/459px-Loading_9_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_10_1.png\" class=\"image\"><img alt=\"Loading 10 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/5e/Loading_10_1.png/230px-Loading_10_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/5e/Loading_10_1.png/345px-Loading_10_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/5e/Loading_10_1.png/459px-Loading_10_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_11_1.png\" class=\"image\"><img alt=\"Loading 11 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/7d/Loading_11_1.png/230px-Loading_11_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/7d/Loading_11_1.png/345px-Loading_11_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/7d/Loading_11_1.png/459px-Loading_11_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_14_1.png\" class=\"image\"><img alt=\"Loading 14 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Loading_14_1.png/230px-Loading_14_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Loading_14_1.png/345px-Loading_14_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Loading_14_1.png/459px-Loading_14_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_15_1.png\" class=\"image\"><img alt=\"Loading 15 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/77/Loading_15_1.png/230px-Loading_15_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/77/Loading_15_1.png/345px-Loading_15_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/77/Loading_15_1.png/459px-Loading_15_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n</ul>\n<p>下列图片会显示在<b>不休荒原</b>的过场文本上方：\n</p>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_1_1.png\" class=\"image\"><img alt=\"Loading 1 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/54/Loading_1_1.png/230px-Loading_1_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/54/Loading_1_1.png/345px-Loading_1_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/54/Loading_1_1.png/459px-Loading_1_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_6_1.png\" class=\"image\"><img alt=\"Loading 6 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/f/f3/Loading_6_1.png/230px-Loading_6_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/f/f3/Loading_6_1.png/345px-Loading_6_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/f/f3/Loading_6_1.png/459px-Loading_6_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_12_1.png\" class=\"image\"><img alt=\"Loading 12 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/42/Loading_12_1.png/230px-Loading_12_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/42/Loading_12_1.png/345px-Loading_12_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/42/Loading_12_1.png/459px-Loading_12_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_13_1.png\" class=\"image\"><img alt=\"Loading 13 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8c/Loading_13_1.png/230px-Loading_13_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8c/Loading_13_1.png/345px-Loading_13_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8c/Loading_13_1.png/459px-Loading_13_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_16_1.png\" class=\"image\"><img alt=\"Loading 16 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/3/36/Loading_16_1.png/230px-Loading_16_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/3/36/Loading_16_1.png/345px-Loading_16_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/3/36/Loading_16_1.png/459px-Loading_16_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155.33333333333px\"><div style=\"width: 155.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 153.33333333333px;\"><div style=\"margin:0px auto;\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Loading_17_1.png\" class=\"image\"><img alt=\"Loading 17 1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/c9/Loading_17_1.png/230px-Loading_17_1.png\" decoding=\"async\" width=\"154\" height=\"90\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/c9/Loading_17_1.png/345px-Loading_17_1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/c9/Loading_17_1.png/459px-Loading_17_1.png 2x\" data-file-width=\"496\" data-file-height=\"292\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">\n\t\t\t</div>\n\t\t</div></li>\n</ul>\n<h2><span id=\".E8.B5.84.E6.BA.90.E5.8A.A0.E8.BD.BD.E8.BD.AE.E6.92.AD.E5.9B.BE\"></span><span class=\"mw-headline\" id=\"资源加载轮播图\">资源加载轮播图</span></h2>\n<table class=\"wikitable responsive center\">\n\n<tbody><tr>\n<th>过场图</th>\n<th width=\"13%\">场景 / 对象</th>\n<th>描述</th>\n<th width=\"8%\">备注\n</th></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg1.png\" class=\"image\"><img alt=\"Originbg1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/50/Originbg1.png/250px-Originbg1.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/50/Originbg1.png/375px-Originbg1.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/50/Originbg1.png/500px-Originbg1.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>暴雨</b></span><br /> <small style=\"color: #999;\">The Storm</small>\n</td>\n<td>它的到来让时间变得无足轻重。时而回到过去，时而重返未来。又或是一无所有，又或是浴火重生。</td>\n<td><small style=\"color: #999;\">公测即启用</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg2.png\" class=\"image\"><img alt=\"Originbg2.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/4d/Originbg2.png/250px-Originbg2.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/4d/Originbg2.png/375px-Originbg2.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/4d/Originbg2.png/500px-Originbg2.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a><br /><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg15.png\" class=\"image\"><img alt=\"Originbg15.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/a/ac/Originbg15.png/250px-Originbg15.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/a/ac/Originbg15.png/375px-Originbg15.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/a/ac/Originbg15.png/500px-Originbg15.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a>\n</td>\n<td><span style=\"color: #bc9567;\"><b>暴雨症候/时代病</b></span><br /> <small style=\"color: #999;\">Storm Syndrome</small></td>\n<td>它是荒谬而可笑，不可言说的癔症。<br />世界的秩序在暴雨冲刷之下难以辨认，一切都开始趋于疯狂，走向陌生。<br />生吞黄金、痛饮石油，歌舞于炙热的铁板之上。病人们总是不知道自己病了，任何时候都一样。</td>\n<td><small style=\"color: #999;\">公测即启用<br />3.0版本时替换新图<br />一列有多张图的，在下方的图是新图片。下同。</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg3.png\" class=\"image\"><img alt=\"Originbg3.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/e/e0/Originbg3.png/250px-Originbg3.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/e/e0/Originbg3.png/375px-Originbg3.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/e/e0/Originbg3.png/500px-Originbg3.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>1999年</b></span><br /> <small style=\"color: #999;\">Modern era</small>\n</td>\n<td>归根结底，是一个很好的年份。有聚会、倒计时、千禧虫、15寸彩色显示器，和一场无眠之夜。<br />尽管向后展望吧，我们有取之不竭的过去呢！你想买黄金吗？</td>\n<td><small style=\"color: #999;\">公测即启用</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg4.png\" class=\"image\"><img alt=\"Originbg4.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/72/Originbg4.png/250px-Originbg4.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/72/Originbg4.png/375px-Originbg4.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/72/Originbg4.png/500px-Originbg4.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a><br /><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg8.png\" class=\"image\"><img alt=\"Originbg8.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/71/Originbg8.png/250px-Originbg8.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/71/Originbg8.png/375px-Originbg8.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/71/Originbg8.png/500px-Originbg8.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>神秘学</b></span><br /> <small style=\"color: #999;\">Arcanum</small>\n</td>\n<td>与生俱来的才能，可被消磨却永不会消失的辉光。<br />它具有神奇效用，功率因人而异，用处可大可小，有时带来便利，有时带来漫长的苦果与不间断的麻烦。</td>\n<td><small style=\"color: #999;\">公测即启用<br />3.0版本时替换新图</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg5.png\" class=\"image\"><img alt=\"Originbg5.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/f/f8/Originbg5.png/250px-Originbg5.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/f/f8/Originbg5.png/375px-Originbg5.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/f/f8/Originbg5.png/500px-Originbg5.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a><br /><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg9.png\" class=\"image\"><img alt=\"Originbg9.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/72/Originbg9.png/250px-Originbg9.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/72/Originbg9.png/375px-Originbg9.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/72/Originbg9.png/500px-Originbg9.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>神秘学家</b></span><br /> <small style=\"color: #999;\">Arcanist</small>\n</td>\n<td>一个种族，因天赋被世界所遗忘，好与其他忙碌的人们区分开来。<br />没有人知道神秘学家是为什么成为神秘学家的，他们曾经昌盛过，如今已然衰落。</td>\n<td><small style=\"color: #999;\">公测即启用<br />3.0版本时替换新图</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg6.png\" class=\"image\"><img alt=\"Originbg6.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/60/Originbg6.png/250px-Originbg6.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/60/Originbg6.png/375px-Originbg6.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/60/Originbg6.png/500px-Originbg6.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a><br /><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg10.png\" class=\"image\"><img alt=\"Originbg10.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/85/Originbg10.png/250px-Originbg10.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/85/Originbg10.png/375px-Originbg10.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/85/Originbg10.png/500px-Originbg10.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>拉普拉斯科算中心</b></span><br /> <small style=\"color: #999;\">Laplace Scientific Computing Center</small>\n</td>\n<td>灵感？还是逻辑？这对拉普拉斯来说不是问题。<br />凡存在的东西，必是无尽未来方程的一部分。</td>\n<td><small style=\"color: #999;\">公测即启用<br />3.0版本时替换新图</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg7.png\" class=\"image\"><img alt=\"Originbg7.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/64/Originbg7.png/250px-Originbg7.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/64/Originbg7.png/375px-Originbg7.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/64/Originbg7.png/500px-Originbg7.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>芝诺军备学院</b></span><br /> <small style=\"color: #999;\">Zeno Armaments Engineering and Technology Academy</small>\n</td>\n<td>服从，坚定，从不退怯。<br />以优补优，主张融合神秘学界武装力量与人类社会武装力量的组织。<br />作为鸽子屋的常备军队活动于世界各地，同时担负着筛选与培育下一代战斗力量的责任。<br />在《视界线公约》签署后陆续与各国签订引渡条约，接收来自于不同国家的适龄儿童，进行系统战术训练。</td>\n<td><small style=\"color: #999;\">2.2版本新增</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg12.png\" class=\"image\"><img alt=\"Originbg12.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/3/3c/Originbg12.png/250px-Originbg12.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/3/3c/Originbg12.png/375px-Originbg12.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/3/3c/Originbg12.png/500px-Originbg12.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>乌卢鲁运动会</b></span><br /> <small style=\"color: #999;\">The Uluru Games</small>\n</td>\n<td>和平、奋斗、公正、竞技、热情。<br />它是一段段古老而崇高的相遇与重逢，恰如那簇永不熄灭的圣火。</td>\n<td><small style=\"color: #999;\">3.0版本新增</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg13.png\" class=\"image\"><img alt=\"Originbg13.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/60/Originbg13.png/250px-Originbg13.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/60/Originbg13.png/375px-Originbg13.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/60/Originbg13.png/500px-Originbg13.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>人工梦游</b></span><br /> <small style=\"color: #999;\">Artificial Somnambulism</small>\n</td>\n<td>在玻璃琴的辅助下，通过声音的赫兹引导，人工梦游可以涉足你的深层颅脑意识。<br />梦境？回忆？幻象？情绪？人工梦游都可以替你制造。</td>\n<td><small style=\"color: #999;\">3.0版本新增</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg11.png\" class=\"image\"><img alt=\"Originbg11.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/5a/Originbg11.png/250px-Originbg11.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/5a/Originbg11.png/375px-Originbg11.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/5a/Originbg11.png/500px-Originbg11.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>星锑唱片</b></span><br /> <small style=\"color: #999;\">Regulus's Record</small>\n</td>\n<td>星锑空间望远镜和星锑唱片穿越暴雨，在近地轨道旋转十二年，最后坠落在奥尔德堡。<br />它被证实是具备微弱暴雨免疫性能的材料，同时，它也是伟大的摇滚海盗最爱的唱片。</td>\n<td><small style=\"color: #999;\">3.0版本新增</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg14.png\" class=\"image\"><img alt=\"Originbg14.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d9/Originbg14.png/250px-Originbg14.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d9/Originbg14.png/375px-Originbg14.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d9/Originbg14.png/500px-Originbg14.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>霍夫曼结</b></span><br /> <small style=\"color: #999;\">The Hofmann Knot</small>\n</td>\n<td>实体化的暴雨免疫术式，它的每一寸蔓延和每一个弧度，都刻有牺牲。<br />它的名字来源于第三贡献者哑谜，他以姓氏命名，纪念为寻找免疫术式而付出生命的姐姐。</td>\n<td><small style=\"color: #999;\">3.0版本新增</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg16.png\" class=\"image\"><img alt=\"Originbg16.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/c9/Originbg16.png/250px-Originbg16.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/c9/Originbg16.png/375px-Originbg16.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/c9/Originbg16.png/500px-Originbg16.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>“热沃当的野兽”</b></span><br /> <small style=\"color: #999;\">Beast of Gévaudan</small>\n</td>\n<td>在1936年法国巴黎，人们谣传它，忌讳它，害怕它——也创造了它。<br />它始于一场混乱的癔症。市民深陷幻觉，失去维系日常的理性与常识，最后成为“野兽”……</td>\n<td><small style=\"color: #999;\">3.2版本新增</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Originbg17.png\" class=\"image\"><img alt=\"Originbg17.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/e/e3/Originbg17.png/250px-Originbg17.png\" decoding=\"async\" width=\"250\" height=\"104\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/e/e3/Originbg17.png/375px-Originbg17.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/e/e3/Originbg17.png/500px-Originbg17.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>迷思海</b></span><br /> <small style=\"color: #999;\">Depths of Myth</small>\n</td>\n<td>意象宝库、世界灵魂、所有人的梦境、集体潜意识的海洋……<br />在悠久的历史上，人们曾赋予它各种称呼，但亲眼见过的人屈指可数。</td>\n<td><small style=\"color: #999;\">3.2版本新增</small>\n</td></tr></tbody></table>\n<h2><span id=\".E5.90.AF.E5.8A.A8.E7.95.8C.E9.9D.A2\"></span><span class=\"mw-headline\" id=\"启动界面\">启动界面</span></h2>\n<table class=\"wikitable center\">\n\n<tbody><tr>\n<th>背景图</th>\n<th>界面图</th>\n<th>主题\n</th></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Bg_denglubeijing.png\" class=\"image\"><img alt=\"Bg denglubeijing.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d9/Bg_denglubeijing.png/240px-Bg_denglubeijing.png\" decoding=\"async\" width=\"240\" height=\"79\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d9/Bg_denglubeijing.png/360px-Bg_denglubeijing.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d9/Bg_denglubeijing.png/480px-Bg_denglubeijing.png 2x\" data-file-width=\"2048\" data-file-height=\"674\" /></a></td>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A21.png\" class=\"image\"><img alt=\"登录界面1.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/ca/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A21.png/200px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A21.png\" decoding=\"async\" width=\"200\" height=\"112\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/ca/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A21.png/300px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A21.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/c/ca/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A21.png/400px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A21.png 2x\" data-file-width=\"1777\" data-file-height=\"996\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>生者与余众</b></span><br /><small style=\"color: #999;\">公测即启用</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Bg_denglubeijing_b01.png\" class=\"image\"><img alt=\"Bg denglubeijing b01.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8a/Bg_denglubeijing_b01.png/240px-Bg_denglubeijing_b01.png\" decoding=\"async\" width=\"240\" height=\"101\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8a/Bg_denglubeijing_b01.png/360px-Bg_denglubeijing_b01.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8a/Bg_denglubeijing_b01.png/480px-Bg_denglubeijing_b01.png 2x\" data-file-width=\"2808\" data-file-height=\"1184\" /></a></td>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A22.png\" class=\"image\"><img alt=\"登录界面2.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/b/bc/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A22.png/200px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A22.png\" decoding=\"async\" width=\"200\" height=\"112\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/b/bc/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A22.png/300px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A22.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/b/bc/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A22.png/400px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A22.png 2x\" data-file-width=\"1777\" data-file-height=\"996\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>旅行归来</b></span><br /><small style=\"color: #999;\">1.9版本新增</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:Bg_denglubeijing_b02.png\" class=\"image\"><img alt=\"Bg denglubeijing b02.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/7e/Bg_denglubeijing_b02.png/240px-Bg_denglubeijing_b02.png\" decoding=\"async\" width=\"240\" height=\"100\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/7e/Bg_denglubeijing_b02.png/360px-Bg_denglubeijing_b02.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/7e/Bg_denglubeijing_b02.png/480px-Bg_denglubeijing_b02.png 2x\" data-file-width=\"1920\" data-file-height=\"800\" /></a></td>\n<td><a href=\"/wiki/%E6%96%87%E4%BB%B6:%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A23.png\" class=\"image\"><img alt=\"登录界面3.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/66/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A23.png/200px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A23.png\" decoding=\"async\" width=\"200\" height=\"112\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/66/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A23.png/300px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A23.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/66/%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A23.png/400px-%E7%99%BB%E5%BD%95%E7%95%8C%E9%9D%A23.png 2x\" data-file-width=\"1777\" data-file-height=\"996\" /></a></td>\n<td><span style=\"color: #bc9567;\"><b>故事的根须</b></span><br /><small style=\"color: #999;\">3.0版本新增</small>\n</td></tr></tbody></table></div>", "categories": [{"sortkey": "", "category": "记录"}], "displaytitle": "过场信息"}}