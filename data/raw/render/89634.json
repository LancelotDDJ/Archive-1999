nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>嗯……我可不喜欢这么安静的地方。</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>虽然没有朋友，但我也可以发出很大的声音！</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>来吧！让我吼叫吧！嗷嗷哦！</div></div></div></div></div><div class=\"tabber-item tabber\" data-type=\"index\" data-index=\"4\"><div class=\"episode-switchbtn\"><small style=\"color: #999;\">头像 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-storyBg\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Cg-guanjiaoxuexiaokeshi.png\" class=\"image\" title=\"guanjiaoxuexiaokeshi\"><img alt=\"guanjiaoxuexiaokeshi\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/600px-Cg-guanjiaoxuexiaokeshi.png\" decoding=\"async\" width=\"600\" height=\"250\" class=\"story-bg\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/900px-Cg-guanjiaoxuexiaokeshi.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/1200px-Cg-guanjiaoxuexiaokeshi.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></div><div class=\"story-text\"><div>小鹿儿转了个身，尾巴尖儿蹭过了一位沾满了灰尘的、带有奇异凸起的椅子朋友。</div></div><div class=\"story-text\"><div class=\"story-text--name\">椅子：</div><div>……！</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>痛！</div></div><div class=\"story-text\"><div class=\"story-text--name\">椅子：</div><div>……</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>这椅子……会咬人？</div></div></div></div></div><div class=\"tabber-item tabber\" data-type=\"index\" data-index=\"5\"><div class=\"episode-switchbtn\"><small style=\"color: #999;\">头像 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-storyBg\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Cg-guanjiaoxuexiaokeshi.png\" class=\"image\" title=\"guanjiaoxuexiaokeshi\"><img alt=\"guanjiaoxuexiaokeshi\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/600px-Cg-guanjiaoxuexiaokeshi.png\" decoding=\"async\" width=\"600\" height=\"250\" class=\"story-bg\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/900px-Cg-guanjiaoxuexiaokeshi.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/1200px-Cg-guanjiaoxuexiaokeshi.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>我的尾巴……呜呜，一回到这里就感觉好痛……</div></div><div class=\"story-text\"><div>椅子上的奇异凸起似乎动了动。</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>怎么椅子上有……这是菌丝吗？</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>啊！它沾到我的尾巴上了！</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>尾巴……尾巴感觉好疼！我得赶紧离开这儿！</div></div></div></div></div><div class=\"tabber-item tabber\" data-type=\"index\" data-index=\"6\"><div class=\"episode-switchbtn\"><small style=\"color: #999;\">头像 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-storyBg\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Cg-guanjiaoxuexiaokeshi.png\" class=\"image\" title=\"guanjiaoxuexiaokeshi\"><img alt=\"guanjiaoxuexiaokeshi\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/600px-Cg-guanjiaoxuexiaokeshi.png\" decoding=\"async\" width=\"600\" height=\"250\" class=\"story-bg\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/900px-Cg-guanjiaoxuexiaokeshi.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/1200px-Cg-guanjiaoxuexiaokeshi.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>我只是偷偷看一眼，只是偷偷地……</div></div><div class=\"story-text\"><div class=\"story-text--name\">椅子：</div><div>……</div></div><div class=\"story-text\"><div class=\"story-text--name\">椅子：</div><div>呜呜——</div></div><div class=\"story-text\"><div>奇异凸起发出了窸窸窣窣的响声。</div></div><div class=\"story-text\"><div class=\"story-text--name\">椅子：</div><div>呜呜——嗷嗷嗷——</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>那是……扁扁的、毛茸茸的朋友？是……魔精朋友！</div></div></div></div></div><div class=\"tabber-item tabber\" data-type=\"index\" data-index=\"7\"><div class=\"episode-switchbtn\"><small style=\"color: #999;\">头像 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-storyBg\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Cg-guanjiaoxuexiaokeshi.png\" class=\"image\" title=\"guanjiaoxuexiaokeshi\"><img alt=\"guanjiaoxuexiaokeshi\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/600px-Cg-guanjiaoxuexiaokeshi.png\" decoding=\"async\" width=\"600\" height=\"250\" class=\"story-bg\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/900px-Cg-guanjiaoxuexiaokeshi.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/1200px-Cg-guanjiaoxuexiaokeshi.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></div><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>呜呜——嗷嗷嗷啊——</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>你看起来很不舒服，需要我帮你下来吗？</div></div><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>呜呜呜嗷嗷嗷嗷——</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>粘得好紧……要是有什么东西能咬断这些粘液就好了。</div></div></div></div></div><div class=\"tabber-item tabber\" data-type=\"index\" data-index=\"8\"><div class=\"episode-switchbtn\"><small style=\"color: #999;\">头像 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-storyBg\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Cg-guanjiaoxuexiaokeshi.png\" class=\"image\" title=\"guanjiaoxuexiaokeshi\"><img alt=\"guanjiaoxuexiaokeshi\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/600px-Cg-guanjiaoxuexiaokeshi.png\" decoding=\"async\" width=\"600\" height=\"250\" class=\"story-bg\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/900px-Cg-guanjiaoxuexiaokeshi.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/1200px-Cg-guanjiaoxuexiaokeshi.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></div><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>嗷嗷呜呜——</div></div></div></div></div><div class=\"tabber-item tabber\" data-type=\"index\" data-index=\"9\"><div class=\"episode-switchbtn\"><small style=\"color: #999;\">头像 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>呜呜——嗷嗷——！</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>唔……你——坚持下！我再使点力气……</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>呼，呼……</div></div><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>呜……</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>真抱歉……我以为我最近力气变大，可以把你从上面扯下来呢。</div></div><div class=\"story-text\"><div class=\"story-text--name\">洁西卡：</div><div>看来还是需要那些爱咬东西的先生……就像森林里的那些咬咬啮齿虫！唔，到底哪里会有呢？</div></div></div></div></div><div class=\"tabber-item tabber\" data-type=\"index\" data-index=\"10\"><div class=\"episode-switchbtn\"><small style=\"color: #999;\">头像 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyHeadicon mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small> <small style=\"color: #999;\">背景图 <div class=\"switchbtn\" style=\"display: inline-block;\"><i class=\"mw-customtoggle-storyBg mw-customtoggle-\"><img alt=\"显示\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/20px-Btn_watch_nor.png\" decoding=\"async\" title=\"显示\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/30px-Btn_watch_nor.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/2e/Btn_watch_nor.png/40px-Btn_watch_nor.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i><i class=\"mw-customtoggle-storyBg mw-customtoggle-\" style=\"display: none;\"><img alt=\"隐藏\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/20px-Btn_watch_selected.png\" decoding=\"async\" title=\"隐藏\" width=\"20\" height=\"20\" style=\"vertical-align: middle\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/30px-Btn_watch_selected.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/Btn_watch_selected.png/40px-Btn_watch_selected.png 2x\" data-file-width=\"56\" data-file-height=\"56\" /></i></div></small></div><div class=\"episode-desc\"><div style=\"display:flex;\"><div style=\"flex-grow:1;\"></div></div></div><div class=\"battle-panel\"><div class=\"story no-indent\"><div class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-storyBg\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:Cg-guanjiaoxuexiaokeshi.png\" class=\"image\" title=\"guanjiaoxuexiaokeshi\"><img alt=\"guanjiaoxuexiaokeshi\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/600px-Cg-guanjiaoxuexiaokeshi.png\" decoding=\"async\" width=\"600\" height=\"250\" class=\"story-bg\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/900px-Cg-guanjiaoxuexiaokeshi.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/73/Cg-guanjiaoxuexiaokeshi.png/1200px-Cg-guanjiaoxuexiaokeshi.png 2x\" data-file-width=\"2592\" data-file-height=\"1080\" /></a></div><div class=\"story-text\"><span class=\"mw-collapsible mw-collapsed story-text--headicon\" id=\"mw-customcollapsible-storyHeadicon\"><img alt=\"305601.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/23px-HeadIconSmall-305601.png\" decoding=\"async\" title=\"305601.png\" width=\"23\" height=\"23\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/35px-HeadIconSmall-305601.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/46px-HeadIconSmall-305601.png 2x\" data-file-width=\"136\" data-file-height=\"136\" /></span><div class=\"story-text--name\">洁西卡：</div><div>对啦，我知道啦！</div></div><div class=\"story-text\"><span class=\"mw-collapsible mw-collapsed story-text--headicon\" id=\"mw-customcollapsible-storyHeadicon\"><img alt=\"305601.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/23px-HeadIconSmall-305601.png\" decoding=\"async\" title=\"305601.png\" width=\"23\" height=\"23\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/35px-HeadIconSmall-305601.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/46px-HeadIconSmall-305601.png 2x\" data-file-width=\"136\" data-file-height=\"136\" /></span><div class=\"story-text--name\">洁西卡：</div><div>安迪，是安迪，安迪一定能咬断这些粘液，把你救下来的！</div></div><div class=\"story-text\"><div>左掏掏，右找找，一只小虫放在了椅面上。</div></div><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>咕……叽叽！</div></div><div class=\"story-text\"><span class=\"mw-collapsible mw-collapsed story-text--headicon\" id=\"mw-customcollapsible-storyHeadicon\"><img alt=\"305601.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/23px-HeadIconSmall-305601.png\" decoding=\"async\" title=\"305601.png\" width=\"23\" height=\"23\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/35px-HeadIconSmall-305601.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/46px-HeadIconSmall-305601.png 2x\" data-file-width=\"136\" data-file-height=\"136\" /></span><div class=\"story-text--name\">洁西卡：</div><div>还差一点点了，安迪！</div></div><div class=\"story-text\"><div>粘液断裂，扁扁的魔精嗖的一下跳起，欣喜得呜咽起来。</div></div><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>唧唧！！唧唧呜呜！</div></div><div class=\"story-text\"><span class=\"mw-collapsible mw-collapsed story-text--headicon\" id=\"mw-customcollapsible-storyHeadicon\"><img alt=\"305601.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/23px-HeadIconSmall-305601.png\" decoding=\"async\" title=\"305601.png\" width=\"23\" height=\"23\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/35px-HeadIconSmall-305601.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/4/48/HeadIconSmall-305601.png/46px-HeadIconSmall-305601.png 2x\" data-file-width=\"136\" data-file-height=\"136\" /></span><div class=\"story-text--name\">洁西卡：</div><div>太好了！你自由啦！</div></div><div class=\"story-text\"><div class=\"story-text--name\">压扁的魔精：</div><div>唧——唧！！</div></div><div class=\"story-text\"><div>他们为自由而欢呼喝彩。</div></div></div></div></div></div></div>", "categories": [{"sortkey": "", "category": "没有战斗的章节", "hidden": true}, {"sortkey": "", "category": "章节"}], "displaytitle": "飞跃旧屋之墙-教室"}}