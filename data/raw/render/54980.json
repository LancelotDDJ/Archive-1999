quip5.png/200px-Bgequip5.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\"><a href=\"/wiki/%E8%BD%AE%E4%B8%8E%E8%BD%B4%E4%B9%8B%E8%8A%AF\" title=\"轮与轴之芯\"><img alt=\"轮与轴之芯\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/87/Item-110704.png/100px-Item-110704.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/87/Item-110704.png/150px-Item-110704.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/87/Item-110704.png/200px-Item-110704.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E8%BD%AE%E4%B8%8E%E8%BD%B4%E4%B9%8B%E8%8A%AF\" title=\"轮与轴之芯\">轮与轴之芯</a><span class=\"tooltips-content\" style=\"text-align:left;\">钟表的心房内铭刻着“精准”二字。用于角色的洞悉与共鸣仪式。</span></span><span>&#160;</span><span class=\"item-link-count\" style=\"float:right\">×1</span></span></td><td class=\"source-text\"><span class=\"item-link\" data-itemid=\"1/110804\"><span class=\"item-link-frame\"><span class=\"item-link-rare\"><a href=\"/wiki/%E9%87%91%E9%92%9F%E7%81%B5%E8%B4%A8%E7%93%B6\" title=\"金钟灵质瓶\"><img alt=\"Bgequip5.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/9b/Bgequip5.png/100px-Bgequip5.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit notpageimage\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/9b/Bgequip5.png/150px-Bgequip5.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/9b/Bgequip5.png/200px-Bgequip5.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\"><a href=\"/wiki/%E9%87%91%E9%92%9F%E7%81%B5%E8%B4%A8%E7%93%B6\" title=\"金钟灵质瓶\"><img alt=\"金钟灵质瓶\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/54/Item-110804.png/100px-Item-110804.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" s