8/Bgequip6.png/150px-Bgequip6.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/200px-Bgequip6.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\" style=\"width:60%; padding-top:7%;\"><a href=\"/wiki/%E7%8E%9B%E4%B8%BD%E5%AE%89%E5%A8%9C\" title=\"玛丽安娜\"><img alt=\"玛丽安娜\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/5/5d/HeadIconSmall-312601.png/100px-HeadIconSmall-312601.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/5/5d/HeadIconSmall-312601.png 1.5x\" data-file-width=\"136\" data-file-height=\"136\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E7%8E%9B%E4%B8%BD%E5%AE%89%E5%A8%9C\" title=\"玛丽安娜\">玛丽安娜</a></span></span></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">实装版本：</span>S02</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:3em\">来源：</span>银行</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">所属系列：</span>21又1</div></div><div><div class=\"grey-small test-hide hide-m\">编号ID：312606</div></div></div></div><div class=\"skin-video tabber\"><h2><span id=\".E8.A7.86.E9.A2.91.E9.A2.84.E8.A7.88\"></span><span class=\"mw-headline\" id=\"视频预览\">视频预览</span></h2><div class=\"tabber-filter\" style=\"margin:0 -3px 4px -3px\"><div class=\"tabber-filter-item filter-button selected\" data-type=\"videoId\" data-videoid=\"4\">1技能</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"3\">2技能</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"2\">大招</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"1\">入场</div></div><div class=\"skin-video--single tabber-item\" data-videoid=\"4\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/玛丽安娜-1技能.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/玛丽安娜-1技能 - frame at 0m0s.jpg\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"3\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/玛丽安娜-2技能.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/玛丽安娜-2技能 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"2\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/7月20日 (1)(2).mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/玛丽安娜-大招 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"1\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/玛丽安娜-入场.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3126/312606/玛丽安娜-入场 - frame at 0m0s.jpg\" style=\"display:none\"></div></div><h2><span id=\".E7.AA.97.E4.B8.AD.E4.BE.A7.E5.86.99_Garment_Display\"></span><span class=\"mw-headline\" id=\"窗中侧写_Garment_Display\">窗中侧写<small style=\"color: grey\"> <span style=\"display:inline-block\">Garment Display</span></small></span></h2><div class=\"infopad\">按人所作的报应人，使各人照所行的得报。<br />冷风在古堡盘旋尖啸，铅云低垂，连月光也销声匿迹。她一手持天平，一手持长剑，口吐烈火的巨龙忠诚地跟随她。阿努比斯称量天平两端的心脏与羽毛，以决定亡灵是否该被阿米特吞噬。但对她而言，古埃及神话中对亡灵的惩罚实在太晚，是非对错在尘世应有公论，善恶赏罚于此间必须分明。当她手中称量罪与理的天平倾斜之时，罪恶便无所遁形。<br />她称量、挥剑——裁决之刻，巨龙怒目切齿，硫磺与火从天而降。惊惧的罪人眼中，映出她高举长剑，施行公义与审判的冰冷神情。<br />罪行已得报应，此地空无一人。她在硫磺火的余烬间一步不停地向前走去，没有回头。</div><div id=\"崭新单品\"></div><h2><span id=\".E5.B4.AD.E6.96.B0.E5.8D.95.E5.93.81_All-new_Item\"></span><span class=\"mw-headline\" id=\"崭新单品_All-new_Item\">崭新单品<small style=\"color: grey\"> <span style=\"display:inline-block\">All-new Item</span></small></span></h2><div class=\"char-item-box0 tabber\"><div class=\"char-item-box1 tabber-item\" data-skinid=\"312606\"><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-312607.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/9/9f/Belonging-312607.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">“度量正义”<div class=\"grey-small\" style=\"text-wrap:wrap\">\"The Scales of Justice\"</div></div></div><div>无估值<hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>以羽毛衡量罪孽之深重，辨别隐匿于人群中的恶魔；以利剑降下判决与天罚，因她即正义的化身。<br />面对天平是否真的能称量人之罪恶这个问题，受访者回答：“人人都有自己应赎的罪，我亦如是。这一点无需称量也能得知。”因此笔者感到好奇，受访者是否真的使用过这柄利剑惩戒他人？</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-312608.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/0/00/Belonging-312608.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">“公理的怒火”<div class=\"grey-small\" style=\"text-wrap:wrap\">\"Flame of Righteousness\"</div></div></div><div><img alt=\"雨滴\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/b/bb/Value-1.png/27px-Value-1.png\" decoding=\"async\" title=\"雨滴\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/b/bb/Value-1.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />25<div class=\"grey-small\" style=\"float: right;\">信任达到60%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>一件做工精细的披风，堆叠起来时略显厚重，其上的金属饰扣为受访者的个人珍藏。<br />为了不破坏披风尾部原本剪裁的弧度，受访者在将披风收叠整齐时，会小心地将披风下摆留在外面免受挤压。受访者表示自己很喜欢披风尾部的设计，因其罕见，也因其使惩罚得以具象化。</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-312609.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/9/9e/Belonging-312609.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">裁决者之袍<div class=\"grey-small\" style=\"text-wrap:wrap\">The Justiciar's Robe</div></div></div><div><img alt=\"雨滴\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/b/bb/Value-1.png/27px-Value-1.png\" decoding=\"async\" title=\"雨滴\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/b/bb/Value-1.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />17<div class=\"grey-small\" style=\"float: right;\">信任达到100%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>样式朴素的长袍，用料不算柔软，却能在坚硬冰冷的盔甲中保护受访者的皮肤。<br />她当忍受痛楚、历经磨难，于无数夜晚吞下无数罪孽与丑恶。而后，鞭笞与苦果使她蜕变为制裁之剑。包裹于这苍白的棉麻剑鞘中时，她感到自己内心难得地平静：“一切修行得此回报。”</div></div></div></div></div><div id=\"全新语音\"></div><h2><span id=\".E5.85.A8.E6.96.B0.E8.AF.AD.E9.9F.B3_New_Voice\"></span><span class=\"mw-headline\" id=\"全新语音_New_Voice\">全新语音<small style=\"color: grey\"> <span style=\"display:inline-block\">New Voice</span></small></span></h2><div><table class=\"wikitable responsive voice-table zh-only\" style=\"margin:0; --size: 23px; width:100%\"><tbody><tr class=\"hide-m\" style=\"vertical-align:middle\"><td style=\"text-align:center\"><img alt=\"Tupo xindiantu.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/107px-Tupo_xindiantu.png\" decoding=\"async\" width=\"107\" height=\"30\" class=\"img-fit\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/161px-Tupo_xindiantu.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/214px-Tupo_xindiantu.png 2x\" data-file-width=\"740\" data-file-height=\"208\" /></td><th>EN</th><th>中</th><th class=\"not-zh\">日</th><th class=\"not-zh\">한</th><th>文本</th></tr><tr><th>入队</th><td><span class=\"hide-pc\">EN </span><i class=\"audio-control style1\" data-audio=\"En_play_hero312606_fightingvoc_71.mp3\" title=\"play_hero312606_fightingvoc_71\"></i><i class=\"hide-pc\" 