umb/0/08/Bgequip6.png/150px-Bgequip6.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/200px-Bgequip6.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\" style=\"width:60%; padding-top:7%;\"><a href=\"/wiki/%E5%9B%BE%E5%9B%BE%E7%9F%B3%E5%AD%90\" title=\"图图石子\"><img alt=\"图图石子\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/a/a3/HeadIconSmall-310901.png/100px-HeadIconSmall-310901.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/a/a3/HeadIconSmall-310901.png 1.5x\" data-file-width=\"136\" data-file-height=\"136\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E5%9B%BE%E5%9B%BE%E7%9F%B3%E5%AD%90\" title=\"图图石子\">图图石子</a></span></span></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">实装版本：</span>3.7</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:3em\">来源：</span>银行</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">所属系列：</span>生死诘问</div></div><div><div class=\"grey-small test-hide hide-m\">编号ID：310905</div></div></div></div><div class=\"skin-video tabber\"><h2><span id=\".E8.A7.86.E9.A2.91.E9.A2.84.E8.A7.88\"></span><span class=\"mw-headline\" id=\"视频预览\">视频预览</span></h2><div class=\"tabber-filter\" style=\"margin:0 -3px 4px -3px\"><div class=\"tabber-filter-item filter-button selected\" data-type=\"videoId\" data-videoid=\"4\">1技能</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"3\">2技能</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"2\">大招</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"1\">入场</div></div><div class=\"skin-video--single tabber-item\" data-videoid=\"4\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子-1技能.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子-1技能 - frame at 0m0s.jpg\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"3\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子-2技能.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子-2技能 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"2\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子-大招（新）.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子大招.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"1\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子-入场.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3109/310905/图图石子-入场 - frame at 0m0s.jpg\" style=\"display:none\"></div></div><h2><span id=\".E7.AA.97.E4.B8.AD.E4.BE.A7.E5.86.99_Garment_Display\"></span><span class=\"mw-headline\" id=\"窗中侧写_Garment_Display\">窗中侧写<small style=\"color: grey\"> <span style=\"display:inline-block\">Garment Display</span></small></span></h2><div class=\"infopad\">黄昏与夜幕互相侵吞着，那往复的潮水，又没过了脚踝。<br />新鞋子不耐盐蚀，被妥善安放，或者说是被放逐在沙滩外，好将赤脚与海洋的记忆交还。<br />这些扎痛脚心的、碎裂的海贝，是潮汐的礼物吗？那为什么如此轻易就被潮汐拍碎？<br />那些呼啸的梦，正无声无息地失去温度、失去色彩、失去可用手指描摹的轮廓……<br />如果泪水会像潮汐一样冲毁记忆的堤坝，如果那些溃倒的屋舍，已经像晚潮时的海贝一样散落在岛群与海底……<br />如果我是见证之人，我是记忆之人，我是侥幸逃离之人——<br />多庆幸，我还能点燃一盏“罗盘灼灼”，在这场淹没所有的风暴里守望、等待，并再次前行。</div><div id=\"崭新单品\"></div><h2><span id=\".E5.B4.AD.E6.96.B0.E5.8D.95.E5.93.81_All-new_Item\"></span><span class=\"mw-headline\" id=\"崭新单品_All-new_Item\">崭新单品<small style=\"color: grey\"> <span style=\"display:inline-block\">All-new Item</span></small></span></h2><div class=\"char-item-box0 tabber\"><div class=\"char-item-box1 tabber-item\" data-skinid=\"310905\"><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-310907.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/5/5e/Belonging-310907.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">海岛拼图<div class=\"grey-small\" style=\"text-wrap:wrap\">Island Pieces</div></div></div><div><img alt=\"利齿子儿\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/62/Value-2.png/27px-Value-2.png\" decoding=\"async\" title=\"利齿子儿\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/6/62/Value-2.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />1.7<hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>这是以骨螺提取物着色、经由海水媒染后缝缀在裙摆上的拼图碎片。沉淀后的纹路上有棕榈叶、海浪及海岛的影子。<br />拼图随裙摆起伏、摇曳，诉说漂泊与怀想。受访者缝合它们，却无法用它们拼凑出一幅完整的家乡。</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-310908.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/3/32/Belonging-310908.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">“听风来函”<div class=\"grey-small\" style=\"text-wrap:wrap\">\"Message in the Wind\"</div></div></div><div><img alt=\"利齿子儿\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/62/Value-2.png/27px-Value-2.png\" decoding=\"async\" title=\"利齿子儿\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/6/62/Value-2.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />50<div class=\"grey-small\" style=\"float: right;\">信任达到60%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>一柄由棕榈叶细细编织的伞，顺着叶梢，还落下几缕茂盛的思念。<br />受访者笑着说，“我很喜欢伞里的味道，有时甚至躲在底下打盹儿，就像在海岸边时一样。”</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-310909.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/d/d1/Belonging-310909.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">“纪念生长”<div class=\"grey-small\" style=\"text-wrap:wrap\">\"Memories of Growth\"</div></div></div><div><img alt=\"利齿子儿\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/62/Value-2.png/27px-Value-2.png\" decoding=\"async\" title=\"利齿子儿\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/6/62/Value-2.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />105<div class=\"grey-small\" style=\"float: right;\">信任达到100%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>一双白色的粗跟鞋，鞋上的花纹画法稍显青涩，记录下一个女孩儿的成长与留恋。<br />采访开始前，受访者匆匆赶来。她步履轻快，但略带练习中的毛糙。“我仍不太习惯穿着鞋走路，但这里的地面可不及家乡的松软。”</div></div></div></div></div><div id=\"全新语音\"></div><h2><span id=\".E5.85.A8.E6.96.B0.E8.AF.AD.E9.9F.B3_New_Voice\"></span><span class=\"mw-headline\" id=\"全新语音_New_Voice\">全新语音<small style=\"color: grey\"> <span style=\"display:inline-block\">New Voice</span></small></span></h2><div><table class=\"wikitable responsive voice-table zh-only\" style=\"margin:0; --size: 23px; width:100%\"><tbody><tr class=\"hide-m\" style=\"vertical-align:middle\"><td style=\"text-align:center\"><img alt=\"Tupo xindiantu.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/107px-Tupo_xindiantu.png\" decoding=\"async\" width=\"107\" height=\"30\" class=\"img-fit\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/161px-Tupo_xindiantu.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/8/8b/Tupo_xindiantu.png/214px-Tupo_xindiantu.png 2x\" data-file-width=\"740\" data-file-height=\"208\" /></td><th>EN</th><th>中</th><th class=\"not-zh\">日</th><th class=\"not-zh\