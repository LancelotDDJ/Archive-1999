ng/233px-Chatacterskinviewtextbg_blue.png\" decoding=\"async\" width=\"233\" height=\"23\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/95/Chatacterskinviewtextbg_blue.png/350px-Chatacterskinviewtextbg_blue.png 1.5x, https://huiji-public.huijistatic.com/res1999/uploads/9/95/Chatacterskinviewtextbg_blue.png 2x\" data-file-width=\"360\" data-file-height=\"36\" /></div><div style=\"margin-left:27px;position:relative;\">崭新形象</div></div><div style=\"position:relative; margin-top:5px\"><div style=\"position:absolute; top:-2px; user-select:none; pointer-events:none;\"><img alt=\"Chatacterskinviewtextbg blue.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/95/Chatacterskinviewtextbg_blue.png/233px-Chatacterskinviewtextbg_blue.png\" decoding=\"async\" width=\"233\" height=\"23\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/9/95/Chatacterskinviewtextbg_blue.png/350px-Chatacterskinviewtextbg_blue.png 1.5x, https://huiji-public.huijistatic.com/res1999/uploads/9/95/Chatacterskinviewtextbg_blue.png 2x\" data-file-width=\"360\" data-file-height=\"36\" /></div><div style=\"margin-left:27px;position:relative;\">崭新单品</div></div></div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">可用角色：</span><span class=\"item-link\" data-itemid=\"3104\"><span class=\"item-link-frame\"><span class=\"item-link-rare\"><a href=\"/wiki/%E7%AC%83%E7%AC%83%E9%AA%A8\" title=\"笃笃骨\"><img alt=\"Bgequip6.png\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/100px-Bgequip6.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit notpageimage\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/150px-Bgequip6.png 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/0/08/Bgequip6.png/200px-Bgequip6.png 2x\" data-file-width=\"256\" data-file-height=\"256\" /></a><span class=\"item-link-img\" style=\"width:60%; padding-top:7%;\"><a href=\"/wiki/%E7%AC%83%E7%AC%83%E9%AA%A8\" title=\"笃笃骨\"><img alt=\"笃笃骨\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/7/7d/HeadIconSmall-310401.png/100px-HeadIconSmall-310401.png\" decoding=\"async\" width=\"100\" height=\"100\" class=\"img-fit\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/7/7d/HeadIconSmall-310401.png 1.5x\" data-file-width=\"136\" data-file-height=\"136\" /></a></span></span></span><span class=\"tooltips\"><a href=\"/wiki/%E7%AC%83%E7%AC%83%E9%AA%A8\" title=\"笃笃骨\">笃笃骨</a></span></span></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">实装版本：</span>3.4</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:3em\">来源：</span>点唱机</div></div><div><div><span class=\"color-darkgold\" style=\"margin-right:1em\">所属系列：</span>岁月的书签</div></div><div><div class=\"grey-small test-hide hide-m\">编号ID：310404</div></div></div></div><div class=\"skin-video tabber\"><h2><span id=\".E8.A7.86.E9.A2.91.E9.A2.84.E8.A7.88\"></span><span class=\"mw-headline\" id=\"视频预览\">视频预览</span></h2><div class=\"tabber-filter\" style=\"margin:0 -3px 4px -3px\"><div class=\"tabber-filter-item filter-button selected\" data-type=\"videoId\" data-videoid=\"5\">技能1</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"4\">技能2</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"3\">大招</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"2\">额外</div><div class=\"tabber-filter-item filter-button\" data-type=\"videoId\" data-videoid=\"1\">入场</div></div><div class=\"skin-video--single tabber-item\" data-videoid=\"5\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-技能1.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-技能1 - frame at 0m0s.jpg\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"4\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-技能2.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-技能2 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"3\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-大招.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-大招 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"2\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-额外行动.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-额外行动 - frame at 0m0s.jpg\" style=\"display:none\"></div><div class=\"skin-video--single tabber-item\" data-videoid=\"1\" data-videourl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-入场.mp4\" data-backgroundurl=\"https&#58;//notice-res.sl916.com/skinVideo/50001/3104/310404/笃笃骨-入场 - frame at 0m0s.jpg\" style=\"display:none\"></div></div><h2><span id=\".E7.AA.97.E4.B8.AD.E4.BE.A7.E5.86.99_Garment_Display\"></span><span class=\"mw-headline\" id=\"窗中侧写_Garment_Display\">窗中侧写<small style=\"color: grey\"> <span style=\"display:inline-block\">Garment Display</span></small></span></h2><div class=\"infopad\">她讨厌雨水，她不喜欢骤变的天气，变化的温度与湿度会引发残肢的疼痛。<br />她也不喜欢春天，这个季节意味着复苏、绿意和新生，她痛恨这种意象的本身，因这所谓新芽的萌发，不过针对枯树的一种嘲笑。她痛恨这些，每一滴落在屋檐的声响，听起来都像回响的叹息。<br />她总是靠在窗棂上，看燕子在檐角筑新巢，那些轻盈的姿态唤醒了某种深藏于心的渴望。她学着燕子的动作，屈伸、舒展、练习。直至那株枯柳的旧疤上，长出了第一朵青色的嫩芽时，她开始有点喜欢春天了。<br />春雨依然带来潮湿与疼痛，但她开始看到世界更多的侧面。也许她并不能改变那些已经发生的事，但至少未来还存在着无数的可能性，迷途的燕子也能在柳树下找到新的家园。</div><div id=\"崭新单品\"></div><h2><span id=\".E5.B4.AD.E6.96.B0.E5.8D.95.E5.93.81_All-new_Item\"></span><span class=\"mw-headline\" id=\"崭新单品_All-new_Item\">崭新单品<small style=\"color: grey\"> <span style=\"display:inline-block\">All-new Item</span></small></span></h2><div class=\"char-item-box0 tabber\"><div class=\"char-item-box1 tabber-item\" data-skinid=\"310404\"><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-310407.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/d/d7/Belonging-310407.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">燕衔春<div class=\"grey-small\" style=\"text-wrap:wrap\">Springtime Swallows</div></div></div><div><img alt=\"雨滴\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/b/bb/Value-1.png/27px-Value-1.png\" decoding=\"async\" title=\"雨滴\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/b/bb/Value-1.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />200<hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>以珍珠镶嵌，以珐琅坠饰，连黄金都以恣意灵动的造型呈现。其主题不言而喻——春正好，梅发新蕊，燕子归未？<br />美总有其代价，好在对于一位老练的舞者来说，这种程度的负重绝不会影响她的舞姿。</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-310408.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/9/9e/Belonging-310408.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">碧罗带<div class=\"grey-small\" style=\"text-wrap:wrap\">Verdant Shawl</div></div></div><div><img alt=\"利齿子儿\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/6/62/Value-2.png/27px-Value-2.png\" decoding=\"async\" title=\"利齿子儿\" width=\"27\" height=\"18\" style=\"vertical-align: text-bottom\" srcset=\"https://huiji-public.huijistatic.com/res1999/uploads/6/62/Value-2.png 1.5x\" data-file-width=\"36\" data-file-height=\"24\" />100<div class=\"grey-small\" style=\"float: right;\">信任达到60%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>仙子携来碧罗带，点作春水映春山。<br />在东方的舞蹈中，飘带、衣袖往往是舞者肢体的延伸。优秀的舞者能将柔软的布料变成他们的第三、第四条手臂。而受访者早在十一岁时就将此类技艺练至炉火纯青。</div></div></div><div class=\"char-item-box2\"><div style=\"margin: 0 -20px;\"><div class=\"char-item-img\"><img alt=\"Belonging-310409.png\" src=\"https://huiji-public.huijistatic.com/res1999/uploads/2/23/Belonging-310409.png\" decoding=\"async\" width=\"484\" height=\"444\" class=\"img-fit\" data-file-width=\"484\" data-file-height=\"444\" /><div class=\"title\">折新绿<div class=\"grey-small\" style=\"text-wrap:wrap\">Willow Sprig</div></div></div><div>无估值<div class=\"grey-small\" style=\"float: right;\">信任达到100%解锁</div><hr style=\"margin:6px 0 10px 0; clear:both\" /></div><div>自衣袖伸出的轻盈柳枝。与舞者一贯的沉郁风格不同，不断萌发的嫩绿色展现出蓬勃的生命力。<br />昔日青青今仍在，更发新绿几万重。</div></div></div></div></div><h2><span id=\".E8.A1.A3.E7.9D.80.E6.B5.B7.E6.8A.A5\"></span><span class=\"mw-headline\" id=\"衣着海报\">衣着海报</span></h2><div style=\"display:flex; gap:10px; border:1px solid #b55829; width:fit-content\"><a href=\"/wiki/%E6%96%87%E4%BB%B6:%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB1.jpg\" class=\"image\"><img alt=\"衣着 裁春衫1.jpg\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB1.jpg/228px-%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB1.jpg\" decoding=\"async\" width=\"228\" height=\"325\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB1.jpg/342px-%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB1.jpg 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/d/d2/%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB1.jpg/456px-%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB1.jpg 2x\" data-file-width=\"1080\" data-file-height=\"1540\" /></a><a href=\"/wiki/%E6%96%87%E4%BB%B6:%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB2.jpg\" class=\"image\"><img alt=\"衣着 裁春衫2.jpg\" src=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/27/%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB2.jpg/228px-%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB2.jpg\" decoding=\"async\" width=\"228\" height=\"325\" srcset=\"https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/27/%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB2.jpg/342px-%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB2.jpg 1.5x, https://huiji-thumb.huijistatic.com/res1999/uploads/thumb/2/27/%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB2.jpg/456px-%E8%A1%A3%E7%9D%80_%E8%A3%81%E6%98%A5%E8%A1%AB2.jpg 2x\" data-file-width=\"1080\" data-file-height=\"1540\" /></a></div></div></div>", "categories": [{"sortkey": "", "category": "衣着"}], "displaytitle": "<span style=\"display:inline-block\"><span style=\"display: flex;flex-direction: column;\">裁春衫 <small style=\"color: grey\">Reborn and Restored</small></span></span>"}}