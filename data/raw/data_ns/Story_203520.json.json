。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"645312.png","audio":"613501308","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["等等——小子，我认得你，你叫野木蓝，是给俱乐部供画的家伙！","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"645313.png","audio":"613501309","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["*****[鼠类脏话]，你这个叛徒！","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501032","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这就是……佩雷斯先生？","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501033","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那个掌控着墨西哥城大半地下市场的走私犯，俱乐部的幕后老板，无所不能的佩雷斯先生……","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一阵荒谬感涌上心头。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501762","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["一直掌握着你命运的人，就是眼前的这窝小老鼠。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501763","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["没猜错的话，在大约不到一个月前，那次俱乐部所谓的内乱之中，原来的佩雷斯就悄无声息地被这窝小老鼠们顶替了。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501764","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["它们躲在屏风的后头，用机器模仿着佩雷斯说话的声音，下达着一条条指令，操纵着所有人的生死。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501034","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["所以最近，俱乐部那些激进的动作……","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501765","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["没错。是它们巩固了俱乐部的势力，扩大墨西哥城的地下神秘学材料市场，吞并其余的黑帮；也是它们召集城市内的画家伪造假画，举办拍卖会。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501766","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["嗯？从这个层面上来说，它们可比原来的佩雷斯强多了。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501767","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["感觉如何？想哭吗？","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他拒绝回答这个问题。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501310","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["嘿，你说得不错，这些可都是我的功劳。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501311","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不要瞧不起老鼠！你得承认，我们比人类更擅长经营黑帮！","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501312","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["直立行走的生物是如此愚蠢，动作迟缓，不如我们天生适合掌控“地下世界”——毕竟我们是穴居动物！","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501768","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我好像没有问你话吧。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501769","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我觉得这儿的老鼠有点太多了。想要问话，留下其中一只听话的就可以了。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501770","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["剩下的，就送给我的九头蛇同事当墨西哥伴手礼吧。虽然我们不熟。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["手的阴影在颜料盒上游移，仿佛在商店中精心挑选着礼物。最终，它朝着其中一只缓缓落下。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501313","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["等等，等等——不要碰我的孩子！","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501314","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我道歉！你和别的蠢货都不一样，是个了不起的、凌驾于他人之上的神秘学家！","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501315","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你值得这一切，你才应该掌管地下王国！哪怕你想要俱乐部的一切，我都可以给你！","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["了不起的神秘学家只是似笑非笑地看着它。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501771","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["看来鼠科动物的适应能力确实很强。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501772","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["可惜了，我对当这里的地头蛇没有什么兴趣。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501316","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["直立行走的女士，你之前说，你在寻找一种矿物颜料的下落？","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501317","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我可以知无不言，把一切都告诉你。前提是，你要保证我的孩子们的安全。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501318","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["很遗憾，你已经不可能找到那种颜料了！<br>这一切得从佩雷斯一家是如何获得智慧开始说起——","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"42":{"step":[[42,153,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"645302.png","audio":"613501319","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["老鼠虽然天生比人类和神秘学家都强大，但并非每只老鼠都拥有智慧。<br>佩雷斯一家的特殊，始于某种惊鼠的偶然。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501320","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["某一个夜晚，因为被邪恶的毛绒生物驱逐，我躲进了一个从未去过的房间里。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501321","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["地板干净得让老鼠脚打滑，墙上挂着数不清的猛兽头颅，比每天晚上逐猎我们的邪恶毛绒还要大得多！就连家具也散发着好闻的木头气味。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501322","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我爬上了桌子，想要找点吃的。桌面上什么吃的都没有，只有一个小瓷碟，而一抹散发着辉光的膏状物体就盛在瓷碟里。真奇怪，这里只有一碟颜料。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501323","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["鬼使神差地，也许是太饿了，我把颜料吃了下去……在它进入嘴巴的那一瞬间，我眼前的世界完全改变了。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501324","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["第一次，除了觅食、繁殖和生存，我的脑海中出现了别的念头。那是只有智慧才能带来的念头。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501325","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["往后几天，我一直躲在那里。老鼠们都拥有着卓越的观察力，我很快弄明白，这里是佩雷斯先生的办公室，而他经营着墨西哥城半数的走私生意。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501326","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那种能让鼠获得智慧的颜料，由一个戴面具的黑袍人带来。佩雷斯先生应下了这桩生意，用锯木厂作为掩饰，帮助面具人在眼泪之谷挖掘一种特殊的秘银矿石。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501327","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["然后，戴面具的人将矿石炼制成颜料，运至很远的地方，传说中的欧洲和美国。作为回报，俱乐部也能获得一些颜料的成品。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":6,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501328","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我只是简单地谋划了一场内乱，就顶替了原本的佩雷斯，接手了他的走私王国和颜料交易。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/1_8/1_8_bg_xiaozhenlvguan.jpg","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501329","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["哈哈，这些直立行走的家伙和老鼠比起来，还是差得远了！","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501330","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["本来一切都无比顺利，直至最近，那个戴面具的人消失了——连同制作颜料的方法一起。","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501331","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我翻遍了墨西哥城的每一寸地皮，并不相信这座城市里还有我找不到的人。","","","","","","",""],"bg":"","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501332","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但事实就是如此：他——或者她，随便吧，它就这样消失了！你懂吗？！就像是鬼魂一样失去了踪迹！","","","","","","",""],"bg":"","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["在听完佩雷斯的故事后，与面前激动的老鼠不同，两位旁听者各自陷入了沉思。","","","","","","",""],"bg":"","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501036","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["眼泪之谷的秘银矿，我听说过它的传说。","","","","","","",""],"bg":"","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501037","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["曾经，人们称呼这座矿山为“吃人的口”，因为被殖民者奴役去挖矿的当地人总是有去无回。","","","","","","",""],"bg":"","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501038","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["十八世纪，眼泪之谷发生过一次巨大的塌方事故，从那之后，再也没有人能够找到秘银矿的入口。","","","","","","",""],"bg":"","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501039","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["传闻那儿产出的秘银有着特殊的辉光颤动，极其纯净、耀眼，有着无穷无尽的延展性，就像……丝线一样，是非常罕见的炼金材料。","","","","","","",""],"bg":"","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501040","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但我从来没听说过，它能制成颜料。而这种矿物颜料，甚至能赋予动物智慧。","","","","","","",""],"bg":"","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501333","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["直立行走的女士，你也瞧见了：我的孩子们已经无法说话。","","","","","","",""],"bg":"","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501334","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这种由颜料所赋予的智慧，需要定期食用颜料才能维持。","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501335","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如今，它们的智慧正在逐渐消失……没有了颜料，我的孩子们正在变回普通的老鼠。","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["箱子中的老鼠们懵懂地看着自己的母亲。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501336","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我能感觉到，用不了多久，再过上一个月？也许只要半个月，我也会变回普通的老鼠。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501337","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我不能接受这样的结局。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501773","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这正是你着急的原因。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501774","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["急着举办拍卖会，扩大走私规模，尝试找到替代矿物颜料的神秘学材料。","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501775","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["很可惜，一无所获。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["佩雷斯妈妈","","","","","","",""],"head_icon":"","audio":"613501338","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["嘿，这位女士，难道你只是为了说风凉话而来的吗？！","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501776","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不可否认这算是我的爱好之一。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501777","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["将近一个月前，重塑之手出现了——","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那时间点，正是“暴雨”将时代重返至1920年不久之后。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["重塑之手携带着不属于这个时代的炼金技艺，来寻找一座已被掩埋、在后世才会重现的矿藏，制作出特殊的矿物颜料。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["跨时代的混沌研究者思索了片刻。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501778","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我可以帮你。告诉我负责走私的重塑人员都有谁。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"n