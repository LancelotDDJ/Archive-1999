[[118,119,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300023","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我与重塑之手达成的，只是一项一次性的交易。但格鲁托夫的渴望已经超过了限度。","","","","","","",""],"bg":"","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300024","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["他觉得自己还能向重塑之手索要更多，而不是一个对他来说没有用处的黑色小盒。","","","","","","",""],"bg":"","choice":[]},"120":{"step":[[120,121,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300811","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我明白了，叛军中的叛军——你的军队正在走向自我毁灭。","","","","","","",""],"bg":"","choice":[]},"121":{"step":[[121,122,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300025","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["讽刺而尖锐的评论，但我确实要为格鲁托夫的疯狂负责，我应该知道他的野心在脱离芝诺之后是不可控的。","","","","","","",""],"bg":"","choice":[]},"122":{"step":[[122,123,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300812","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["就像该为圣保罗那些本不应该殉职的芝诺士兵负责一样。","","","","","","",""],"bg":"","choice":[]},"123":{"step":[[123,124,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300026","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我不会否认这一点，也必将为我所犯下的罪孽赎罪。","","","","","","",""],"bg":"","choice":[]},"124":{"step":[[124,125,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300027","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但眼下，我也必须对格鲁托夫在顿河的所作所为负责。","","","","","","",""],"bg":"","choice":[]},"125":{"step":[[125,126,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300028","bool_1":false,"show_name":true,"show_name_