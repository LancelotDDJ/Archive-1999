/hubian_ye.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"28":{"step":[[28,125,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/4_0/4_0_bg_47.jpg","choice":[]},"29":{"step":[[29,122,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"30":{"step":[[30,126,""]],"type":6,"name":["莫德雷德","","","","","","",""],"head_icon":"315831.png","audio":"6215810#999|999|0.1|0|0|0|0|0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……！","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["兰斯洛特","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……莫德雷德，你在听吗？若仍有疑问，我可以再次……","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["金发蓝眼的骑士正立于圆桌的另一侧。华美、庄重，堪为骑士典范。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["莫德雷德","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你是……兰斯洛特？","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["兰斯洛特","","","","","","",""],"head_icon":"","audio":"614002795","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是的，我正是兰斯洛特，你的同僚……","","","","","","",""],"bg":"","ch