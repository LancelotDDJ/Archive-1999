,111,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["祥瑞是排忧解难，实现大家的心愿。","","","","","","",""],"bg":"","choice":[]},"111":{"step":[[111,112,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["沛城里有名的酒坊老板娘，许娘子，最近对外声明要关了酒坊，出去游历一番。众酒客听了无不感慨痛惜。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["在连着喝了几日的欢送酒后，众人才依依不舍，与许娘子告别。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,116,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那一日，城里的酒客都来送行，除了跑堂的那个曲娘，听说她早已换去了别家上工。不多日，酒坊也顺势盘给了别人。","","","","","","",""],"bg":"","choice":[]},"115":{"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,115,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"info":{"title":"【1.6】曲娘玩法剧情07","start":1}}