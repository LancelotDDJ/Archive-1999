:false,"show_name_en":false,"no_l2d":false,"text":["曲娘摇摇头，又端起酒碗端详，那时，一轮明月落在碗中，仿若玉盘，又如轻巧的银子片，晃一晃就碎了。","","","","","","",""],"bg":"","choice":[]},"95":{"step":[[95,96,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["小家伙们又恰到时机地爬上小桌，嘻嘻哈哈闹个不停，给冷清的小院儿增添了些活泛气息。","","","","","","",""],"bg":"","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["木头小人群","","","","","","",""],"head_icon":"622801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["<u>冷清——冷清——无人陪——</u>","","","","","","",""],"bg":"","choice":[]},"97":{"step":[[97,98,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["他们说，一碗美酒解千愁……","","","","","","",""],"bg":"","choice":[]},"98":{"step":[[98,99,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我原还不懂，可今时今日，果然如此。","","","","","","",""],"bg":"","choice":[]},"99":{"step":[[99,100,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["罢了，罢了，你们也喝一碗吧。","","","","","","",""],"bg":"","choice":[]},"100":{"step":[[100,101,""]],"type":1,"name":["木头小人群","","","","","","",""],"head_icon":"622801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["<u>喝酒——喝酒——</u>","","","","","","",""],"bg":"","choice":[]},"101":{"step":[[101,102,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["曲娘眉目带笑，又拿出一只海碗，斟满美酒。","","","","","","",""],"bg":"","choice":[]},"102":{"step":[[102,103,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bo