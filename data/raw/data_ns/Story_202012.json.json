se,"show_name_en":false,"no_l2d":false,"text":["人们出了窍般，目光齐聚，眼睛跟着她的步伐挪移。","","","","","","",""],"bg":"story_bg/2_0/2_0_bg_disikewuting.jpg","choice":[]},"112":{"step":[[112,113,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["环状水星赤脚踏上舞台，手臂犹如鸟儿般，高举于灯下——凝滞，相片般定格。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["先驱者","","Pioneer","","","","",""],"head_icon":"309601.png","audio":"612000442","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["嘘……开始了。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["起先——是一个音符，撞击上另一个音符。","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,159,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["其后，音乐犹如浪潮般倾涌而来，声浪将所有人包裹在一团共振之下。","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,160,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["可没有人摇摆，亦无人赞颂或质疑，人们只是目不转睛地盯着她。","","","","","","",""],"bg":"story_bg/2_0/2_0_bg_disikewuting.jpg","choice":[]},"117":{"step":[[117,118,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["手中碰杯的人们，悬置着酒杯；痴迷于电子游戏的男人，命数随着声效一条条减少——","","","","","","",""],"bg":"story_bg/2_0/2_0_bg_disikewuting.jpg","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["而她的臂膀，时而如同扑展而上的羽翼般颤动，时而同泥壤深处的种子般，沿着光蜿蜒而上，破土而出——直至顶点，回归死亡般的寂静。","","","","","","",""],"bg":"story