],"head_icon":"300101.png","audio":"612600946","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["我很惊讶……在这座监狱中，你是第一个主动与我提起她的人。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"612600947","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["所以，奥克塔维奥小姐，你知道德洛丝女士现在在哪里吗？","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601216","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我确实见过她，但我并不知晓她现今在监狱的何处，也许你得直接去问监狱的管理者们。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,44,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601217","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这是德洛丝女士先前交给我的东西，我想你比我更需要它。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,45,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["奥克塔维奥将随身携带的收纳册递上前。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,43,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["在翻开之前，她就已经转过身去。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"522201.png","audio":"612601218","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我还有事情要筹备，就不奉陪各位的推理游戏了。加西亚先生，我们走吧。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["","","","","