{"1":{"step":[[1,2,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512114.png","audio":"610015952","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["咳咳……！","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"2":{"step":[[2,3,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["气味古怪的烟尘在街道上弥漫，使原本混乱的场面变得更加棘手。","","","","","","",""],"bg":"","choice":[]},"3":{"step":[[3,4,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512114.png","audio":"610015953","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这个烟雾不对劲……！像是某种汽化后的神秘术药剂。咳！这个味道……应该有魔鬼鞋带的成分。唔，为了增加扩散性吗？","","","","","","",""],"bg":"","choice":[]},"4":{"step":[[4,5,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512114.png","audio":"610015954","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["马库斯，捂住口鼻。等它散去后我们再进入基金会分部。","","","","","","",""],"bg":"","choice":[]},"5":{"step":[[5,89,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["霍夫曼拉着马库斯的手快速穿越人潮，避免再吸入更多的不明气体。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"6":{"step":[[6,7,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["此时，唯有稍作等待。","","","","","","",""],"bg":"","choice":[]},"7":{"step":[[7,8,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……","","","","","","",""],"bg":"","choice":[]},"8":{"step":[[8,9,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["第一次执行任务的青涩调查员愣然地站着，表情是前所未有的呆滞。","","","","","","",""],"bg":"","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015955","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……怎么了，马库斯，这道烟雾对你的身体出现了什么影响吗？","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017201","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不是的……","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯低下头，她的额头上泛起了一层冷汗。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017202","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["霍夫曼女士，刚刚的暴动分子，还有游行队伍里的人，他们喊着“为了自由的王国”的口号……","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017203","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这，这是伊索尔德小姐在沙龙上的发言。她的话语又引用自卡卡尼亚医生……","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017204","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["而在最早，是我……是我把这些话告诉了卡卡尼亚！我告诉了她那座岛的事，我告诉她那是一个神秘学家的自由地……！","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017205","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["点燃这场灾害的人，其实是我……！是我泄露了黄金岛的机密，导致了后续的连锁！","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["霍夫曼女士也沉默了片刻。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯近乎崩溃地蹲下，抱住了头。","","","","","","",""],"bg":"story_bg/bg/gongmu.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306515.png","audio":"610017206","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["我没有聆听您的教导……我，太冲动了，缺乏理智，不稳定，不可控，唯一可取的神秘术也没有派上用场……","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306515.png","audio":"610017207","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["您承担了风险，将我从总部带出来参加外勤，可是我……！","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015956","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……也许是这样吧。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["霍夫曼揉着太阳穴，罔顾下属的脸色变得愈发煞白。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015957","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["也许你的确错误参与了时代的一隅，在一系列偶然的碰撞下，引发了历史的震荡。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015958","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但试图为超出自己能力的一切事情负责，只是一种非理性的狂妄。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306513.png","audio":"610017208","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["——！","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015959","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["首先，在这个民族冲突、刺杀案、间谍案频出的时代，制造混乱本就是极容易的。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015960","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没有“魔圈”与伊索尔德，重塑之手也会找到另一枚引信。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015961","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你也无从事先知晓泄露给卡卡尼亚的信息会如何发酵，它的后续扩散属于不可抗力，再为此懊悔是无用的。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015962","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["更显著的事实是，人们早已对那座岛冠以自己的期望，你只是印证了他们原有的想法。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306510.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她的脸颊终于又有了血色。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015963","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["至于你的自我评价……","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015964","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们都听过这样的说法：人类更加理智，神秘学家更加感性。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015965","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他们对世界的幽微之处更加敏感，因此也更容易沉浸于自我的情绪，忽略客观的现实。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015966","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但我想，倘若将一个人类孩子放到神秘学家的处境，倘若他从小就要因为独特而对抗世界，因为天赋而不被理解——","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015967","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那么或许，他也会变得冲动，敏感，不成熟，不稳定。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015968","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["由此，我曾经想过：如果将一个神秘学家孩子放到人类的处境，倘若他能接受充分的关爱、良好的教育、足够的正向反馈——","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015969","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……这些“不稳定”就至少是可控的——至少，不会让他们烧伤自己，烧伤他人。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306510.png","audio":"610017210","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["霍夫曼女士……","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015970","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我曾在1912年那场“暴雨”中将你带离。这么长的日子里，我知道时间再度拨回这个时代——拨回1914年，对你来说是何种珍贵之事。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015971","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我理解你想迫切完成任务，重回罗马尼亚看看的心情。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015972","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……你并不是冲动，马库斯，你只是还在成长。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015973","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你也需要成长。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["霍夫曼将手放到嘴边，小声咳嗽了几声。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015974","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["至于我申请将你从总部调出来，是我个人的想法。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["霍夫曼","","","","","","",""],"head_icon":"512101.png","audio":"610015975","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——因为，人类的时代已经结束了。","","","","","","",""],"bg":"","choice":[]},"47":{"ste