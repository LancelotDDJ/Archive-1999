p":[[25,26,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["波蒂埃按响街边一户人家的门铃，伴随着隔着门板传来越来越近的沉重脚步声，门在少女错愕的目光下被猛地掀开。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["市民Ⅰ","","","","","","",""],"head_icon":"563801.png","audio":"612500442","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你们终于来了！<br>你知道我等了多久吗？那些怪物又来了，就在那里！快做点什么！","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["如此“热情”的欢迎显然不在见习执夜人的意料之中。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["但当她下意识地转过头，却发现自己的教官早已退到了几个台阶下远离战场的有利地势。看来她需要独自应付这一切了。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501408","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……请您冷静一些，女士。我们在这里，没有什么能够伤害您。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501409","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我看到您报告说有魔精屡次闯入您的住宅中，您能描述一下袭击您的魔精的具体外形吗？它们一共有几只？","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["市民Ⅰ","","","","","","",""],"head_icon":"563801.png","audio":"612500443","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["很多！它们有很多，那些该死的恶魔！","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["即便是夹杂着愤怒与恐慌的歇斯底里，其中仍然存在着有效信息。<br>见习执夜人略作思考，给出了自己的方案。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501410","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["存在复数的危险对象……既然如此，波蒂埃教官，我提议我们分头行动。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501411","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["能否请您负责保护这位女士，将制服魔精的任务交给我？<br>这里并不是野生的危险魔精会喜爱的环境，背后可能有人操控那些魔精。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501412","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["根据魔精的种类，我可以推断出操控它们的术法。如果是提线魔咒、拟影魔咒这类的神秘术，我们可以快速找出施术者——","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["市民Ⅰ","","","","","","",""],"head_icon":"563801.png","audio":"612500444","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["它们来了！就在那里！","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501413","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["请躲到我身后去，女士！它们在哪——","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501414","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["里……","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["摆出警戒姿态的少女僵在了原地，目光凝结在院子的角落。<br>那里有几个胖乎乎的身影排着队，慢悠悠地转了出来。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["慢慢吞","",""