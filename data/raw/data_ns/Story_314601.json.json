_bg/2_1/2_1_bg_lvguanqiantai.jpg","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["小瑞安侬","","Rhiannon","","","","",""],"head_icon":"314601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["您是……一位老朋友，对吗？","","","","","","",""],"bg":"story_bg/2_1/2_1_bg_lvguanqiantai.jpg","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["倒挂在术杖上的尘酿鹰目光炯炯，几乎要在欧文夫人的脸上看出一个洞来。","","","","","","",""],"bg":"story_bg/2_1/2_1_bg_lvguanqiantai.jpg","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["小瑞安侬","","Rhiannon","","","","",""],"head_icon":"314601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["别这么盯着人看……！太不礼貌了。","","","","","","",""],"bg":"story_bg/2_1/2_1_bg_lvguanqiantai.jpg","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["欧文夫人","","","","","","",""],"head_icon":"637901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没关系，看来你现在和这些小鸟儿相处得不错。回想我们上次见面时，你甚至还不会说话，就已经被尘酿鹰追得满地跑。","","","","","","",""],"bg":"story_bg/2_1/2_1_bg_lvguanqiantai.jpg","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["欧文夫人","","","","","","",""],"head_icon":"637901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["真怀念能看见缇威尔的孩子们和鸟儿一起逛集市，用鸟鸣和笑声装点街道的日子。","","","","","","",""],"bg":"story_bg/2_1/2_1_bg_lvguanqiantai.jpg","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["欧文夫人","","","","","","",""],"head_icon":"637901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["缇威尔那时也还是个响当当的大家族，一大家子人在领地里生活，和镇上的我们比邻而居，不像现在……","","","","","","",""],"bg":"story_bg/2_1/2_1_bg_lvguanqiantai.jpg","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["小瑞安侬","","Rhiannon","","","","",""],"head_icon":"314601.png","audio":"","bool_1":false,"show_name":true,"show