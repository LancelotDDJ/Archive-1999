","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["隐藏在空白纸张中间的文字记录，字迹不一，但排列整齐。似乎被人刻意遗忘，直到现在重新发掘。","","","","","","",""],"bg":"story_atcg/1_6/1_6_at_xinjian.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["——幸运的是，她能在边角处找到签名，就像每页的一枚谨慎脚注。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["“记录人”——","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,117,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["“小叶尼塞”。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"","audio":"610013443","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这是……我的听写稿件。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"","audio":"610013444","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["笔迹看起来像野外速记，页边磨损，已经干燥保存一年以上……","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"","audio":"610013445","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["一年……噢，这是别斯米尔女士曾委托我记录的游记。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"","audio":"610013446","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["或者说，应该叫“手记”？哈哈……","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,118,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"","audio":"610013447","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["无论是什么，我都应该已经整理完成，寄给她了才对。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013448","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["我不会忘记这种事。它怎么会还在这里？","","","","","","",""],"bg":"story_atcg/1_6/1_6_at_xinjian.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013449","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["上面的记录也断了几天——","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308210.png","audio":"610013450","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["十月十日，十月十六，十月十七……","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308210.png","audio":"610013451","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“……十月十七日，天气阴。我们卖掉马车，改租当地农民的船只，以顺利渡过尚未进入结冰期的鄂木河……”","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308210.png","audio":"610013452","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“这样我们便能找到另一种可能，规避掉从鄂木斯克北门进城的路线。”","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,119,""]],"type":6,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308210.png","audio":"610013453","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“毕竟在远东的旅行者口中……那里防备森严，如同堡垒；守卫从不放过任何说辞与文书不匹配的细节。”","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":6,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308210.png","audio":"610013454","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“之所以这样大费周章，都是由于出行匆忙，我们临时拼凑起的证明文书—— ”","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":6,"name":["？？？","","","","","","",""],"head_icon":"619920.png","audio":"610013455","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“——根本经不起那样严格的检验。”","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":6,"name":["？？？","","","","","","",""],"head_icon":"619920.png","audio":"610014556","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“为了筹集行程经费，我多次召开游说演讲。我还记得最后一次演讲的地方，正位于鄂木河下游的新建公园之中。”","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":6,"name":["？？？","","","","","","",""],"head_icon":"619920.png","audio":"610014557","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“据我的助手描述，那里生有一片高耸的堆积岩，上面遍布正处于茂盛期的欧洲俄罗斯植被。”","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":6,"name":["？？？","","","","","","",""],"head_icon":"619920.png","audio":"610014558","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“这便是十七日的记述。那么，第二天后……”","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,113,""]],"type":6,"name":["？？？","","","","","","",""],"head_icon":"619920.png","audio":"610014559","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“唔，十月十八日”……这天我缺少印象。小叶尼塞，你还记得吗？","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["女孩忙于检查自己的记录，一小会儿后才终于出声回答。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"","audio":"610013456","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["十月十八日……我记得。在适当休整和获取补给之后，您与总督进行了面谈。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"","audio":"610013457","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["他将负责历史研究的文员介绍给您，并派遣测绘员——","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014560","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，我想起来了，都是不重要的事情。那让我们跳过它吧。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013458","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["……好的。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014561","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“十月十九日，天气较为晴朗。我在公园里正式阐述了我的计划，所用论据中，就包含着部分我所了解的东方‘度朔节’传说。”","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013459","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“度朔节”，传说……","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014562","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“……里面那些与亚洲土地崇拜相关的古代地质学猜想，和对佚散神秘术的考察资料，都成功引发了听众的兴趣。”","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014563","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“土地崇拜会随‘保护神’的更替有所不同，而类似‘所求必应’的东方神秘术，却在行脚商人的口口相传中长久地存在。”","","","","","","",""],"bg":"","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014564","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“在那些绘声绘色的描述里，主角们常怀着用至高信念换取答案的决心，飞跃高山，横跨天堑……”","","","","","","",""],"bg":"","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014565","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“……他们一如苦行僧般企望着摄提神的怜悯，亟待自身所求能够灵验。”","","","","","","",""],"bg":"","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["年轻人快速地记录下这些关键词。从陌生到熟悉，她已经与这些名字相识长久。","","","","","","",""],"bg":"","choice":[]},"59":{"step":[[59,61,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014566","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“即使那人从此失去踪迹，神明也从未显露真身……但从枯寂中复现丰润的大地上，我们仍能窥见，‘所求必应’这一古老神秘术确实施行起效。”","","","","","","",""],"bg":"","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014568","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“毕竟他们的语调就像是地质学家研究河滩低地后，认为其土质与大部分山地有显著不同一样笃定。”","","","","","","",""],"bg":"","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"619901.png","audio":"610014569","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“没错。人们没有亲手触摸过沉积岩，却不能因此便认为它不存在……”","","","","","","",""],"bg":"","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["年轻人记录的速度已经能与口述者的话语保持相当的同步。但即使如此，到此处她还是迟疑了。","","","","","","",""],"bg":"","choice":[]},"64":{"step":[[64,65,""]],"type":1