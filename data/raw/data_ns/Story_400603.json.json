":"","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而他的妻子霍氏出身钱塘，与道学有渊源，虽然家道中落，但家中几代之前也是有人尸解成仙的。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["只可惜她天分稀薄，虽会画符，但画得不好，也卖不出什么价钱。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["胡家为神秘学家，深居山中，自然血统纯粹。霍家虽入世颇深，但血脉稀薄……她是一位混血神秘学家吗？","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"7208696","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那归根结底，人类富商离去，故事仍旧变成了的神秘学家与神秘学家的斗争？","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["里正摆手，露出一个爽朗的笑容。","","","","","","",""],"bg":"","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"610015527","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["非也非也，娘子，你听我细细说来。","","","","","","",""],"bg":"","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["先说胡家与霍家，他们与你想的并无差异。","","","","","","",""],"bg":"","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["胡家本是山中狐仙，自有山头，嫁娶也论门当户对，他们这一旁支是夺权失利，在山里没了地方过日子，才下山来讨生活。","","","","","","",""],"bg":"","choice":[]},"120":{"step":[[120,121,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而霍家修道出身，也与草木精灵有过通婚，但从来都活在人中，婚嫁也更开明随意。","","","","","","",""],"bg":"","choice":[]},"121":{"step":[[121,122,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这两方一个是神秘学家，一个是神秘学家混血种。","","","","","","",""],"bg":"","choice":[]},"122":{"step":[[122,123,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而宅子里除了胡霍，还有一个傅家人，也就是傅生。","","","","","","",""],"bg":"","choice":[]},"123":{"step":[[123,124,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["难道他是……","","","","","","",""],"bg":"","choice":[]},"124":{"step":[[124,125,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是了，他是个货真价实的“人”。","","","","","","",""],"bg":"","choice":[]},"125":{"step":[[125,126,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["与霍氏祖上那样有点奇能异力的人不同，傅生家贫，通婚虽无筛选，但也都是无异能之家。他连带着自己那十八辈的祖宗，都是彻底的“人”。","","","","","","",""],"bg":"","choice":[]},"126":{"step":[[126,127,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而后面的故事就简单得多了，傅霍夫妻两个情比金坚，你出计谋，我画符咒。<br>倒也靠着机智和狐狸斗法，有来有回，妙趣横生。","","","","","","",""],"bg":"","choice":[]},"127":{"step":[[127,128,""