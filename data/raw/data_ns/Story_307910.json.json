_en":true,"no_l2d":false,"text":["那人缠绵病榻时，又对天上的声音询问，那件大事在何时发生？","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["亚齐","","Atticus","","","","",""],"head_icon":"307901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["天上的声音说：“我曾予以你无数创造奇迹的机会，可你都错失了。”","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["亚齐","","Atticus","","","","",""],"head_icon":"307901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["“因为你自以为知晓了命运，于是不再采取任何行动。最终，一事无成。”","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["我曾憎恶过这个故事，因为它将天上的意志包装为某种趋之若鹜的好处，对命运的冷酷只字未提。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["但撇去所有误解，它的寓意是如此简单：不要一味等待，需主动去承担自己的天命。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["——这是我早就知道的事，也是我已经做出的事。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["亚齐","","Atticus","","","","",""],"head_icon":"307901.png","audio":"6207914","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……这本书里，究竟还有什么我需要的内容呢？","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["当我意识到，自己已踱步来到沙滩时，天已经黑了下来。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"33":{"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1