},"63":{"step":[[63,64,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["好比你家的许三娘和那座酒坊，给了我们这些酒蒙子们一个喝酒的地方，又在不放酒的日子里偷偷送来糟饼子。","","","","","","",""],"bg":"","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["所以许娘子应该就算是我们的庇佑了吧，嘴巴上利落，心里却善。在她那里喝上一杯佳酿，世上烦心事都飘走了。","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["说到此处，老翁像是陷入了回忆，独自念叨起来。","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["酒哇，酒哇是个好东西，酒能给人安慰。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["年轻时不识酒滋味，等我这个年纪，总念着过去，又忧心将来。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["唯有一杯浊酒下肚，浑浑噩噩间，仿佛回了过去，了结心愿愁绪。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那会儿日头正西移，还有几块糟饼子未送，曲娘不敢耽搁时间，与沈阿翁告别，但回目看去，老者端了糟饼酒，坐在门边，慢哼一首曲儿。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,112,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一路上曲娘都在想沈阿翁说的“庇佑”，凭着地图，不知不觉又踏入了要送的最后一家。","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_zhiciyuanzhong.jpg","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["老板娘开酒坊，让大家的心愿满足，能喝酒，这就是“庇佑”。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["如果要成为祥瑞的话，就得……","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["曲娘这般想着，却被一个威武身影挡住了去路，那人习惯性压下腰间的短剑，调整了别剑姿势，又哼了两声提醒。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["法曹","","","","","","",""],"head_icon":"622001.png","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["见曲娘依旧神游世外，便又哼了一声来。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["法曹","","","","","","",""],"head_icon":"622001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你来晚了，曲娘。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["法曹","","","","","","",""],"head_icon":"622001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["晚了一个时辰，幸而今天里正在审年节用度账册上花了这么些时间。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"s