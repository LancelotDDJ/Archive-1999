":"","choice":[]},"110":{"step":[[110,111,""]],"type":1,"name":["哈拉尔","","","","","","",""],"head_icon":"561601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["于是有一天，他们合伙戏弄她，除非她爬上镇子上最高的世界树，否则，就得乖乖承认是男孩们故意让着她。","","","","","","",""],"bg":"","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["哈拉尔","","","","","","",""],"head_icon":"561601.png","audio":"7208791 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["后来的结果，我们都知道了。","","","","","","",""],"bg":"","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["","","","","","","",""],"head_icon":"305701.png","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他长叹一口气，摊开了手。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["哈拉尔","","","","","","",""],"head_icon":"561601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不过，大人们总归觉得女孩跑得太快，晒得太黑……不是什么好事情。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["哈拉尔","","","","","","",""],"head_icon":"561601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["于是，终于有一天，喂鹰人撞上了那头怪物。他们先是针锋相对、势均力敌，一只手掌抵在另一只爪子上，一份倔强抵在另一份顽固上。","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["哈拉尔","","","","","","",""],"head_icon":"561601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["后来，她还是筋疲力尽了。","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["哈拉尔","","","","","","",""],"head_icon":"561601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["她的心儿被那头怪物撕得支离破碎，但始终没人见她掉过一滴眼泪。","","","","","","",""],"bg":"","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["哈拉尔","","","","","","",""],"head_icon":"561610.png","audio":"7208880 ","bool_1":false,"show_name":true,"s