amona","","","","",""],"head_icon":"","audio":"613500202","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我并不是很高兴听到我的名下也有高额悬赏。","","","","","","",""],"bg":"","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"","audio":"613500203","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不过，这片荒废的墓地足够偏远，俱乐部的家伙们暂时找不到这里来。想必你不是代表着俱乐部来和我说话的。","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501055","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是的，我……","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["面前的访客欲言又止，最终抛出了毫不相干的问题。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501056","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我记得您是为了城市中一起连环命案而前往拍卖会的。您的调查，是否已经有结果了？","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"","audio":"613500204","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你应该知晓了，第六起案件就发生在拍卖会的现场，而我莫名成了案件的真凶。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"","audio":"613500205","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["如今，执夜队已经正式介入，接下来就是漫长的“猫鼠游戏”——他们会逮到佩雷斯的。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"","audio":"613500206","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你应该不会指望我这个除灵师，一举抓到俱乐部的幕后之人吧？","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501057","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["您已经为夜巡特遣提供了足够的线索，推进了案件的调查进展。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501058","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["只是……我担忧，佩雷斯先生并非幕后元凶。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"613501059","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他深吸一口气，取出那一份从佩雷斯身上获得的走私名单。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501060","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我思考了一整日，认为您需要看看这个。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501061","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["夜巡特遣管理局并非唯一调查此案的势力。我们找到了这份名单，但……那位女士，我不认为她会阻止后续的命案发生。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501062","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我无法预测，她的旁观会带来怎样的后果。这也许是最后的机会。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"","audio":"613500207","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["什么样的机会？","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"","audio":"613500208","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["算了，你别告诉我。我有预感，我可能不愿意听见接下来的话。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["尽管如此，临时侦探仍然接过了对方带来的线索。","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501063","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["谢谢您，拉莫纳小姐。您是一个非常好的人。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501064","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我衷心祝您调查顺利，如愿以偿。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["访客如来时那般悄声离去了。除灵师打开那份名单。","","","","","","",""],"bg":"story_bg/3_5/3_5_bg_16.jpg","choice":[]},"83":{"step":[[83,84,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["空脑袋","","Loggerhead","","","","",""],"head_icon":"311216.png","audio":"613500525","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["哇，送上门的线索！拉莫纳小姐，你不愧是城市的影子，四处果然都是你的耳目。","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"314210.png","audio":"613500209","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["画中女士，你对这名单中出现的人物，有什么印象吗？","","","","","","",""],"bg":"","choice":[]},"86":{"step":[[86,87,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["《湖边的女人》","","<i>Lady by the Lake</i>","","","","",""],"head_icon":"","audio":"613500028","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["让我看看……噢！！当、当然！我认识他们！","","","","","","",""],"bg":"","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["《湖边的女人》","","<i>Lady by the Lake</i>","","","","",""],"head_icon":"","audio":"613500029","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["他们都是重塑之手的追随者。有一些我没有见过的家伙，但我记得他们的名字。","","","","","","",""],"bg":"","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["《湖边的女人》","","<i>Lady by the Lake</i>","","","","",""],"head_icon":"","audio":"613500030","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["虽然我后来发现，他们也许从头到尾，就没有把我当成同伴。哈哈……","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["《湖边的女人》","","<i>Lady by the Lake</i>","","","","",""],"head_icon":"","audio":"613500031","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我们短暂地共处过一段时间，不得不说，在巴黎的那段日子，是我人生中为数不多的快乐片段……","","","","","","",""],"bg":"","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["女孩不得不打断再次陷入伤感与回忆的画作，让话题回到正轨。","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["拉莫纳","","Ramona","","","","",""],"head_icon":"","audio":"613500210","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我想我弄清楚了。这个名单——他们都是负责走私矿物颜料，与俱乐部接洽的重塑之手成员。","","","","","","",""],"bg":"","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["空脑袋","","Loggerhead","","","","",""],"head_icon":"","audio":"613500526","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那他们身上，一定有我正在寻找的矿物颜料！","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[94,95,""]],"type":1,"na