{"1":{"step":[[1,2,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"2":{"step":[[2,65,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/2_6/2_6_bg_jianyu.jpg","choice":[]},"65":{"step":[[65,5,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"5":{"step":[[5,6,""]],"type":1,"name":["囚犯Ⅰ","","","","","","",""],"head_icon":"522901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["有一天，我在一篇文章里读到了一个说法——说是你们智利人不喜欢巴洛克文学，大概是因为聒噪。你们天性沉默。","","","","","","",""],"bg":"","choice":[]},"6":{"step":[[6,7,""]],"type":1,"name":["囚犯Ⅱ","","","","","","",""],"head_icon":"523001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["噢？看来你们阿根廷人是相当地喜欢了？照我看，阿根廷人可是相当的吵闹。","","","","","","",""],"bg":"","choice":[]},"7":{"step":[[7,8,""]],"type":1,"name":["囚犯Ⅰ","","","","","","",""],"head_icon":"522901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你这家伙，仗着理想家先生缺席，就想将沙龙变成批评辩论赛！","","","","","","",""],"bg":"","choice":[]},"8":{"step":[[8,9,""]],"type":1,"name":["囚犯Ⅱ","","","","","","",""],"head_icon":"523001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["明明是你先……","","","","","","",""],"bg":"","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["够了！有那贫嘴的功夫，不如把作品贴出来看看。","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["依我看，你们只是相较文体更热衷于韵律，我们丰富的拉丁美洲语言天生就具备丰富、善变与艺术性，就像巴洛克文学一样。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["惯于沉默的男人为辩论浇了一桶冰块，令狱友们进入了难能可贵的冷静期。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["哈哈！话说回来，我还挺真切地怀念他们的。自打那些疯疯癫癫的朋友们离开了诗社，咱们在意识流创作的探索上就少了很多乐趣。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我倒是乐于讨论关于意识流创作中的“美学价值”。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["随着新话题浮出水面，狱友们的音量又逐渐高昂了起来。","","","","","","",""],"bg":"story_bg/2_6/2_6_bg_jianyu.jpg","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这是一场别开生面的文学沙龙，其中充满了情绪化、片面化的论调。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但我并不抵触这里的一切。相反，这些囚犯们给我一种不可思议的感觉。他们之中没有任何一个人将自己视作丧失自由的囚徒。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这些热衷于文学的人们在一座废弃的监狱中相遇，共同建造了一座理想的国度。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["一切就像一场约定。但从现实来讲，这里分明是一座隶属于政府的监狱。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"522211.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["诸位——请安静一下！我有一件事情需要宣布。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["陌生的女声打断了纪实作家心中打字机的咔咔作响。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["未曾谋面的女作家从另一端的黑暗中走上了沙龙的中央，停驻于为发言者置备的白板与讲桌前。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601736","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["由于私事，理想家先生将缺席本次沙龙。他在墙角的石头下压了一封信件，嘱托本人为本次文学沙龙的代言人。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在本期沙龙上，我将为大家公布我们之后的研究主题——","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601737","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“社会现实关注与自我存在探寻的关系性”。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["座下一片哗然——显然，参与者们听到了一个与预期相悖的说法。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她扬了扬手中的信件，做了一个噤声的手势。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601738","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在场的各位同好们，未来的重要作家们……自十九世纪末以来，那些曾经震慑文学界的名字，现在也不过逐渐沦为了谈资。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601739","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["朋友们，文学已经沦为了边缘的艺术。人们走进剧院、电影院和艺术馆，欣赏油画、为雕塑驻足，却很少有人能完整地读完一本著作。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601740","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["当家庭遭分崩离析，当祖国被暴政蹂躏，我们美洲诗社究竟能做到什么？","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601741","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们的武器就是小说！它应当毫不含糊地成为重大的、严肃的，一类对社会进步直接而起作用的工具。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["底下的观众陷入了短暂的沉默。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你可以试着写出一部属于拉丁美洲的《战争与和平》。<br>而我们则继续原来的沙龙主题——这并不矛盾。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……为了理想家先生先前所说的主题，我已经准备了足足一个月。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果你执意要修改理想家先生的论题，那我就先行离开了。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["奥克塔维奥小姐……原谅我的打断，但这跟我们事先约定好的主题不一样。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你所说的一切……我们是做不到那种事的！我们连自己的生活都没搞明白……","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["奥克塔维奥，这个议题有点意思。<br>也许我们可以就这个主题聊点儿什么——但不会是现在。 ","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["另外，希望你别忘了自己的遭遇——正是因为你到处宣传“把小说当成武器”，才会被扔进这种地方。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["囚犯Ⅰ","","","","","","",""],"head_icon":"522901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["正如胡利奥所说——要不是拜你的富商老爹所赐，你这会儿应该在处刑台上，而不是在这里高谈阔论。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["闻言，支持奥克塔维奥的囚犯出言反驳。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["囚犯Ⅲ","","","","","","",""],"head_icon":"523101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你们根本没弄懂奥克塔维奥小姐的意思！伟大的作家就应当像个偏执的掘墓人一样，在时代的坟茔中挖出社会现实主义的腐肉！","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["囚犯Ⅲ","","","","","","",""],"head_icon":"523101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["只有这个庞大的社会熔炉，才有资格成为我们文学上的宿主！","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>加西亚先生略显抵触，胡利奥先生严厉提醒，而罗贝托小姐则注重劝解。</i>","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>之后，更多的人参与了辩论，一些为奥克塔维奥小姐说话的声音逐渐出现了。<br>诗社的成员们在无形中分为了两派。</i>","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,66,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>那时，我意识到自己需要做些什么，来中止这场彻底误入歧途的文学沙龙。</i>","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"612601717","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["请允许我自我介绍，我是来自圣保罗的德洛丝。我的笔名是“兀尔德”，我也是一名作家。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601742","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["兀尔德……？我好像在哪儿看到过这个名字……","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601743","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["等等，您是给UTTU杂志投稿的那个“兀尔德”吗？天呐，我没想到今天竟然会迎来一位这样的贵客！我很喜欢您投稿的那篇《圣保罗锌皮兵》。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"612601719","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["是的……此次前来拜访科马拉监狱，也是取材的重要部分。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那，请问兀尔德女士，您又是如何看待我们今天的沙龙主题呢？","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["难题出现了，涉及到认知偏好、创作立场与政治倾向。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["天秤的两端向来难以平衡。何况，此类问题最重要的从来都不是答案本身。","","","","","","",""],"bg":"","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"612601720","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["就我个人的了解来说，文学一直处于世界的边缘地带。被漠视、被排外、被误解。就像……","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"612601721","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["是的，就像乌斯怀亚一样。","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["在座的各位反应不一。有的陷入沉思，有的赞许点头，有的面带疑惑。<br>听众们并未意识到话题的转变。","","","","","","",""],"bg":"","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>对于大多数人来说，这座位于世界尽头的监狱太过遥远、太过寒冷，甚至可以说是太过绝望。</i>","","","","","","",""],"bg":"","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>当一名囚犯刚被送到这里来的时候，我们能够想象：他首先感受到的是一滩死水，一滩平静的绝望。</i>","","","","","","",""],"bg":"","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["医生抓住了这个稍纵即逝的机会，试图让文学沙龙从立场争斗的泥沼中重回正轨。","","","","","","",""],"bg":"story_bg/2_6/2_6_bg_jianyu.jpg","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那些望着河流、小船与散尾葵敲下打字机的时日浮现于眼前，令医生的话语顺畅了起来——文字是诚实的，关于文字的一切并不是谎言。","","","","","","",""],"bg":"","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我来到此地，正是为我的下一部作品取材。我会如实地记录我在此处所经历、所聆听到的一切。","","","","","","",""],"bg":"","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那么，兀尔德女士，请问您打算写一部什么样的作品呢？它是一部纪实文学吗？它的主题和科马拉监狱有关吗？","","","","","","",""],"bg":"","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["它的主题是——“命运”。","","","","","","",""],"bg":"","choice":[]},"63":{"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,46,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"info":{"title":"【2.6】小径02","start":1}}