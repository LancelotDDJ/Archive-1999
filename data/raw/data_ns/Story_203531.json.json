_name_en":false,"no_l2d":false,"text":["蝴蝶女士，谈论了如此多关于我的话题，您是否有兴趣，来聊聊您自己？","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501844","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["——我？","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她眼中的玩味褪去了。但对方无视了危险的信号，只是继续淡然说着。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"645611.png","audio":"613501113","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["从俱乐部前往拍卖会现场的时候，我们曾经接触过一块用作传送仪式的太阳石。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"82":{"step":[[82,112,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"645612.png","audio":"613501114","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["那个时候，我意识到了一件事情：蝴蝶女士，您对某些颜色极其不敏感，具体来说，您无法区分一些对常人来说差异非常明显的色彩。","","","","","","",""],"bg":"story_bg/3_5/3_5_bg_22.jpg","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501115","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我想，这也是像您这样的犯罪天才，无法在第一时间确认真凶的原因。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["野木蓝","","","","","","",""],"head_icon":"","audio":"613501116","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["您大概耗费了许多时间才发现，一切秘密隐藏在画面的颜色里吧。","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"","audio":"613501845","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["所以呢，这个小小的发现能发挥什么作用？你该不会以为这样能威胁到我吧？","",""