},"102":{"step":[[102,103,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"610015537 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["由此可见，学文还是要看老天赐赋的。","","","","","","",""],"bg":"","choice":[]},"103":{"step":[[103,104,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610015571 ","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["认字比打酒难多了，我脑袋里像发了个面团，一看见字就涨疼。","","","","","","",""],"bg":"","choice":[]},"104":{"step":[[104,105,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["而且这些字歪歪扭扭，好像地龙虫儿。","","","","","","",""],"bg":"","choice":[]},"105":{"step":[[105,106,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“天地玄黄，宇宙洪荒”，自仓颉造字起，才开了智能，圣人训诫才能流传下来，条律才有了记录，人所得礼法。","","","","","","",""],"bg":"","choice":[]},"106":{"step":[[106,107,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["识了字，读圣贤书，方才开化。要是不识字，连药书也看不懂，更别说像我一般开医馆了。","","","","","","",""],"bg":"","choice":[]},"107":{"step":[[107,108,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那造字的人挺坏的。","","","","","","",""],"bg":"","choice":[]},"108":{"step":[[108,109,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["又想让人认字，又不把字造得简单些。","","","","","","",""],"bg":"","choice":[]},"109":{"step":[[109,110,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"110":{"step":[[110,111,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610015575","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["柳郎君，你知道祥瑞是什么吗？酒坊老板娘说你博古通今，什么都知道。","","","","","","",""],"bg":"","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"610015536","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["所谓祥瑞，祥瑞嘛……","","","","","","",""],"bg":"","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["柳郎君顿上一顿，所幸他平日里就爱看些杂书，对这问题信手拈来，才没在这小娘子跟前拂了面子。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["祥瑞又称“福瑞”，意为吉祥征兆，乃是上天传授乐善之天意，于人有益的征兆。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"610015538 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不过祥瑞之形变化无端，有天降彩云的，有禾生双穗的，有地涌甘泉的，当然，也有奇珍异兽出现的。","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["“奇珍异兽”这四字像是一记惊堂木，让曲娘忙追问起来。","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那奇珍异兽，怎么变成祥瑞呢？","","","","","","",""],"bg":"","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"610015540 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这，这……这我也不清楚，读圣贤书的，怎么知道这些杂文野史的细节。","","","","","","",""],"bg":"","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那你也是什么都不知道的，老板娘让我来这里，还以为能学到些什么。","","","","","","",""],"bg":"","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["曲娘两句话把柳郎君问得说不出话，只能干挠头。","","","","","","",""],"bg":"","choice":[]},"120":{"step":[[120,121,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["柳郎君忽想到，这世上的东西，除了用文字记下，当然还有别的方式。于是他便往医馆里去，没一会儿就拿着几本沾灰的书走出来。","","","","","","",""],"bg":"","choice":[]},"121":{"step":[[121,122,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["打开一看，里面都是些山精野怪的图画，配着小小的方块字。印制粗糙，连封面都残破不堪。","","","","","","",""],"bg":"","choice":[]},"122":{"step":[[122,123,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["喏，就这些，都是些讲山精野怪、民间传言的书。上面字不多，尽是图画。","","","","","","",""],"bg":"","choice":[]},"123":{"step":[[123,124,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你呢，正好一边学学字，一边也找找你要的祥瑞，正所谓一举两得。","","","","","","",""],"bg":"","choice":[]},"124":{"step":[[124,125,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["曲娘接过书，小心捧着翻看。","","","","","","",""],"bg":"","choice":[]},"125":{"step":[[125,126,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["趁着空当，柳郎君便拿出两块糟饼子，又拿出一只大碗放在柜台上。","","","","","","",""],"bg":"","choice":[]},"126":{"step":[[126,127,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014112 ","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["咦，是糟饼子，我也想吃。","","","","","","",""],"bg":"","choice":[]},"127":{"step":[[127,128,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"610015539 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我记得许娘子说你不爱喝酒，这几日不见，酒量着实见长。","","","","","","",""],"bg":"","choice":[]},"128":{"step":[[128,129,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["想是我们最能喝的老翁，也不敢空口吃糟饼子。","","","","","","",""],"bg":"","choice":[]},"129":{"step":[[129,130,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你说什么呀？老板娘从不给我吃糟饼子，我从没吃过呢，所以好奇。","","","","","","",""],"bg":"","choice":[]},"130":{"step":[[130,131,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["看来你们老板娘还没跟你提过，我这一说会不会……","","","","","","",""],"bg":"","choice":[]},"131":{"step":[[131,132,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["也罢，你要帮衬着老板娘，经营酒坊的话，不论早晚也是要知道的。","","","","","","",""],"bg":"","choice":[]},"132":{"step":[[132,133,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["但见柳郎君拿一块糟饼子细细掰碎了，落在碗里，约莫盛了有个半碗，随着一壶热茶水冲入碗里，熟悉的香味漫入曲娘的鼻子。","","","","","","",""],"bg":"","choice":[]},"133":{"step":[[133,134,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["醇厚的酿造芬香，夹着芝麻的干香和炙烤过的炉气。","","","","","","",""],"bg":"","choice":[]},"134":{"step":[[134,135,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014112 ","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["咦，热茶把饼变成了酒。","","","","","","",""],"bg":"","choice":[]},"135":{"step":[[135,136,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["曲娘凑在柜台边，小小的面庞倒映碗中，糟饼子已经溶化，只余一些酒糟粒沉在茶碗底。","","","","","","",""],"bg":"","choice":[]},"136":{"step":[[136,137,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["许娘子为了照顾我们这些老酒客，专门做成了这糟饼子。","","","","","","",""],"bg":"","choice":[]},"137":{"step":[[137,138,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["听说这糟饼子用的酒糟是特意酿的几缸，专是出糟多，出酒少。所以这糟饼子才能如此酒气十足。","","","","","","",""],"bg":"","choice":[]},"138":{"step":[[138,139,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["空口吃饼，定要吃得满脸红，只有那老酒蒙子才敢吃。","","","","","","",""],"bg":"","choice":[]},"139":{"step":[[139,140,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不过要是兑上水，只一碗，就成了一口解忧消愁的美酒。","","","","","","",""],"bg":"","choice":[]},"140":{"step":[[140,141,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["原来如此，怪不得每到闲酒日，那么多人来买饼。","","","","","","",""],"bg":"","choice":[]},"141":{"step":[[141,142,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["老板娘真厉害，能想出这个办法送酒给人喝。","","","","","","",""],"bg":"","choice":[]},"142":{"step":[[142,143,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["闲暇时酌上一两杯，暂时遨游世外，老百姓平日里就这一点喜好了。","","","","","","",""],"bg":"","choice":[]},"143":{"step":[[143,144,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这禁酒令让百姓们寻找各种法子，与官府斗智斗勇。","","","","","","",""],"bg":"","choice":[]},"144":{"step":[[144,145,""]],"type":1,"name":["柳郎君","","","","","","",""],"head_icon":"623201.png","audio":"610015538 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不过好在查得倒是不严，又有你们老板娘的有勇有谋，才让我们能有一口喝的。","","","","","","",""],"bg":"","choice":[]},"145":{"step":[[145,146,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["原来……老板娘在帮酒客们，我今天才知道。","","","","","","",""],"bg":"","choice":[]},"146":{"step":[[146,147,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我也该帮大家喝上一口酒的，对了，我回去就跟老板娘说，我也跟着她一起送酒给大家。","","","","","","",""],"bg":"","choice":[]},"147":{"step":[[147,148,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["这小娘子竟然有如此胆气，全然不在乎禁酒的诏令，柳郎君也不禁佩服。","","","","",