"","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一听见老板娘有所了解，曲娘变得颇为激动，直往这边凑。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["许娘子只得先把曲娘按住坐下，再跟她好好说话。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015542 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["好了好了，莫要冲动。关于祥瑞我也是一知半解。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["只是听说，城外那桥在断前，也有个祥瑞一直庇护这方城池。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015543 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["据说这祥瑞样子和马很像，跑得比风还快。不过这都是很早以前的事了，我也是听酒坊里的老客人说起过，不知真假。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["那祥瑞会做什么？怎么才能变成祥瑞？","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["至于祥瑞会做什么，大概就和神话书上的差不多吧，人有难时它就会出现，助完人后就不见了。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["至于变成祥瑞……祥瑞基本都是精怪神物所化，哪有人能变成祥瑞的。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["见曲娘竖起耳朵，一个字也不敢落下。","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你呀，就跟前门绸铺的小儿一个样，整天就对神仙列传、妖怪传说之类的感兴趣。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那小儿天天拿着本《山海经》问东问西，时间久了，倒也把一本书的字识全了，还省了上学堂的钱。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你要真想弄明白什么祥瑞之类的，就去问问街尾医馆的柳郎君，他博学多见，你也跟他顺便学学认字。","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015543 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["到时候帮我看看账本，写些祝酒词也是好的。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["听闻此，曲娘自然是心生欢喜，识字了就能看书，听别人说，书里什么都写了，想必祥瑞之事也在上面有所记载。","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["于是当下应了，旋即就要出门去找柳郎君。","","","","","","",""],"bg":"","choice":[]},"86":{"step":[[86,87,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015541 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["诶，先不忙出门。你先过来。","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["许娘子把张黄麻纸拿出来，细细拣了十二个糟饼子，仔细包好，又用绳子捆了打个结儿。","","","","","","",""],"bg":"","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["除了这一包饼，许娘子又拿出一把铜钱，让曲娘交给柳郎君。","","","","","","",""],"bg":"","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610015585 ","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["老板娘你生病了？怎么还要让柳郎君抓药？","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你这傻孩子，这不是让你买药，这是人情。","","","","","","",""],"bg":"","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015557 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但凡托人办事呢，可不能吃白食，人情往来，最是重要……你要学的还多着呢。","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["一包饼子，一溜子钱就叫作人情了。","","","","","","",""],"bg":"","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610015581 ","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["唔……人情真奇怪，提在手里还怪累的。","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[9