"name":["卡尔","","","","","","",""],"head_icon":"512201.png","audio":"610017367","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不过就让程序见鬼去吧！无论如何，他们都不该这样对待一位年轻的小姐。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["卡尔先生身材微胖，脸色苍白。就像这个帝国的官僚体系，散发着打孔纸卡独有的清香。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["整体上，他是个轻松愉快的好人，如果不是出现在这个位置上的话。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["音效-解开咒语","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306516.png","audio":"610016966","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["……呼啊！","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["卡尔","","","","","","",""],"head_icon":"512201.png","audio":"610017368","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["放轻松，别紧张，这只是个小小的意外！再没有什么地方能比维也纳更开放而包容了——就像圣洛夫基金会一直致力于提倡的那样！","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["卡尔","","","","","","",""],"head_icon":"512201.png","audio":"610017369","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["凡是登记过的神秘学家都能自由地穿行于这座美丽的城市！对待艺术家和音乐家，我们还有全方位的优待，因为维也纳是一座热爱艺术和音乐的城市！","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["卡尔","","","","","","",""],"head_icon":"512201.png","audio":"610017370","bool_1":false,"show_name":true,"sh