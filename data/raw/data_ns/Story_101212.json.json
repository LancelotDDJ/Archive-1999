,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一小时后，停留不多时的骑兵军离开了红柳树村，沿着河流向上游的别列格勒城而去。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["上万名骑兵占据了行军队列头部的主要长度，在这之后的是少量的步兵，以及漫长的辎重队伍。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_17.jpg","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529914.png","audio":"613301107","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你们能同意和我一起走前锋真是太好了，和你们聊天有意思得很，可以听听外面的故事。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"531713.png","audio":"613301475","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不是你非要和我们一起走的吗……","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["玛尔纱","","Marsha","","","","",""],"head_icon":"312701.png","audio":"613300402","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["这倒让我想起在骑士团的时候，我也当过好几次斥候骑兵。不过这可不是一个能开小差的职位。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["谢尔盖仰头看了看天。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,130,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529916.png","audio":"613301108","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这样下去，大部队在天黑之前应该是进不了城了。在这里下马吧，我们等一等身后的人。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,131,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["为大军开路的斥候小队在一处有阴凉遮蔽的缓坡边下了马。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_02.