{"1":{"step":[[1,2,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["空白的稿纸折了又拆，拆了又折。","","","","","","",""],"bg":"","choice":[]},"2":{"step":[[2,3,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["伏在书桌上的手无意识地重复着同样的动作，口中喃喃自语。","","","","","","",""],"bg":"","choice":[]},"3":{"step":[[3,4,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"610017969","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["昨天应该是《弗兰南群岛史》新的一节登报的日子……","","","","","","",""],"bg":"","choice":[]},"4":{"step":[[4,5,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"610017991#1.5|1.5|1.5|1.5|1.5|1.5|1.5|1.5","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["如果邮报的编辑们不满意我寄出的内容，那它们应该在两天前就被寄回了。而直到昨天，马歇尔先生都没有收到任何一封邮件。","","","","","","",""],"bg":"","choice":[]},"5":{"step":[[5,6,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这说明它顺利通过了编辑们的考核……","","","","","","",""],"bg":"","choice":[]},"6":{"step":[[6,7,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"6206514","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["谢天谢地……多亏了岛上的三位先生，他们为这篇专栏提供了许多帮助，甚至提供了千奇百怪的题材，这一定能让读者们对弗兰南群岛有更确切的了解。","","","","","","",""],"bg":"","choice":[]},"7":{"step":[[7,8,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"610017987","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["说不定这还能推动一阵弗兰南群岛的旅游风潮，当局一定会支持这个……！","","","","","","",""],"bg":"","choice":[]},"8":{"step":[[8,97,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["而丹尼希女士也能凭借这个顺利通过编辑部的考核，得到优秀编辑的奖金，攒够一笔环游欧洲的资金……","","","","","","",""],"bg":"","choice":[]},"9":{"step":[[9,98,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["真希望她能在出游时为我捎上几本书……","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯旁若无人地感慨着，沉浸在文字与书籍的世界里。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["遗憾的是，此地的和平与安宁并未持续太久。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515402.png","audio":"610017962","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["马……马库斯，邮差们到岛上来了——！","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["气喘吁吁的幽灵从墙外探出头来，马库斯准确地阅读出了更“重要”的信息。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"610017981","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["邮差先生……们？","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515402.png","audio":"610017965","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["没错，他们来了好几个人，很显然，这意味着你的故事大获成功——！","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515402.png","audio":"610017966","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他们也许正打算邀请你去世界各地发表演讲呢～你可别忘了在发表感言时提到我们的名字，来自岛上的马歇尔先生和他的幽灵朋友们。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……！","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,88,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一前一后的身影快步越过了门槛，奔向了岛上唯一的对外通信点。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["三位幽灵先生和呼吸急促的姑娘在不大的邮筒前站定，面面相觑。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,91,""]],"type":1,"name":["唐纳德","","","","","","",""],"head_icon":"515301.png","audio":"610017923","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["先生们……马库斯……邮差先生们已经离开了……把这些信件留在这儿之后，便急匆匆地离开了……","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515401.png","audio":"610017968","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他们只留下了这些信……？就没问我们要点明信片、私人签名之类的……","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["唐纳德","","","","","","",""],"head_icon":"515301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你、你忘了吗？马歇尔先生……他们、看不见我们……","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"610017932","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["没什么可怀疑的，朋友们……孩子们偶尔会紧张，而对于即将成为岛上明星的我们来说，豁达一点儿总没什么坏处。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306521.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["这些信……都是寄给我的？","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["幽灵们不约而同地点了点头。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这完全能够理解，小马库斯——你写出了这么好的作品，读者们热情一些也在所难免。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,92,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306522.png","audio":"610017991","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["可是，它们实在是太多了……","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯紧了紧围巾，压住了泛上脸颊的期待，小心翼翼地拆开了其中的一封。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,94,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["清晰而直白的文字落入她的眼中，令她僵在原地。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“很冒昧向您寄出这样一封信，《弗兰南群岛史》的作者。”","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“但我想，我必须要向您表达我的心声。这不仅仅是为了我，同样是为了千百个同样蒙难的读者。”","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“当我初读文章时，我确实被其中生动的心理描写、作者热切的介绍所吸引，它们推动着我购置了一期又一期的报纸，并将它们推荐给了我的诸多亲朋好友……”","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306521.png","audio":"6206509","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“可是，您却联合出版社一同编造了一个巨大的谎言！——！”","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["翻页的手僵在了原地。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,99,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“《白日梦邮报》无时无刻不在向我们夸赞着未来一期的《弗兰南群岛史》！”","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“我怀着热切的期待苦等了近乎一周，等待着这篇能让一切谜团都尘埃落定的新专栏……”","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"6206508","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“您介绍了幽灵岛上的老船长，介绍了那场遮天蔽日的迷雾和滔天的巨浪，甚至还普及了古老的七圣岛传闻……”","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306521.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“可之后呢——？！”","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306523.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“这三位声称自己在岛上呆了十二年之久的先生到底是如何失踪的？他们又为何成为了幽灵？幽灵的记忆可靠吗？他们有什么可信的证据吗？”","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306523.png","audio":"610017977","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“如果他们真是幽灵，那他们的尸体又去了哪儿？不然的话，您又何以证明这不是神秘学家们又一次的胡言乱语呢？”","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“您试图用这些互相扭打、结成死结的证词糊弄我们，可它们反而制造了更多、更多的谜团，它们不断延伸，延伸，仿佛永远没有尽头——！”","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,95,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"6206509","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“您是个骗子——！”","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯怔怔地站着，她张了张口，却什么声音也发不出来。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["唐纳德","","","","","","",""],"head_icon":"515301.png","audio":"610017928","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这封信……可真吓人……比马歇尔和杜卡特先生的恶、恶作剧还可怕……","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"610017940","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["咳、别紧张，小马库斯……显然，这只是某些极端读者的偏见，他不能代表所有人的意见，对……吧？","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,100,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515401.png","audio":"610017964","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["没错，我们应该阅读一些专业人士的建议……像是《白日梦邮报》的丹尼希女士，她主导了《弗兰南群岛史》的出版……","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["神情恍惚的马库斯开始紧张地在信件堆里翻找，企图寻获她的救命稻草。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,93,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["很快，她便得偿所愿。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“致《弗兰南群岛史》专栏作者，马库斯小姐”。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"6206514","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“首先，我们希望向您表达祝贺，昨天，载有《群岛史》的《白日梦邮报》一经发表，便取得了销量上的巨大成功。”","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“或许是由于上一节的修改延期所致，仅仅在数小时内，您翘首以待许久的读者们便将油墨未干的报纸抢购一空……”","","","","","","",""],"bg":"","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"610017977","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“但在我们准备增发更多刊物时，某些富于激情的读者们便涌入了我们的出版社，他们占领了这里。”","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“这是一件令人始料未及的事，他们挥舞着双臂，高呼着‘退钱！’‘你们这是欺诈！’‘我要向市长先生写信投诉你们’之类并不难懂的话……”","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306517.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“了解原委后，我们意识到他们的身份相当统一，《弗兰南群岛史》的忠实读者们。”","","","","","","",""],"bg":"","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"6206508","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“他们居然认为您的《群岛史》是一场蓄谋已久的欺诈，认为我们同您一同欺骗了所有人……”","","","","","","",""],"bg":"","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“这是多么荒唐的言论啊——！它们竟然将对《群岛史》本身的不满转嫁在我们这样一家小小的出版社上。”","","","","","","",""],"bg":"","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“诚然，我们确实在本期《群岛史》发布前便展开了规模不小的前期宣传工作。但这并非是我们仓促的决定，而是出于对您的信任！”","","","","","","",""],"bg":"","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"6206509","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“是您——！您在来稿中向我们承诺，您的所有文字都出于当事人的亲身经历，您会对其中的真实性负责！”","","","","","","",""],"bg":"","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“但很遗憾，事情的发展超乎了所有人的想象。”","","","","","","",""],"bg":"","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306523.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“我们认为，如果您无法在下一期的《弗兰南群岛史》中尽可能地满足读者们的期待，给出一个轰动性的结论，或是揭晓故事的重大真相……”","","","","","","",""],"bg":"","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306523.png","audio":"610017973","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“您或许不得不准备一个新的笔名，更换一个弗兰南群岛以外的新课题，或是……放弃这份工作。”","","","","","","",""],"bg":"","choice":[]},"63":{"step":[[63,96,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“我们诚恳地希望您能考虑上述建议。”","","","","","","",""],"bg":"","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["“噗——”","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯瘫坐在地，再也无力负担这沉甸甸的信纸。","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["唐纳德","","","","","","",""],"head_icon":"515301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["幽灵们一言不发，默契地扎进了信件堆里。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“您是个可耻的作家，您滥用自己的纸笔，以所谓的神秘学搪塞一切，如果一切都如您所言，这该是一个多么荒诞的世界啊！”","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515401.png","audio":"610017963","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不，不是这个——","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他故作轻快地吁了口气，毫不犹豫地将这封信扔到一旁。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"610017934","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["来听听我这封，小马库斯——这正是经验所赋予我们的鉴别力。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,101,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“向您表达祝贺，作者女士。我笃信，您凭借巧妙的、故弄玄虚的能力攫取了丰厚的稿费。”","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["杜卡特","","","","","","",""],"head_icon":"515501.png","audio":"610017940","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["咳、经验偶尔也会欺骗我们。当然，这同样是经验的一部分。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["唐纳德","","","","","","",""],"head_icon":"515301.png","aud