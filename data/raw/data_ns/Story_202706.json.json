ina","","","","",""],"head_icon":"","audio":"612700694","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["她帮助我收起了身体周围的光幕，还试着分析了神秘术的原理。虽然我最后仍然没听懂。","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["库珀花环","","Kiperina","","","","",""],"head_icon":"","audio":"612700695","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但我记住了她用的方法，理线学。她借给我的测量仪也的确让我更容易控制自己的神秘术。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["库珀花环","","Kiperina","","","","",""],"head_icon":"","audio":"612700696","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["再加上，团长也希望我能答应邀请……所以我决定明天还是去和她见一面。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["冷周六","","Hissabeth","","","","",""],"head_icon":"","audio":"612700085","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["挺好，她是个很不错的学者。虽然理线学基本上是纯理论内容，但实践研究也离不开理论支持。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["冷周六","","Hissabeth","","","","",""],"head_icon":"","audio":"612700086","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你要是真打算加入拉普拉斯，我也能给你写推荐信。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["库珀花环","","Kiperina","","","","",""],"head_icon":"","audio":"612700697","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["您也是拉普拉斯的研究员？","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["冷周六","","Hissabeth","","","","",""],"head_icon":"","audio":"612700087","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我看起来不像？奇怪，那群家伙总说我打扮得很符合他们的刻板印象，怪胎科学家之类的。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["库珀花环","","Kiperina","","","","",""],"head_icon":"","audio":"612700698","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":fa