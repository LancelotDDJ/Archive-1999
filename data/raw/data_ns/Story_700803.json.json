,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但好在不远处就是个加油站，有驻军，和其他的油站一样。","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们下车后，看着卡车慢慢开过去。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["大家都还很放松，在路边有说有笑，等卡车加满油回来。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["为什么要大伙儿下车？","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"","audio":"7208581","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["因为汽车爆炸的时候，待在车上比待在这里危险。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"","audio":"7208553","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["对那些藏在山上的家伙来说，打掉一辆车有时候比打死几个人更有价值。","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208561","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["头儿，你别吓唬小同志了，今天是个好日子呀，艳阳高照，不会有事的。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["站在这里晒晒太阳好，多晒太阳，能长高个儿。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["上个月我们的友军清理了这附近的村子，因为村民支持我们的敌人。放松点，同志们，别太紧张。日头正好呢！","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208560","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["咱们今天运气不错！是不是啊，阿历克塞兄弟！运气不错，都是托了你的福呀！","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["阿历克塞","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["保持警惕，哈桑同志，盯紧山上。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["一行人里，阿历克塞的情绪最紧张，哈桑却最放松。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他们不关心我是人类还是神秘学家，而是问我属于哪个部队，又在哪里服役。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507514.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["甚至没人关心我多大了！我可是穿着军装呢！嘿，穿军装的少女，还骑着史上最酷的扫帚，他们就不好奇这个吗？","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507514.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["如果他们见到芝诺军械库里能喷火的飞毯和会自动索敌的飞天麻绳，他们肯定会张大嘴巴说不出话的，哈哈。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507514.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但那些玩意儿都比不上我的家伙好！","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["加入芝诺前，我在布哈拉的街上要饭。饱一顿饿一顿，哈哈，那都是寻常事！","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208565","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他们问我：“嗨，伙计，要来当兵吗？管饭！一天三顿！”所以我就去了。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["热情的哈桑开始跟我搭话。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208652","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在咱们这儿，忠诚是很便宜的：一双靴子，两碗抓饭，再加一日三餐。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["芝诺的人还会教我认字读书，跟我讲了很多以前的故事。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208580","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不过你要小心，在这里可以给老乡们送礼物，但绝不能收他们的东西。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["运气好点，你拿到的是毒药，运气差点，那就是炸药了。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["八音盒跟布偶玩具都可能在手心爆炸。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208558","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["哈哈！你吓到了吗？别怕！红弩箭同志，欢迎来到乌哈拉，祝你长命百岁！ ","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你讲的事我都听说过，吓唬谁呢！","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208567","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是，是，你当然很勇敢！对了，你以前在哪服役的？","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["阿历克塞","","","","","","",""],"head_icon":"","audio":"7208551","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她跟我一样，都是芝诺的学员。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是空军预备役。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208566","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["展翅待飞的隼崽儿啊！你是不是靠那根扫帚飞的？","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["哈桑对我的红色-38很感兴趣，还摸了摸它的金属外壳。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["哈桑","","","","","","",""],"head_icon":"","audio":"7208637","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这玩意儿坐上去，真的能飞起来吗？太酷了，朋友！","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["要我露一手吗？","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["无所事事的大伙儿朝我聚拢。他们很好奇，像等着马戏开演的观众。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["晴天，山路，山和山之间的谷地就像一条飞行跑道。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"","audio":"7208570","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["去吧，看看你是不是真的拥有猎隼的眼光吧。到天上看看，侦察这附近的山，靠你了。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["好嘞，长官！","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["大伙儿立马给我让开一条路，直到我和了不起的红色-38腾空而起——","","","","","","",""],"bg":"story_bg/1_8/1_8_bg_tiankong1.jpg","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["飞起的瞬间，我听到他们在欢呼，也可能是惊呼。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["除了山还是山，山上有树，没我想象中那么荒凉。有亮光从林子里反射出来。","","","","","","",""],"bg":"","c