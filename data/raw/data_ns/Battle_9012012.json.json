nHeroViewOffset":"2#-47.7#1","canWade":0,"canHide":0,"mainBody":0,"skinGainViewImgOffset":"-110.7#-78#0.87","jump":10173,"storeTag":"109|103|104|105|101|102","fullScreenLive2dOffset":"14.6#-59.2#1","fullScreenCameraSize":12,"folderName":"v1a4_306403_wajueyishu","playercardViewLive2dOffset":"","playercardViewImgOffset":"-262.7#-81.2#0.88","lucidescapeViewImgOffset":"","summonPickUpImgOffset":"","isSkinVideo":true,"repeatBuyTime":"2026-10-31 04:59:59","unavailableStore":"510","skinStory":"嬉皮士手记\n\n这真是一个可怕的地方！\n我一点儿都不想再回忆那些事情——关于我怎样自以为逃出了小岛，又怎样重新回到了重塑之手……为了拜访海岛的哲人，我花光积蓄请人为我订制了新的衣服，以此表示尊重，但到头来我连一个酒神的信徒都没遇到！难道艺术将要迎来真正的消亡了吗？这里的人只想着怎么造出大炮和军舰，却没有人愿意停下来听我说话。\n除此之外，还存在着更严峻的情况：即使我找到了志同道合的朋友，也无法与他们保持联系——这关乎重塑之手，他们的话语总是诱人，连我都差点迷失在那些状似美好的描述之中。\n所幸有一位香气女士向我提供了帮助，她告诉了我一些实话，并帮助我说服了几位先生和小姐，让我的艺术能够在此地推行——好吧，即使那些家伙根本不懂艺术！\n伟大艺术的路途总是曲折的，而前方是光明的。","skinStoreId":0,"subTitle":"","skin2dParams":"","skinSwitchLive2dOffset":"","skinLevel":3,"handbookRedDot":0,"skinSignature":"","costafterbuy":""}},"skill":{"2161021":{"id":2161021,"name":"群居生物","timeline":"","icon":501,"desc_art":"","eff_desc":"","battleTag":"","skillEffect":2161021,"skillRank":0,"notDoAction":0,"showInBattle":0,"bloomParams":"","activeTargetFrameEvent":"","preFxId":0,"heroId":0},"2161015":{"id":2161015,"name":"癫狂脑髓","timeline":"","icon":501,"desc_art":"","eff_desc":"","battleTag":"","skillEffect":2161015,"skillRank":0,"notDoAction":0,"showInBattle":0,"bloomParams":"","activeTargetFrameEvent":"","preFxId":0,"heroId":0},"51400282":{"id":51400282,"name":"狂热祭祀","timeline":"","icon":0,"desc_art":"","eff_desc":"","battleTag":"","skillEffect":51400282,"skillRank":0,"notDoAction":0,"showInBattle":0,"bloomParams":"","activeTargetFrameEvent":"","preFxId":0,"heroId":0},"51400283":{"id":51400283,"name":"污毒蔓延","timeline":"","icon":0,"desc_art":"","eff_desc":"","battleTag":"","skillEffect":51400283,"skillRank":0,"notDoAction":0,"showInBattle":0,"bloomParams":"","activeTargetFrameEvent":"","preFxId":0,"heroId":0},"901101911":{"id":901101911