e,"no_l2d":false,"text":["我知道，有人以“洛伦兹蝴蝶”署名发表了《全球环境与局部混沌能量的变化路径采样》。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011373","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["很显然，他们借用了我们的采样点，研究方向与结论却和拉普拉斯的大相径庭。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011374","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["固守人类科技和转向神秘学的研究员们正在分庭抗礼。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011375","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["眼下还难以评判谁是正确的，因为缺乏数据验证。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011376","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但到处都是这样的声音：如果时代持续倒退，人类的科技只会越来越衰落，仰赖个人能力的神秘学却会大放异彩。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011377","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是的，灵知不可重复，不可独立验证，无法被理性理解……","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011378","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["它无法搭建起科学的大厦，也无法推广至所有的人群。就像细软的流沙，与理性的花岗岩的质地相去甚远。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,171,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011379","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——可既然整个世界的根基都已经变得不可理喻，那又有什么所谓呢？","","","","","","",""],"bg":"","choice":[]},"173":{"step":[[173,174,""]],"type":0,"name":["","","",""