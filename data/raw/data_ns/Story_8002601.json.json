""],"head_icon":"518501.png","audio":"612601710","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["美洲……<b>“<i>诗社</i>”</b>？","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一路走来的触感，与她此刻听到的名词大相径庭。凭借对音源的敏锐捕捉，医生在这个想象中略显宽敞的空间里停下了脚步。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一切陷入了寂静，就像人类史迎来了它最漫长的一分钟。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……请问两位还在吗？","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["黑暗中传来一声轻咳，和一道沉重的鼻息。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["两位曾与我是旧识吗？至少在记忆中，我是第一次来到这座监狱。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["女声","","","","","","",""],"head_icon":"522310.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["听听这个如此陌生的词汇——“<i><b>监狱</b></i>”！上一次听到它是什么时候？《叙事人》发表的那年吗？","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["女声","","","","","","",""],"head_icon":"522301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["难不成你是一位古老的、追寻现实主义的幽灵吗？","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":2,"name":["旁白","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["眼前的人故作神秘地说道。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["男声","","","","","","",""],"head_icon":"522412.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["锈迹斑斑的闸门，晦暗无光的牢房，“监狱”。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["男声","","","","","","",""],"head_icon":"522412.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["交换信件的栏杆，清幽僻静的空间，“诗社”。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["男声","","","","","","",""],"head_icon":"522401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["以及，我们并不认识你。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["从回声的间隔来判断，三者间的距离足够他们在黑暗中勉强看清来客的样貌。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["女声","","","","","","",""],"head_icon":"522301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["加西亚举了一个很好的例子，正是这样！一切都取决于你看待这个世界的方式，新来的朋友。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"522401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["罗贝托，我们时间不多了。这可是本月……不，也许是本年度最重要的一次集会。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"522301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你说的对，加西亚。眼下，没什么比理想家先生精心筹备的沙龙更重要的了。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你该先集中精力，把那堆手稿的顺序搞清楚。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"612601711","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["——我无意打扰二位，但，请问你们的组织为什么叫做“<i><b>美洲诗社</b></i>”？我相信，那不会只是地理位置使然。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"522301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["放心吧，女士，我们理应向每一位新朋友介绍我们的诗社——但不是现在。等沙龙结束，我们会向狱卒询问你的住处。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["等会儿，罗贝托，用你早已适应了黑暗的眼睛看看清楚……","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她既不是个新人，也不是个重返者。她……她是个盲人。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，请原谅加西亚的粗鲁，女士！感官的缺陷有时能换来更为敏锐的直觉。在那个五彩斑斓的心灵世界中，您看到的一切一定比现实更美。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不过……如果您不是被狱医抓进来的，那为什么会出现在这儿呢？","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,59,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["医生试图在思维中搭建虚构，为她那魔幻的遭遇自圆其说。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,57,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["场景","","","","","","",""],"bg":"story_bg/2_6/2_6_bg_jianyuwaiwei.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["从圣保罗湿热的信风，到海崖边喧嚣的海潮。<br>此刻，陌生的土地用冰冷的沉默作为首次见面的招待。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["淑女格蕾丝","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["<i>“将兀尔德女士安置于乌斯怀亚的科马拉监狱，不可将其视为普通囚犯对待。”</i>","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["淑女格蕾丝","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——依传道者的箴言，兀尔德女士，您是我们宝贵的座上宾。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"612601712","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["从那位小姐复述的话语中，我得知了这片土地的面目——<i><b>乌斯怀亚</b></i>。在幅员辽阔的美洲大陆上，它是最为边陲的南端。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,43,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"612601713","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我能感觉到那位小姐对我并无恶意……甚至恰恰相反。行走途中，我总是感受来自她的视线。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["淑女格蕾丝","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["关于您的身份与权宜，我已知会科马拉监狱的管理者，他会保障您的安全。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["淑女格蕾丝","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["祝您好运，再见。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"612601714","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["她命令两名随从跟随在我身后，有什么东西正从他们身上滴落。这座奇异的建筑笼罩在一种我从未体验过的氛围中。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"612601715","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["在了解这份异常的缘由之前，我必须先获得自由探索的权利。黑暗对我来说是一种幸运。甩开他们并非什么难事。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,60,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"612601716","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["抱歉，两位称职的朋友。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["场景-监狱甬道（盲人滤镜版，或者特别篇那种效果也行）","","","","","","",""],"bg":"story_bg/2_6/2_6_bg_yongdao.jpg","choice":[]},"49":{"step":[[49,50,""]],"type":6,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"612601717","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["嗯……我并不认识你口中的狱医，我是一名作家。因为对于你们的“沙龙”抱有崇敬之情，我前来参观，并希望从中取材。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你听听，加西亚，这位女士是个好人，是位作家！你差点儿害咱们错过了一位专程前来的