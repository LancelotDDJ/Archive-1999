{"1":{"step":[[1,3,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"3":{"step":[[3,4,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["这场隔河对射的小规模冲突，在一方拥有空中优势的情况下迅速结束。河畔复归宁静。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"4":{"step":[[4,5,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["红弩箭悬停在半空中，将地面的局势尽收眼底。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"5":{"step":[[5,6,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300732","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["土匪损失了两个人，剩下三人在往北逃……噢，他们想钻到树林里去。","","","","","","",""],"bg":"","choice":[]},"6":{"step":[[6,7,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300733","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["骑兵军只有谢尔盖一人受伤，萨沙留下来照顾他了，看样子无大碍。","","","","","","",""],"bg":"","choice":[]},"7":{"step":[[7,42,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300734","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["剩下的人已经上马，正在往渡河的浅滩去。那这两个被抛下的土匪就交给他们负责吧。","","","","","","",""],"bg":"","choice":[]},"8":{"step":[[8,9,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["飞行女巫调转方向。此刻她还能看见骑马逃亡的匪军的背影。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300735","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["——我看看能不能揪出他们的老巢。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"10":{"step":[[10,11,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["重重树影当然能遮蔽地面追击者的视野，但对于空中的鹰隼来说不是很起作用。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["枯黄的叶片已被秋风吹走了大半，如今只有细瘦的树杈胡乱地刺向天空，织成一片稀疏的网。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300736","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["加把劲，跑得再快点吧，别浪费我的时间。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["对习惯了高速掠空的飞行员来说，这种“追击”几乎和放牧没有太大的区别。","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,45,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300737","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["照这么飞下去，我看我还有时间停下来喝一杯……","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,18,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"17":{"step":[[17,19,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一朵黑云在她的耳旁炸开。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"18":{"step":[[18,17,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300738","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["——！","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["紧接着，是第二朵——第三朵——数百枚细碎的金属碎片在她的衣服上撕开了数不清的裂口。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"20":{"step":[[20,44,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300739","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["见鬼了，是防空炮？！——他们从哪里搞来这种东西？","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["飞行女巫没有掉头。她压低高度，几乎擦到了树梢，执拗地以规避姿态向防空火力的来源飞去。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300740","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["开火的声音很近了，还差一点——让我看看你们在林子里都藏了些什么东西！","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["干枯交错的枝条将她眼前的景物切成碎片，四处爆炸的黑色硝烟又让一切都染上模糊不清的暗色。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["但她的勇气还是为她换来了一个电光石火般的瞬间。鹰隼的目光敏锐地捕捉到一块架设着防空炮的林中空地。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300741","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这就够了！","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她拉起Su-01ве，以几乎是与地面垂直的角度刺入高空厚重的云团。","","","","","","",""],"bg":"story_atcg/3_3/3_3_at_01.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_06.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300411.png","audio":"613300742","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["那门高射炮不是这个时代的东西，土匪绝对搞不到手。至于型号……不，就算只瞄一眼我也不会认错——","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300412.png","audio":"613300743","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["——AZP-37高射炮，是芝诺的武器。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300411.png","audio":"613300744","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["得把这事告诉军长。也许维尔汀也会感兴趣，可以给她捎条留言。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["“喀咯咯——”","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_06.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300412.png","audio":"61