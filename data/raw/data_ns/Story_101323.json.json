":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"313902.png","audio":"613700481","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["芝诺寻找到那些“暴雨”后身份有异的士兵，伪造了他们的“逃兵”证明，再用寂静小队将他们转移至实验室。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"313902.png","audio":"613700482","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["灌体实验是否成功我们尚未得知，但回环实验室基于灌体的原理，研究出了一项新的技术——","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["无名者","","Ms. Stranger","","","","",""],"head_icon":"314701.png","audio":"613700908","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……趋光性定律。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["无名者","","Ms. Stranger","","","","",""],"head_icon":"314701.png","audio":"613700909","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["一项镌刻在受训者大脑皮层与皮肤表面的复杂神秘术，无数条咒语共同组成了名为“趋光性定律”的控制系统。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["无名者","","Ms. Stranger","","","","",""],"head_icon":"314701.png","audio":"613700910","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["它能够保证受训者绝对的优秀、坚定……以及忠诚。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那些快乐、恐惧、悲伤、感动，像是剧毒的违禁物，在大脑中蠢蠢欲动。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"313902.png","audio":"613700483","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["重视亲近之人的塞西莉，柔情的凯拉，喜爱标本的格蕾丝……基金会一直在用趋光性定律让你去扮演他人的身份。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["无名者","","Ms. Stranger","","","","",""],"head_icon":"314701.png","audio":"613700911","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我……曾经成为她们，利用她们的身份，做了许多……我不愿回忆的事情。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"313902.png","audio":"613700484","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你不是她们。这些年来，我一直在追踪回环实验室的动向。许多受训者都在多次转换身份后崩溃，无法继续执行任务。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"313902.png","audio":"613700485","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["毫不夸张地说，你是回环实验室交给副会长康斯坦丁的，最优秀的那件“消耗品”。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["无名者","","Ms. Stranger","","","","",""],"head_icon":"314701.png","audio":"613700912","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["够了，玛格丽特小姐。请直接告诉我，我身上究竟有什么你想要的。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"313902.png","audio":"613700486","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这些年来，我一直没能找到的，唯有这项实验成果的承载者——","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"313902.png","audio":"613700487","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那正是你，经过重重试炼与改造的无名者小姐。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["洛伦兹蝴蝶","","Lorentz Butterfly","","","","",""],"head_icon":"3139