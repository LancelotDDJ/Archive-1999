,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/2_1/2_1_bg_yuanye1.jpg","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"613300113","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["兀尔德女士，军队全员已经做好战斗准备了。","","","","","","",""],"bg":"","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["兀尔德","","","","","","",""],"head_icon":"518520.png","audio":"613301183","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["麻烦您了，将军。仪式举行的瞬间，会是他们最脆弱的时候，我需要在那个瞬间靠近仪式中心。","","","","","","",""],"bg":"","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300114","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["好。我相信您知道自己在做什么。","","","","","","",""],"bg":"","choice":[]},"120":{"step":[[120,121,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300115","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["重塑之手的防御很薄弱，行动会很顺利，请您不用担心，兀尔德女士。","","","","","","",""],"bg":"","choice":[]},"121":{"step":[[121,122,""]],"type":1,"name":["兀尔德","","","","","","",""],"head_icon":"518520.png","audio":"613301184","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我不为自己的命运担忧，不过，我很担心她。","","","","","","",""],"bg":"","choice":[]},"122":{"step":[[122,123,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300116","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["她……您的孩子，对吗？","","","","","","",""],"bg":"","choice":[]},"123":{"step":[[123,124,""]],"type":1,"name":["兀尔德","","","","","","",""],"head_icon":"518520.png","audio":"613301