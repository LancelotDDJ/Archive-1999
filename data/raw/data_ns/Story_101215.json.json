:[[131,132,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309221.png","audio":"613300120","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["我向兀尔德保证行动会顺利，但这是谎言。芝诺和基金会都不清楚重塑之手布设的防御术阵有多么强大。","","","","","","",""],"bg":"","choice":[]},"132":{"step":[[132,133,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"613300121","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["情况过于危急，所有战斗人员都只得到了一条命令——前进，不计伤亡。","","","","","","",""],"bg":"","choice":[]},"133":{"step":[[133,134,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309212.png","audio":"613300122","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["战役的细节被“暴雨”带走，只剩沉重的情绪还留在我的回忆中，那是下令让无数士兵走向死亡的悲痛。","","","","","","",""],"bg":"","choice":[]},"134":{"step":[[134,135,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309216.png","audio":"613300123","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["无数性命像酒杯口的小虫子一样，轻易地滑向了深渊，再也没有回来。","","","","","","",""],"bg":"","choice":[]},"135":{"step":[[135,136,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309217.png","audio":"613300124","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["如果不是被第一场“暴雨”或多或少带走了记忆，我离开芝诺与基金会的时间只会更早。","","","","","","",""],"bg":"","choice":[]},"136":{"step":[[136,137,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["地铁站走到了尽头，前面似乎是一个更广阔的地带，白色的光线和风灌了进来。","","","","","","",""],"bg":"","choice":[]},"137":{"step":[[137,138,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"613300634","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["那之后又是什么导致了你背叛芝诺和基金会？","","","","","","",""],"bg":"","choice":[]},"138":{"step":[[138,139,""]],"type":1,"name":["","","","","","","",""],"head_icon":"