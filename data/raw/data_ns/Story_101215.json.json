e_en":false,"no_l2d":false,"text":["我会去找几个有声望的人，比如费奥多尔·彼得罗维奇，一位市民代表。我会让他相信骑兵军没有恶意。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300071","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["人们不会理解自己看不到的东西，你没办法把基金会和芝诺的事情解释给他们听。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["阴影处潜伏着一些手持武器的市民，这一切无法躲过军人敏锐的目光。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300072","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["看来他们已经组织起了民兵，做好了最坏的打算。我们能做的只有在城里保持安静，不要再火上浇油。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301764","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……我只希望这一切快点结束。解决格鲁托夫，最好逮捕或杀死他本人，然后毁坏正在控制顿河天气的术阵。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300073","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["以及让司辰完成基金会交给她的任务。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301765","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没错，所有这一切——一星期之内完成，你答应过我。也希望你能信守承诺。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"","audio":"613300074","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["嗯，我建议将解决术阵的问题交给红弩箭的飞行中队。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"nam