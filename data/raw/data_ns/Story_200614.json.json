"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610013990","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["好的呀，那是一定的！真是谢谢你们啦！","","","","","","",""],"bg":"","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她熟络地与居民叙话，却又不住地向茶馆的方向张望——似乎想确认之前那位说书先生是否还在原地。","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["当看到远处那摇头晃脑的身影后，她终于露出释然和欢欣的神色。","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["小叶尼塞安静观察，慢慢退后，转身朝别斯米尔走去。刚才人们的对话流进她的耳朵，使她确定了一个事实。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013697","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["女士，请跟我来。那位应该就是……里正所说的“执礼”。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013698","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["请您留神脚下，现在地面上有些乱糟糟的。我们得继续跟上去看看，或许能与她搭上话。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_chengzhongjieshang.jpg","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622714.png","audio":"610015457","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["——先不论——烛夜如何——","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013699","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……？","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["两人一走到茶馆前，没等拾到一个好位置，便发现人潮都追着石台上的声音向前涌去。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_chengzhongjieshang.jpg","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他们更紧地聚拢在茶店前的空地，以至于身在其中的两人也被裹挟到那人面前。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015458","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["且说那帝尧，亦是多见此类异兽——","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他的声音娓娓道来，的确带着某种奇异的魔力，连并不为此而来的人都自然被吸引。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015459","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["其在位日久，及至七年。有使者前来献宝。此使乃结匈国人，样貌精奇，胸脯尖削，自称从玉门关外万万里处来。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015460","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“有鸟生来即通人言，鸣若凤啸，吾人引以为祥瑞，特此献上人主！”","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015461","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["帝尧诸臣见证，结匈使者所献宝物果真为一巨鸟。其貌壮如山峦，有凤凰之姿，青身红尾，神貌不凡！","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["城中居民Ⅱ","","","","","","",""],"head_icon":"622920.png","audio":"610015436","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["难道真的是凤凰？","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015462","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["哎，非也，非也。此鸟唤作灭蒙鸟，云是能勘骨相，改命貌，禳异灾！","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015463","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["于是帝尧甚悦，故另辟山头饲之。今人所见灭蒙，盖度朔山始祖之后也。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["先前那位绿衣姑娘眼中盈满了艳羡的神色。","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308312.png","audio":"610013991","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["您、您有亲眼见过灭蒙鸟吗？","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015464","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["莫急莫急。灭蒙鸟生性喜静好洁，古今之人常将门前扫净，盼望祥瑞禽鸟停留聚集。虽时不定，长此以往，或可见之。","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["城中居民Ⅲ","","","","","","",""],"head_icon":"622401.png","audio":"610015442","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们朔日需得扫门，原是这么个道理？","","","","","","",""],"bg":"","choice":[]},"86":{"step":[[86,87,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015465","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["正是。亦有人将金玉珠宝刻成灭蒙模样，装点家宅以求平安。是以诸位仰头望去，今日屋头檐上所刻时夜，其非时夜也，其真灭蒙也，家户所裁门笺亦是。","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["说罢，他举起一张红色的门笺，上面剪刻了某种鸟类的形状。","","","","","","",""],"bg":"","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015466","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["此鸟即为——灭蒙鸟。","","","","","","",""],"bg":"","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["众人露出了失望的神色。","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610013992","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["唔。可这个，看起来像普通的鸡……","","","","","","",""],"bg":"","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013700","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这看起来像松鸡。","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013701","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……也像我刚才画的巨鸟？","","","","","","",""],"bg":"","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014772","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他说话的方式和语调很有韵律感，像是在唱歌。只可惜没有伴奏，清唱似乎令这些歌词失去了一些味道。","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[94,95,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014773","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果他能——","","","","","","",""],"bg":"","choice":[]},"95":{"step":[[95,96,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["别斯米尔话音未落，红色的纸张瞬间在灰衣男子手中自燃，又于触到手指之前尽数化为灰烬，簌簌落到石台之上。","","","","","","",""],"bg":"","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一旁侍立的小童则登时踮起脚来，利落地接手，将那些灰烬扫进了下方的炭盆中。","","","","","","",""],"bg":"","choice":[]},"97":{"step":[[97,98,""]],"type":1,"name":["说书先生","","","","","","",""],"head_icon":"622701.png","audio":"610015467","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["灭蒙属火，庭燎燃春，此即为喻。而话又说回——","","","","","","",""],"bg":"","choice":[]},"98":{"step":[[98,99,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["小叶尼塞的注意力被转移了。她目睹小童那一切动作，却不明白其中的含义，只是注视，直到噼啪的爆炸声在身后响起。","","","","","","",""],"bg":"","choice":[]},"99":{"step":[[99,100,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014774","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这是——什么声音——？","","","","","","",""],"bg":"","choice":[]},"100":{"step":[[100,101,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["然而几乎身边所有人都对这动静见怪不怪，以至于此时与两人一同回过头去的，只有先前在闹市中力挽狂澜的曲娘。","","","","","","",""],"bg":"","choice":[]},"101":{"step":[[101,102,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她回头时，一种突然记起早前遗忘之事的懊恼神色，也逐渐浮现在她脸上。","","","","","","",""],"bg":"","choice":[]},"102":{"step":[[102,103,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610013993","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["庭燎爆竿……糟了。天哪，我差点忘了正事！","","","","","","",""],"bg":"","choice":[]},"103":{"step":[[103,104,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308315.png","audio":"610013994","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["抱歉、抱歉！请让开一下，我得出去——","","","","","","",""],"bg":"","choice":[]},"104":{"step":[[104,105,""]],"type":1,"name":["城中居民Ⅱ","","","","","","",""],"head_icon":"622920.png","audio":"610015437","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这就不继续听啦？时辰还早着呢，急着回去酿酒吗？","","","","","","",""],"bg":"","choice":[]},"105":{"step":[[105,106,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610013995","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不是酿酒，但也还有事呢……明天，明天一定请你们喝酒！","","","","","","",""],"bg":"","choice":[]},"106":{"step":[[106,107,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["人们低声调笑着，为曲娘让开一条小道来。小叶尼塞也牵住别斯米尔，以防跟过去时，她落在了身后。","","","","","","",""],"bg":"","choice":[]},"107":{"step":[[107,110,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她们这回很轻易地跟上去了。无人对发色醒目的异乡人投以别样注视，所有人的注意力都集中在这位讲述传奇的“歌唱家”身上。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"108":{"step":[[108,109,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_na