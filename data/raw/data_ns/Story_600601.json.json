{"1":{"step":[[1,3,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"3":{"step":[[3,5,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_xueshan.jpg","choice":[]},"5":{"step":[[5,6,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["白色的冰雪覆盖着远处的山峰，伴随着气候的回暖，岩石嶙峋的线条也得以彰显。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_xueshan.jpg","choice":[]},"6":{"step":[[6,7,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["但此刻的气候依旧远远称不上怡人——实际上，早春糟糕的温度反倒会让雨后的草地变得更加泥泞难行。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"7":{"step":[[7,8,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["但相较于人们会面临的其他困境，糟糕的天气已经是其中最为温和无害的一项了。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"8":{"step":[[8,9,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208582","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["所以，我们接下来还会遇到什么？","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208586","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["来自山峦另一侧的焚风、难缠的魔精、不知死活的神秘学家难民，又或是来自佩希塔的邪恶把戏？","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"10":{"step":[[10,11,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["埃米尔将自己的靴子从草地拔出，报复般的用登山杖砸了砸一旁的岩石，大声的抱怨道。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208610","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["见鬼，我受够了这座该死的山脉！塞梅尔维斯队长，我们当时就不应该离开维也纳的！","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"12":{"step":[[12,13,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["山地的情况与维也纳所要面对的情况并不相似，但难缠程度有过之而无不及。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不要敲击岩石，埃米尔。别忘了我们还处在塔泽尔虫【tatzelwurm】的领地之中。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不过，如果你想被它往你的脑袋上喷上一口臭气，我也不会阻止你。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“我们勇敢的埃米尔，他为神秘学生物研究做出了杰出的贡献——他用脑袋验证了塔泽尔虫牙齿与臭气的威力。”","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"16":{"step":[[16,68,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["被称做塞梅尔维斯的少女的劝阻显然起到了作用。埃米尔警惕的缩了缩脑袋，小心翼翼的环顾了一圈四周。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["在确认并没有一只散发着臭气的巨型怪物从地底出现后，埃米尔明显的松了一口气。他快走几步，来到了塞梅尔维斯的身边。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"18":{"step":[[18,19,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["被埃米尔滑稽神态逗乐，周围的四名队员也发出了一阵善意的笑声。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["包括埃米尔在内，这是一支由六人组成的小型队伍，位于队伍中央的塞梅尔维斯则是这支队伍的领导者。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["别担心，刚刚的只是一个玩笑话，我们不会就这么看着你被怪物袭击的。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208574","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["多谢提醒，队长。我可不愿意变成一封殉职报告被送到贝尔格莱德分部。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208580","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["尽管有不少人是为了委外合约人才管理组织丰厚的抚恤金而来，但我显然不在此列。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["经过刚刚的小插曲，埃米尔连说话的声音都刻意的压低了。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208616","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不过说真的，队长，我们到底还要在这座该死的山里待多久？","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["很遗憾，直到我们找到那伙重塑追随者之前，我们都必须与冰冷的睡袋为伍了。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208632","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["唉……啊，真是要命了。说真的，我们有必要如此紧追不舍吗？","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208620","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这不过就是一伙重塑之手的走狗而已——他们甚至连真正的重塑之手都算不上！","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208636","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["追踪他们的时间，足够我们处理三个任务了。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这次任务来自于委外合约人才组织的高层，我们没有拒绝的权力。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而且，尽管对方只是数量众多的分支教派中的一支，但比起一般的重塑门徒，这些狂热的追随者有些时候更为棘手。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他们往往熟知当前社会的规则，能够利用各种途径给我们制造麻烦，掩盖自己的行踪。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208588","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["好吧，也不知道这帮家伙到底有什么了不起的地方，值得高层下达这样的命令。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208578","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但要我说，总部如果真想要找到这些重塑信徒，还不如好好查查那些神秘学家难民。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["嗯，我们先前所处理的暴动、谋杀案件，也确实证明了这一点。重塑之手极大可能在煽动这些难民。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他们大多来自巴尔干半岛，都是遭受了政治斗争与对神秘学家的种族迫害才来到奥匈帝国。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["塞梅尔维斯","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["因此，“神秘学家至上”的理念自然会在这些可怜人中得到广泛的认可。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_caoyuan_dong.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1