",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523811.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我在你身上看见了一件我曾纺织过的旧毛衣，一个辉煌的幻影。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"32":{"step":[[32,33,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["时至今日，我终于完全地理解了自己——我的写作是为了追随一个伟大的年代，是为了重现一场伟大的冒险。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523814.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我幻想着那份遥远的震动能够通过你的文字，再一次铭刻在我的心脏上。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"34":{"step":[[34,35,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["我的写作是为了追随自己的私心。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523814.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这份不切实际的幻想，亦是我的私心。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"36":{"step":[[36,37,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["我想象自己如同一个诗人那样地，浪漫地，无望地活着——叛逆，不顾名利，罔顾一切。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523814.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你应该想象自己像一个纯粹的诗人那样，幸福地活着。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"38":{"step":[[38,3