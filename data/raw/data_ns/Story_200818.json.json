维拉故作苦恼地摇了摇头，童稚的疑惑在此前的无数时刻缠住了她的眉间与臂膀。","","","","","","",""],"bg":"story_bg/1_8/1_8_bg_tonghuaguangchang2.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["北方哨歌","","Windsong","","","","",""],"head_icon":"307701.png","audio":"610019742","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但理线学，归根结底只是个仍然停留在理论上的学派。","","","","","","",""],"bg":"story_bg/1_8/1_8_bg_tonghuaguangchang2.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["北方哨歌","","Windsong","","","","",""],"head_icon":"307701.png","audio":"610019743","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这个学派太小，野心却太大。迄今几十年来，它都只是一小撮人的自娱自乐，并且越来越少，直到现在……","","","","","","",""],"bg":"story_bg/1_8/1_8_bg_tonghuaguangchang2.jpg","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["对方若有所思地点了点头。","","","","","","",""],"bg":"story_bg/1_8/1_8_bg_tonghuaguangchang2.jpg","choice":[]},"39":{"step":[[39,40,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["氛围图7-维拉挽起自己的袖子，露出手腕上显眼的大片鱼鳞+稍微凸起的鱼鳍","","","","","","",""],"bg":"story_atcg/1_8/1_8_at_weilawanxiu.jpg","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["北方哨歌","","Windsong","","","","",""],"head_icon":"307701.png","audio":"610019744","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["——！","","","","","","",""],"bg":"story_atcg/1_8/1_8_at_weilawanxiu.jpg","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["维拉","","Вила","","","","",""],"head_icon":"308701.png","audio":"610018964","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……身为鲁萨尔卡的过往。","","","","","","",""],"bg":"story_atcg/1_8/1_8_at_weilawanxiu.jpg","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["北方哨歌","","Windsong","","","","",""],"head_icon":"30