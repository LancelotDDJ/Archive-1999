{"name":"雷米特杯失窃案","name_En":"The Rimet Cup","ids":[11101,11201,11301,11401],"chapterIndex":"TRC","actId":11104,"type":111,"chapter_map_element":[{"id":11101011,"mapId":1110101,"pos":"33.50#-20.80#-1","offsetPos":"0.63#2.33","res":"scenes/m_s14_hddt_hd01/prefab/hddt_front_baozhi_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.9","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_006.prefab","condition":"EpisodeFinish=1110101","showCamera":0,"showArrow":0,"type":1,"param":"","paramCn":"","paramLang":"","title":"读者来信","desc":"无人问津的路边报纸上，被雨水沾湿的第一部分，似乎是读者互动专栏。","flagText":"","acceptText":"阅读","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":1001,"retroReward":""},{"id":11101031,"mapId":1110103,"pos":"37.30#-16.00#-1","offsetPos":"0.63#2.33","res":"scenes/m_s14_hddt_hd01/prefab/hddt_front_baozhi_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.9","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_006.prefab","condition":"EpisodeFinish=1110103","showCamera":0,"showArrow":0,"type":1,"param":"","paramCn":"","paramLang":"","title":"“寻人启事”","desc":"报纸上常见的“寻人启事”板块，位于第二版的广告预留位。这次的内容似乎不太一样。","flagText":"","acceptText":"阅读","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":1002,"retroReward":""},{"id":11101041,"mapId":1110104,"pos":"87.90#-18.70#-1","offsetPos":"0.63#2.33","res":"scenes/m_s14_hddt_hd01/prefab/hddt_front_baozhi_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.9","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_006.prefab","condition":"EpisodeFinish=1110104","showCamera":0,"showArrow":0,"type":1,"param":"","paramCn":"","paramLang":"","title":"“开胃酒”","desc":"摇滚海盗当然也出现在辛辣的社会时评菜单上。请别摇晃，以便享用纯粹中立的风味。","flagText":"","acceptText":"阅读","finishText":"“褒贬不一”是某种收敛的佐料。","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":1003,"retroReward":""},{"id":11101042,"mapId":1110104,"pos":"74.10#-19.20#-1","offsetPos":"0