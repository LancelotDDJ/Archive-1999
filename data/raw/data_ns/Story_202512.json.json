name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["向老板娘道过谢后，梁月返回座位，波蒂埃立刻投去疑问的眼神。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501011","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["怎么样？","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501601","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["有两个坏消息。受害者的数目比我们之前认为的还要多，并且……<br>我们并不是唯一察觉到这一事件的人。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501602","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["如果想要在引起恐慌和不必要的骚动前解决事件，我们就需要抓紧了。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501012","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那个菲林士多导演不能成为突破口吗？","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["解决掉了眼前一圈的餐点，波蒂埃将摆在桌边的叉烧包拉到了自己的面前。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501013","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没想到原本只是我们用来作为进入唐人街的借口的事件，居然和我们在调查的事有关系。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501014","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你也说了，发生在那个菲林士多导演过去的事件和现在发生在唐人街的事非常相似，这未免有些过于巧合了。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501015","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那个编剧何日君也是神秘学家。在被烈火焚身的弥留之际，她的怨恨被自己的作品吸收……这样的案件在神秘学犯罪科中并不罕见。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501016","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那种含有诅咒的物件往往邪乎的很，搞不好就是追着菲林士多来了唐人街，其他受害者都只是被殃及池鱼而已。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["梁月","","Liang","","","","",""],"head_icon":"","audio":"612501603","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["“菲林士多导演与何日君之死有关”只是一个传闻而已，并没有任何证据能够证明何日君临死时对菲林士多怀有怨恨。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501017","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但就连你们夜巡特遣管理局都把这件事写进了情报里，不就说明了这件事并不全是空穴来风吗？","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501018","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在那个看了胶片之后精神失常，最终跑到建设中的高楼一跃而下的家伙摔成一块肉饼的同一晚，菲林士多遭遇车祸，双腿残疾……","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501019","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这两件事发生的时间只相隔不到五分钟，发生的地点只相距一条街。<br>难道你要说这是巧合？","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["波蒂埃","","","","","","",""],"head_icon":"","audio":"612501020","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我告诉你，做神秘学警察最忌讳的一个词，就是“巧合”。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["","","