,"23":{"step":[[23,24,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我想要的不是一枚奖章，或者刻在纪功廊上的名字，将军。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["以前是，但现在不是了。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"613302363","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你想要什么，士兵？","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我想，我只是……","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["迎面吹来一丝风，轻得像是夜莺翅膀底下扇出来的。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我只是想回草原了。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一阵阵风从草原深处吹来，将干枯的艾草和百里香的气味送到士兵鼻子底下。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我开始不觉得，一场一场仗打下来，我的心冻得跟顿河上的冰一样硬了。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["什么东西砸下去也不会溅起水花。恐惧、愤怒、悲伤，我什么也感觉不到。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["一直以来，我所期待的只有纪功廊上的那个名字，我想那才是我真正可以安睡的地方。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["直到来到这里，我才发现，原来的日子我一天也忍受不下去了。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["伊戈尔看着紫丁香的夜雾被风一点点吹散，露出远处的白桦树林。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"613302364","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这里是我们所有人的童年。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但童年已经过去了，孩子，这是个马上就会毁灭的时代。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_01.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"613302365","