:true,"text":["噢，请见谅——在当时，部分，或者说大部分的神秘学家，都被定义为一种疯癫的存在。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311410.png","audio":"612600357","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["毕竟没有人在意“疯癫”的本质是什么，不是么？但人们总会意识到，神秘学血统并不是一种疾病，于是在1947年，疗养院就被废弃了。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311410.png","audio":"612600358","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["二十世纪七十年代，被弃置的科马拉疗养院迎来了一次真正的改头换面：一群国家福柯学会的人引进了来自欧洲的先进概念。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612600359","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["没人知晓那些复杂的理论代表着什么含义，总之，他们将疗养院更名，并在旧址上哐哐当当地改造了数个月。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311411.png","audio":"612600360","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["漫长的改造结束了，科马拉疗养院成为了一座真正关押神秘学家罪犯的监狱——","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311415.png","audio":"612600361","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["他们在这儿囚禁那些被诊断为精神分裂的嫌犯，那些在各种秘密集会、反对组织中被抓捕的神秘学家。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311415.png","audio":"612600362","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["协会宣称会给他们最好的治疗，直到他们能痊愈，能回到日常生活里去。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311410.png","audio":"612600363","bool_1":false,"show_name":true,"sho