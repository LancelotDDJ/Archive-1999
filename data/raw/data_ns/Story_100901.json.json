_name":true,"show_name_en":true,"no_l2d":false,"text":["噢，那当然是因为我们还没还清这几天的马黛茶钱……","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["同行青年Ⅱ","","","","","","",""],"head_icon":"523601.png","audio":"612601540","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["听着，虚构集。成为一个诗人，环游拉丁美洲，在官方大诗人的集会上闹事，这一切确实如你所说的那样酷。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["同行青年Ⅱ","","","","","","",""],"head_icon":"523601.png","audio":"612601541","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但它只是没法一直持续下去。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_icon":"523501.png","audio":"612601517","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们都很喜欢你，也很喜欢你的小说。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_icon":"523501.png","audio":"612601518","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我不想否认这段旅程给我带来的一切。哈，像切·格瓦拉一样骑摩托车环游拉丁美洲？自成年之后我就没有过这样的幻想了。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["同行青年Ⅱ","","","","","","",""],"head_icon":"523601.png","audio":"612601542","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["是挺好的，除了像切·格瓦拉一样摩托车坏掉的那几天。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_icon":"523501.png","audio":"612601519","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["闭嘴，潘乔。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_icon":"523501.png","audio":"612601520","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["虚构集，你知道吗？自从你邀请我和潘乔加入本能现实主义派之后，有那么一些时刻，我们确实感觉自己成为了一名真正的诗人。","","","","","","",""],"b