:1,"name":["哑谜","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["先等会儿，狐狸，你最好说清楚，我们到底要找什么？一个棋子，一枚零件？","","","","","","",""],"bg":"","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["缪斯三世","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["喔……这正是难点所在。我很难给你描述它的样子。","","","","","","",""],"bg":"","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["缪斯三世","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["根据我检查的结果来看，箱内的认知系统已经紊乱，也就是说，它或许没有能被稳定识别的形态……","","","","","","",""],"bg":"","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["缪斯三世","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但别沮丧，您瞧，就像被污染的语言仍发挥语言功能，这枚核心也必然还保留着它维持认知的特性，也许您会发现，它的形态变化有其规律……","","","","","","",""],"bg":"","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["尽管缪斯三世以轻缓的口吻和委婉的语调，发挥了它作为一位商人与一只毛绒玩偶所能发挥的全部安抚能力，乌尔里希和哑谜的脸色此刻仍然不太好看。","","","","","","",""],"bg":"","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["哑谜","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["所以我们要在几乎毫无情报的情况下，找一个会变形的“普罗透斯”。","","","","","","",""],"bg":"","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["缪斯三世","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["事实确实如此，亲爱的朋友……很遗憾我没有海豹皮给你们。另外——如果拉普拉斯的语言已经成了这个样子，玩具箱里棋子们的状况恐怕只会更糟。","","","","","","",""],"bg":"","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["缪斯三世","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text