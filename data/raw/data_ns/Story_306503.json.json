],"head_icon":"515401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“纪实文学的全新尝试，独树一帜的写作风格，身临其境的阅读体验……”","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["年轻的幽灵显然记起了更多的事，他愤愤不平地念叨着。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["马歇尔","","","","","","",""],"head_icon":"515401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这可都是他们自己说的，怎么才过去这么一会，我们的马库斯就不再是那个代表着新思潮的进步榜样啦？！","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"610017982","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["马……马歇尔先生，请不要再说下去了……","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"610017974","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这些话都过于夸张了，和我的真实能力远远不符。更何况，我如今还收到了这样一封退稿信……","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯双颊通红，她的脑袋埋得更低了。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["突然，她像是想起了什么，纷繁的信息一并涌入了脑海。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"610017975","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["天啊——我刚刚还大言不惭地向那位基金会的先生夸耀自己的作品……","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""