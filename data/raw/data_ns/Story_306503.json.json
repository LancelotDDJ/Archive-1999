{"1":{"step":[[1,2,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["拆出的信纸在一双不住颤抖的手上轻轻地摇晃着。","","","","","","",""],"bg":"","choice":[]},"2":{"step":[[2,3,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“我们很遗憾地通知您，马库斯女士……”","","","","","","",""],"bg":"","choice":[]},"3":{"step":[[3,4,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“经过编辑审议会的讨论，我们暂时不能发表您的《弗兰南群岛史》第十五节。”","","","","","","",""],"bg":"","choice":[]},"4":{"step":[[4,5,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“原因如下……”","","","","","","",""],"bg":"","choice":[]},"5":{"step":[[5,6,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“您的《弗兰南群岛史》一经发表，便收获了许多读者的热切讨论。”","","","","","","",""],"bg":"","choice":[]},"6":{"step":[[6,7,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“我们深知读者们对于这座神秘小岛的好奇，也清楚地相信您对于纪实作品的写作能力。”","","","","","","",""],"bg":"","choice":[]},"7":{"step":[[7,8,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“正因如此，我们希望您能修改《弗兰南群岛史》的新一节内容。相比现有的内容，我们希望您能揭露真相——关于三位守塔员更详细的信息。”","","","","","","",""],"bg":"","choice":[]},"8":{"step":[[8,9,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“请别误会，马库斯女士。我们并非对您现有的记录有所怀疑，但我们的读者对于神秘学的了解尚且不足，他们非常关心守塔员们的过往，关心真相。”","","","","","","",""],"bg":"","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“他们坚信，您一定能揭开困扰我们十余年的谜团，为这个耸人听闻的传说画上一个圆满的句号。”","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“针对当前的情况，我们已为您的《弗兰南群岛史》提前预留了一部分宣传版面。”","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306519.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“——盼望着您新内容的，丹尼希”。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,137,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["这张信纸终于飘飘然落在了地上。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["遭受挫败的女孩低下了头，一阵酸楚涌了上来。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"610017991#1|1|1|1|1|1|1|1","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["丹尼希女士似乎并不满意现在的故事……可是，这些故事不正是读者所期望的真实么？","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那些排列古怪的礁石，灯塔怪象的成因……他们一点儿也不好奇么？","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"hea