":[[33,107,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这是总部给我的命令。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"618213.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["一个月前来过命令，要求把公路两边的山都清理干净，一棵树都不留，但始终没人负责这事。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"618213.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们离开了荒野，沿着小径深入山林，每个人都提起了十二分精神。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"618213.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["队伍里很少再有闲聊，而林子里的鸟鸣让我以为自己又回到了敖德萨的夏天。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["贝托尔特","","","","","","",""],"head_icon":"618213.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["红弩箭带来的设备为我们指引方向，但在那儿，“方向”和“道路”是两回事。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["阿历克塞","","","","","","",""],"head_icon":"","audio":"7208566","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我家乡很少能看到这么多树，小同志。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["阿历克塞","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我来自来亚什基，你知道那里吗？一个很远也很冷的小镇，和芝诺有合作。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["阿历克塞","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可能是因为这层关系，当时选拔去芝诺军备学院进修的新兵时，芝诺才挑中了我。","","","","",""