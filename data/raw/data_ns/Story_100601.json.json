"step":[[73,74,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["唐突响起的质问取代了电流的滋鸣，观众们纷纷回头，望向后排站起的娇小女性。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"308001.png","audio":"610016079","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["请允许我向您——向综合医学协会提出质疑。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["伊索尔德","","Isolde","","","","",""],"head_icon":"308111.png","audio":"610016639","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["呼……呼……","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"308001.png","audio":"610016080","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["您所展现的电击疗法严重缺乏人道主义的光辉。在我看来，这样的疗法除了徒增病人的痛苦，毫无实质性的帮助。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"308001.png","audio":"610016081","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果您的目的就是增加病人肉体上的痛苦来转移精神上的痛苦——那请当我没有说。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["伊索尔德","","Isolde","","","","",""],"head_icon":"308111.png","audio":"610016640","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["……？","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["绿色的身影纤巧，如同一把匕首破开了混沌的视野。","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017454","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["尽管诊疗会的意义就是交流。但您——真是唐突。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017455","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["电击疗法早已不同于上个世纪。在人类驯服电力的如今，电疗毫无疑问是最先进的技术——您不能只看表象。这其中的原理是与简单的蛙腿运动有所不同的！","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017456","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我的治疗方案有着充足的理论与文献作为支持，并拿到了医学协会的批准与赞助——合理，而又合法。","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017457","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但是您，噢，我想我没认错，那位以兜售神秘学小花招闻名的“社会活动家”——卡卡尼亚，或者，克拉拉小姐。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017458","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["就我所知，您并没有拿到医学院的毕业证书，您那些名为“分离”的艺术运动也让人倍感精神上的迷惑。","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,87,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017459","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["姑且不谈及其他。出于专业交流考虑，我建议咱们的交谈最好留到之后——比如，您拿到行医执照的时候！","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["人群的私语、细碎的嘲笑声响作一团。","","","","","","",""],"bg":"","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016082","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不，施瓦茨医生。这与我个人的出身与经历无关，我只是作为一个有同理心的维也纳市民，一个最基本的“人”——在质问您！","","","","","","",""],"bg":"","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016083","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["您何以如此无视她的痛苦？是您至高无上的医学权威蒙蔽了您的感官，还是您也罹患歇斯底里症，致使双目失明、双耳失聪了吗？","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,92,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017461","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……！","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017462","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如此无礼！","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_gongkaizhenliaoting.jpg","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017463","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["请容我再强调一次——电击疗法先进而可靠。而且，迪塔斯多夫小姐已经签署了协议。诊疗是在我们双方的同意下进行的。","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[94,95,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017464","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["您的反对不仅毫无效用，还严重影响了治疗进程。","","","","","","",""],"bg":"","choice":[]},"95":{"step":[[95,96,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017465","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但我们一向欢迎交流。既然您反对——那不妨畅言！您又秉持着什么样的高见呢？","","","","","","",""],"bg":"","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016085","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["据我所知，西格蒙德·弗洛伊德先生早在1895年就发表了《歇斯底里症研究》。","","","","","","",""],"bg":"","choice":[]},"97":{"step":[[97,98,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016086","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他认为，歇斯底里症是由神经系统紊乱所引起的心理障碍，而非纯粹的器质性疾病。","","","","","","",""],"bg":"","choice":[]},"98":{"step":[[98,99,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016087","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他的癔症创伤理论曾解释过：患者的生活与个人经历对他们有着潜移默化的影响——这正是症结所在。","","","","","","",""],"bg":"","choice":[]},"99":{"step":[[99,100,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016088","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——分析这些创伤远比用“科学”去损害人的躯体更为有效。","","","","","","",""],"bg":"","choice":[]},"100":{"step":[[100,101,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016089","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["至于先进，弗洛伊德先生在去年还发表了《图腾与禁忌》……","","","","","","",""],"bg":"","choice":[]},"101":{"step":[[101,102,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017466","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——什么？！","","","","","","",""],"bg":"","choice":[]},"102":{"step":[[102,103,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["绅士脸上的表情出现了裂痕。","","","","","","",""],"bg":"","choice":[]},"103":{"step":[[103,104,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017467","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["弗洛伊德——弗洛伊德！","","","","","","",""],"bg":"","choice":[]},"104":{"step":[[104,105,""]],"type":1,"name":["施瓦茨医生","","","","","","",""],"head_icon":"513601.png","audio":"610017468","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d"