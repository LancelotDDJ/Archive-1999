":true,"show_name_en":false,"no_l2d":false,"text":["想通？不，司辰，我恰恰没有想通。","","","","","","",""],"bg":"","choice":[]},"105":{"step":[[105,106,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301677","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果我“想通”了，我就不会追着佳琳娜夫人，希望在她身上寻找我母亲的蛛丝马迹。","","","","","","",""],"bg":"","choice":[]},"106":{"step":[[106,107,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301678","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可我真的找到了——","","","","","","",""],"bg":"","choice":[]},"107":{"step":[[107,108,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301679","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["五官、皱纹、身形……或者说她所有外在的一切，都与我在第一次“暴雨”中失去的母亲如出一辙。甚至同我说话时，嘴角的弧度都与以往一模一样。","","","","","","",""],"bg":"","choice":[]},"108":{"step":[[108,109,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["军长深呼吸了几下，好让自己的牙根不再颤抖。","","","","","","",""],"bg":"","choice":[]},"109":{"step":[[109,110,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301680","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["回想你曾经失去的那些人，当他们现在就出现在你眼前，一切都是那么熟悉……只不过换了一身新的衣服，失去了一些记忆。","","","","","","",""],"bg":"","choice":[]},"110":{"step":[[110,111,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301681","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你真的不会希望重新回到他们身边吗？你会如此残酷地把那些人从“暴雨”中消失这件事视作死亡吗？","","","","","","",""],"bg":"","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"613300588","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["……我不确定。","","","","","","",""],"bg":"","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"613300589","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["我现在还没遇到过这样的事，也许我要经历过之后才知道该如何回答你。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,153,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["军长不再追问，他转向眼前在风中低俯的草甸——一片在繁茂中枯萎的金黄色，永无止境地绵延到大陆的尽头。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301682","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在这样的草原上，父亲将十岁不到的我抱上一匹栗色的牝马，教我如何控制缰绳。","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301683","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["母亲就站在不远处，满脸忧虑，生怕我从马上坠下，但她也知道，这是每一个孩子的必经之路。","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301684","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["几个世纪以来，哥萨克都过着这样的生活，在草原中成长，也狂妄地与它交战，如同最叛逆的孩童。","","","","","","",""],"bg":"","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301685","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["草原从未变过，在这里生活的人也一样。有时我确实会恍惚——这真的是一个虚假的1920年吗？","","","","","","",""],"bg":"","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["军长伊万","","","","","","",""],"head_icon":"","audio":"613301686","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["司辰，你是一个游走在很多个时代的人。我们之间有区别，不能互相理解。","","","","","","",""],"bg":"","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"61