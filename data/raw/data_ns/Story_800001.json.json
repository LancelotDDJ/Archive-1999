,"9":{"step":[[9,10,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["星锑","","Regulus","","","","",""],"head_icon":"302512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["啊——哈！咱们终于拥有了一个酷毙了的纪念日！不然本海盗正打算当场发明一个——就叫它“电台复活节”！","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["星锑","","Regulus","","","","",""],"head_icon":"302511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["说实话，我一直觉得你的箱子里缺点儿真正有品位的东西。而现在，瞧瞧它——这台银色大耳朵音响——我非得在里头录下整套强尼·卡什的摇滚乐不可！","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["APPLe","","","","","","",""],"head_icon":"302801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这趟漫长的旅程不免让船长与各位朋友们稍感疲劳。依APPLe某之见，为了延续思维的保质期，我们需要一些闲暇时光来整理头绪。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["APPLe","","","","","","",""],"head_icon":"500901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我衷心期望这份慷慨的礼物不会录下APPLe某的酒后失言。那些“胡扯”……嗯……那些无根据的猜测与不合时宜的谈吐，它们本应与夜色一同消逝。","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300411.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["喂……维尔汀？嗯……这玩意儿可比芝诺那老掉牙的“抗、干、扰”通讯清晰多了——就是携带起来不太方便。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["备点儿我最爱的“生命之水”，再给自己和其他孩子们准备些果汁儿——你知道的，比起废话连篇的问候，我更擅长用力碰杯。","","","","","","",""],"bg":"","choice":[]},"18":{"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"info":{"title":"【1.9】磁场留声机【收藏品】","start":1}}