{"1":{"step":[[1,2,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"2":{"step":[[2,3,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"3":{"step":[[3,4,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["塞梅尔维斯的早晨十分简单：起床，或不起床。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"4":{"step":[[4,5,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["如果起床，那她就会立刻检视她脑海里所浮现的第一件事：思索今天的“苏醒”是哪一种。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"5":{"step":[[5,6,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["基本上她的苏醒有三种。第一种是迅速进入工作状态的苏醒，长久以来这是最好的一种，醒来后她可以立刻开始执行任务。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"6":{"step":[[6,7,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["有时睡眠和梦境会对她看待任务的方式产生影响，她会细细思索它们对她揭露了什么，并以新的视角来检视任务列表。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"7":{"step":[[7,8,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["幸运的话，她也许能够捕捉到一点新的眉目，就像终于听完了《月之暗面》。这并不是因为月球在移动，而是因为她按下了播放键。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"8":{"step":[[8,9,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["第二种是焦虑的苏醒。这种焦虑不是因为外在有什么危险或威胁，而是单纯因为醒来而感到恍惚，意识到自己还活着，并且再也感觉不到生命的倒计时。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["至于第三种……","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"10":{"step":[[10,11,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["睁眼特效","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"11":{"step":[[11,12,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["地标","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208561","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["队长，你终于醒了！你今天的睡眠时间已经超过14个小时了！","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["塞梅尔维斯从床上坐起来。前一晚在她梦中回荡的尖叫声逐渐远离，被映入眼前的画面吸收。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["埃米尔腾出空闲的右手看了一眼手表。他左手臂弯中的褐色纸袋里装有从便利店里买来的全麦面包、半只烤鸡和六瓶装的威杰兹牌矿泉水。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["袋子里的六瓶矿泉水随着他的动作互相敲击，发出欢快的声响。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023122","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你看起来像是要在这里办派对……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208652","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["很接近。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……而且还是不请自来的。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208580","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你当然可以请我出门，但我可没那么容易打发。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208582","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我来拉普拉斯一趟可不容易，所以我想尽可能多带些补给品给你。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208583","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你看上去恢复得相当不错，队长，而且并没有被归类到“令人不安”的病患类别中，你应该已经成功度过转化后的排异期了？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023124","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["才刚刚开始。这段时期我每天的大部分时间都是在头痛和做梦，醒过来也只能盯着这里的天花板，因为“鱼缸脸”不准我晒太阳。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208549","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“鱼缸脸”？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023167","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["她是负责我健康检查的接待员。每次我都忍住了没有问她经常佩戴那个头盔会不会让脖子像排烟管一样僵硬。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208581","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["队长，你知道吗？最佳的生存策略就是依循医生的嘱托，因为再怎么说他们是赢家、是幸存者。你要配合检查，遵从医嘱，健康饮食才行。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023114","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我当然知道。我几乎要感谢在这里的日子了，这让我更加懂得欣赏平凡的事物，譬如一瓶矿泉水。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["塞梅尔维斯从埃米尔手中接过矿泉水。咕嘟咕嘟的吞咽声让在一旁拆烤鸡的埃米尔不禁抬起眉毛瞥向她所坐的位置。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你对我现在的形象有什么意见吗？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208605","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，不。当然没有。但现在的队长看起来……要怎么说？我感觉我只是在一张血食怪的面孔上看到一点过去的队长的痕迹而已。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208588","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["就比如说……我有好一阵子没看见队长你笑了。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我应该也没那么常笑吧？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208605","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不不不，这是有区别的。想象一下，一个你曾经很熟悉的人有一天突然假扮成了一个截然不同的人，这当然会使你感到奇怪了！","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023133","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["或许有一种可能，我的笑只是你想象出来的而已。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["埃米尔面带微笑，摇了摇头。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208630","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那场“暴雨”之后，我被调职到后勤部做专车司机了。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["司机？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208585","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我知道，让我继续留在基金会倒不一定是因为他们觉得我的工作做得多好。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我听说一位“资深”调查员，在一次任务中甚至忘记了调整答询器的频段……这根本就是白占名额嘛！","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208652","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["好吧，也许我在自我吹嘘，但我应该继续干老本行才对，在队长领导的小组调查案子……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023132","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我以为你不喜欢会流太多汗的工作。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208659","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可是那个我很在行啊，开车就……对了，专车司机的考核就在下周，我现在每天都在死记硬背地名和路线。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208578","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["唉……也许正是因为我的愚笨，我才得以在经历“暴雨”之后再次被基金会接纳，得以回归，玩我非常擅长的游戏。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023107","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["比如绕过探视规定，偷偷溜进某位重点监视对象的病房？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208560","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["也不是偷偷！我不过是事先跟经常坐我车子的拉普拉斯员工打了招呼……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208630","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["更何况，基金会怎么会留意一个后勤司机的动向呢，毕竟我的工作就是给员工开车，顶多就是会有一些稍微不合常规的“合作”。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208580","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["虽然我不是完全照规矩来，但不也依旧做出了一些成果吗？尤其是安全驾驶这一项……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023167","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……如果你真的还像现在这么蠢，那今后怎么样都是你活该，埃米尔。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208652","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["谢谢队长，我会注意的。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208584","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不管怎么说，过去的那段时期我在队长手下受益良多，事到如今我依然会做好分内的工作，特别是涉及队长健康这一点。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208582","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["所以现在，队长，你该去做检查了——遵从医嘱，健康饮食！","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我绝对拒绝健康食品，这严重违背我的饮食信仰。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjian.jpg","choice":[]},"52":{"step":[[52,53,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["渐入","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"53":{"step":[[53,54,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["黑屏","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"54":{"step":[[54,55,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["场景-拉普拉斯-康复中心走廊","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"55":{"step":[[55,56,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["地标","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["和往常一样，塞梅尔维斯准时前往康复中心的检查室报道。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["“鱼缸脸”一边说话一边擦头罩，仿佛害怕塞梅尔维斯会批评她的说话方式。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她话语中间的停顿太过频繁，害得塞梅尔维斯总是怀疑她如此讲话是不是因为塞住她喉咙的弹簧瓶盖总是不受控制地弹来弹去。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208717","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你昨晚，睡得好吗？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023131","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不是很好。我的脑子里一直出现各种尖叫声，有时候还会做把人杀死的噩梦。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023140","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不过目前那只野兽还乖乖待在床底下。我本来以为会更辛苦的。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208744","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["才刚开始而已，你之后的日子，会更辛苦。每一个新的发作期，都是在旧发作期结束的时候开始的。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208693","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["如果你能，按时服用血液营养补剂的话……虽然它们的作用，完全不能取代人血，但……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那些补剂的味道都太寡淡了，一点血味都没有。当然我这么说可不是因为偏食和挑剔，我只是想尽可能替自己的胃着想。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208671","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你从转化完成开始就在……禁食血液，迄今为止已经四十八天了……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["日子不就是由辛苦和不幸构成的吗？我什么时候能够离开这里？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208749","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["司辰……已经签署了你的出院许可。很快，就会有人来联系你。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208694","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但你的畏光情况，愈发严重了。出院之后，必须做好应对措施。最好彻底断绝，接触阳光的可能性。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208719","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["烧伤的问题……不能再出现，还记得我叮嘱你的……注意事项吗？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["塞梅尔维斯抬起手将浓密的长发拨到脖颈旁，盖住上面的伤痕。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["嗯哼，当然。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208711","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["还有……把我给你的美沙酮注射液带去。这样如果你想继续……禁血，日子会好过一点。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208754","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["最好的状况是，它可以让你止渴一阵子；而最坏的状况是，它可能会刺激那只野兽越来越想取得力量和控制权。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["就没有一种方法可以把渴血症状彻底消除吗？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208764","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["噢！又来了！这种话我总是能从病患口中听到……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你们就是无法应付疑惑，都喜欢听到自己的情况是“确定的”，比如说诊断是确切的、病症是可治愈的……","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208744","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们不给出明确答复，有时并不意味着病因太过复杂，或者我们的专业有其局限。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["当然，我们也有可能永远都无法确定是否能找到，颠覆血食怪物种习性的方法。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208694","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但我们依旧在努力，在已有生物血库中，寻找血液中能够协助修复的物质。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208693","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["如果你的血液，能够拥有自我修复的功能，你就可以在理论上实现，不需要吸食人血也能维持最基础的生存质量的状态。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["“鱼缸脸”","","","","","","",""],"head_icon":"506601.png","audio":"7208692","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["人类历史上很多伟大的发现，一开始都是误打误撞得来的。说不定到后面，你会发现能够解决你疑问的，可能只是一颗糖果。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"610023152","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这倒是没错。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxin.jpg","choice":[]},"83":{"step":[[83,84,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["渐入","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"84":{"step":[[84,85,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["黑屏","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"85":{"step":[[85,86,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["场景-拉普拉斯-康复中心房间","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"86":{"step":[[86,87,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["少了来访者的身影和声音，病房里显得安静又明亮。塞梅尔维斯想起自己刚来到这里休养的时候，还以为误进了一间镜子迷宫。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["当然，如今的她已经无法从这些“镜子”中看到自己的倒影，但它们依旧让她心中暗暗生出警惕。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她总是能感觉到自己一举一动投射在墙壁、地板和天花板上。她避免直视它们，甚至还养成了洗手强迫症。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她不清楚这其中的原理是什么，但那种感觉就像挥之不去的细菌不断地啃噬着她的身体，直至她最令人毛骨悚然的模样完全暴露在外。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["不久之前，渴血症状开始给她找麻烦，她的身体先是出现本能的渴望，接着就被一股冲动袭击。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["如今这股冲动迈入新境界，她觉得自己想要把见到的每一个人都撕成碎片。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["今天早上，她一醒来就感觉到体内的嗜血瘾在噬咬着她，埃米尔的出现更是令她心力交瘁。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她知道自己如果再不摄入鲜血的话，就会连一滴水分都无法保留在胃里。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"94":{"step":[[94,95,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["难道我好不容易从转化中逃过一劫，最后却还要面对再也见不到阳光的阴影，甚至还有可能活活渴死？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"95":{"step":[[95,96,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["天知道她为什么做了禁血的决定，可能她只是厌烦了时刻被审视的感觉。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她保持清醒的理由从来都不是原则性的，仅仅出于实用，好让她有足够的时间去面对自己的变化。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"97":{"step":[[97,98,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她也不想再讨论为什么她要禁血，她这个人说一就是一，说二就是二，绝不动摇，绝不妥协，也绝不搪塞。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"98":{"step":[[98,99,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["啧……没完没了，不是这样就是那样。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"99":{"step":[[99,100,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她将健康检查报告折叠装进口袋里，这时躺在里面的另一个东西发出振动，宛如飞鸟拼命扇动翅膀。她拿出通讯器。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"100":{"step":[[100,101,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我是塞梅尔维斯。","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"101":{"step":[[101,102,""]],"type":1,"name":["基金会女职员","","","","","","",""],"head_icon":"508601.png","audio":"7209036","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你好，塞梅尔维斯小姐。我想你应该已经接到了出院通知，对吧？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"102":{"step":[[102,103,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["没错。请问我什么时候可以正式开始工作？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"103":{"step":[[103,104,""]],"type":1,"name":["基金会女职员","","","","","","",""],"head_icon":"508601.png","audio":"7209021","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我正是为此事而来的。在向你说明情况之前，我想要确认一下，你的休假日期栏目是一片空白，对吧？","","","","","","",""],"bg":"story_bg/bg/kangfuzhongxinfangjianheiping.jpg","choice":[]},"104":{"step":[[104,105,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"105":{"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"info":{"title":"塞梅尔维斯角色故事01","start":1}}