},"75":{"step":[[75,76,""]],"type":1,"name":["阿琳","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那您住哪里呢？","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["只是从雇人打工变成给人打工嘛，又不是去流浪了。我还有这间办公室和这个沙发呢。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["菲林士多豪气地拍拍沙发，女助手震惊地看着自己的老板，分不清这是否又是她的一个玩笑。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["阿琳","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["然后呢？","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["把钱当做《花闹春喜日》的启动资金。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["阿琳","","","","","","",""],"head_icon":"","audio":"612402204","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……您是认真的吗？","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["菲林士多有些不舍地点了点头。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_