","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["但菲林士多并没有回应她，只是万分珍爱地看着那一排奖杯。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["在最左边的奖杯上贴着一张拍立得的照片，由于经常被窗帘缝中透漏过来的夕阳照射，照片的一角已经有些许褪色。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"63":{"step":[[63,64,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["浮窗道具-三人照片","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_xinyishusanjie.jpg","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["照片的最中央是菲林士多、何日君和奇星三人笑容满面地捧着一尊奖杯。","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_xinyishusanjie.jpg","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["在照片之外，菲林士多的眼中，剧组的众人正围簇在一起，每个人的脸上都是意气风发，那是C07系列电影拿下的第一个奖项。","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_xinyishusanjie.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"311114.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["那时可真是风光无两，再看看迷影谍，票房倒数，奖杯倒是捧回来三座。","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_xinyishusanjie.jpg","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"311111.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["叫好不叫座呀……呵……什么用都