158","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那你们是想……？","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017108","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["唔，是这样的……您自称卡卡尼亚，可是，我知道您的本名叫克拉拉……","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016159","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，没想到基金会也有我的读者——这真叫人快活！","","","","","","",""],"bg":"","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016160","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是的，我是克拉拉！但是政府小姐，您不觉得这个名字很风趣吗？海因里希——噢，他是我的一位朋友，他给了我一本书，使我受益匪浅。","","","","","","",""],"bg":"","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017109","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……！","","","","","","",""],"bg":"","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016161","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们所在的国家正如这个名字一样——既是又是，既有又有，无处可寻，又无处不在！","","","","","","",""],"bg":"","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016162","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["瞧瞧这片土地吧！","","","","","","",""],"bg":"","choice":[]},"60":{"step":[[60,127,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016163","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["鳞次栉比的金色方块，上面缀满了漂亮的卷草纹，摞得这样高、这样巧妙……","","","","","","",""],"bg":