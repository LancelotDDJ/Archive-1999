？","","","","","","",""],"bg":"","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016146","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那就说来话长了——","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016147","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，不用这样谨慎地盯着这位小姐。她救了我一命，人还算不错，算是半——三分之一个朋友吧！","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306513.png","audio":"610017098","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["三分之一……","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"12":{"step":[[12,13,""]],"type":6,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯在口袋里轻轻松开了通讯器的按钮。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306516.png","audio":"610017099","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["呜……这下糟了，通讯线路一直无法连接，根本联系不上霍夫曼女士。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306516.png","audio":"610017100","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["她或许在和委外合约小队的专员谈很重要的事，所以启用了屏障模式……","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306512.png","audio":"610017101","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["没问题的，马库斯，你一个人也没问题的，先和任务目标保持交流……！只是交流而已，这有什么难的呢？没问题的，你演练过……一定没问题的！","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她设想了一千种搭上话的可能，却没想到最后是这样的场合。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马库斯开始在脑中疯狂地搜寻话题。所幸，在场的人全都比她健谈得多。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017545","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["卡卡尼亚，你现在也变成和官老爷做朋友的人了！","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017546","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["真新奇！我在这待了一年，还从未见过嘴上没毛的基金会成员呢！","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017547","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你是从哪来的？克罗地亚？摩拉维亚？加里西亚？","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017102","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我在罗马尼亚长大……","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017548","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，我来自波斯尼亚和黑塞哥维那——反正咱们就是“同乡”了！","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016148","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你也要注意安全，伊里奇。要是遇到了卫兵可就麻烦了！你的许可证一定还没签发。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017103","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["咦？你们没有许可证吗？","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017549","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["嚯，我们当然没有了！听听它的条件，“三代以上的神秘术安全使用担保……”——我一出生就在卖货了，连妈妈的妈妈都没见过哩。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017550","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这都算了，担保历来是最好造假的。可现在你要是在维也纳申请许可证，就得经过中央政府签发。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017551","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不是奥地利政府，也不是匈牙利政府——是那个夹在它们中间的中央政府。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017552","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而这就是最难的一步，从没人能稳妥地理清这里的区别。哪里是皇帝的，哪里是国王的，哪里是皇帝-国王的……","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017553","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你要是照章办事，就会发现自己上了大当啦！回过神来，就会被未知的咒术困在这里，束手束脚，动弹不得。除非拿出点闪闪发光的克朗润滑一下……","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017104","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……如果没有神秘术许可证，会怎么办？","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017554","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，那就刺激了。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017555","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你可能被拘留三天，也可能被判刑十年。也可能你被判了十年，法院却忘了通知你。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017556","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["又或者你实在技艺高超，正适合通过一场先进的外科切除手术，来验证理性对神秘学的压倒性胜利……","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017557","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这里的制度可比神秘术随机多了，咱们的机会还是相当大的！","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016149","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可以了，伊里奇。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["卡卡尼亚清了清嗓子，仍有些戒备地使了个眼色。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,124,""]],"type":1,"name":["小贩Ⅰ","","","","","","",""],"head_icon":"512501.png","audio":"610017558","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["哦，好的，好的……再见了，卡卡尼亚和——政府的小姐，就当我什么都没说过！","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["马库斯","","Marcus","","","","",""],"head_icon":"306501.png","audio":"610017105","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["他们是……？","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016150","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["一些神秘学家孩子，我很惊讶您竟然不清楚这些。这个国家就是有这样的处境。维也纳可不是所有事物都像环城大道的建筑和绅士街【Herrengasse】那样辉煌。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她语气里带了一点点讥讽。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016151","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我很感谢您的帮助，政府小姐，不过目前我也同样帮助了您——被卫兵发现对你们来说也不是那么好摆平的，不是吗？咱们扯平了！","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016152","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["所以您来找我究竟是为了什么？","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016153","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，我知道了。是卡尔先生叫你们来找我要行医许可证的，可您好歹也休息两天吧！","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016154","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["以先祖的名义发誓，我做的是百分之百的神秘学营生，绝没有一丁点和科学以及医学沾边的成分！","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她提出了疑问，却并没给回答的空隙。卡卡尼亚凑近了马库斯，怀疑地推了推眼镜。","","","","","","",""],"bg":"