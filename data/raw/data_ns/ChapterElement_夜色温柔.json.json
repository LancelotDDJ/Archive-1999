nes/m_s08_hddt/prefab/hddt_front_mojing_a_001.prefab","resScale":0,"tipOffsetPos":"0.064#0.888","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_008.prefab","condition":"EpisodeFinish=10204","showCamera":0,"showArrow":1,"type":12,"param":"4,3_4_4_4,3,1,5_2_5_3,3,2,2_2_2_3,3,3,3_1_3_2,3,0,7,5_4,2,0,2_1,1,0,5_1,4,4,2_4,4,0,4_3,4,2,3_3,4,1,1_2,4,3","paramCn":"","paramLang":"","title":"防身情报","desc":"大吵大闹的魔精在道路一侧游荡，四处传播手中的传单——你试图助它一臂之力。\n它十分怀疑，但也仅限于怀疑。","flagText":"","acceptText":"拿一叠传单","finishText":"参差不齐的尖牙是它们表达谢意的方式。小家伙们落下了一份传单，蹦跳着走远了。","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":12,"retroReward":""},{"id":1020501,"mapId":10205,"pos":"56.6#-10.2#0","offsetPos":"0.8#2.30","res":"scenes/m_s08_hddt/prefab/hddt_front_mojing_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.9","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_001.prefab","condition":"EpisodeFinish=10205","showCamera":1,"showArrow":1,"type":1,"param":"","paramCn":"","paramLang":"","title":"小径① 人类吃金块的证据","desc":"在布满金块的地方，魔精的亲戚——另一只魔精靠近了你。它并无敌意，并希望得到你的帮助。","flagText":"","acceptText":"提供帮助","finishText":"","dispatchingText":"","reward":"1#980026#1|2#2#20","rewardPoint":1,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""},{"id":1020601,"mapId":10206,"pos":"41.4#-7#0","offsetPos":"0.4#2.3","res":"scenes/m_s08_hddt/prefab/hddt_front_cidai_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_002.prefab","condition":"EpisodeFinish=10206","showCamera":1,"showArrow":1,"type":2,"param":"30201","paramCn":"","paramLang":"","title":"小径① 残局","desc":"棘手的残局，酝酿自一场胶着已久的苦战。等待着正确的指引让他们得以解放。","flagText":"","acceptText":"清理残局","finishText":"你清理了残局，现在这里不再有那些麻烦。","dispatchingText":"","reward":"2#2#20","rewardPoint":1,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""},{"id":1020602,"mapId":10206,"pos":"26.84#-6.2#0","offsetPos":"0.8#2.30","res":"scenes/m_s08_hddt/prefab/hddt_front_mojing_a_001.prefa