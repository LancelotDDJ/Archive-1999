ep":[[16,17,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["请放心！这次我修改了前几章的叙事节奏，保证不会再出现主题呈现过晚的问题了！","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["哎……希望我能相信你。我们开始吧。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["咳咳——","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一缕来自安第斯山谷的晚风拂过了亨廷疲倦的眼皮，虚构集开始了故事的讲述。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601613","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["<i>“牛仔是从遇到车夫开始，才下定决心要返乡的——那是另一位没有影子的人。”</i>","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["<i>“他乘着那辆破旧的马车，踏上了一场漫长的旅途，跨越千山万水，最终回到了故乡。”</i>","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601614","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["<i>“然而，那份迟来的欣喜却追不上他的步伐。他站在这片熟悉又陌生的土地上，<br>注视着眼前的一切，却只感到一种挥之不去的诡异。”</i>","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["亨廷发现：自己的眼皮已沉重到无法抬起。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["周围的空气变得粘稠而扭曲起来，墙壁、灯光、桌椅都化作缥缈的影子，消失在迷雾中。","","","","","","",""],"bg":"story_bg/bg/bangongshi.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["笔记本","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523812.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["有些不对劲……发生什么事了？","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"27":{"step":[[27,28,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“在故乡的天空下，牧童们的影子比他们的身躯还要巨大。<br>‘这里是我的故乡，’牛仔开口，声音沙哑，‘可如今，我却像是闯入了别人的梦。’”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"28":{"step":[[28,29,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“‘山还是那座山，风还是那阵风，可它们再也认不出我了。’牛仔徒劳地望着远方。”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523812.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这些画面……正在流动？","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["亨廷的脑海中开始出现那些远方的山峰。","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"31":{"step":[[31,32,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“车夫叹了口气，从腰间取出一个早已生锈的怀表，在牛仔面前晃了晃。<br>‘时间会将一切变成影子，连故乡也不例外。你如此，我亦如此。’”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"32":{"step":[[32,33,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“他顿了顿，目光投向广袤的地平线：‘我连影子都没有。我的故乡在哪儿？’”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"33":{"step":[[33,34,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“牛仔笑了笑，宽慰地拍了拍车夫的肩膀：‘伙计，别丧气——你看那些牛。’”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"34":{"step":[[34,35,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“那些牛从不低头吃草。它们追着星辰跑，直到把牧童的灵魂也一并拖走。谁也别妄想回到故乡，那里的土地会咬人，咬得你再也走不掉。”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"35":{"step":[[35,36,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“我们只要跟着那些牛走，也许就能找到我们弄丢的影子。”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice":[]},"36":{"step":[[36,37,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["<i>“两人将马车安置在山坡下，整理好马车的缰绳。然后，他们默契地跟在牧童的脚印后面，步伐沉重却坚定。”</i>","","","","","","",""],"bg":"story_bg/bg/typerbg.png","choice"