{"chapter_map_element":{"id":1010101,"mapId":10101,"pos":"11.89#-9.47#0","offsetPos":"1.77#2.96","res":"scenes/m_s08_hddt/prefab/hddt_front_yundaoxiaoren_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=10105","showCamera":0,"showArrow":1,"type":4,"param":"1","paramLang":"","title":"投机倒把和烂糖果","desc":"","flagText":"","acceptText":"","finishText":"","reward":"","rewardPoint":0,"fragment":1,"retroReward":""},"chapter_map_fragment":{"id":1,"title":"投机倒把和烂糖果","res":"fragmenticon_001","type":2,"content":""},"chapter_map_element_dialog":[{"id":1,"stepId":1,"type":"dialog","param":"","audio":610002884,"speaker":"？？？","content":"暴躁的孩子们睡着了。你注意到他们的鞋底上沾着像蚂蟥一样的，被踩扁了的口香糖。"},{"id":1,"stepId":2,"type":"options","param":"1#2#3","audio":0,"speaker":"","content":"口香糖是什么颜色的？#口香糖现在怎么样了？#我对那见鬼的口香糖没兴趣！"},{"id":1,"stepId":3,"type":"selector","param":"1","audio":0,"speaker":"","content":""},{"id":1,"stepId":4,"type":"dialog","param":"","audio":610003246,"speaker":"？？？","content":"经过长时间的咀嚼，它呈现出糖胶树胶应有的浅琥珀色。某些褶皱部分则是青色。它极有可能是薄荷味的。"},{"id":1,"stepId":5,"type":"dialog","param":"","audio":610002885,"speaker":"？？？","content":"薄荷口味的口香糖销售冠军是瑞格利球场附近的泡泡糖机。在疯狂的球赛过后，总有人需要清清口气，忘掉被上一场赛绩狠狠揍了屁股的愤怒。"},{"id":1,"stepId":6,"type":"dialog","param":"","audio":610003247,"speaker":"？？？","content":"但是，嘿，难道你还没有注意到？那被挤压成块的口香糖胶基中，混杂着的美妙的颗粒物？"},{"id":1,"stepId":7,"type":"dialog","param":"","audio":610003248,"speaker":"？？？","content":"灰白色的砂粒，合成的涂蜡的弹性纤维。在南岸，只有一个地方铺设了这样极具政治象征性意味的广场地面——圣洛夫基金会。"},{"id":1,"stepId":8,"type":"selectorend","param":"","audio":0,"speaker":"","content":""},{"id":1,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":""},{"id":1,"stepId":10,"type":"dialog","param":"","audio":610003249,"speaker":"？？？","content":"非常悲惨。值得令人同情的遭遇。它兢兢业业地完成了自己的使命，但是很显然，没有人在乎这一切。"},{"id":1,"stepId":11,"type":"dialog","param":"","audio":610003250,"speaker":"？？？","content":"我敢说它是现在最受欢迎的薄荷口味。芝加哥人在失去灌醉自己的权利后，就只能投靠向这娘娘腔的新贵阶级玩意儿了。"},{"id":1,"stepId":12,"type":"dialog","param":"","audio":610003251,"speaker":"？？？","content":"口香糖销售冠军是瑞格利球场附近的泡泡糖机。孩子们鞋底的口香糖也来自于那里。"},{"id":1,"stepId":13,"type":"dialog","param":"","audio":610003252,"speaker":"？？？","content":"被挤压成块的胶基中混杂着一些颗粒物。灰白色的砂粒，合成的涂蜡的弹性纤维。在南岸，只有一个地方铺设了这样极具政治象征性意味的广场地面——圣洛夫基金会。"},{"id":1,"stepId":14,"type":"selectorend","param":"","audio":0,"speaker":"","content":""},{"id":1,"stepId":15,"type":"selector","param":"3","audio":0,"speaker":"","content":""},{"id":1,"stepId":16,"type":"dialog","param":"","audio":610003253,"speaker":"？？？","content":"谁又不是呢？很高兴在这件事情上我们能志同道合。"},{"id":1,"stepId":17,"type":"dialog","param":"","audio":610003254,"speaker":"？？？","content":"描述被遗弃的糖胶树胶并不会令任何人感到高潮。因此让我们跳到下一个阶段——你有注意到口香糖底粘着的碎颗粒吗？"},{"id":1,"stepId":18,"type":"dialog","param":"","audio":610003255,"speaker":"？？？","content":"灰白色的砂粒，合成的涂蜡的弹性纤维。在南岸，只有一个地方铺设了这样极具政治象征性意味的广场地面——圣洛夫基金会。"},{"id":1,"stepId":19,"type":"selectorend","param":"","audio":0,"speaker":"","content":""},{"id":1,"stepId":20,"type":"dialog","param":"","audio":610003256,"speaker":"？？？","content":"正如过去的每一天一样，广场前热闹非凡。推崇人类至上的投机分子，试图通过游行来引起基金会官方的注意。"},{"id":1,"stepId":21,"type":"dialog","param":"","audio":610003257,"speaker":"？？？","content":"他们与基金会同属于一个阵线，可惜的是，基金会并不打算完全地迎合他们。甚至派出一个小姑娘来敷衍他们。"},{"id":1,"stepId":22,"type":"options","param":"4","audio":0,"speaker":"","content":"小姑娘？这是个好话题"},{"id":1,"stepId":23,"type":"selector","param":"4","audio":0,"speaker":"","content":""},{"id":1,"stepId":24,"type":"dialog","param":"","audio":610003258,"speaker":"？？？","content":"是的，是的，没有人不会对这个话题产生兴趣。她们是蜂蜜色的，是早晨加州的阳光，是你永远也追不到的母鹿上的耀眼光斑。"},{"id":1,"stepId":25,"type":"dialog","param":"","audio":610003259,"speaker":"？？？","content":"对于某些道貌岸然的家伙来说，小姑娘就是垂涎在嘴边的肥肉。值得庆幸的是，这位小姑娘并不属于其中。"},{"id":1,"stepId":26,"type":"dialog","param":"","audio":610003260,"speaker":"？？？","content":"她很紧张，但没有惊慌失措。她看起来并不擅长与油滑的“政治家们”打交道。一枚属于基金会的任务胶囊在她手里被捏得发烫。"},{"id":1,"stepId":27,"type":"dialog","param":"","audio":610003261,"speaker":"？？？","content":"而在广场的另一侧，一位身着黑西装的小女孩正阴郁地望向这里。那里接近基金会的出风口，是个再适合她不过的好地方。"},{"id":1,"stepId":28,"type":"dialog","param":"","audio":610003262,"speaker":"？？？","content":"一个边缘得不能再边缘的位置，正是20世纪第二代移民的最好写照。"},{"id":1,"stepId":29,"type":"selectorend","param":"","audio":0,"speaker":"","content":""},{"id":1,"stepId":30,"type":"options","param":"5#6","audio":0,"speaker":"","content":"谈谈那个基金会小姑娘#黑西装小女孩是谁？"},{"id":1,"stepId":31,"type":"selector","param":"5","audio":0,"speaker":"","content":""},{"id":1,"stepId":32,"type":"dialog","param":"","audio":610003263,"speaker":"？？？","content":"她是你熟悉的那个好姑娘，橘红色的头发，思考的时候转笔就像在转魔术师手里的那个灵活的球。"},{"id":1,"stepId":33,"type":"dialog","param":"","audio":610003264,"speaker":"？？？","content":"围着她叫嚷的那群家伙们使她感到困惑。但她眼里亮着光，好像在期盼着什么好事。"},{"id":1,"stepId":34,"type":"dialog","param":"","audio":610003265,"speaker":"？？？","content":"是接下来要完成的那个任务胶囊中的使命？是因为她即将要去会见的某个人？"},{"id":1,"stepId":35,"type":"dialog","param":"","audio":610003266,"speaker":"？？？","content":"她的脸颊微微涨得发红。手心中的物件也因此松开了。"},{"id":1,"stepId":36,"type":"selectorend","param":"","audio":0,"speaker":"","content":""},{"id":1,"stepId":37,"type":"selector","param":"6","audio":0,"speaker":"","content":""},{"id":1,"stepId":38,"type":"dialog","param":"","audio":610003267,"speaker":"？？？","content":"她是你将来会认识的某个人。"},{"id":1,"stepId":39,"type":"dialog","param":"","audio":610003268,"speaker":"？？？","content":"现在的她浑身打着冷战，像是一只急于寻求庇护的蛉虫，在寻找暴雨中的屋檐或一片瓦砾。"},{"id":1,"stepId":40,"type":"dialog","param":"","audio":610003269,"speaker":"？？？","content":"与她孱弱的身躯不同，她的眼眶中准备好了脏话。或许她刚遭受了一场拒绝，甚至是侮辱。这一切使得她像个死士般地向广场中心移动。"},{"id":1,"stepId":41,"type":"dialog","param":"","audio":610003270,"speaker":"？？？","content":"她不得不去执行另一个她并不情愿的任务了。"},{"id":1,"stepId":42,"type":"dialog","param":"","audio":610003271,"speaker":"？？？","content":"正在这时，那位基金会临时代表手中的胶囊，在人群的推搡下松开了。"},{"id":1,"stepId":43,"type":"selectorend","param":"","audio":0,"speaker":"","content":""},{"id":1,"stepId":44,"type":"dialog","param":"","audio":610003272,"speaker":"？？？","content":"——这是一个好机会。"},{"id":1,"stepId":45,"type":"dialog","param":"","audio":610003273,"speaker":"？？？","content":"来自非洲大陆的暖风吹向特拉帕尼。接着，整个西西里岛都变得干燥，温暖，快活。四周弥漫着湿热的珊瑚和野生橘子的香气。"},{"id":1,"stepId":46,"type":"dialog","param":"","audio":610003274,"speaker":"？？？","content":"这不是这个冬天应该发生的事。但它一直在西装女孩的脑中，徘徊，舞动，提醒她还要继续活下去。"},{"id":1,"stepId":47,"type":"dialog","param":"","audio":610003275,"speaker":"？？？","content":"她曾经很绝望。"},{"id":1,"stepId":48,"type":"dialog","param":"","audio":610003276,"speaker":"？？？","content":"失败接着失败。但她旺盛的生命力不会停止在这里，至少不是现在。"}]}