{"name":"星","name_En":"The Star","ids":[310],"chapterIndex":"5SP","actId":0,"type":1,"chapter_map_element":[{"id":3100401,"mapId":31004,"pos":"18.62#-12.81","offsetPos":"0.65#2.33","res":"scenes/m_s08_hddt/prefab/hddt_back_mutual_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_004.prefab","condition":"EpisodeFinish=31004","showCamera":1,"showArrow":1,"type":4,"param":"22","paramCn":"","paramLang":"","title":"小径① 目所能及的雨","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":1,"permanentReward":"","holeSize":"","fragment":65,"retroReward":""}],"chapter_map_fragment":{"65":{"id":65,"title":"目所能及的雨","res":"fragmenticon_059","type":2,"content":"","toastId":0}},"chapter_map_element_dialog":{"22":[{"id":22,"stepId":1,"type":"dialog","param":"","audio":6208055,"speaker":"？？？","content":"只要多看看雨后的地面，您就能发现这道潮湿的、漫长的痕迹。","res":""},{"id":22,"stepId":2,"type":"dialog","param":"","audio":6208056,"speaker":"？？？","content":"在痕迹尽头或许会有一只缓慢爬行的蜗牛，它为我们标识出何为“前方”。","res":""},{"id":22,"stepId":3,"type":"dialog","param":"","audio":6208057,"speaker":"？？？","content":"可——如果没找见蜗牛呢？直线的哪一头才是前，哪一头又指向过去？","res":""},{"id":22,"stepId":4,"type":"options","param":"1#2","audio":0,"speaker":"","content":"需要更多依据#抱歉，我不知道","res":""},{"id":22,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":22,"stepId":6,"type":"dialog","param":"","audio":6208058,"speaker":"？？？","content":"您听听，依据。凡事都要找点儿道理和实例，进行缜密推演。","res":""},{"id":22,"stepId":7,"type":"dialog","param":"","audio":6208059,"speaker":"？？？","content":"眼见并非为实，合逻辑的才是正确的，切实的。因为还尚未有能动摇逻辑规律的东西存在，如果有——那只是缘于不够了解。","res":""},{"id":22,"stepId":8,"type":"dialog","param":"","audio":6208060,"speaker":"？？？","content":"曾经那群在罐头房子里忙碌的研究者们是如此认为的。","res":""},{"id":22,"stepId":9,"type":"dialog","param":"","audio":6208061,"speaker":"？？？","content":"直到第一滴雨落下，他们猛然间发觉原有的认知已不足以自洽，就像破掉的窗户上那个巨大的空洞。","res":""},{"id":22,"stepId":10,"type":"dialog","param":"","audio":6208062,"speaker":"？？？","content":"无论如何用木板、铁皮、防水布遮挡和修补，最终，一片狼藉中留下的仍旧只有这么扇摇摇欲坠的窗户。","res":""},{"id":22,"stepId":11,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":22,"stepId":12,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":22,"stepId":13,"type":"dialog","param":"","audio":6208063,"speaker":"？？？","content":"喔！承认尚有不明白的事儿，接着费工夫弄懂它，您已经摸清了那群家伙的行事方式。","res":""},{"id":22,"stepId":14,"type":"dialog","param":"","audio":6208064,"speaker":"？？？","content":"那群在满地狼藉里费力地捡拾零件，希望尽力保留科技成果的研究者，眼瞅着浪潮将搭建好的沙堡冲刷，最后还原为散碎的沙砾。","res":""},{"id":22,"stepId":15,"type":"dialog","param":"","audio":6208065,"speaker":"？？？","content":"他们专注地做着记录，本以为自己所处的地方是个安全坚固的罐头，却发现四壁之中填充的同样是数不清的沙。","res":""},{"id":22,"stepId":16,"type":"dialog","param":"","audio":6208066,"speaker":"？？？","content":"从落下的第一滴雨开始，熟悉的存在消失殆尽。","res":""},{"id":22,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":22,"stepId":18,"type":"options","param":"3","audio":0,"speaker":"","content":"然后呢？","res":""},{"id":22,"stepId":19,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":22,"stepId":20,"type":"dialog","param":"","audio":6208067,"speaker":"？？？","content":"混乱不会持续太久。如果是突如其来的雨冲走了蜗牛，把时间搅得一塌糊涂……那么，反过来想——","res":""},{"id":22,"stepId":21,"type":"dialog","param":"","audio":6208068,"speaker":"？？？","content":"弄清雨的秘密，是否就能洞悉时间？在此前可没有这样好的案例，时间本该是个摸不着、瞧不见的概念。","res":""},{"id":22,"stepId":22,"type":"dialog","param":"","audio":6208069,"speaker":"？？？","content":"很快，观测站在世界各地冒了出来。以最快、最实用的方式，他们学会了采集与保存珍贵的研究材料，能盛放雨水的小盒子至今还在持续迭代。","res":""},{"id":22,"stepId":23,"type":"dialog","param":"","audio":6208070,"speaker":"？？？","content":"研究室重归整齐与寂静，每一枚齿轮都回到了原有的轨道。","res":""},{"id":22,"stepId":24,"type":"dialog","param":"","audio":6208071,"speaker":"？？？","content":"能迅速了解这座臃肿、庞大、吱吱作响的机器的，终究也是机器。她并不倾向某一方，只追逐看得见的结果。","res":""},{"id":22,"stepId":25,"type":"dialog","param":"","audio":6208072,"speaker":"？？？","content":"所以，当那页报告——关于机器中某些忙着扑扇翅膀的，轻巧细小的零件，以及一张布满圈画与墨点的纸张被送到桌面时，她立刻做好了决定。","res":""},{"id":22,"stepId":26,"type":"dialog","param":"","audio":6208073,"speaker":"？？？","content":"——她毁去了报告，只让这些信息留在她的存储硬盘中。","res":""},{"id":22,"stepId":27,"type":"dialog","param":"","audio":6208074,"speaker":"？？？","content":"而那张据称是“暴雨”发生地点预测的纸——上面的涂画就像蝴蝶眼斑——被她保存下来，和现有的研究结果进行比对。","res":""},{"id":22,"stepId":28,"type":"dialog","param":"","audio":6208075,"speaker":"？？？","content":"看样子结果使她很满意。","res":""},{"id":22,"stepId":29,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}]}}