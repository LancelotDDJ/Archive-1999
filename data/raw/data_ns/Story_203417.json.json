w_name_en":false,"no_l2d":false,"text":["浮窗","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314110.png","audio":"613400576","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“金丹术”修炼过程是这样的，你们听好。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314110.png","audio":"613400577","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["第一步，“人能常清静，天地悉皆归。”你们需得放下世情，去寻求内心的沉静，以此得以揣摩天道的意义。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314110.png","audio":"613400578","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["第二步，感受自己体内的“气”，“人之生，气之聚也。聚则为生，散则为死。”","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314110.png","audio":"613400579","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“气”便是我们修身养性，从而延年益寿的关键，我们需要通过漫长的摸索来认识自己体内的“气”，熟知它的流转。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314110.png","audio":"613400580","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["第三步，你们需融会贯通，要学会引导自身的“气”，改变其本来的运转方式，使之融入天道。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"64":{"step":[[64,65,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["浮窗","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314119.png","audio":"613400581","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["而接下来这步是重中之重，你们需得让体内的“气”和身体慢慢磨合，切不可急躁。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314119.png","audio":"613400582","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“道炁不居人身，人身则空，人身既空，何得久生？”","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314119.png","audio":"613400583","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["你们需日复一日，持之以恒地潜心修行，磨炼自己的肉体凡胎，使它与体内的“气”和谐共存。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314110.png","audio":"613400584","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“保气则得道，得道则长存”说的便是这个道理。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314116.png","audio":"613400585","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["但这磨合的过程漫长且凶险，稍有不慎，修炼者便会走火入魔，更甚者则会神形俱灭。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314116.png","audio":"613400586","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["快的话，这个磨合的过程一般会持续个几十年，慢的话……修炼了上百年的人我也是见过。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"71":{"step":[[71,72,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["浮窗","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choic