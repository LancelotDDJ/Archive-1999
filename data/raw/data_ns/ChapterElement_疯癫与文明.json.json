,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_001.prefab","condition":"EpisodeFinish=916","showCamera":1,"showArrow":1,"type":1,"param":"","paramCn":"","paramLang":"","title":"《…图书…博览会导览》","desc":"思想与知识的伟大市场。","flagText":"","acceptText":"打开看看","finishText":"","dispatchingText":"","reward":"","rewardPoint":1,"permanentReward":"","holeSize":"","fragment":148,"retroReward":""},{"id":1091701,"mapId":10917,"pos":"11.96#-5.37#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=10917","showCamera":1,"showArrow":1,"type":4,"param":"44","paramCn":"","paramLang":"","title":"文学兵役","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":149,"retroReward":""},{"id":1091801,"mapId":10918,"pos":"55.05#-7.45#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=918","showCamera":1,"showArrow":1,"type":4,"param":"45","paramCn":"","paramLang":"","title":"愚人船","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":150,"retroReward":""},{"id":1091901,"mapId":10919,"pos":"67.93#-10.01#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_001.prefab","condition":"EpisodeFinish=10919","showCamera":1,"showArrow":1,"type":1,"param":"","paramCn":"","paramLang":"","title":"亦去亦返","desc":"这有一段话，不知何人书写。","flagText":"","acceptText":"聆听心声","finishText":"","dispatchingText":"","reward":"","rewardPoint":1,"permanentReward":"","holeSize":"","fragment":151,"retroReward":""},{"id":1092001,"mapId":10920,"pos":"79.41#-15.57#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#0.7","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=10920","showCamera":1,"showArrow":1,"type":18,"param":"41","paramCn":"","paramLang":"","title":"密谈","desc":"1991年的信息化让信息传播是如此迅速！","flagText":"","acceptText":"偷听对话","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""}],"chapter_map_fragment":{"133":{"id":133,"title":"回环的幽灵","res":"v2a6_fragmenticon_016","type":2,"content":"","toastId":0},"134":{"id":134,"title":"《布宜诺斯艾利斯分部交接报告》","res":"v2a6_fragmenticon_002","type":1,"content":"布宜诺斯艾利斯分部已收容“暴雨专项小组”成员乌尔里希、星锑，目前两位成员暂驻分部进行基础健康检查。<br>……<br>司辰及其助手于火地岛登陆后接到讯息，已离队执行任务。<br><i>讯息来源与该行动详情已由十四行诗自行提交报告，我方目前无权限查阅。</i><br>……<br><br>已收容的其余幸存者<br><br>芭卡洛儿<br>纯血神秘学家，“自由海风号”游轮乐手。<br><br>……<br><br>图图石子<br>纯血神秘学家，努库泰奥族人。<br><i>*该族群需进一步调查。</i><br><br>……<br><br>危险等级评估报告详见附页1-35。","toastId":0},"135":{"id":135,"title":"乌斯怀亚港口爆炸","res":"v2a6_fragmenticon_001","type":1,"content":"&nbsp;&nbsp;&nbsp;&nbsp;乌斯怀亚港口爆炸引发的地面震动持续近10秒，随后火势借助强风吞没了港区，浓烟蔓延数公里，爆炸造成12人受伤，200多名居民被疏散，海军与消防部门消耗近六小时控制火势，但关键物流设施已化为废墟。<br>&nbsp;&nbsp;&nbsp;&nbsp;经查，爆炸源头是第三码头的一座储油罐与两处货运仓库，但港口的原油储存数量与爆炸规模严重不等，怀疑事件涉及神秘术，目前尚不明确是否与芝诺撤离有关，也正在同步调查其他神秘学组织。<br><br>&nbsp;&nbsp;&nbsp;&nbsp;<i>这是什么情况？！到了今天你就给我交一份这样的报告？恐慌已经在蔓延了，乌斯怀亚港口是距离哪里最近的一座深水港还需要我给你们强调吗？窜得比灯塔还高的火焰，被映成血红色的海水，所有人都在想起十几年前的战争！现在我们所有人的伤口被人以这样的方式狠狠撕开，我给足你们时间调查，你就给我列几个可能性？<br>&nbsp;&nbsp;&nbsp;&nbsp;前几天居然还有人在怀疑监狱里关的那群疯子——他们除了拿脑门磕铁丝网磕出一首蹩脚的陈词滥调以外还会干什么？拿写满颠倒诗句的废纸给自己造个分身留在监狱里，再幻想出几个隐形热气球把他们带到港口，最后拿泥土和碎冰捏出大量炸弹？你唯一做对的事情就是没把他们列入你的可能性，否则我们就一起进监狱和那群疯子磕铁丝网吧！</i>","toastId":0},"152":{"id":152,"title":"暗色带编织·卷一","res":"","type":2601,"content":"","toastId":0},"136":{"id":136,"title":"致未曾谋面的笔友","res":"v2a6_fragmenticon_003","type":1,"content":"&nbsp;&nbsp;&nbsp;&nbsp;阿莱夫，我亲爱的笔友，谨此附上我小说最新的修改部分。在上次的来信中，你向我提出了银行职员这一角色，赋予了阿马尔菲塔诺一个资本主义生产模式的标志，这当然非常好！在这次的修改中，我也增加了我的想法。<br>&nbsp;&nbsp;&nbsp;&nbsp;……<br>&nbsp;&nbsp;&nbsp;&nbsp;关于小说的部分，上面就是我迫不及待想与你分享的所有内容了，你或许不介意我与你聊些其他的话题？在我创作的途中，你的鼓励与肯定无疑是我面对无数扇合上的编辑大门时最大的安慰，那些漫长徒劳的努力在你的理解面前变得无足轻重，噢我亲爱的笔友，我说这些是出于真心——想必我做这样的解释都显得多此一举，或许我不需要再费笔墨去描述你的回信对我而言有多珍贵。因此，我诚挚且忐忑地向你询问：我们是不是可以当面聊一聊这些——这些亡灵、沙漠、命运、令我苦恼不已的结局，与你我沉浮的想象与见解。<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;虚构集<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;于哥伦比亚&nbsp;圣菲波哥大&nbsp;露天剧场的诗会<br>&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;虚构集小姐，如我曾几次在信件中向你提及的而你或许也有所察觉的，我所处的位置是一所监狱，这也是我总是不与笔友们见面的原因。因为其偏僻的位置与寒冷的气候，乌斯怀亚不是一个人们愿意轻易踏足的地方，相比起跨越这样漫长的距离，人们更愿意在布宜诺斯艾利斯的百年咖啡店里喝一杯三十八度四的热饮。<br>&nbsp;&nbsp;&nbsp;&nbsp;……<br>&nbsp;&nbsp;&nbsp;&nbsp;最后，依然祝你的创作之途顺利。<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;阿莱夫<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;于乌斯怀亚的科马拉监狱","toastId":0},"137":{"id":137,"title":"南方也存在","res":"v2a6_fragmenticon_014","type":2,"content":"","toastId":0},"153":{"id":153,"title":"暗色带编织·卷二","res":"","type":2601,"content":"","toastId":0},"154":{"id":154,"title":"暗色带编织·卷三","res":"","type":2601,"content":"","toastId":0},"138":{"id":138,"title":"打字机记录#P5","res":"v2a6_fragmenticon_004","type":1,"content":"&nbsp;&nbsp;&nbsp;&nbsp;……&nbsp;&nbsp;&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;即使如今的他们对外界环境总是闭口不谈，但只需在监狱中短暂停留数日，你也会发现他们立足于此的原因正是他们不愿再谈及的理由。<br>&nbsp;&nbsp;&nbsp;&nbsp;乌斯怀亚是阿根廷边界的寒冷小镇，无论是极夜、冰海、咫尺之遥的南极还是漫长的冬天，这一切都使得它似乎沉眠在地层之下，由时间堆积，又被时间遗忘。它无疑拥有构建监狱所需的重要特质，使得一些患有精神疾病的神秘学家嫌犯被送入了这所监狱，让他们随同这里被遗忘的特性一般被遗忘。<br>&nbsp;&nbsp;&nbsp;&nbsp;抛去疯癫的定义与囚犯的身份，我在这所监狱里真正看见的，是曾经的诗人、作家与社会活动家。在那个时代，他们之中有人曾经谈论诗歌，随后因为存有一本让·保罗·萨特的书而从社会中消失；有人曾经在从属关系中掀起了自下而上的反抗，因此遭到流放。他们曾经被频繁质问“为什么要念这些书，为什么要写这些诗”他们曾经被打上过“思想组织者”的罪名，他们最终辗转至此，参与一场以福柯和精神分析为名义的实验，我们已经很难分辨他们的“疯癫”是因为无法被规训而被社会定义为“疯癫”，还是因为无尽的电击和拷问，或者根本来说，所有的原因都是一体的，这个原因常被逃避、美化或者忽略，因为我们都很清楚，每个人的生活都与这个原因息息相关。<br>&nbsp;&nbsp;&nbsp;&nbsp;……<br>&nbsp;&nbsp;&nbsp;&nbsp;他们起初的确闭口不谈，但恰是这样刻意的回避，才真正向我传达了他们的哀伤与恐惧。","toastId":0},"155":{"id":155,"title":"暗色带编织·卷四","res":"","type":2601,"content":"","toastId":0},"139":{"id":139,"title":"打字机记录#P12","res":"v2a6_fragmenticon_004","type":1,"content":"&nbsp;&nbsp;&nbsp;&nbsp;他们谈起“重塑之手”时，总是语调轻松且夹带玩笑，诸如“脑袋流油的音乐家把瓷砖抹得像爱德华·戈雅醉酒后的即兴创作”，这样的话语时常在他们的诗句之间突然出现，即使我从未“亲眼”见过那样的画面，也能感受到他们对“重塑之手”的态度——那是比起他们曾经的遭遇有过之而无不及的压迫，但他们在潜意识中“忽略”了这份相似性，或许是因为逃避，或许是因为这所监狱的确教会了他们服从——依然是在潜意识中。<br>&nbsp;&nbsp;&nbsp;&nbsp;但就我所知，“重塑之手”的的确确将恐怖降临到了这里，那些面具使得神秘学家变得疯狂而痛苦，犹如被捕兽夹困囿而不得解脱，漫长的折磨之后，他们变得无法再念出哪怕半句他们自己的语言，成为了这个民间组织的奴隶——只剩单一的思维，灵魂已经脱壳而去。<br>&nbsp;&nbsp;&nbsp;&nbsp;而人类，人类则在大量地死去。夜晚，他们不被允许保持长时间的睡眠，每隔一小时就会被交接的同伴叫醒，在思维的迷雾中坐到瞭望塔下合念祷词，而等到天亮，高强度的训练和不需要答案的拷问又会来临……“重塑之手”的目的藏在这些残忍的手段之下，明确得像是冰原中央最深的孔洞——只是摧毁，他们只是想“完全地摧毁”人类。","toastId":0},"140":{"id":140,"title":"监狱改造笔记","res":"v2a6_fragmenticon_005","type":1,"content":"·███的日常地西泮用量为二又四分之三片，于第三次科马拉议会取消，换为两本经归类的A1675诗集和六十片氯丙嗪（给予每日一又二分之一片医嘱）。<br><i>1.两天十一小时八分钟零四秒后，他位于第二层第三楼梯左数第八间的囚室栏杆出现八毫米的破损，第三十二块瓷砖被他抠下四毫米×三毫米的碎屑。<br>2.提及“另一个我”的次数，从四十八小时内三次，变为四十八小时内二十五次。<br>3.四天三小时七分钟零八秒后，从仅收集文稿纸张，变为收集文稿纸张与镜子碎片，在接下去的二十四小时内共收集十一块镜子也即一百零三块碎片。</i><br><br>……<br><br>·于第六次科马拉议会，将████的氟西汀和丙戊酸盐供给完全取消，换为四本经归类的L6759文选和四卷四百厘米的绷带。<br><i>1.平均每小时撞击栏杆与墙三十二次，绷带在四天十四小时二十分钟零九秒内用尽，有八十九点三厘米在其拉扯中落入水池。<br>2.在十天六小时八分钟零三秒内共写诗十五页，其中撕毁十四页，剩下的一页被他吞入肚中。</i><br>……","toastId":0},"141":{"id":141,"title":"《芝诺叛逃部队动向报告》","res":"v2a6_fragmenticon_006","type":1,"content":"&nbsp;&nbsp;&nbsp;……<br>&nbsp;&nbsp;&nbsp;综合以上多方信息以及近日司辰小队传来的情报，可以确认芝诺叛逃部队曾涉足关押众多神秘学家的科马拉监狱，并于3月2日从乌斯怀亚撤离，该行动轨迹明确涉及重塑之手，叛逃部队目前的行踪去向尚不明确，可以等待司辰小队的进一步情报。<br>&nbsp;&nbsp;&nbsp;<i>*信息较为琐碎，以推断为主，行动推论过程与情报原件索引见附件4-28。</i>","toastId":0},"142":{"id":142,"title":"命运豪赌","res":"v2a6_fragmenticon_015","type":2,"content":"","toastId":0},"143":{"id":143,"title":"《科马拉监狱治疗清单第303目》","res":"v2a6_fragmenticon_007","type":1,"content":"12月1日<br>704号-733号<br>各人统一配发氯丙嗪1剂，沙利度胺1剂<br>12月3日<br>704号-710号，712号-730号，732号-733号<br>各人统一配发氯丙嗪3剂，沙利度胺3剂<br>12月7日<br>706号-708号，712号-717号，722号-730号，732号<br>各人统一配发氯丙嗪6剂，佛罗那11剂<br>……","toastId":0},"156":{"id":156,"title":"暗色带编织·卷五","res":"","type":2601,"content":"","toastId":0},"144":{"id":144,"title":"一份剪报","res":"v2a6_fragmenticon_008","type":1,"content":"1935年，来自葡萄牙的安东尼奥教授被一份记录着猩猩在被切除了前额叶后会变得温顺的医学研究报告所吸引，并成功地做出了世界上第一例人类前额叶切除手术。这被称为脑叶白质切除术。手术非常成功且带来的一系列研究都成果颇丰。在1949年安东尼奥教授因此获得了诺贝尔医学奖。<br>在不断的实践与总结下，他们终于改进并完善了手术，甚至研究出了一种专门的脑白质切除器。但是这种手术技术要求极高，所以并没有被普及。<br>1945年，一名美国医生弗里曼对手术进行了改进，也就是现在臭名昭著的“冰锥疗法”。先将病人通过电击或麻药的形式放倒后，直接用锤子将一根大概筷子粗的钢针从病人的眼球上方凿入脑内，而后徒手搅动那根钢针以摧毁病人前额叶。<br>1950年，在精神病理学家瓦西里·加雅诺夫斯基的强烈建议下，苏联政府率先宣布全面禁止前脑叶白质切除术。此后的二十多年里，包括美国在内的绝大多数国家也纷纷立法禁止前脑叶白质切除术。","toastId":0},"145":{"id":145,"title":"一封破碎的邀请函","res":"v2a6_fragmenticon_009","type":1,"content":"尊敬的阿莱夫先生：<br>国家福柯学会诚挚邀请您加入，这是一个能使我们的社会乃至世界走上一个更加规范的未来的组织。我们相信您的优秀能力能够帮助我们更好地实现这一目标。静候您的回信。<br><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;何塞·达尔杜夫<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;于&nbsp;乌斯怀亚&nbsp;科马拉监狱","toastId":0},"146":{"id":146,"title":"奇怪术式的草稿","res":"v2a6_fragmenticon_010","type":1,"content":"关于……（模糊不清的水渍）仪式：<br>1.大量的神秘学家——对于重塑之手来说，这应该是一个简单的目标。那些有能力捡起砖块的，能出海的年轻人遍地都是，虔诚是最好的催化剂。<br>2.吼狮之尾，圣甲虫双翼，努库泰澳族人的贝壳——这些材料配合永生之泉，可以想象，重塑之手想要做一些了不得的事。基于贝壳本身的性质，它可以承载仪式大量的能量，保证其顺利进行。确实有一个法术需要如此周密的筹备。<br>3.地点…（模糊不清的水渍）——确实是个很好的地方，但对于仪式本身，时间更加重要，这里所指的时间并非我们传统的认知，而是时间“本身”。","toastId":0},"147":{"id":147,"title":"未寄出的信","res":"v2a6_fragmenticon_011","type":1,"content":"尊敬的虚构集小姐：<br>对于你1991年2月8日随信附上的《理性家族的崛起与衰落》第六版修改稿，我已阅读完毕。<br>以下是一些我个人的见解与故事发展方向的建议：<br>……<br>我相信我们离结局已经非常接近了。希望你永远不会放弃对于写作的热爱。<br>另，关于盲眼的织工一角色……<br>（信件还没有写完，看得出来回信者是遇到未知的突发事件而停笔了）","toastId":0},"148":{"id":148,"title":"《…图书…博览会导览》","res":"v2a6_fragmenticon_012","type":1,"content":"B区作品导览：<br>1.《青鸟》，沃森·克鲁斯，儿童文学。<br>编辑点评：儿童文学，但不只是儿童文学。从另一个角度看世界，会发现一切都截然不同。<br>2.《天空下的福克斯》，塔德奥，社会文学。<br>编辑点评：人类历史上经典的思维自传之一，呈现了对时间本质的深刻思考。<br>3.《血怪》，阿威罗伊，怪谈小说。<br>编辑点评：毫无疑问，本世纪最优秀的关于血食怪的小说。一部关于永生、嫉妒与人性的，长达三百年的故事。<br>…<br><br>与会作家个人联系方式：<br>1.塔德奥：0054178858943<br>2.埃玛·宗兹：0054257119382<br>3.阿莱夫：00543512239841<br>4.阿威罗伊：……<br>……","toastId":0},"149":{"id":149,"title":"文学兵役","res":"v2a6_fragmenticon_018","type":2,"content":"","toastId":0},"150":{"id":150,"title":"愚人船","res":"v2a6_fragmenticon_017","type":2,"content":"","toastId":0},"151":{"id":151,"title":"亦去亦返","res":"v2a6_fragmenticon_013","type":1,"content":"我还是回到了科马拉监狱。如今，于我而言，这座巨大的囚笼并非不可逃离的迷宫。在我离开科马拉监狱时，那位重塑之手的女士未曾阻拦我，但我仍然能感受到她的视线，如此悲伤、朦胧与寒冷，从未从我身上移开。<br>在乌斯怀亚的大街上，一位少女为我指明了返回监狱的道路。那截断线牵引着我的心神，我确信，我所追寻的使命就在此处。如果将我置于“命运”前，我的生死似乎也会以一个固定的路径走向它应有的终点。而我，在走上这条道路的同时，也不该带有任何的迟疑。<br>是时候与那位无问不答的“阿莱夫”先生谈话了。","toastId":0}},"chapter_map_element_dialog":{"41":[{"id":41,"stepId":1,"type":"dialog","param":"","audio":922600001,"speaker":"？？？","content":"一场战争开启之时，世界便开始了原地踏步。","res":""},{"id":41,"stepId":2,"type":"dialog","param":"","audio":922600002,"speaker":"？？？","content":"前进，撤退，冲锋，溃败，活在战场上不需要理解其他规则。","res":""},{"id":41,"stepId":3,"type":"dialog","param":"","audio":922600003,"speaker":"？？？","content":"这份报告上甚至没有写它是何时开始的，也没有陈述战争的诉求。","res":""},{"id":41,"stepId":4,"type":"options","param":"1#2","audio":0,"speaker":"","content":"战争还未开始#词句是文学的战场","res":""},{"id":41,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":41,"stepId":6,"type":"dialog","param":"","audio":922600004,"speaker":"？？？","content":"当然，你可以这样说。土地的疮痍总是触目惊心，灵魂的徘徊只能让人后知后觉。","res":""},{"id":41,"stepId":7,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":41,"stepId":8,"type":"dialog","param":"","audio":922600005,"speaker":"？？？","content":"作家施加在音节与词语上的暴力，不亚于一道非人性的军令。","res":""},{"id":41,"stepId":9,"type":"dialog","param":"","audio":922600006,"speaker":"？？？","content":"士兵必须按照军令行事，文字也得跟随作家的意愿排列。","res":""},{"id":41,"stepId":10,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":41,"stepId":11,"type":"options","param":"3","audio":0,"speaker":"","content":"这与现在发生的又有什么关系","res":""},{"id":41,"stepId":12,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":41,"stepId":13,"type":"dialog","param":"","audio":922600007,"speaker":"？？？","content":"这是一场看不到结局的流浪，年轻的作家可用的道标并不多。","res":""},{"id":41,"stepId":14,"type":"dialog","param":"","audio":922600008,"speaker":"？？？","content":"正如在厮杀的间隙，一些战士会捧出宗教的箴言，另一些则会流连来自亲友的书信。","res":""},{"id":41,"stepId":15,"type":"dialog","param":"","audio":922600009,"speaker":"？？？","content":"他们通常将这称为归宿，靠它盖过炮弹的轰鸣声，来提醒自己保持人性。","res":""},{"id":41,"stepId":16,"type":"dialog","param":"","audio":922600010,"speaker":"？？？","content":"但他们总会意识到自己很可能回不了家，迟早带着思乡病死在战场上。","res":""},{"id":41,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":41,"stepId":18,"type":"options","param":"4","audio":0,"speaker":"","content":"一场梦会是最好的良药","res":""},{"id":41,"stepId":19,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":41,"stepId":20,"type":"dialog","param":"","audio":922600011,"speaker":"？？？","content":"当然，梦会带你去往任何地方，不管是老家的街景，还是趴在桌上写书的下午。","res":""},{"id":41,"stepId":21,"type":"dialog","param":"","audio":922600012,"speaker":"？？？","content":"直到你分不清梦和现实，最后忘了如何醒来。","res":""},{"id":41,"stepId":22,"type":"dialog","param":"","audio":922600013,"speaker":"？？？","content":"士兵将在烂泥巴战壕里徘徊一生，士官长将一遍遍地发出送死的军令。","res":""},{"id":41,"stepId":23,"type":"dialog","param":"","audio":922600014,"speaker":"？？？","content":"而词句将永远逡巡于诗篇的结构里，诗篇永恒复苏在预言的律令下……","res":""},{"id":41,"stepId":24,"type":"dialog","param":"","audio":922600015,"speaker":"？？？","content":"诗人说话真是拗口。","res":""},{"id":41,"stepId":25,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"42":[{"id":42,"stepId":1,"type":"dialog","param":"","audio":922600016,"speaker":"？？？","content":"那么长官，是时候总结一下这番长篇大论的演讲，以便隔绝激情与狂想对你的毒害。","res":""},{"id":42,"stepId":2,"type":"dialog","param":"","audio":922600017,"speaker":"？？？","content":"从纷繁的情报里提炼关键词，有助于你在战场上更有效率地做出战术抉择。","res":""},{"id":42,"stepId":3,"type":"options","param":"1","audio":0,"speaker":"","content":"文学大爆炸","res":""},{"id":42,"stepId":4,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":5,"type":"dialog","param":"","audio":922600018,"speaker":"？？？","content":"一种暴力的军事遗产，在约莫30年前移植进入这片文学界，突然具有了与毁灭相对的含义——生机。","res":""},{"id":42,"stepId":6,"type":"dialog","param":"","audio":922600019,"speaker":"？？？","content":"自然，在虚构的世界里，你不用担心自己患上“弹震症”。","res":""},{"id":42,"stepId":7,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":8,"type":"options","param":"2","audio":0,"speaker":"","content":"你还懂文学？","res":""},{"id":42,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":10,"type":"dialog","param":"","audio":922600020,"speaker":"？？？","content":"是个士兵都该能做这样的汇报，除非你是动员兵。现在让我们看向地图。","res":""},{"id":42,"stepId":11,"type":"dialog","param":"","audio":922600021,"speaker":"？？？","content":"消费社会与出版社已经为西班牙铸好了再次发现新大陆的船只。","res":""},{"id":42,"stepId":12,"type":"dialog","param":"","audio":922600022,"speaker":"？？？","content":"而他们的“哥伦布”也已向时代的码头行军。","res":""},{"id":42,"stepId":13,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":14,"type":"options","param":"3","audio":0,"speaker":"","content":"新的“哥伦布”是谁？","res":""},{"id":42,"stepId":15,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":16,"type":"dialog","param":"","audio":922600023,"speaker":"？？？","content":"卡门与卡洛斯，加泰罗尼亚与拉丁美洲之间这场文学盛宴的策划者。","res":""},{"id":42,"stepId":17,"type":"dialog","param":"","audio":922600024,"speaker":"？？？","content":"前者的慧眼识出了拉丁美洲的硕果，严苛而又仁慈地为作家的心血赢得一份回报颇丰的合同。","res":""},{"id":42,"stepId":18,"type":"dialog","param":"","audio":922600025,"speaker":"？？？","content":"后者精通工业社会的运作模式，以诱人的奖金为西班牙语新美洲文学买好了登陆欧洲的船票。","res":""},{"id":42,"stepId":19,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":20,"type":"options","param":"4","audio":0,"speaker":"","content":"然后呢？","res":""},{"id":42,"stepId":21,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":22,"type":"dialog","param":"","audio":922600026,"speaker":"？？？","content":"那之后的故事由一场军事学院的丑闻拉开序幕，猪尾巴男孩将飓风吹向了世界。","res":""},{"id":42,"stepId":23,"type":"dialog","param":"","audio":922600027,"speaker":"？？？","content":"当然，不能忘记那位文学的外交官富恩特斯，和总“像孩子一样讲话”的科塔萨尔。","res":""},{"id":42,"stepId":24,"type":"dialog","param":"","audio":922600028,"speaker":"？？？","content":"可谁都不能质疑，马里奥与加博是领军人，历史总会优先铭记一场大捷里关键的战略指挥家。","res":""},{"id":42,"stepId":25,"type":"dialog","param":"","audio":922600029,"speaker":"？？？","content":"他们互通书信，钦赞彼此的才华，甚至慷慨地将对方的前半生写入博士论文。","res":""},{"id":42,"stepId":26,"type":"dialog","param":"","audio":922600030,"speaker":"？？？","content":"呵，友谊。","res":""},{"id":42,"stepId":27,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":28,"type":"options","param":"5","audio":0,"speaker":"","content":"友谊也是光辉的见证","res":""},{"id":42,"stepId":29,"type":"selector","param":"5","audio":0,"speaker":"","content":"","res":""},{"id":42,"stepId":30,"type":"dialog","param":"","audio":922600031,"speaker":"？？？","content":"他们确实以此为傲。","res":""},{"id":42,"stepId":31,"type":"dialog","param":"","audio":922600032,"speaker":"？？？","content":"但这一切都逃不过“爆炸”早已预示的落幕命运。","res":""},{"id":42,"stepId":32,"type":"dialog","param":"","audio":922600033,"speaker":"？？？","content":"一位古巴诗人的二次入狱与自我反省，加之一记再无解释的拳头——爆炸之后安静得令人心生恐惧。","res":""},{"id":42,"stepId":33,"type":"dialog","param":"","audio":922600034,"speaker":"？？？","content":"接着，军政府的独裁扼紧了后爆炸时代的咽喉，“哥伦布”们还是没能到达预期的目的地。","res":""},{"id":42,"stepId":34,"type":"dialog","param":"","audio":922600035,"speaker":"？？？","content":"年轻一代无法与上一代和解，后者成了前者眼中的老古董。","res":""},{"id":42,"stepId":35,"type":"dialog","param":"","audio":922600036,"speaker":"？？？","content":"他们再一次找寻全新的写作方式，试图表达独属于他们这一代的恐怖现实。","res":""},{"id":42,"stepId":36,"type":"dialog","param":"","audio":922600037,"speaker":"？？？","content":"现在则到处打着游击战。","res":""},{"id":42,"stepId":37,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"43":[{"id":43,"stepId":1,"type":"dialog","param":"","audio":922600038,"speaker":"？？？","content":"没什么人愿意听一枚骰子的指挥，指挥官不应该用运气下命令。","res":""},{"id":43,"stepId":2,"type":"dialog","param":"","audio":922600039,"speaker":"？？？","content":"每天的行军路程得是一个简单明了的数字，而不是两个数字中间夹着一个“D”，这会引起哗变的。","res":""},{"id":43,"stepId":3,"type":"dialog","param":"","audio":922600040,"speaker":"？？？","content":"当然，若有一枚骰子，可提前为士兵宣告命运的选择——","res":""},{"id":43,"stepId":4,"type":"dialog","param":"","audio":922600041,"speaker":"？？？","content":"我想他应该会把命交给骰子，专心等待它落下。","res":""},{"id":43,"stepId":5,"type":"options","param":"1","audio":0,"speaker":"","content":"不会次次都有好运的","res":""},{"id":43,"stepId":6,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":43,"stepId":7,"type":"dialog","param":"","audio":922600042,"speaker":"？？？","content":"而幸福正好需要厄运作伴，运气好和运气坏加起来就足以概括任何人的人生。","res":""},{"id":43,"stepId":8,"type":"dialog","param":"","audio":922600043,"speaker":"？？？","content":"不论生存还是死亡，骰子可以无数次地滚落。当然，也不止骰子……","res":""},{"id":43,"stepId":9,"type":"dialog","param":"","audio":922600044,"speaker":"？？？","content":"一枚硬币，一只贝壳，或者一张彩票，娱乐命运的手段要多少有多少。","res":""},{"id":43,"stepId":10,"type":"dialog","param":"","audio":922600045,"speaker":"？？？","content":"一个巴比伦人可以在十天前成为总督，更可以在二十天后变为奴隶。","res":""},{"id":43,"stepId":11,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":43,"stepId":12,"type":"options","param":"2","audio":0,"speaker":"","content":"有些事本可以避免","res":""},{"id":43,"stepId":13,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":43,"stepId":14,"type":"dialog","param":"","audio":922600046,"speaker":"？？？","content":"这就是历史学家的工作了。","res":""},{"id":43,"stepId":15,"type":"dialog","param":"","audio":922600047,"speaker":"？？？","content":"让他们在书上删减几笔，增添几笔，骰子的结果便有了合理性。","res":""},{"id":43,"stepId":16,"type":"dialog","param":"","audio":922600048,"speaker":"？？？","content":"“不该如此”就变成了“这很合理”以及“本应如此”。","res":""},{"id":43,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":43,"stepId":18,"type":"options","param":"3","audio":0,"speaker":"","content":"毕竟骰子公平公正，充满机会","res":""},{"id":43,"stepId":19,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":43,"stepId":20,"type":"dialog","param":"","audio":922600049,"speaker":"？？？","content":"你已初步洞察了赌徒的心理。","res":""},{"id":43,"stepId":21,"type":"dialog","param":"","audio":922600050,"speaker":"？？？","content":"不过输多了或者赢多了的家伙都会觉得自己看穿了骰子之上的伟大规律。","res":""},{"id":43,"stepId":22,"type":"dialog","param":"","audio":922600051,"speaker":"？？？","content":"巫师装神弄鬼换取幸运，数学家在纸上倒腾可能性，赌博游戏成为了著作的养料。","res":""},{"id":43,"stepId":23,"type":"dialog","param":"","audio":922600052,"speaker":"？？？","content":"或者单纯怀疑有人出老千。","res":""},{"id":43,"stepId":24,"type":"dialog","param":"","audio":922600053,"speaker":"？？？","content":"但愿这群人能走到一起，然后找出那个真正掌握了宇宙万物过去未来所有规律的恶魔，再赏它一耳光说辛苦了。","res":""},{"id":43,"stepId":25,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":43,"stepId":26,"type":"options","param":"4","audio":0,"speaker":"","content":"你今天说话真是混乱不堪","res":""},{"id":43,"stepId":27,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":43,"stepId":28,"type":"dialog","param":"","audio":922600054,"speaker":"？？？","content":"我想我一贯如此，只是今天骰子给出了一个独特的数字。","res":""},{"id":43,"stepId":29,"type":"dialog","param":"","audio":922600055,"speaker":"？？？","content":"不过话说回来，其实我更喜欢另一种指挥官。","res":""},{"id":43,"stepId":30,"type":"dialog","param":"","audio":922600056,"speaker":"？？？","content":"骰子已经掷下了，但别管是几，该过河了。","res":""},{"id":43,"stepId":31,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"44":[{"id":44,"stepId":1,"type":"dialog","param":"","audio":922600057,"speaker":"？？？","content":"咳咳……喘口气，配给品的香烟已经抽完了，故事马上迎来结局，这场“战役”也要结束了。","res":""},{"id":44,"stepId":2,"type":"dialog","param":"","audio":922600058,"speaker":"？？？","content":"一位作家终于离开了自己的疆域，只留下一地的创作物，就像那些战壕里留下的绷带和半颗脑袋。","res":""},{"id":44,"stepId":3,"type":"dialog","param":"","audio":922600059,"speaker":"？？？","content":"读下来很够呛。","res":""},{"id":44,"stepId":4,"type":"options","param":"1#2","audio":0,"speaker":"","content":"我读不懂哪怕一点#我想我读懂了","res":""},{"id":44,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":6,"type":"dialog","param":"","audio":922600060,"speaker":"？？？","content":"我们达成了共识。我也庆幸自己的司令从来不是文学家，否则在我解读完一首诗的指令前，就要被炸得稀巴烂了。","res":""},{"id":44,"stepId":7,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":8,"type":"dialog","param":"","audio":922600061,"speaker":"？？？","content":"那太好了，建议你兼任“文学加密通话组”的组长，并为你配给一本字典，用以对抗11.43毫米马克沁机枪。","res":""},{"id":44,"stepId":9,"type":"dialog","param":"","audio":922600062,"speaker":"？？？","content":"相信在子弹穿过你的眉心之前，你朗诵的诗歌就能让敌人脑袋开花。","res":""},{"id":44,"stepId":10,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":11,"type":"options","param":"3","audio":0,"speaker":"","content":"你似乎变幽默了","res":""},{"id":44,"stepId":12,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":13,"type":"dialog","param":"","audio":922600063,"speaker":"？？？","content":"多亏这位贯彻诗人式流浪生活的作家，从智利到布宜诺斯艾利斯，她用她宝贵的、罕有的，洗碗工与露营地保管员的兼职经验折服了我。","res":""},{"id":44,"stepId":14,"type":"dialog","param":"","audio":922600064,"speaker":"？？？","content":"她对文学的严肃性让我的幽默感死而复生。你如果在战友墓碑前听过冷笑话，或许就能明白我说的。","res":""},{"id":44,"stepId":15,"type":"dialog","param":"","audio":922600065,"speaker":"？？？","content":"总而言之，她从自己为数不多的流浪与革命经历中掏自肺腑，试图将“文学”作以社会变革的伟大手段，一位意见领袖，一位精英知识分子。","res":""},{"id":44,"stepId":16,"type":"dialog","param":"","audio":922600066,"speaker":"？？？","content":"有人会说，她是拉丁美洲的角斗士，而每个文字都是一颗子弹，一篇诗歌就是一架战术轰炸机。","res":""},{"id":44,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":18,"type":"options","param":"4#5","audio":0,"speaker":"","content":"我不相信那些关于文学的话#我相信那些话是事实","res":""},{"id":44,"stepId":19,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":20,"type":"dialog","param":"","audio":922600067,"speaker":"？？？","content":"很多人与你想法一样，我也不例外。","res":""},{"id":44,"stepId":21,"type":"selector","param":"5","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":22,"type":"dialog","param":"","audio":922600068,"speaker":"？？？","content":"你从不将信将疑，还对一切充满信任。这也许是好事。将军总得相信自己的士兵，不然早该投降了。","res":""},{"id":44,"stepId":23,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":44,"stepId":24,"type":"dialog","param":"","audio":922600069,"speaker":"？？？","content":"来吧，还是让我跟你汇报个机密……","res":""},{"id":44,"stepId":25,"type":"dialog","param":"","audio":922600070,"speaker":"？？？","content":"很多人、不计其数的人，以为拉下闸刀的是刽子手，击发子弹的是火药。","res":""},{"id":44,"stepId":26,"type":"dialog","param":"","audio":922600071,"speaker":"？？？","content":"可他们只说对了一半。战壕上的坑洞，只是一场场思想与意识撞击后的残骸。早在火药燃烧之前，思想就钻进了枪膛。","res":""},{"id":44,"stepId":27,"type":"dialog","param":"","audio":922600072,"speaker":"？？？","content":"而至于文学……","res":""},{"id":44,"stepId":28,"type":"dialog","param":"","audio":922600073,"speaker":"？？？","content":"确实没必要相信那场始自于拉美的大爆炸，之前的报告你听过就算了。","res":""},{"id":44,"stepId":29,"type":"dialog","param":"","audio":922600074,"speaker":"？？？","content":"但至少……听我说，至少你可以笃信一点。","res":""},{"id":44,"stepId":30,"type":"dialog","param":"","audio":922600075,"speaker":"？？？","content":"书翻太快也会割到手。","res":""}],"45":[{"id":45,"stepId":1,"type":"dialog","param":"","audio":922600076,"speaker":"？？？","content":"该撤退了，这艘船就要沉了。散落的破木板上挂着尸骸，逃亡的囚徒已经争相游向海岸。","res":""},{"id":45,"stepId":2,"type":"options","param":"1","audio":0,"speaker":"","content":"什么船","res":""},{"id":45,"stepId":3,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":45,"stepId":4,"type":"dialog","param":"","audio":922600077,"speaker":"？？？","content":"一艘被光辉靓丽的文明世界驱逐到无人之海的船。","res":""},{"id":45,"stepId":5,"type":"dialog","param":"","audio":922600078,"speaker":"？？？","content":"既用作监狱，也用作病院，上面有你的熟人么？接下来的报告会很冒犯。","res":""},{"id":45,"stepId":6,"type":"dialog","param":"","audio":922600079,"speaker":"？？？","content":"社会的毒瘤、渣滓……文明人有很多词形容船上的乘客。","res":""},{"id":45,"stepId":7,"type":"dialog","param":"","audio":922600080,"speaker":"？？？","content":"这很中肯，他们确实缺乏纪律性和独立能力。","res":""},{"id":45,"stepId":8,"type":"dialog","param":"","audio":922600081,"speaker":"？？？","content":"可对于他们来说，或许只是涉入了过多痛苦导致的应激反应。","res":""},{"id":45,"stepId":9,"type":"dialog","param":"","audio":922600082,"speaker":"？？？","content":"理论学家也曾跳出来澄清，也有人说他们只是理性与非理性之间的囚徒，在历史中被不断重复定义的无辜者。","res":""},{"id":45,"stepId":10,"type":"dialog","param":"","audio":922600083,"speaker":"？？？","content":"以上都是无意义的观念冲突，你可以只听我的总结——疯子，名为“疯癫”的枷锁已在他们的脖颈留下了一道道不褪的伤痕。","res":""},{"id":45,"stepId":11,"type":"dialog","param":"","audio":922600084,"speaker":"？？？","content":"现在，疯子们正在抢滩登陆。","res":""},{"id":45,"stepId":12,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":45,"stepId":13,"type":"options","param":"2#3","audio":0,"speaker":"","content":"这是一件好事#这是在散播疫病","res":""},{"id":45,"stepId":14,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":45,"stepId":15,"type":"dialog","param":"","audio":922600085,"speaker":"？？？","content":"那些游向彼岸的人欣喜若狂的表情清晰可见，还有他们在海滩上畅快奔跑留下的足印。","res":""},{"id":45,"stepId":16,"type":"dialog","param":"","audio":922600086,"speaker":"？？？","content":"自由，是的，这是一件好事。我们自此拥有作践自己的生命，糟蹋他人的尊严，以及选择拥抱荒诞和无意义的自由。","res":""},{"id":45,"stepId":17,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":45,"stepId":18,"type":"dialog","param":"","audio":922600087,"speaker":"？？？","content":"预先并可控地感染疾病也可以当作疫苗用。","res":""},{"id":45,"stepId":19,"type":"dialog","param":"","audio":922600088,"speaker":"？？？","content":"可要是有哪位无知的上将，为了新鲜的知识而将流浪的疯子捧为神，那就得戒备了。","res":""},{"id":45,"stepId":20,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":45,"stepId":21,"type":"dialog","param":"","audio":922600089,"speaker":"？？？","content":"再让我们深究一下——就像在战场的烂肉堆里捡狗牌一样。这些人生来就带疯病吗？","res":""},{"id":45,"stepId":22,"type":"dialog","param":"","audio":922600090,"speaker":"？？？","content":"在看过那么多彼此倾轧的战争后，我的个人理解是：只有知识会让人发疯，无知不会。","res":""},{"id":45,"stepId":23,"type":"dialog","param":"","audio":922600091,"speaker":"？？？","content":"疯癫，只是“知识”这一镇定剂的副作用。只要陆地上的人还食用着知识，这艘船的兵源，就不会断。","res":""},{"id":45,"stepId":24,"type":"dialog","param":"","audio":922600092,"speaker":"？？？","content":"这就是战争，文明人和疯子之间的战争，互相把对方打为异类，然后互相沾上对方的血，互相倾轧……","res":""},{"id":45,"stepId":25,"type":"dialog","param":"","audio":922600093,"speaker":"？？？","content":"直到所有人都跳进战壕里，杀作一团分不清来源的肉球。仅少数人能回避这命运。","res":""},{"id":45,"stepId":26,"type":"options","param":"4","audio":0,"speaker":"","content":"比如谁？","res":""},{"id":45,"stepId":27,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":45,"stepId":28,"type":"dialog","param":"","audio":922600094,"speaker":"？？？","content":"你后面，六点钟方向。","res":""},{"id":45,"stepId":29,"type":"dialog","param":"","audio":922600095,"speaker":"？？？","content":"那位倚靠在沉船上，既不挣扎，也不哀嚎的“加西亚”。","res":""},{"id":45,"stepId":30,"type":"dialog","param":"","audio":922600096,"speaker":"？？？","content":"海水已经侵入他的气管，呛得他眼珠红肿，而他望向陆地，就这么干巴巴地望着……","res":""},{"id":45,"stepId":31,"type":"dialog","param":"","audio":922600097,"speaker":"？？？","content":"他已经身处自己的指挥部，毫不期盼敌人的原谅。他一人成军，为自己而战。","res":""},{"id":45,"stepId":32,"type":"dialog","param":"","audio":922600098,"speaker":"？？？","content":"然后，请你再原地转体一周，一个回头的功夫，当你再看向他，他已经全军覆没了。","res":""},{"id":45,"stepId":33,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}]},"dialog_step":{"38":[{"groupId":38,"id":38001,"type":1,"content":"据我所知，乌斯怀亚最早时只有四百人，直到有一千一百名死刑犯被流放到这里。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":38,"id":38002,"type":2,"content":"是的！毕竟如我们所见，这是一座太冰冷的小镇，连雨雾都已经不是哀愁，而是能劈入你骨髓的冰棱。","name":"虚构集","avatar":"311401","chessId":2},{"groupId":38,"id":38003,"type":1,"content":"但正是因此，犯人们在小镇成为了非常重要的劳动力，他们砍树、发电，和小镇居民们一起度过寒冬。一些人被释放后留在了这里，小镇也逐渐繁荣了起来。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":38,"id":38004,"type":2,"content":"一座与流放和监狱息息相关的小镇，你不觉得这充满了某种神秘的、精妙的、无需宣之于口的魅力吗？","name":"虚构集","avatar":"311401","chessId":2},{"groupId":38,"id":38005,"type":2,"content":"在极夜的寒冷与平静中，一双能为你带来温暖的手当然也能捂热你的心。","name":"虚构集","avatar":"311401","chessId":2},{"groupId":38,"id":38006,"type":1,"content":"即使这双手来自被流放至此的死刑犯吗……？","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":38,"id":38007,"type":2,"content":"当然，即使来自一只呆头呆脑的企鹅，它当然也会是我们的朋友，经年累月，我们也可以成为家人！","name":"虚构集","avatar":"311401","chessId":2},{"groupId":38,"id":38008,"type":1,"content":"的确，我想我可以理解居民与囚犯们逐渐融合到一起的原因。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":38,"id":38009,"type":1,"content":"极地生存的不易也使得囚犯无法凭借个人的力量生存下去，理应被敬畏的大自然会教会囚犯们最简单的道理，逃跑象征的，也许就是一次死亡。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":38,"id":38010,"type":2,"content":"如此充满诗意的描述——十四行诗，我很希望你可以去试试写诗，写诗是感受的倾诉，是思维的漫步！","name":"虚构集","avatar":"311401","chessId":2},{"groupId":38,"id":38011,"type":1,"content":"思维的漫步？嗯，感谢你的建议，未来我会尝试。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":38,"id":38012,"type":3,"content":"对话结束","name":"","avatar":"","chessId":0}],"39":[{"groupId":39,"id":39001,"type":1,"content":"国家福柯学会在军政府的支持下，由学者们共同成立，旨在研究福柯的理论，进一步讨论社会配置结构……","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":39,"id":39002,"type":1,"content":"……因此，特于此报开设定期专栏，欢迎各界共同辩论。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":39,"id":39003,"type":2,"content":"这报纸的岁数看着和我差不多大，你居然能找到一份复印件出来朗读。","name":"虚构集","avatar":"311401","chessId":2},{"groupId":39,"id":39004,"type":2,"content":"嗯……科马拉全景监狱由国家福柯学会创立，是一所精神分析的实践场所。","name":"虚构集","avatar":"311401","chessId":2},{"groupId":39,"id":39005,"type":1,"content":"我读到过相关的资料，只需一名监视者就可以监视所有囚犯，因为犯人无法确认他们是否受到监视，这样的监视机制渗透进囚犯生活的每个细节。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":39,"id":39006,"type":2,"content":"精致的规训机制，权力不可见，却又将囚犯置入封闭又割裂的结构中——噢，这话来自我的笔友。","name":"虚构集","avatar":"311401","chessId":2},{"groupId":39,"id":39007,"type":2,"content":"他也说了，这对当时的政府来说是一次重要的实验。","name":"虚构集","avatar":"311401","chessId":2},{"groupId":39,"id":39008,"type":1,"content":"但在那个时代，福柯的精神分析，似乎更像一种达到目的的手段。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":39,"id":39009,"type":2,"content":"咦？那如果我早出生十几年，岂不是不需要这样费尽心思进这所监狱，宪兵真的会因为我写的小说或者说的话把我给关进来？","name":"虚构集","avatar":"311401","chessId":2},{"groupId":39,"id":39010,"type":1,"content":"……虽然我常常被评价不懂玩笑，但我现在希望你只是在说一个玩笑。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":39,"id":39011,"type":1,"content":"当时的人们面临的不只是监禁，还有失踪、拷打，甚至死亡。","name":"十四行诗","avatar":"302301","chessId":1},{"groupId":39,"id":39012,"type":2,"content":"好吧，好吧，我很抱歉，这的确是一个不合时宜的玩笑，希望你可以松开你的眉头，十四行诗。","name":"虚构集","avatar":"311401","chessId":2},{"groupId":39,"id":39013,"type":3,"content":"对话结束","name":"","avatar":"","chessId":0}],"40":[{"groupId":40,"id":40001,"type":1,"content":"你有听说过福柯吗，十四行诗？","name":"维尔汀","avatar":"300101","chessId":1},{"groupId":40,"id":40002,"type":2,"content":"是的，司辰。他是法国著名的哲学家，社会思想家。在第一防线学校的时候，我曾阅读过相关内容的书籍……","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40003,"type":1,"content":"所以这是不会被没收的那一类书籍。","name":"维尔汀","avatar":"300101","chessId":1},{"groupId":40,"id":40004,"type":2,"content":"抱歉，我没有明白……","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40005,"type":1,"content":"没什么。可以详细解释一下吗？","name":"维尔汀","avatar":"300101","chessId":1},{"groupId":40,"id":40006,"type":2,"content":"好的。福柯认为，疯癫并不是自然的产物，而是一种文化的产物。","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40007,"type":2,"content":"在早期，刑罚是一种公开的仪式，通过它，君主得以展现力量。","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40008,"type":2,"content":"现代则不然。启蒙运动时期后，惩罚变成了一种公共教育，主要的作用是打击犯罪的欲望……","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40009,"type":1,"content":"确实如此。如今，我们已经很少听到“斩首示众”类似的词汇了。","name":"维尔汀","avatar":"300101","chessId":1},{"groupId":40,"id":40010,"type":1,"content":"规训与惩罚……这么看来，第一防线学校非常符合这位哲学家的理论。","name":"维尔汀","avatar":"300101","chessId":1},{"groupId":40,"id":40011,"type":2,"content":"……咳咳。","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40012,"type":2,"content":"但德勒兹认为，另一种权力模式取代了规训的权力。那就是管理型权力。这是一个高效且冷漠的管理系统——","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40013,"type":2,"content":"管理系统掌握管理环境的权力，在这种情况下，个人的内在也不再重要。","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40014,"type":2,"content":"所以……司辰，我们忽然谈论起这个，是和狱医先生有关吗？","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40015,"type":1,"content":"没错，我一开始只是想听听你对于狱医先生刚才那番话的看法。","name":"维尔汀","avatar":"300101","chessId":1},{"groupId":40,"id":40016,"type":1,"content":"听起来，这种模式把人变成了动物。","name":"维尔汀","avatar":"300101","chessId":1},{"groupId":40,"id":40017,"type":2,"content":"好的，司辰。","name":"十四行诗","avatar":"302301","chessId":2},{"groupId":40,"id":40018,"type":3,"content":"对话结束","name":"","avatar":"","chessId":0}],"41":[{"groupId":41,"id":41001,"type":2,"content":"你为何而来？","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41002,"type":1,"content":"将军让我向您传达最新的动态。","name":"芝诺士兵","avatar":"518301","chessId":1},{"groupId":41,"id":41003,"type":2,"content":"哈，我想伊戈尔误会了什么：尽管我们如今都在这儿，但并不代表天使兄弟会和芝诺需要合作。","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41004,"type":1,"content":"桑托斯先生，传道者说过，我们每一个人都是祂的臣民。","name":"芝诺士兵","avatar":"518301","chessId":1},{"groupId":41,"id":41005,"type":2,"content":"……伊戈尔究竟派你过来干什么？","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41006,"type":1,"content":"芝诺的谍报人员拦截了一份来自基金会布宜诺斯艾利斯分部的消息。","name":"芝诺士兵","avatar":"518301","chessId":1},{"groupId":41,"id":41007,"type":2,"content":"怎么，芝诺如今有兴趣当邮差了？","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41008,"type":1,"content":"消息提到，一支基金会的舰队——包括一艘战列巡洋舰和两艘驱逐舰，以及数量可观的随行船只，已经从北方出发，正在向南航行。","name":"芝诺士兵","avatar":"518301","chessId":1},{"groupId":41,"id":41009,"type":2,"content":"你是说那些灰白格子有一支舰队……","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41010,"type":1,"content":"将军希望你们加紧人员和物资的运输，以及尽可能消耗基金会布宜诺斯艾利斯分部的人力。","name":"芝诺士兵","avatar":"518301","chessId":1},{"groupId":41,"id":41011,"type":2,"content":"我再声明一次，我不是他的下属。","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41012,"type":1,"content":"…… ","name":"芝诺士兵","avatar":"518301","chessId":1},{"groupId":41,"id":41013,"type":2,"content":"但为了传道者，为了祂，我会完成属于我的使命。","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41014,"type":2,"content":"告诉你们的将军：其他的事不用他操心，我们会为基金会的老弱舰队备好一份合格的见面礼的。","name":"桑托斯","avatar":"517801","chessId":2},{"groupId":41,"id":41015,"type":1,"content":"收到。","name":"芝诺士兵","avatar":"518301","chessId":1},{"groupId":41,"id":41016,"type":3,"content":"对话结束","name":"","avatar":"","chessId":0}]}}