"audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["玛丽没有追问“第二次”是什么意思。","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["骑着扫帚飞行是什么感觉？","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"315501.png","audio":"614002677","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["很爽快，有点像骑特种机车，就那样趴着——但还是有很多细微的不同，手腕需要调整好发力的姿势。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["就和游泳一样？","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"315501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["差不多……虽然有神秘术的保护，但风打在脸上还是很疼。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"315501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不过这些在我第一次摸到Su-01ве的时候就都明白了，整个世界天旋地转，但我却觉得这才是人本来该有的移动方式——想去哪儿就去哪儿。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"315501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["难道你不觉得飞行很爽快吗？","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["意识到自己身处天空确实很令人激动，亲爱的。","","","","","","",""],"bg":"story_atcg/4_0/4_0_at_78.jpg","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"614002714","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["地面上的世界确实很无聊，建筑物看上去永远那么庞大，门框永远比人的脑袋高出几英寸，慢吞吞的火车需要几周才能将人运到目的地。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"614002717#2|2|2|2|2|2|2|2","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["飞上天空确实可以颠覆这一切，我可以想去哪儿就去哪儿，只要做好准备，或许我会试着完成一场环球的旅途。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但我没有真正离开地面而活，从来没有。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"614002721","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我能自由地翱翔，是因为我有两位优秀的导航员，他们无暇欣赏天空的美丽，而是全神贯注地操作无线电，翻译摩尔斯密码，为我校准航向。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["也因为我的丈夫站在地面上，为我处理着地面上的琐事。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"315501.png","audio":"614002664","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……你为什么驾驶飞机？","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["维罗妮卡曾问过她这个问题，如今被她抛给了他人。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["玛丽","","","","","","",""],"head_icon":"540501.png","audio":"","bool_1":fa