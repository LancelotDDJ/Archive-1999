":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301422","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["怎么到了这里还在……打仗……","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["芝诺征兵官","","","","","","",""],"head_icon":"530701.png","audio":"613302113","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["天下没有太平的地方。<br>芝诺需要新鲜的血液，这样我们才能打败敌人，迎来和平。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["芝诺征兵官","","","","","","",""],"head_icon":"530701.png","audio":"613302114","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["要是改了主意，想为骑兵军服务，就沿着顿河向下游走，过了城就能看见我们的营地。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["征兵官背过身去，此时，又有十几个新入伍的哥萨克聚集在他身后，三五成群地与熟悉的人站在一起。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他们互相显摆着新制服，攀比着谁家的马照顾得更好，谁家的马刀来历更传奇。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["芝诺征兵官","","","","","","",""],"head_icon":"530701.png","audio":"613302115","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["好了，别像小鸡仔一样围成一团，地上有米给你们啄吗？全体都有，成行军纵队——","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["芝诺骑兵","","","","","","",""],"head_icon":"530602.png","audio":"613301589","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["——长官！","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no