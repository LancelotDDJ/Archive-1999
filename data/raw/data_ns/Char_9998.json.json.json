"behaviorTarget20":"","limit20":0,"roundLimit20":0}},"activeSkill":"1#99980111#99980112#99980113|2#99980121#99980122#99980123","passive_skill":[{"id":99980141,"name":"真·一拳超玛被动1","timeline":"","icon":300403,"desc_art":"","eff_desc":"","battleTag":"","skillEffect":30361,"skillRank":0,"notDoAction":0,"showInBattle":0,"bloomParams":"","activeTargetFrameEvent":"","preFxId":0,"heroId":0,"skillLevel":1},{"id":99980142,"name":"真·一拳超玛被动2","timeline":"","icon":300403,"desc_art":"","eff_desc":"","battleTag":"","skillEffect":30361,"skillRank":0,"notDoAction":0,"showInBattle":0,"bloomParams":"","activeTargetFrameEvent":"","preFxId":0,"heroId":0,"skillLevel":2},{"id":99980143,"name":"真·一拳超玛被动3","timeline":"","icon":300403,"desc_art":"","eff_desc":"","battleTag":"","skillEffect":30361,"skillRank":0,"notDoAction":0,"showInBattle":0,"bloomParams":"","activeTargetFrameEvent":"","preFxId":0,"heroId":0,"skillLevel":3}],"skill_ex_level":[{"heroId":9998,"skillLevel":1,"consume":"1#133027#1","requirement":"","desc":"","deviceId":0,"qteGoupId":0,"skillGroup1":"99980111|99980112|99980113","skillGroup2":"","skillEx":0,"passiveSkill":"","consume2":""},{"heroId":9998,"skillLevel":2,"consume":"1#133027#1","requirement":"","desc":"","deviceId":0,"qteGoupId":0,"skillGroup1":"99980111|99980112|99980113","skillGroup2":"","skillEx":0,"passiveSkill":"","consume2":""},{"heroId":9998,"skillLevel":3,"consume":"1#133027#1","requirement":"","desc":"","deviceId":0,"qteGoupId":0,"skillGroup1":"99980111|99980112|99980113","skillGroup2":"","skillEx":0,"passiveSkill":"","consume2":""},{"heroId":9998,"skillLevel":4,"consume":"1#133027#1","requirement":"","desc":"","deviceId":0,"qteGoupId":0,"skillGroup1":"99980111|99980112|99980113","skillGroup2":"","skillEx":0,"passiveSkill":"","consume2":""},{"heroId":9998,"skillLevel":5,"consume":"1#133027#1","requirement":"","desc":"","deviceId":0,"qteGoupId":0,"skillGroup1":"99980111|99980112|99980113","skillGroup2":"","skillEx":0,"passiveSkill":"","consume2":""}],"character_data":[{"heroId":9998,"id":1,"skinId":0,"type":1,"number":0,"title":"","titleEn":"","text":"","icon":"","estimate":"","lockText":0,"unlockConditine":"","unlockRewards":"","isCustom":0},{"heroId":9998,"id":2,"skinId":0,"type":2,"number":1,"title":"Metis's humility 墨提斯的谦逊","titleEn":"","text":"£ 1643<br><br>用料与做工似乎都与拥有者声称的价格并不相符。根据当事人口中反复强调的“动物纤维”、“合成材料”、“有机化合物”等相关用词分析，当事人似乎并不认同该饰物的珍贵。","icon":"","estimate":"1#1643","lockText":68,"unlockConditine":"","unlockRewards":"","isCustom":0},{"heroId":9998,"id":3,"skinId":0,"type":2,"number":2,"title":"Trail 彩色尾焰","titleEn":"","text":"无估值<br><br>“非常重要的研究成果，但目前尚未有成型的应用方向。”这是受访者本人对此的评价。考虑到该效果对他人目光的吸引程度，我认为它至少能作为苹果种类的重要区分标准。","icon":"","estimate":"1#估","lockText":68,"unlockConditine":"1#60","unlockRewards":"2#2#40","isCustom":0},{"heroId":9998,"id":4,"skinId":0,"type":2,"number":3,"title":"Apple 苹果","titleEn":"","text":"无估值<br><br>为了收集到受访者的相关资料，我们开放了“APPLe先生故事征集稿”特别栏目，遗憾的是，近乎所有稿件内容都只是来自读者个人的主观臆断。","icon":"","estimate":"1#估","lockText":68,"unlockConditine":"1#100","unlockRewards":"2#2#60","isCustom":0},{"heroId":9998,"id":5,"skinId":0,"type":3,"number":1,"title":"在炼金术之上","titleEn":"Above alchemy","text":"<i class=\"indent-pad\"></i>自<i class=\"story-icon\"></i>中世纪以来，关于炼金术的故事不胜枚举。有人从<br><i class=\"indent-pad\"></i>中求得了财富，有人从中求得了名望，但人们从不满<br><i class=\"indent-pad\"></i>足，他们乞求于更高的名望，更多的财富，甚至，更<br><i class=\"indent-pad\"></i>长久的生命。<br><i class=\"indent-pad\"></i>关于“贤者之石”的说法，究竟是彻底的虚构，还是<br><i class=\"indent-pad\"></i>基于过往经验的推导，已经无人关心。炼金术师们大<br><i class=\"indent-pad\"></i>多富于想象力，他们掘取着古籍中零碎的只言片语，<br><i class=\"indent-pad\"></i>编织出了一个完美的概念。这最后的一剂药引，与之<br><i class=\"indent-pad\"></i>前无数的传闻搅弄在一起，撩拨了所有人的心。<br><i class=\"indent-pad\"></i>一场炼金史上的远征开始了。","icon":"","estimate":"1#自中世纪以来","lockText":68,"unlockConditine":"","unlockRewards":"","isCustom":0},{"heroId":9998,"id":6,"skinId":0,"type":3,"number":2,"title":"以元素al-iksir作为媒介的测定记录","titleEn":"Research manuscript","text":"<i class=\"indent-pad\"></i>以<i class=\"story-icon\"></i>下内容节选、整理自某份手稿：<br><i class=\"indent-pad\"></i>实验目的：检定元素al-iksir的适用含量<br><i class=\"indent-pad\"></i>实验原理：al-iksir具有一定黏合剂作用，具备降低金<br><i class=\"indent-pad\"></i>属活性的性质<br><i class=\"indent-pad\"></i>实验方法：<br><i class=\"indent-pad\"></i>1、将物质carmot分解为高活性元素（主要为火、土、<br><i class=\"indent-pad\"></i>水、气）<br><i class=\"indent-pad\"></i>2、提纯卑金属黄铜、铅矾、生铁，静置于-24℃环境<br><i class=\"indent-pad\"></i>中自然反应，持续时间为33小时52分51分<br><i class=\"indent-pad\"></i>3、依次将100%含量、77.32%含量水溶剂、29.76%含量<br><i class=\"indent-pad\"></i>的al-iksir元素与卑金属混合，等待其自然反应<br><br><i class=\"indent-pad\"></i>……","icon":"","estimate":"1#1","lockText":68,"unlockConditine":"1#40","unlockRewards":"2#2#30","isCustom":0},{"heroId":9998,"id":7,"skinId":0,"type":3,"number":3,"title":"对于葡萄酒研究协会的匿名建议 | UTTU&APPLe","titleEn":"","text":"<table><tr><th>白雪松：</th><td>……看来我打断了你的品酒时间？</td></tr><tr><th>APPLe：</th><td>咳，……没关系。APPLe某只是在做关于葡萄<br>酒发酵的小实验。</td></tr><tr><th>白雪松：</th><td>如果我没记错的话，似乎有人匿名向世界葡<br>萄酒协会投递了一份报告，对于葡萄酒新型发酵原料<br>的选择有了重大………APPLe先生，您打算去哪？</td></tr><tr><th>APPLe：</th><td>抱歉，我对后续的事情不是很感兴趣。</td></tr><tr><th>白雪松：</th><td>即使这项成就是由您达成的？</td></tr><tr><th>APPLe：</th><td>很多人都在做这件事，这并非单个果子的成<br>就。</td></tr></table>","icon":"","estimate":"1#就","lockText":68,"unlockConditine":"1#80","unlockRewards":"2#2#50","isCustom":0}],"character_level":[{"heroId":9998,"level":1,"hp":999999,"atk":999999,"def":275,"mdef":275,"technic":250,"cri":0,"recri":0,"cri_dmg":1300,"cri_def":0,"add_dmg":0,"drop_dmg":0},{"heroId":9998,"level":30,"hp":999999,"atk":999999,"def":2200,"mdef":2200,"technic":2000,"cri":0,"recri":0,"cri_dmg":1300,"cri_def":0,"add_dmg":0,"drop_dmg":0},{"heroId":9998,"level":70,"hp":999999,"atk":999999,"def":2475,"mdef":2475,"technic":2250,"cri":0,"recri":0,"cri_dmg":1300,"cri_def":0,"add_dmg":0,"drop_dmg":0},{"heroId":9998,"level":120,"hp":999999,"atk":999999,"def":2750,"mdef":2750,"technic":2500,"cri":0,"recri":0,"cri_dmg":1300,"cri_def":0,"add_dmg":0,"drop_dmg":0},{"heroId":9998,"level":180,"hp":999999,"atk":999999,"def":2750,"mdef":2750,"