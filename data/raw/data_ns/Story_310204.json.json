","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["伊戈尔将军与他的子女们很少像那样聚在一起。","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["洛佩拉","","Lopera","","","","",""],"head_icon":"","audio":"612003552","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["哥伦比亚也好，巴西也好，我都不在乎，芝诺才是我的家。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["罗德里戈好像没有听明白女孩说了什么，为此他甚至停下了寻找桑德罗的脚步。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"612003581","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你错了，小鸟，一支军队怎么能成为你的家呢？","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我也在军队服役过，但我不认为这和在工厂上班有什么区别，都只是来历不同的人聚在一起共谋生路罢了。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["许多年前，有人对我说：“到军队去吧，结识几个好兄弟，到时候在里约没有人敢看不起你。”","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"612003566","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可我退役之后的日子并不好过，没有哪个“好兄弟”愿意帮帮我。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那时候我又听人说：“老弟，去圣保罗吧，那里的汽水工厂能赚美元呐。你的孩子不会受苦啦。”","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我刚去不久工厂就倒闭了，最后一个月的工钱都没拿到，后来才知道原来是我的工友偷偷分掉了我的那一份。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["罗德里戈两只大手一拍，仿佛在制造一个激烈的休止音。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["最后我全搞懂了——这世上除了真正的家人，没有人会在乎你。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["一旦战争结束，工厂倒闭，你就得灰溜溜地滚蛋了，接下来便是成天为孩子们吃什么而发愁。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["洛佩拉","","Lopera","","","","",""],"head_icon":"","audio":"612003520","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["等等，你还有个孩子？","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["罗德里戈张开大手，在洛佩拉头顶轻轻一扫。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"612003565","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没错，一个女儿，和你一个岁数。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"612003582","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不过她死在里约了。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["洛佩拉","","Lopera","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……抱歉。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["男人挂上一副微笑——他不愿让女孩接下如此沉重的话题。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是我的错，我不该去当兵的，不然那帮毒贩子也不会为了报复我而杀她。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她一定去了天堂，用她那软磨硬泡的方式让上帝赐给了我一艘小船。瞧，我已经是蒙受过恩典的人啦。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["也许某天我也会像突然遭雷劈了一样，决心一辈子生活在船上。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["罗德里戈","","","","","","",""],"head_icon":"","audio":"612003566","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但现在还不是时候，我还得帮你找到桑德罗，对吧？","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["洛佩拉","","Lopera","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["对……得快点找到桑德罗。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"33":{"type":0,"name":["","","","","","","",""],"hea