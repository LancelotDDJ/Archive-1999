e":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301397","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["唉，再往前走走吧，这里怎么看都不像是能休息的地方……你觉得车夫给我们的地图可靠吗？","","","","","","",""],"bg":"","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["卡戎","","Charon","","","","",""],"head_icon":"","audio":"613300310","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你说的是哪一个车夫？","","","","","","",""],"bg":"","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301398","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301399","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我还是再帮你回忆一下之前发生的事吧，这已经是第不知道多少次了，卡戎。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301400","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["就从离开波兰之后说起，我们稀里糊涂地搭上了一辆满是捷克斯洛伐克人的火车，和他们一起往东走。","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["卡戎","","Charon","","","","",""],"head_icon":"","audio":"613300311","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["是因为稀里糊涂吗？好像是他们告诉你，再往东走就不会见到黑衣的军队，然后你就吵着要上车了。","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301401","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢……这你倒记得了。总之他们让我们上车，可还没走多远，火车就被另一伙不知道是什么的人拦下来了。","","","","","","",""],"bg":"","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301402","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["再之后，到处都是枪响。我们去载马的车厢把安德烈森救走，趁乱往南逃了。","","","","","","",""],"bg":"","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["安德烈森","","","","","","",""],"head_icon":"528101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["咴咴……","","","","","","",""],"bg":"","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["战马对那场惊心动魄的营救行动仍然心存感激。","","","","","","",""],"bg":"","choice":[]},"120":{"step":[[120,121,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301403","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["之后就是我说的那个车夫，他丢了一匹马。","","","","","","",""],"bg":"","choice":[]},"121":{"step":[[121,122,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301404","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们和他商量了一个办法——安德烈森借他拉一天的车，而他要告诉我们往哪里走更安全。","","","","","","",""],"bg":"","choice":[]},"122":{"step":[[122,123,""]],"type":1,"name":["卡戎","","Charon","","","","",""],"head_icon":"","audio":"613300312","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那么，这确实是一个安全的地方，四周都很安宁。","","","","","","",""],"bg":"","choice":[]},"123":{"step":[[123,124,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301405","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但我要的安全不是这种啊！——再找不到有人的地方，我们，不对，只有我会饿死在路上的。","","","","","","",""],"bg":"","choice":[]},"124":{"step":[[124,125,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["不用进食的亡者低下头，仿佛是在为自己考虑不周而失落。<br>安德烈森也别过脑袋——它倒是能靠嚼草根过活。","","","","","","",""],"bg":"","choice":[]},"125":{"step":[[125,161,""]],"type":1,"name":["梅蕾尔","","","","","","",""],"head_icon":"","audio":"613301406","bool_1":false,"show_