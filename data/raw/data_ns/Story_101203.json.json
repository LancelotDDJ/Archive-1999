13301613","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["比起渠道，更重要的是供应者——除芝诺本身之外，有谁掌握芝诺装备？","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["斯捷尔诺娃","","","","","","",""],"head_icon":"","audio":"613301233","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["也许是重塑之手在其他战场缴获了我方的武器，然后把它们提供给了顿河的匪军。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300754","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["把一切都推给重塑之手确实是个省事的思路，不过我看这种可能性并不是很大。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300755","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["匪军里的人类多到能让基金会心花怒放。相比合作，重塑之手应该更想把他们一起消灭。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300756","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["另外，匪军在遭受损失之后就立刻逃跑，他们没有表现出受重塑之手控制的那种疯狂的进攻性。","","","","","","",""],"bg":"","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300757","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我们还是谈谈另外一种可能性吧——有没有可能是伊戈尔的叛军？","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["骑兵军将领们的表情凝固了一秒，就连烛光也突然静滞。<br>可抛出话题的中尉却仿佛与空气中的情绪完全隔绝。","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"613300758","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["他也有能力从非常规渠道投送人员和武器，对吧，军长？我记得你以前在伊戈尔手下干过。"