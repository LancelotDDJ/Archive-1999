:[]},"9":{"step":[[9,10,""]],"type":1,"name":["仪式术士","","","","","","",""],"head_icon":"","audio":"613301982","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["十一、十二……一共十三名神秘学家。遗憾的是，潜入城市的部队已经失去了联络，权且当他们已经死去吧。","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,49,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["术士对昨夜的“收获”十分满意。她点了点头，随后勾了勾手。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529911.png","audio":"613301160","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["唔——！","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["仿佛有一条看不见的锁链套上了他的脖子，谢尔盖和其他十二个被俘的神秘学家被无形之力牵扯着向前。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["渐渐地，谢尔盖感觉一阵极寒从脚踝缠上了他。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529910.png","audio":"613301161","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["嗯？","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他低下头，发觉脚下踩着的泥土竟被无来由的寒意冻得僵硬，粘住了他的鞋子，让他动弹不得。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["仪式术士","","","","","","",""],"head_icon":"","audio":"613301983","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……你这是什么意思，将军？","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["格鲁托夫转了转手腕，面露不悦。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301352","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你没经过我的允许，就擅自派遣重塑之手的士兵潜入城市。这不是我想看到的合作态度。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["仪式术士","","","","","","",""],"head_icon":"","audio":"613301984","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们要明确一点，重塑之手的军队不受你的指挥。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_19.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["仪式术士","","","","","","",""],"head_icon":"","audio":"613301985","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你执意要调走主力进攻伊戈尔，这已经严重扰乱了我们在顿河的任务。这也不是我们希望看见的合作态度。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["仪式术士","","","","","","",""],"head_icon":"","audio":"613301986","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["现在，那帮飞行巫师正在一个接一个地破坏术阵的节点，大规模战争也导致神秘学家大量外逃……","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301353","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["伊戈尔就躲在骑兵军的塞契里，等我的主力开到，他的生命和他的军队很快就会走到尽头。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301354","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["至于骑兵军则更是不值一提。顿河很快就会完全掌控在我的手中，到那时你们想在顿河做什么都随便。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301355","bool_1":false,"sh