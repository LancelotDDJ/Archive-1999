png","audio":"613301022","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们到的地方比预定的侦察点要远很多，它们一定都累坏了。你绝不能累坏自己的马。","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300705","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["那就按你说的，休息一下。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300412.png","audio":"613300706","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["对了——下次拿着望远镜的时候别对天瞎看。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300413.png","audio":"613300707","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["要是反光再晃到我的眼睛，我就用导弹轰你。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529918.png","audio":"613301023","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["好、好吧，我下次一定不会了。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,109,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_03.jpg","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["中尉收起望远镜，交给身旁的谢尔盖。她敏捷地翻身下马，从鞍袋中拿出一捧事先备好喂马用的燕麦。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_03.jpg","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["战马","","","","","","",""],"head_icon":"528102.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["咴。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["马儿喘着气吃完了一捧燕麦，随后又贪婪地用鼻子使劲蹭上红弩箭的颈窝。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300708","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["嘿——你还想吃吗？","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["正当她打算再取一些食料的时候，谢尔盖靠上前来。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301024","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这匹马是你第一次骑吧，中尉？","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300709","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["没错，我想它要饿坏了。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301025","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没有这样的事，它是个狡猾的贪吃鬼，别把它喂得太好了。它得学会自己去嚼草根。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300710","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你听见了，这可不能怪我——去喝水吧。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["红弩箭稍微用力地拍了拍马脖子，遭到拒绝的马儿垂头丧气地摇晃着脑袋，冲着谢尔盖打响鼻。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["芝诺骑兵Ⅰ","","","","","","",""],"head_icon":"530401.png","audio":"613301920","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["把它交给我吧，中尉。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["另一位士兵上前来，卸下被固定在马背上的飞行扫帚，随后将闹脾气的马牵去河边饮水。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["飞行女巫将扫帚安放在身边，在与季节不符的温暖空气中，她嗅到尤为浓烈的河水腥气与苦艾的干涩气味。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301026","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这真的很不对劲，十一月的日子不应该这么暖和——你见过这样的冬天吗？","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300711","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我在十一月见过夏天，但那是在地球另一头。现在这儿的天气确实有些怪。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301027","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没错，早就该下雪了，可天气还像刚入秋那样。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["青年抬手，抹去额头的汗水，指着面前泛着青光的河流。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301028","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果不是这样的天，再过几个星期，河面应该要上冻了，我们可以直接从浅滩走过河。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301029","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["过河之后，再往前走一点就可以看见顿河的拐点，到那时，沿着河流往上走，就到了别列格勒。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301030","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你去过城里吗？","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["城里——对生活在这片草原上的人来说，这座城指的就是别列格勒。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300712","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["基金会在城里有分部，我偶尔会去送些信件，或者处理一些烦人的手续。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301031","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["说起信件——一些上前线的同村人给家人来信了，听说他们正在回家的路上。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["谢尔盖摇摇头，似乎并不太认同同乡返家这件事。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300713","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["怎么，和你邻里关系不好，不想见他们？","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301032","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["怎么能这么说呢，我和谁的关系都好，我很开心他们能活着回来。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301033","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我是在想，就算这时候回家，也没有地可以种了。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["年轻的哥萨克就地蹲下，用力抓了一把脚边的牧草。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529911.png","audio":"613301034","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["天气是暖和，但这小麦像中邪了一样，还没到新年呢，秆子就蹿得老高，眼瞧着都要枯了——但它偏偏又不结穗。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529916.png","audio":"613301035","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["夏天那茬粮食收成又差得没眼看，我们村里的谷仓都快空了……留在边境至少饿不死。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,107,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300714","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你想得太简单了，重塑之手的军队可能会出现在任何地方，没有地方是安全的。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301036","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["重塑之手会打到顿河来吗？","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300715","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["现在他们的主力都在西欧，但他们就像老鼠一样，在你觉得很干净的地方，突然冒出来一大窝。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["新入伍的骑兵有些毛躁地抓着还没个影子的胡须。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301037","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["自从加入芝诺以来，我还没有打过一场像样的仗。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301038","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["成天只等长官一声令下——“嘿，谢尔盖，去找找那些土匪藏在哪里？”可怜的谢尔盖就要跑断腿了。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301039","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["土匪哪里是那么好找的，又不像咱们骑兵军有个大营地。那都是些缩在林子里的几十号人，到了夜里就去打家劫舍。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300716","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那你觉得打仗是怎么回事？","","","","","","",""],"bg":"","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301040","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我知道打仗是怎么回事。我的爷爷，我的父亲，还有我哥哥，都上过战场。","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["青年并没有很好地回答红弩箭的问题，他尴尬地移开视线，看向红弩箭一直放在身边的飞行扫帚。","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301041","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["下一个渡河的浅滩还要再走几里才能到，为什么你不飞过去看一眼呢，中尉？","","","","","","",""],"bg":"","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301042","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这样我们的侦察任务就算完成了，天黑之前就可以回营，不需要在外面过夜。","","","","","","",""],"bg":"","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300717","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["红色38吃的可不是草料，我没有多少燃料用来浪费。另外，它的飞行时长是按分钟计算的。","","","","","","",""],"bg":"","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300718","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我可不想在真正遇到敌人的时候，驾驶一架超过保养寿命的扫帚。","","","","","","",""],"bg":"","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301043","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果你教会我怎么用飞行扫帚，是不是就能多申请一架Su-01ве？我们可以轮流飞行。","","","","","","",""],"bg":"","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"300401.png","audio":"613300719","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我很想看你从天上掉下来的样子，可我不想和军长说你手底下的骑兵在我的扫帚上摔断了一条胳膊。","","","","","","",""],"bg":"","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301044","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["别忘了，你刚来的时候也不会骑马，是斯捷尔诺娃上校教你才没有从马上摔下来。","","","","","","",""],"bg":"","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"529901.png","audio":"613301045","bool_1":false,"show_name":tru