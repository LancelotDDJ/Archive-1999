e":true,"show_name_en":true,"no_l2d":true,"text":["您是说，城堡里的骑士是幽灵？","","","","","","",""],"bg":"","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001804","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["没有人知道那是什么，但几百年前的骑士突然出现，我认为不是幽灵就是食尸鬼。","","","","","","",""],"bg":"","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001805","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["只有猎人哈罗见过。他说自己只是靠近了城堡的外围就被骑着扫帚的女巫发现，然后从黑暗里冒出来的骑士把他打成了瘸子。","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["班纳特夫人","","","","","","",""],"head_icon":"537901.png","audio":"614001730","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["从小哈罗嘴里蹦出的任何一个字我都不信！","","","","","","",""],"bg":"","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["班纳特夫人","","","","","","",""],"head_icon":"537901.png","audio":"614001731","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他从小手脚就不干净，肯定是贪图亚瑟王的宝藏，惊扰了那些英雄和圣徒的安眠。","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["班纳特夫人","","","","","","",""],"head_icon":"537901.png","audio":"614001732","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你母亲难道没有告诉过你，“你只可在围墙外祈祷和跪拜，凡是擅入城堡者，凡是贪图卡美洛的宝藏者，灵魂定会受到圆桌骑士的裁决。”","","","","","","",""],"bg":"","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001806","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我一直以为那是怕我们掉下城堡地窖，编出来吓唬小孩的。谁见过亚瑟王的宝藏？老威，你见过吗？","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[94,95,""]],"type":1,"name":["伯恩","","","","","","",""],"head_icon":"","audio":"614001614","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["当然没有，我一直只在城堡门外祈祷。","","","","","","",""],"bg":"","choice":[]},"95":{"step":[[95,96,""]],"type":1,"name":["班纳特夫人","","","","","","",""],"head_icon":"537901.png","audio":"614001733","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你是个好孩子，威廉。","","","","","","",""],"bg":"","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["班纳特夫人","","","","","","",""],"head_icon":"537901.png","audio":"614001734","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我相信你没有擅自进入城堡，不然你早就像裁缝铺的菲尔一样，把自己的灵魂留在了城堡里，从此成为幽灵的傀儡。","","","","","","",""],"bg":"","choice":[]},"97":{"step":[[97,98,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001807","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["班纳特夫人，我们都是看着菲尔长大的，都知道那孩子本来就脑袋不太灵光，没有继承他母亲的神秘术，只继承了那股疯劲儿。","","","","","","",""],"bg":"","choice":[]},"98":{"step":[[98,99,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001808","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["只是，他从古堡转了一圈回来脑袋就更不灵光了，总是叫着“我是莫德雷德爵士……不，吾乃太阳骑士，勿要熄灭那盏日光！”","","","","","","",""],"bg":"","choice":[]},"99":{"step":[[99,100,""]],"type":1,"name":["伯恩","","","","","","",""],"head_icon":"","audio":"614001615","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可怜的孩子……","","","","","","",""],"bg":"","choice":[]},"100":{"step":[[100,101,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001809","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["要我说，除了总不让人关灯以外，菲尔也没什么问题，昨天清醒的时候还在改礼服裤子呢。","","","","","","",""],"bg":"","choice":[]},"101":{"step":[[101,102,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"614001036","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["除了骑士和女巫之外，您还听说了什么吗，比如说……盲眼的仙女？","","","","","","",""],"bg":"","choice":[]},"102":{"step":[[102,103,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001810","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["哈罗倒是说过，是湖中仙女阻止了骑士，还给了他药物，否则他就不只是瘸子了。","","","","","","",""],"bg":"","choice":[]},"103":{"step":[[103,104,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001811","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但过了几天，他又说骑士拿剑柄打了他之后，就让他滚开了。","","","","","","",""],"bg":"","choice":[]},"104":{"step":[[104,105,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001812","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["也不知道怎么，这件事突然就传开了。人们都说城堡里住着湖中仙女，至于为什么蒙着眼睛，可能是不忍心看见世间的罪恶。","","","","","","",""],"bg":"","choice":[]},"105":{"step":[[105,106,""]],"type":1,"name":["班纳特夫人","","","","","","",""],"head_icon":"537901.png","audio":"614001735","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["再给我一杯金酒，小奥利弗。","","","","","","",""],"bg":"","choice":[]},"106":{"step":[[106,107,""]],"type":1,"name":["酒馆老板","","","","","","",""],"head_icon":"538603.png","audio":"614001813","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我必须拒绝您，夫人，再来一杯您就会醉倒在我的吧台上。","","","","","","",""],"bg":"","choice":[]},"107":{"step":[[107,108,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["酒馆老板回到吧台后，继续擦起了啤酒杯。","","","","","","",""],"bg":"story_bg/4_0/4_0_bg_12.jpg","choice":[]},"108":{"step":[[108,109,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"614001037","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["伯恩先生，您知道有什么方法可以避开那些骑士，进入城堡吗？","","","","","","",""],"bg":"","choice":[]},"109":{"step":[[109,110,""]],"type":1,"name":["伯恩","","","","","","",""],"head_icon":"","audio":"614001616","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我说过，现在可不是进入城堡的好时候。","","","","","","",""],"bg":"","choice":[]},"110":{"step":[[110,111,""]],"type":1,"name":["伯恩","","","","","","",""],"head_icon":"","audio":"614001617","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而且比起复活的骑士、盲眼的仙女，我觉得更值得警惕的是，附近的神秘学家多了起来。","","","","","","",""],"bg":"","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["伯恩","","","","","","",""],"head_icon":"","audio":"614001618","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这对小镇来说不算什么新闻，毕竟这里曾经是卡美洛，从古到今，神秘学家都在这里来来去去。","","","","","","",""],"bg":"","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["伯恩","","","","","","",""],"head_icon":"","audio":"614001619","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但没有人看到那群神秘学家是怎么出现的，他们没有开着汽车，也没有乘着船，简直像是凭空出现。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["伯恩","","","","","","",""],"head_icon":"","audio":"614001620","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这也是你们来这里的原因吧，维尔汀，还有这位飞行员小姐？","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["红弩箭","","Lilya","","","","",""],"head_icon":"","audio":"614000067","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["您的眼光很敏锐，先生。","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["小瑞安侬","","Rhiannon","","","","",""],"head_icon":"","audio":"614000361","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["其实维尔汀她……","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"614001038","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["我和红弩箭都隶属于圣洛夫基金会，我们来到这里，确实是为了调查那群突然出现的神秘学家，您或许听过他们的名字，重塑之手。","","","","","","",""],"bg":"","choice":[]},"117":{"step":[[117,118,""]],