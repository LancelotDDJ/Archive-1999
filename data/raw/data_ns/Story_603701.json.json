["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["接近死亡的途径不止一种。跟我来，我们可以去一场更伟大的仪式。","","","","","","",""],"bg":"story_bg/3_7/3_7_bg_31.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["平","","","","","","",""],"head_icon":"640701.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你是想……！你也疯了？","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,63,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["蟹壳的纹路因恼火而更加扭曲，平转过身，向着相反的方向走去。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_atcg/3_7/3_7_at_rouge_01.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["河道上的景象与几小时之前迥然不同，人们在塞纳河的两岸游行，怪异的欢庆场景和雨幕连成模糊的一片。","","","","","","",""],"bg":"story_atcg/3_7/3_7_at_rouge_01.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那些狂热也推涌着河水，将渡船拍打得微微摇晃。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["意识唤醒者站在船头，难得地主动开口。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你看，他们一直这样。为明天的口号而高兴，为今天的工钱而愤怒，先为自己寻求束缚，再为自己寻求解脱。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他们往自己脚下堆砌了无尽的柴薪，支撑着变幻的喜怒——直到他们将自己葬身于火焰中，宣称获得了灵魂的自由。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["当我还是一盏灯时，我就对这些习以为常了。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但是你的情感又不太一样，你的情绪很纯粹，也还很崭新。对我这种初学者来说，你这种情感肯定更好学、更好理解。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["珐琅眼茫然地看向水面。提灯的大人很少说这么多话，既没有提问，也不像训斥。","","","","","","",""],"bg":"story_atcg/3_7/3_7_at_rouge_01.jpg","choice":[]},"37":{"step":[[37,68,""]],"type":1,"name":["珐琅眼","","","","","","",""],"head_icon":"314412.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我……不知道。大帽子们很好，他们说……我可以做到，我要——","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["提灯大人的火焰点亮了周围的河水，珐琅眼感觉自己似乎正坐在一只漂荡的灯盏上。","","","","","","",""],"bg":"story_atcg/3_7/3_7_at_rouge_01.jpg","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["珐琅眼","","","","","","",""],"head_icon":"314412.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["死、死亡是，超脱秩序。死亡是，体验，新启发，为了我们的主权……","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["哈哈。你还真的信他们那一套。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["哦，我发出了他们在……笑的声音，这应该是我开心的表现。你再多说几句吧，我的确有了一些新的冲动……把你带过来果然是正确的决定。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,66,""]],"type":1,"name":["珐琅眼","","","","","","",""],"head_icon":"314413.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["ㄕˋ，是的，死亡是……正确的决定，无畏的死亡，是绝佳的……","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["雨越下越大，岸边的声音也逐渐被掩埋在雨水里。珐琅眼紧紧攥住手里的帽子，余光里只剩下火焰湛蓝的光泽。大人的声音像是从远方传来。","","","","","","",""],"bg":"story_atcg/3_7/3_7_at_rouge_01.jpg","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["对。我现在也不在意未竟的疑惑了，“不在意”也是一种崭新的感觉，然而，不再在意后，答案就向我敞开——","","","","","","",""],"bg":"story_atcg/3_7/3_7_at_rouge_01.jpg","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["灯油或柴薪都不是燃烧的关键，也不是情感的钥匙。一场雨才是——火的愿望就是熄灭在雨中。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,71,""]],"type":1,"name":["火渡船","","","","","","",""],"head_icon":"640601.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["雨真大。你脸上都是水。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,70,""]],"type":1,"name":["珐琅眼","","","","","","",""],"head_icon":"314413.png","audio":"","bool_1":false,"show_name"