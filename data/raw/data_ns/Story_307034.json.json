 ","","Black Dwarf","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但他并未观测到星体上的生物，而是——发现了被天文学家忽视、遗忘的一颗行星，从此声名鹊起，举世瞩目。","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["伽菈波那 ","","Black Dwarf","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["“你对失去高位如此恐惧，以为它的好处无可替代；而好处，却往往另辟蹊径，降临在你身旁。”","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["伽菈波那 ","","Black Dwarf","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["“命运啊，喜爱这种颠倒的把戏，它使你朝着一个方向掷出希望的种子，但最终却在你未曾意想的地方，长出一棵参天大树。”","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["夜幕降临，星光显现。你深叹一口气，无垠的宇宙并未如期给予回应。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["幸运之神没有眷顾你，根本不存在尚未被发现的恒星……","","","","","","",""],"bg":"","choice":[]},"14":{"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"15":{"step":[[15,1,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"info":{"title":"伽菈波那玩法剧情34","start":15}}