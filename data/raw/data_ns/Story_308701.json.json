":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["阿夫西维","","Авксивий","","","","",""],"head_icon":"307801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["彼得森说不对，“永恒的灵魂”是一件永远不会变脏的好衣服，他的妈妈在礼拜堂见过。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["阿夫西维","","Авксивий","","","","",""],"head_icon":"307801.png","audio":"610019392 ","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["可是衣服不能保护人呀。叶甫根尼变成海燕的时候也穿着衣服，我这样告诉彼得森，他就像煮开的水壶一样突突地跳走了。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["阿夫西维","","Авксивий","","","","",""],"head_icon":"307801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["问其他人，他们也不知道。命名日说维拉知道，我想，你有漂亮的尾巴，也没有变成泡沫，那一定是这样。","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["","","","","","","",""],"head_icon":"623916.png","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["维拉睁大了眼睛。半晌，她停下来，转过身。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["维拉","","Вила","","","","",""],"head_icon":"308701.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["泡沫……嗯。我知道你在说什么了，是那个童话，对吗？","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["维拉","","Вила","","","","",""],"head_icon":"308701.png","audio":"6208712","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["是的，它可能的确脱胎自鲁萨尔卡的传说，或者我们可以说它源于偏见。","","","","","","",""],"bg":"","choice":[]},"86":{"step":[[86,87,""]],"type":1,"name":["维拉","","Вила","","","","",""],"head_icon":"308701.png","audio":"610019375","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但那归根结底其实都只是，故事……","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["","","","","","","",""],"head_icon":"623916.png"