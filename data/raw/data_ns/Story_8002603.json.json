,"audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["无论是亲身经历还是撰写的故事，咱们得让这次沙龙热闹起来！","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果没人愿意说的话，我也可以勉为其难地再讲一遍我横穿墨西哥边境的命运之旅……","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["“哗啦——”","","","","","","",""],"bg":"story_bg/2_6/2_6_bg_jianyu.jpg","choice":[]},"13":{"step":[[13,14,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["寡言的男性率先站起身，所有人的视线都集中于他那高大颧骨下的阴霾。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["这是一个意料之外的转折。<br>没有人注意到人群身后的阴影。","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我的前半辈子是个银行柜员。有一天，我坐在柜台的玻璃罩里，望着一沓接一沓的支票、文件、传单，我忽然觉得这是一场无期徒刑。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我辞了职，打算回家写点儿什么。妻子知道了之后，起初是大吵大闹，之后是微缩文明的世纪冷战，最后是一个单方面的驱逐令。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我喝了个大醉，在街上给一个殴打乞丐的混账军官结结实实地来了一拳，后面的事儿不记得了。恢复意识以后，我就已经来到了这儿，一个比家更像家的地方。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["理想家先生喂我喝了点儿水，并建议我给阿莱夫写信。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我照他说的做了。我写了信，问了问题。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["两周之后，我收到了回信。上面只有一行字，我仍在试图领悟其中的道理。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>“在人生的有限时间里，存在一个无限延伸的楼梯，而终点，不过是一片寂静的水域。”</i>","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["胡利奥，我都不知道你有这么一段精彩的过去。之前怎么没听你提起过？","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601745","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我也不知道……原来你也给阿莱夫写过信。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["奥克塔维奥，也许你的课题是对的。像你这样充满朝气的青年作家，应该怀着改变社会的梦。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["胡利奥","","","","","","",""],"head_icon":"519801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不要像我一样，到了这个岁数才真正决定拿起那杆笔。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……噢？","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,58,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["代理主持人已沉迷在故事会中，逐渐忘怀了那个原本严肃的主题。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["罗贝托","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["很好，接下来总归轮到我来分享横穿墨西哥边境……","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["囚犯Ⅲ","","","","","","",""],"head_icon":"523101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["省省吧！你那点儿故事我都听过七八个版本的了。甚至还没算上短篇小说集里的那五篇——","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["囚犯Ⅲ","","","","","","",""],"head_icon":"523101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你把一个故事写了整整五遍，其差异性不过只是视角上的转换！","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["加西亚","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["重复性叙事的确也是文学批评中的一个重要课题——","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["余下的时间里，囚犯陷入了喧哗与骚动的故事会中。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["唯有德洛丝医生默念了一遍那个唐突的名字。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,59,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"","audio":"612601722","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“阿、莱、夫”……？","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>胡利奥先生的往事是一份意料之外的收获，它很适合编撰为一本传记。在下一次的投稿中，我会将它作为一份珍重的材料使用。</i>","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>回过神来，这场文学沙龙令我已经逐渐忘记了自己正身处监狱之中的事实。</i>","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>我会在写作中毫无保留地描绘我所认知与经历的一切。至于他们是否是真正的囚犯，这将交由敬爱的读者们来评判。</i>","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>那时，我并未听由直觉去询问他们进入监狱的理由，而是如他们一般，思考着更为纯粹的事物。</i>","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["<i>如今，当我回忆起整段旅程，那些盘根错节的魔鬼涎呈现出一种相互联结的构造。</i>","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["就在沙龙进行得如火如荼之时，阴影中浮现出一张脸庞，其中只有笑容清晰可见。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["理想家","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我很少以旁观者的视角，来接纳沙龙每一种别有趣味的象征、每一个细枝末节的隐喻。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["理想家","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["现实与非现实的桥梁，典型与非典型的诗意！<br>这正是我在创办之初对于“美洲诗社”的设想。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["新到来的囚犯吸引了医生的注意力。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["现实与非现实……您指的是纪实文学与虚构文学的差异性吗？<br>我想，我还未能完全理解您的深意……","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["理想家","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢，但你至少能够理解其中的部分，不是吗？由此可见，我们共同行走在一条追求始终如一的美学的道路上！","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["理想家","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们是文学王国的臣民，我们是追逐第一束抵达新大陆边界的光的观星者，我们是在树下望着纯粹的理想之果而流涕的孩子。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["理想家","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——以创办者的名义，我诚挚地邀请您加入<i><b>美洲诗社</b></i>，成为我们中的一员。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["加入……<i><b>美洲诗社</b></i>？","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一个无可挑剔的绅士礼，一份难以拒绝的盛情邀约。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["这里的一切都别有奥妙——眼前的文学盛会、萦绕着奇异氛围的建筑，还有那位神秘的收信人。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":2,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["不可多得的良机，医生对自己说。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518510.png","audio":"612601723","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……我愿意答应您的邀请，参与各位的集会与活动。","","","","","","",""],"bg":"","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518501.png","audio":"612601724","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但我还有一个问题，理想家先生。<br>——您自称为创办者，我猜您就是那位“理想家”，对吗？","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["理想家","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但问无妨。","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["德洛丝","","","","","","",""],"head_icon":"518511.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["您能告诉我关于“阿莱夫”的事情吗？","","","","","","",""],"bg":"","choice":[]},"56":{"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"59":{"step":[[59,