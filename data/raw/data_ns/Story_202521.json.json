00186","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你说得对，我搞砸了。你说我的计划有很多漏洞……那是当然的，因为所谓的“计划”从一开始就被打乱了。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["斯考特","","","","","","",""],"head_icon":"","audio":"612500187","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我把东西藏在空脑袋那里后，才得到基金会已经发现了我所作所为、开始调查的消息。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["斯考特","","","","","","",""],"head_icon":"","audio":"612500188","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我只好故意把嫌疑引向这个笨蛋，但没想到那盘胶片居然被她不小心装进了行李里，带来了洛杉矶……而我居然被委派成了追查这件事的人。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["斯考特","","","","","","",""],"head_icon":"","audio":"612500189","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我早就联系好了这个中间人，交易的地点正好是洛杉矶，我想这也许是个机会，能够让我按照原计划把胶片出手……","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["斯考特","","","","","","",""],"head_icon":"","audio":"612500190","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但现在看来，正是这份贪婪……和对这个笨蛋的优柔寡断，导致了节外生枝。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她剐了空脑袋一眼，但很快移开了目光，像是不屑，又像是躲闪。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["空脑袋","","Loggerhead","","","","",""],"head_icon":"","audio":"612500392","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["可是……可是……","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["空脑袋","","Loggerhead","","","","",""],"head_icon":"","audio":"612500393","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我们不是朋友吗？","","","","","","",""],"bg":"","ch