icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["梅兰妮脱力般地坐回椅子上，用手扶住额头。","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那您一定也在办公室里看到了我关于《足球比赛》的全部计划。<br>我把它们全都写了下来，还按字母顺序排好了参考文献，就摊在台面上！","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["可您还是上天台来了，我不理解……","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["范恩斯苦笑着摇了摇头，打断了滔滔不绝的年轻女孩。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610007175","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["梅兰妮，你很像你的父亲。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"610007133","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我……像他？这不可能。","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他常说，安保员的职责是完成客户的交付，此外全都无关。他眼里只有进攻和防卫的挑战。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610009029","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而你在听完安保业和古董交易的内幕后，关心的也还是你的谜题。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"610007085","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不，这只是我习惯了做题……","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["最重要的是，你们都视这项活动为自我挑战。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["范恩斯陷入了久远的追思中。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你父亲是一个真正的艺术家。他死后，一切都变得索然无味。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610007174","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我承认，最初我只想报复拉米雷斯——但后来我转变了想法。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610007160","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["梅兰妮，你很聪明，很好学，而且相当细心，不会看漏任何一个机会。<br>这些都是极其宝贵的素质，所以我会去天台上见你。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610007173","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——你要不要来做大盗？","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"610007126","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["啊？！ ","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你有这个天赋。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"610007091","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["范恩斯先生，我对非法占有他人物品并没有兴趣！","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["梅兰妮涨红了脸。显然，她从未想过会收到这样一份犯罪录取通知书。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["范恩斯耸了耸肩。显然，他对这一提议也只是随便说说。","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610007176","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那你可以继续经营拉米雷斯。你是一个优秀的计划者。","","","","","","",""],"bg":"","choice":[]},"86":{"step":[[86,87,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不……我不是一个很好的出题人，也缺乏经营的经验。","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你能从小偷的角度思考，这是很罕见的。","","","","","","",""],"bg":"","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你父亲常说，尊重你的对手，换回对手的尊重。仅凭这一点，他就胜过了无数艾弗森。","","","","","","",""],"bg":"","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"610007134","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["可这不公平。","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["父亲尊重对手，却被视为和小偷同流合污。拉米雷斯和新人类都弄丢了展品。我们被视为行业耻辱，父亲被逼到自杀……新人类呢？","","","","","","",""],"bg":"","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["没人指出《安保指南》的漏洞！所有人都信了他们的说辞。人们被那几台笨头笨脑的机器人吸引了全部注意，而一辆救护车来当安保员都会比它们更好！","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610007158","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["人们历来短视，只能记住他们最后见到的东西。","","","","","","",""],"bg":"","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["《安保指南》是否完备，并不重要。艾弗森只需要人们认为它完备。<br>这样即使出了差错，也是笨蛋们没执行好，绝不是指南的错。","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[94,95,""]],"type":1,"name":["梅兰妮","","Melania","","","","",""],"head_icon":"","audio":"610007088","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["可这并非事实！ ","","","","","","",""],"bg":"","choice":[]},"95":{"step":[[95,96,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"0","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这却是人们眼中的事实。","","","","","","",""],"bg":"","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["范恩斯","","","","","","",""],"head_icon":"560401.png","audio":"610009028","bool_1":false,"sh