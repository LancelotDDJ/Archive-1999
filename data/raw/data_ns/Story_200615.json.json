01.png","audio":"610014011","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但是——怎么可能呢？你们的意思好像是说，羽人能把人变成……变成马？","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014012","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我不明白。难道因为他是“祥瑞”，就会有这样的能力吗？","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["再次听到“祥瑞”这个词，别斯米尔燃起了兴趣。","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014776","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们刚刚也在说书先生那儿听到了关于“祥瑞”的故事，“祥瑞”听起来确实很像具有地域特征的保护神。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014013","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["什么神？我只知道摄提神。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014777","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["噢。是的，摄提神。这应该才是你们供奉的东西。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014778","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我猜“祥瑞”应该更类似一种本地的信仰，传奇的神秘学家之类的。这里神秘术的使用听起来相当常见，或许神秘学家也一样。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014779","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不过，既然说到这里，您能告诉我，摄提神究竟是什么吗？","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014014","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我只知道摄提神有十二……还是十三位，的样子？但那些名字，很多我都不认识。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014015","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["哦，我知道今年是摄提神执徐的生辰年！我们会请很多的年节动物去断桥供奉祂。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014016","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["走吉和跃桥是最有趣的。我们会带着年节动物去到悬崖上的断桥前，一起数着步数摆动身子，像跳舞一样，最后再尝试跳过去——","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013712","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["跳过悬崖上的断桥？这听起来不仅危险，而且还相当的……耳熟。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["别斯米尔知道小叶尼塞在暗示什么。传闻中“所求必应”的规则不约而同浮现在她们的脑海里，但没有一个人真的问出声来。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["而曲娘的解释也及时打断了她们的联想。","","","","","","",""],"bg":"","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"610014017","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不不不，跳不过去的！还没听说有谁能跳过去呢，连最厉害的山羊都跳不过去，更别说人了。","","","","","","",""],"bg":"","choice":[]},"5