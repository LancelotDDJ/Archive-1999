d":false,"text":["这是战场，中校。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_11.jpg","choice":[]},"105":{"step":[[105,106,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["安德烈看着伊戈尔，火光映在他的眼睛里。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_11.jpg","choice":[]},"106":{"step":[[106,107,""]],"type":1,"name":["安德烈","","","","","","",""],"head_icon":"639502.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这不是战场，我们对抗的不仅仅是士兵，不是步枪，不是火炮和装甲车。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_11.jpg","choice":[]},"107":{"step":[[107,108,""]],"type":1,"name":["安德烈","","","","","","",""],"head_icon":"639502.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["对方拥有我们无法想象的神秘学武器，你看到弟兄们的尸体了吗……那不是普通的子弹和刺刀，从前线上都拉不回一具完整的尸体。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_11.jpg","choice":[]},"108":{"step":[[108,109,""]],"type":1,"name":["伊戈尔","","","","","","",""],"head_icon":"532002.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["从我们选择踏上战场的第一天开始，就只能接受别人的牺牲，最后再接受自己的牺牲。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_11.jpg","choice":[]},"109":{"step":[[109,110,""]],"type":1,"name":["安德烈","","","","","","",""],"head_icon":"639502.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["如果这种牺牲没有原因，也没有结果呢？","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_11.jpg","choice":[]},"110":{"step":[[110,111,""]],"type":1,"name":["安德烈","","","","","","",""],"head_icon":"639502.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你看这座城市，一旦踏进来，士兵只能活一天，军官只能活三天。为什么这些年轻人还毫不犹豫地往前冲？","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_11.jpg","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["安德烈","","","","","","",""],"head_icon":"639502.png","audio":"","bool_1":false,"show_name":true,"show_name_en":fa