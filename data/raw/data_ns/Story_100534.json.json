_l2d":false,"text":["但神秘学家更注重的是另一进路的知识，也就是灵知。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011534","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["占卜获取的“知识”，就属于这一种。","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["苏芙比","","Sotheby","","","","",""],"head_icon":"300901.png","audio":"610011121","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["哇……","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["苏芙比的眼睛兴奋地睁大了。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["玛蒂尔达掏出笔记本，有模有样地在上面勾勒了几笔。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011535","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["比方说，有两个人类的研究员，同时在两个地点检验斯涅尔折射定律，他们最后总是能得到趋于一致的结果。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011536","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["或者，有两个魔药学家，同时使用了相同的材料和配方，那他们也能制造出功效相近的咳咳立止剂。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011537","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["但如果有两个占卜师，同时对一件事做出了占卜，他们看到的“画面”可能会大相径庭。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011538","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["因为占卜揭示的只是“预兆”，对它的解读，本质是基于现行一切的推演，不存在标准答案。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011539","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["即使这两个占卜师碰巧给出了差不多的结论，它也不具备推广性。所以，从来没有占卜师会通过同行评议来验证自己是否正确！","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011540","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["这就是灵知，它独一无二，也无法像理性一样放之四海而皆准。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["玛蒂尔达收起笔记本，对苏芙比晃了晃手指。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011541","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["换而言之，即便有人占卜出了“暴雨”的原因，也无法只靠占卜来检验结论！一百个占卜师会得出一百个结论，场面会比金色大厅的交响乐团还要热闹十倍。","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011542","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["更实际的情况是，根本就占卜不出来！因为占卜者无法获得超越自己能力的知识。要做这种世界级别的占卜，必须也是世界级别的占卜家才行。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["玛蒂尔达","","Matilda","","","","",""],"head_icon":"304101.png","audio":"610011543","bool_1":f