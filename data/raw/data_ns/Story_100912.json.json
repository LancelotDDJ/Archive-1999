udio":"612600544","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["总之，目前的部分你们有什么读后感吗？什么都好！","","","","","","",""],"bg":"","choice":[]},"95":{"step":[[95,96,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"612600931","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["我只想知道主人公最后能不能找到那个骰子。","","","","","","",""],"bg":"","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600545","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["噢噢，事实上，那并不是一个具体的骰子。维尔汀，那只是一个意象！","","","","","","",""],"bg":"","choice":[]},"97":{"step":[[97,98,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"612600932","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["很抱歉，看来我没有理解它想要表达的内容。但这并不妨碍我能感受到，它应该是一个凄美而奇幻的故事。","","","","","","",""],"bg":"","choice":[]},"98":{"step":[[98,99,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600546","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["所以主题还是过于晦涩吗？唉……阿莱夫在上一次的回信中也提出了些建议，比如说这个盲眼的织工，就是他建议增加的角色，让她来引出主题的关联性。","","","","","","",""],"bg":"","choice":[]},"99":{"step":[[99,100,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600547","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这确实有些帮助，但角色们总是在讲话，而故事其实并没有实质性的进展。","","","","","","",""],"bg":"","choice":[]},"100":{"step":[[100,101,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600548","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这很奇怪。就像这个小镇中缺乏了某种至关重要的元素，导致每个篇章仿佛游荡在各自的世界里，无法交汇，而逐渐走向瓦解。","","","","","","",""],"bg":"","choice":[]},"101":{"step":[[101,102,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600549","bool_1":false,"show_name":true,"show_