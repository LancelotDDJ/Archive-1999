"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600552","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["诗社、规则、理想家……那些象征、意象和隐喻，它们分明就是按照同一种规律在推进！","","","","","","",""],"bg":"","choice":[]},"110":{"step":[[110,111,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600553","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["从阿马尔菲塔诺到科马拉，故事与现实构成了一个巨大的整体。当一个事物出现时，另一个也随之而定。","","","","","","",""],"bg":"","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600554","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["维尔汀，这一切都是从我遇见你开始的。","","","","","","",""],"bg":"","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600555","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["因为在这个故事的开头，也有一个和你一样的、提着箱子的能量扰动学家……！","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["女孩语无伦次地解释着人物的对应关系。","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600556","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["就像德洛丝女士……她是盲眼的织工。织工是一个宿命论的拥护者，一直崇奉巴比伦之骰的存在，却被它夺去了双眼……","","","","","","",""],"bg":"","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600557","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["而狱卒小姐，则是银行职员，为了遗忘可怕的过去，甘愿让跨国集团建立的新制度将小镇侵蚀……","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600558","bool_1":false,"show_