"name":["伊索尔德","","Isolde","","","","",""],"head_icon":"308101.png","audio":"610016744","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["可是，我的确是运用了迪塔斯多夫家族的神秘术。没有它，我无法取得这样的成就。","","","","","","",""],"bg":"","choice":[]},"108":{"step":[[108,109,""]],"type":1,"name":["伊索尔德","","Isolde","","","","",""],"head_icon":"308101.png","audio":"610016745","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["神秘学家卓越的艺术天赋，也是一种疯癫的诅咒。","","","","","","",""],"bg":"","choice":[]},"109":{"step":[[109,110,""]],"type":1,"name":["伊索尔德","","Isolde","","","","",""],"head_icon":"308101.png","audio":"610016746","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["医生，或许我只是一个借助疾病的冒充者。一旦病症好转，艺术天赋便荡然无存……","","","","","","",""],"bg":"","choice":[]},"110":{"step":[[110,165,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["卡卡尼亚突然顿住了。","","","","","","",""],"bg":"story_atcg/1_7/1_7_at_kakaniya2.jpg","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016295","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不是这样的，伊索尔德小姐。","","","","","","",""],"bg":"story_atcg/1_7/1_7_at_kakaniya2.jpg","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016296","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我从没听说过，任何人运用自己的天赋，会被称为舞弊。","","","","","","",""],"bg":"","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016297","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们是神秘学家。可在我们被这个模糊不清的词语定性前，我们是谁？","","","","","","",""],"bg":"","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016298","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果一个“神秘学家”从小就在孤岛上生活……她绝不会称自己为“神秘学家”，只会觉得自己是一个“人”——一个和我们，和所有人都没有区别的人。","","","","","","",""],"bg":"story_atcg/1_7/1_7_at_kakaniya3.jpg","choice":[]},"115":{"step":[[115,166,""]],"type":1,"name":["伊索尔德","","Isolde","","","","",""],"head_icon":"308113.png","audio":"610016747","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["医生……","","","","","","",""],"bg":"","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016299","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可是伊索尔德，你知道吗？当我向人群中望去，我从未见过任何一个“神秘学家”！","","","","","","",""],"bg":"story_atcg/1_7/1_7_at_kakaniya3.jpg","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016300","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我只是看到一个一个有天赋的同胞，受限于世俗的困顿之中，磨平自己的棱角，变得面目朦胧、模糊不清。","","","","","","",""],"bg":"","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016301","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["人类因他们的缺陷而纯粹，我们却因为非凡而受阻。","","","","","","",""],"bg":"","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016302","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在那个评价体系里，我们的天赋仅仅是一种病症，才华仅仅是一种缺损，血脉则是一种可怖的诅咒。","","","","","","",""],"bg":"","choice":[]},"120":{"step":[[120,121,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016303","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["治好了病症，我们便泯然众人。要靠病症生存，我们便反复刨开自己的创口。","","","","","","",""],"bg":"","choice":[]},"121":{"step":[[121,122,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016304","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["神秘学家就像这样贩卖自己呕出的血肉生存。","","","","","","",""],"bg":"","choice":[]},"122":{"step":[[122,123,""]],"type":1,"name":["伊索尔德","","Isolde","","","","",""],"head_icon":"308110.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["……","","","","","","",""],"bg":"","choice":[]},"123":{"step":[[123,124,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016305","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["您看看这个地方，我们最开明、最包容的城市。在萨赫蛋糕的甜美巧克力外衣下，埋藏的却是火药和毒酒。","","","","","","",""],"bg":"story_atcg/1_7/1_7_at_kakaniya2.jpg","choice":[]},"124":{"step":[[124,125,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016306","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["神秘学家被承认拥有艺术才华，却也仅仅如此，我们没有任何议会席位，难以评上任何职称，也难以获得任何专业证明。","","","","","","",""],"bg":"","choice":[]},"125":{"step":[[125,126,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016307","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们被流放到文化的角落，流放到装饰画和花瓶的位置，因为那是唯一一个掀不起波澜的地方。","","","","","","",""],"bg":"","choice":[]},"126":{"step":[[126,127,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016308","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而针对神秘学家的管束和歧视每天都在增加，先是登记，然后是居留证明，现在是神秘术许可证……","","","","","","",""],"bg":"","choice":[]},"127":{"step":[[127,128,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016309","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们必须忍气吞声，必须合乎体面，必须做一个“好”神秘学家，不能出现任何“不稳定”，因为我们应是理性的动物，否则我们就是动物。","","","","","","",""],"bg":"","choice":[]},"128":{"step":[[128,129,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":