。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"16":{"step":[[16,99,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["鹭鸶剪笑着指了一下院中的梅树。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["任仙子","","","","","","",""],"head_icon":"642304.png","audio":"613401107","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这棵树？","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"18":{"step":[[18,100,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["任仙子瞧了一眼那棵再普通不过的红梅，瘦弱细小，不免引得她哂然一笑。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["任仙子","","","","","","",""],"head_icon":"642304.png","audio":"613401108","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["虽都是红梅，但这棵有什么好聊的？假以千年，待它像城外那棵一般枝繁叶茂，还算有些意思。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400651","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["就聊聊往事。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400652","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["洪武年间，揽诸苏醒。白马派镇压揽诸期间遭他人围攻。致使满门皆灭，揽诸亦受重创。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400653","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["师祖为保众生，折断一把长生剑，放出剑中储藏先天之炁，将最后一名白马派弟子和揽诸之魄一并封于梅花树中，一去百年。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["任仙子","","","","","","",""],"head_icon":"642304.png","audio":"613401109","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["直到一只画皮小妖渡劫时无意经过，引天雷劈开了梅花树，白马派传人方重新现世。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["任仙子","","","","","","",""],"head_icon":"642304.png","audio":"613401110","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["而画皮小妖则被天雷击中，或将殒命。白马派弟子感叹因缘，遂传授这只小妖门派术法——后来的事，便不用说了。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400654","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["是的，你记得很清楚。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["任仙子","","","","","","",""],"head_icon":"642304.png","audio":"613401111","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——从未忘却。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400655","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你拿了长生剑，也学了金丹术。我并不要求你拜入白马派，因为白马派已去。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["任仙子","","","","","","",""],"head_icon":"642304.png","audio":"613401112","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["只是镇压险道兽一事，还需有人去做。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_08.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["任仙子","","","","","","",""],"head_icon":"642304.png","audio":"613401113","bool_1":false,"show_n