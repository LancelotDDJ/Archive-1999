。","","","","","","",""],"bg":"story_bg/3_3/3_3_bg_12.jpg","choice":[]},"137":{"step":[[137,138,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["又有一阵密集的枪声，同样地伴随着某些东西摔向地面的声音。","","","","","","",""],"bg":"","choice":[]},"138":{"step":[[138,139,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301321","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["就连我也能告诉你，草原即将被鲜血灌溉。明年的土地将会更加丰沃，而我是主宰这一切的主人。","","","","","","",""],"bg":"","choice":[]},"139":{"step":[[139,140,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301322","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我需要的不是这个，而是一个更精准的死亡预言，关于某一个人，或者……关于我自己。","","","","","","",""],"bg":"","choice":[]},"140":{"step":[[140,141,""]],"type":1,"name":["卡戎","","Charon","","","","",""],"head_icon":"","audio":"613300323","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我无法做到这样的事，也不愿预言任何人的死亡。","","","","","","",""],"bg":"","choice":[]},"141":{"step":[[141,142,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301323","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我是在给你机会，意识唤醒者。留在我身边，为我的军队服务，我就不会把你交到那个术士手上。","","","","","","",""],"bg":"","choice":[]},"142":{"step":[[142,143,""]],"type":1,"name":["卡戎","","Charon","","","","",""],"head_icon":"","audio":"613300324","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["术士？","","","","","","",""],"bg":"","choice":[]},"143":{"step":[[143,144,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["格鲁托夫用下巴指了指卡戎脚踩着的禁锢术式。","","","","","","",""],"bg":"","choice":[]},"144":{"step":[[144,145,""]],"type":1,"name":["格鲁托夫","","","","","","",""],"head_icon":"","audio":"613301324","bool_1":fals