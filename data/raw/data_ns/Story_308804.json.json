w_name_en":false,"no_l2d":false,"text":["身穿游行服装的人们聚集在圣斯蒂芬广场，向塞梅尔维斯投以好奇的目光，因为一个游客模样的外地人手持玩具软弹枪在街上奔跑是很罕见的。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"109":{"step":[[109,110,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["塞梅尔维斯快速奔跑，刚才她飞奔到市集，一把夺过游客手里的软弹枪，吓得射击游戏摊位老板后背直接撞上了置物架，所有的礼品全都跌落而下。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"110":{"step":[[110,111,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她记得自己说了“借”，不知道老板听懂了没有。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"111":{"step":[[111,112,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"308813.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["麻烦让一下！","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"112":{"step":[[112,113,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她推开人群一路前进，翻越路障，一名警卫想阻止她，她从口袋里亮出基金会的证件，然后踏上开阔的广场，脚下碎石不断咯吱作响。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"113":{"step":[[113,114,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她逐渐感到行动吃力，知道自己不能再望向那颗火球。她一鼓作气，冲进圣斯蒂芬大教堂，鞋底踩在楼梯上听起来宛如砂纸擦东西般沙沙作响。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"114":{"step":[[114,115,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她迅速找到一个制高点，把脸颊贴上软弹枪的枪托，把左手放在枪管稍靠下的位置，眯起左眼，从瞄准镜向外望出去。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"115":{"step":[[115,116,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她的眼睛扫过一排排民众，当中有老人、拍照的情侣、肩上背着孩子的父亲，还有一尊戴着面具的人形雕像，一颗巨大的彩蛋被安置在那尊雕像的手中。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"116":{"step":[[116,117,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["找到了，那就是珍宝彩蛋……这么说诺娜·伊斯特一定就在附近。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"117":{"step":[[117,118,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["就在这时，她从瞄准镜中瞥见一张熟悉的面孔。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"118":{"step":[[118,119,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……是那个孩子。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"119":{"step":[[119,120,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["看来他也成功找到了线索，赶到这里来了。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"120":{"step":[[120,121,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["要阻止那个孩子打开珍宝彩蛋吗？贸然出手势必会打草惊蛇，在附近监视情况的诺娜一定会远程引爆彩蛋，一旦彩蛋打开，蕈虫脂就会四处飞散……","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"121":{"step":[[121,122,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["不阻止的话，就要在珍宝彩蛋被打开之前尽快找到诺娜·伊斯特，控制她的行动。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"122":{"step":[[122,123,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"123":{"step":[[123,124,""]],"type":1,"name":["贝拉","","","","","","",""],"head_icon":"308820.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["开枪。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"124":{"step":[[124,125,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["是你……","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"125":{"step":[[125,126,""]],"type":1,"name":["贝拉","","","","","","",""],"head_icon":"308820.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你来不及找到诺娜·伊斯特的，而那孩子一定会打开彩蛋，那可是他不愿放手的小骄傲。你只有一个选择，那就是尽量拖延彩蛋被开启的时间。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"126":{"step":[[126,127,""]],"type":1,"name":["贝拉","","","","","","",""],"head_icon":"308820.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你可以把损失降到最小，但这场庆典注定会有一个人要流血，而那将为我们所饮用。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"127":{"step":[[127,128,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"128":{"step":[[128,129,""]],"type":1,"name":["贝拉","","","","","","",""],"head_icon":"308820.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["瞄准那个小孩，对，眼睛。虽然这把枪里只有软弹，但这个距离也足够让他头破血流，血溅当场！","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"129":{"step":[[129,130,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["闭嘴！","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"130":{"step":[[130,131,""]],"type":1,"name":["贝拉","","","","","","",""],"head_icon":"308820.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["开枪射他！快点！","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"131":{"step":[[131,132,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"132":{"step":[[132,133,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["烈日高挂天空，周围尽是欢声笑语，塞梅尔维斯在这中间静止不动。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"133":{"step":[[133,134,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["教堂内溢满阳光，令她目眩，双眼刺痛。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"134":{"step":[[134,135,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她心中突然浮现一个预感：那孩子会死。","","","","","","",""],"bg":"story_bg/1_9/1_9_bg_weiyenaguangchang.jpg","choice":[]},"135":{"step":[[135,136,""]],"type":1,"name":["小孩","","","","","","",""],"head_icon":"","audio":"7208164","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我的目标是