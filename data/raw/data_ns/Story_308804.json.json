8,9,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208588","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["队长，我们要想办法说服维也纳政府取消游行吗？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["恐怕不行。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["先不说取消游行势必会引起市民众怒，政府首先就要先做出清场的决定，并且为这个决定负责，显然他们并不会因为我们的片面之词就取消游行。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["更重要的是，绑匪现在就在人群之中，一旦取消游行，很有可能会打草惊蛇，如果刺激她直接在人群中动手的话，场面会变得非常不可控。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208602","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你已经知道绑匪是谁了？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["绑匪就是诺娜·伊斯特。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208599","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["什么？她？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208638","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她、她不是这个案件中的失踪人员吗？她绑架她自己？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208651","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["为什么？总不能是为了印证媒体的猜测，让这个案子看起来是同事之间的自相残杀导致的吧？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那只是她的第二个动机，首要的动机是她必须要让自己成为受害者。这样她就不会被怀疑，这样她才好隐藏自己，来和我们玩逃脱游戏。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["就算被我们提前找到并接受问询，作为受害人，她的证词会具有很强的证据效力。利用这一点，她想要混淆视听、误导调查就会变得非常容易。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208650","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那你是怎么怀疑她的？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["昨晚警方接到报案，称有人目击到一男一女非法入侵诺娜·伊斯特的住所。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208585","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["那两个人就是队长你和狼群先生，这件事我已经知道了。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"610023139","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["是的，但人数不对。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208549","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["人数？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["昨晚出现在诺娜·伊斯塔家中的人，除了狼群和我，还有第三个女人。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["起初我以为那第三个女人就是绑匪，但是为什么邻居会声称只目击到两个人非法入侵呢？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["只有一种可能，那就是第三人就是诺娜·伊斯特本人。邻居认出了她，而她无论是出于什么原因，回到自己的家都不可能算是犯法。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208628","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["有没有一种可能是邻居看错了呢？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我并不认为有这种可能。在夜晚能够清晰辨认进入邻居家中的人是一男一女，应该不会犯认错人这种错误。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我想诺娜·伊斯特应该和邻居相交甚好，所以自从她被警方“宣布”失踪后，邻居也一直在密切关注她的房子，想着她会不会在某个时候回来。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208591","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["然后没想到真的在昨晚见到她回来了……","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["埃米尔","","","","","","",""],"head_icon":"624301.png","audio":"7208601","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但既然诺娜·伊斯特想要隐藏自己的行踪，那她为什么还要冒着被目击的风险也要回到自己的家中呢？","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"610023107","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这个问题只有亲自问她本人才能知道答案了。","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["也许她是想要取回某个重要的东西，也许是遇到了某个情况让她不得不回到家中……","","","","","","",""],"bg":"story_bg/1_7/1_7_bg_huanchengdadao_zhou.jpg","choice":[]},"34":{"step":[[34