],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["母亲甚至把我的姓氏改为伊斯特，也就是复活节（Easter），我多少有点以这个姓氏为傲。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"610023107","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["嗯，你来自维也纳最优秀的彩蛋艺术世家。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们身为血食怪，必须学会在阳光和阴影之间保持平衡，但最后总是会被拉下水。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["或是太阳。或是被血液里的野兽支配。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"7208696","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["总有一天你也会体会到同样感觉，所以你必须要打造属于自己的立足之地。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我不用打造，也没有“必须”这回事。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"56":{"step":[[56,57,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我小时候会抢其他小孩的积木来把我自己的房子盖得更大。问题只在于你想要什么。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"57":{"step":[[57,58,""]],"type":1,