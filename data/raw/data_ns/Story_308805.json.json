_name":true,"show_name_en":false,"no_l2d":true,"text":["……是吗？","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["是她们干的，对不对？艾勒梅·霍尔和玛蒂娜·基姆对你做了这件事，所以你要向她们发起复仇。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["……","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"7208744","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["她们发现了我的真实身份。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["在那之前，每当我毫无戒心地走下工会的楼梯时，完全不会想到自己有一天会被绊倒。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["如果我经历过一次就记住的话，下一次再走到那个地方一定会格外小心，可是我忘记了。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"35":{"step":[[35,36,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["渐入","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一个月前，当她被工会任命为复活节彩蛋的主设计师的那天，她没想到那两个女人会将她从昏暗的工作室里拖出来，拉开窗帘，将她的脸砸在窗玻璃上。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她拼命闭着眼睛，但她们将她的胳膊拧在背后，硬生生扒开她的眼睛，逼她看着太阳。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"7208719","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["不！不要……住手……住手啊！","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那扇窗户。她的母亲曾经用挡住那扇窗户的钢琴弹奏一首歌，那首歌唱的是一个因被火灼烧而双目失明，但依旧想要在阳光下舞蹈的人的故事。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["父亲总是会开玩笑说：“亲爱的，你把我们家里唯一能看到多瑙河景观的窗户挡住了。”","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["而她则将手肘撑在餐桌上，双手交握，仿佛在祈祷。她知道母亲还会再跟她解释一遍那首歌的涵义，直至她听懂其中的关联性为止。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["被烧伤的那一晚，她想起祖母、母亲和父亲的葬礼，以及母亲用非常轻柔的声音所做的祈祷。","","","","","","",""],"bg":"story_bg/bg/dubaiyongheiping.jpg","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["？？？","","","","","","",""],"head_icon":"616201.png","a