name_en":false,"no_l2d":true,"text":["那我们一样，我这辈子从来没有动过任何人类一根汗毛，包括那两个女人的。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我梦过，幻想过，为这个哭过，但是我从来没做过，哪怕是现在。你能理解吗？","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["就像我清楚自己会对别人造成什么伤害，因为我自己也曾经历过同样的恐惧和尖叫。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["有一个心理学家曾经说过，血腥刺激和渴望死亡两者之间有着紧密的关系。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["被血食怪咬过之后，我以为我死了，然而当我醒过来，却发现自己变成了过去想要杀死的那种人。我变得长生不死，开始无法止住对鲜血的渴望。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["诺娜","","","","","","",""],"head_icon":"562801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["而且永远渴望杀戮与死亡？","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["正是。但我跟你不一样。","","","","","","",""],"bg":"story_bg/bg/hubian_huanghun.jpg","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["塞梅尔维斯","","Semmelweis","","","","",""],"head_icon":"","a