racterRankUpViewOffset":"31#225.5#1","fightSuccViewOffset":"-38.5#-301.8#1.19","characterGetViewStaticOffset":"31#225.5#1","characterGetViewOffset":"-2.5#42.9#1.09","characterDataTitleViewOffset":"","characterViewOffset":"-58.4#51.4#1.15","characterTitleViewStaticOffset":"-176#482.8#0.73","characterDataVoiceViewOffset":"","guideLeftPortraitOffset":"","guideRightPortraitOffset":"","characterViewImgOffset":"0#-79.7#1","characterSkin":"维纳斯的传道","characterSkinNameEng":"The Preaching of Venus","skinDescription":"如此完美，如此完美的曲线。","skinSpineOffset":"","showSwitchBtn":1,"skinViewImgOffset":"-130.3#-78.3#1","skinReplaceIcon":"301103","skinGetIcon":"301103","skinGetBackIcon":"","skinGetColorbg":"","skinGetDetailViewSpineOffset":"","skinGetDetailViewIconOffset":"","summonHeroViewOffset":"277.5#-76.6#1","canWade":0,"canHide":0,"mainBody":0,"skinGainViewImgOffset":"47#-52.8#0.72","jump":48,"storeTag":"109|103|104|105|101|102","fullScreenLive2dOffset":"","fullScreenCameraSize":0,"folderName":"v1a4_301103_mll_p","playercardViewLive2dOffset":"","playercardViewImgOffset":"18.7#-71.4#0.76","lucidescapeViewImgOffset":"","summonPickUpImgOffset":"","isSkinVideo":true,"repeatBuyTime":"","unavailableStore":"","skinStory":"《快乐爱情》《娱乐至上》……出演的大热作品越多，来自好莱坞的注视便愈发疯狂。老板们端着一杯杯天价美酒接踵而来，各路经纪人争破头想要得到一个站在她身边的位置。而她总是望向窗外，内心只想拥有一刻属于自己的宁静。\n在远海的另一边，如世外桃源般的小岛上，一切却截然相反。学者会以手中的笔与尺规丈量她的美，孩童们簇拥而来，想要听关于实数的故事。人们依然为她着迷，但并非源于金钱、名气或足以见报的桃色新闻，而是源于她完美的身体比例所体现的和谐美学。\n她意识到，这里只有对数字与真理的渴求。自己所熟悉的、日夜栖身的那片纸醉金迷，在小岛上则如幻梦般无关紧要。\n于是她继续出演，这次的剧本是《维纳斯的传道》。\n宛如维纳斯的布道一般，此刻她自身的存在，正是“黄金分割”这一美学原理显现的最佳铁证。","skinStoreId":0,"subTitle":"singlebg_lang/txt_skinhandbook_singlebg/skinsuitdetailview_title_1_4.png","skin2dParams":"","skinSwitchLive2dOffset":"","skinLevel":3,"handbookRedDot":0,"skinSignature":"","costafterbuy":""},"690114":{"id":690114,"name":"道路指示牌·左转","nameEng":"","des":"","colorbg":1,"spine":"v1a3_690114_lupaiguai/690114_lupaiguai","fight_special":0,"flipX":0,"isFly":0,"skills":"","headIcon":"690114","retangleIcon":"","matId":3,