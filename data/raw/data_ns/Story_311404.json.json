,"","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["如果我没记错的话，我们第一次见面的时候，你抽了烟，还特地把窗子打开了。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……那是一场意外。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["坦白说，那天我被你吓了一跳，小天才。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["为什么这么说？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你提及的那个时代，离我们已经十分遥远了。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在我出生的那个年份，拉美文学正值辉煌，那一代对文字怀有热忱的年轻人都能感受到那场浩大而旷日持久的大地震。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这并不是某个单一作家的崛起，而是一种集体的觉醒。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["一切都急迫而不可逆转，仿佛整座大陆的灵魂突然意识到自我的存在，开始以文学的形式说话。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601632","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["天呐，亨廷，你这话说得真好！","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……只是工作需要的谈资储备罢了，这没什么。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这跟我的感受很像。当我回头去读那一代作家的小说时，我受到的震撼就像来自地心的岩浆。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["它穿越了历史、暴力、记忆的沉积层，最终涌上地表，带着古老的泥沙与血迹……","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你能想象那对我而言，是多么震撼、多么战栗、多么心驰神往吗？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我错过了那场大地震，但我仍然能够感受到那份遥远的震动——在我第一次动笔开始，那震动就与我的心跳合了拍！","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601633","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我相信你是能够理解我的，对吗？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我当然理解你，虚构集，所以我才要帮助你出版一部伟大的作品，才会对你严格要求。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["只有严厉的车夫才能抓住脱了缰绳的马驹。在相处中，编辑深刻地意识到了这一点。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["闭眼","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"34":{"step":[[34,35,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["全黑","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她闭上眼，在黑暗中审问自己。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523811.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["抛开那些该死的专业理论和出版经验之外，你觉得这部小说足够好吗？亨廷。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523811.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["它很好，很好，我很喜欢。但……","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"38":{"step":[[38,39,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["场景-露营地（昼）","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"39":{"step":[[39,40,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["地标","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["夏秋交替之际，空气干燥清爽。<br>亨廷用打火石毫不费力地生起了火，铁锅咕噜咕噜地冒起了泡。","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["炖汤的香味让虚构集的肚子也冒出一阵咕噜咕噜的声音。","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这铁锅里冒的泡泡还怪响的，可别把我的猎物吓走了。","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你……这、这可不能怪我！","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我还以为你说的露营是家庭秋游，是公园野餐……没想到竟然是背着十几公斤的包裹，翻过两座山才能到达的深山老林！","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["而且，就连吃的东西都得现找……","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["虚构集揉了揉酸痛的肩膀，看着不远处正在捕猎的亨廷。","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["捕手的目光如同鹰隼，动作娴熟，以半蹲的姿态缓慢地移动至阴影中。<br>草叶微微颤动，猎物竖起耳朵、察觉异动——一切已经太迟。","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"48":{"step":[[48,49,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["挥刀","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["正握军刀一击毙命，老练的猎人并未给猎物留下任何痛苦。","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["呼……好了，接下来只需要稍加处理，就能扔进锅里了。","","","","","","",""],"bg":"story_bg/bg/luyingdi_zhou.jpg","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":fal