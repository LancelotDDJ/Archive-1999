e_en":false,"no_l2d":false,"text":["在这个团体里，休反而是最格格不入的那个。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011321","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他们实质上的领头人是“她”。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011322","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我不知道该如何形容……她就像陨星，飓风，一场不可理喻的天灾本身。就像她的名字一样，简单，却蕴含甚多。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011323","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["请原谅我的软弱。时至今日，我依然不想写下她的名字——如果那可以称为名字。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011324","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["实际上，“她”很亲切，相当热情，在我接触的所有未登记神秘学家里，对基金会是相当友好的一个。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011325","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她看起来很年轻，尽管我听说她也有女儿。她保持了孩童的那种纯真，我所熟悉的属于天才的眼神——整个世界在她看来就像一个闪闪发光的玩具。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011326","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["最开始，交流还是令人振奋的。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011327","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们都渴望弄清这里发生了什么……就像两个海上漂流的难民牢牢地握住彼此。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,93,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011328","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但事实上我完全不懂她在说什么。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011329","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这不是那种人类和神秘学家无法沟通的问题。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011330","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我确信我们的语言并无实质障碍。但我不理解她所用的每一个词。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011331","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["倘若一个人能在瞬间说出11567的所有因数，那我理应相信她拥有很高的智力。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011332","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可我听见的却是一番莫名其妙，不清不楚，毫无逻辑的空话！","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011333","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她宣称存在一个至高无上的数字天国，在那里万物的本质以抽象的形式永恒存在。而具有时间的物理世界不过是附属的次等品，从未完全真实过。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011334","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["因此眼下世界的混乱是无足轻重的，重要的是弄清“至高存在”发生了什么事。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011335","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这完全是现代数学和古代迷信的灾难结合，柏拉图主义起尸回魂的梦呓，又一个自诩先知的狂妄神秘学家……","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011336","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["更别提那些关于“灵魂数字”的命理鬼话……整个新纪元运动都产生不了这么多胡言乱语。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011695","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她竟然还声称自己已知晓了下一个倒退的年份！","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011337","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可当我认真询问时，她又说：","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["“她”","","","","","","",""],"head_icon":"","audio":"610011229","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“噢，抱歉，我发过誓，不能把证明告诉灵魂没有数字的人。”","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011338","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……我不知道她是存心戏弄我，还是来真的。可她好像真的很想告诉我，她是如何灵光一闪，就此知晓了那天赐的奥秘……","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011339","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["在她那里，一切规律似乎是直观地被她洞悉，而不是基于逻辑的推演。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["“她”","","","","","","",""],"head_icon":"","audio":"610011230","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“你难道看不见吗？它就在你眼前！”","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["记录者","","","","","","",""],"head_icon":"","audio":"610011340","bool_1":false,"show_name":true,"show_n