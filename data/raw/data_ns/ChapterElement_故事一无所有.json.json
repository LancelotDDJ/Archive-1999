id":1031501,"mapId":10315,"pos":"32.27#-16.1#-1","offsetPos":"0.3#2.3","res":"scenes/m_s08_hddt/prefab/hddt_front_cidai_a_001.prefab","resScale":0,"tipOffsetPos":"0#0.7","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_005.prefab","condition":"EpisodeFinish=10315","showCamera":0,"showArrow":1,"type":5,"param":"","paramCn":"","paramLang":"红松鼠和啄木鸟","title":"意料之外的听众","desc":"乔治橡树生长于七百年前。树洞内曾有哪些动物与你们一起倾听了那首歌？","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"1#980028#1|2#2#20","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""}],"chapter_map_fragment":{"21":{"id":21,"title":"开放式三明治","res":"fragmenticon_021","type":2,"content":"","toastId":0},"22":{"id":22,"title":"拉普拉斯康复中心工作人员“时间表”","res":"fragmenticon_022","type":1,"content":"<span style=\"font-size:85%\">07:30&nbsp;a.m.–08:30&nbsp;a.m.</span><br>巡查大厅及各区情况。<br><br><span style=\"font-size:85%\">08:30&nbsp;a.m.–09:30&nbsp;a.m.</span><br>接待到岗，接待访问者1位。<br>真的有人可以完整背下来自己的编码吗？<br><br><span style=\"font-size:85%\">09:30&nbsp;a.m.–09:35&nbsp;a.m.</span><br>早饭结束。另，今天的焙坚果司康有点硬。<br><br><span style=\"font-size:85%\">09:35&nbsp;a.m.–12:30&nbsp;p.m.</span><br>接待时间。注意微笑，珊迪。<br><br><span style=\"font-size:85%\">12:30&nbsp;p.m.–01:30&nbsp;p.m.</span><br>轮班，午饭时间。烤菠菜配黄皮土豆，焦烤猪排。<br><br><span style=\"font-size:85%\">01:30&nbsp;p.m.–02:00&nbsp;p.m.</span><br>接待时间。猪排的分量也太少了！<br><br><span style=\"font-size:85%\">02:00&nbsp;p.m.–03:00&nbsp;p.m.</span><br>接待时间。第十二期的《诡丽幻谭》去哪里了？该死的纸浆杂志也有人拿？！可恶……结局究竟是什么！<br><br><span style=\"font-size:85%\">03:00&nbsp;p.m.–03:05&nbsp;p.m.</span><br>接待时间。呼，珊迪，注意微笑，注意微笑……<br><br><span style=\"font-size:85%\">03:05&nbsp;p.m.–04:05&nbsp;p.m.</span><br>接待时间。其他区域似乎有骚动……<br>唔……我想，我或许需要去趟洗手间。<br><br><span style=\"font-size:85%\">04:05&nbsp;p.m.–04:10&nbsp;p.m.</span><br>接待时间。嗯……嗯？认真的？只过了五分钟？<br><br><span style=\"font-size:85%\">04:10&nbsp;p.m.–05:30&nbsp;p.m.</span><br>接待时间。阿曼达应该早点来接班才对。<br>上次她足足迟到了四十五分钟！<br><br><span style=\"font-size:85%\">05:30&nbsp;p.m.–06:30&nbsp;p.m.</span><br>接待时间。很好，迟到……迟到！<br>我今天还得在这破地方坐多久！！<br><br><span style=\"font-size:85%\">06:30&nbsp;p.m.–07:00&nbsp;p.m.</span><br>深呼吸，珊迪，保持微笑……还有三十分钟——<br><br><span style=\"font-size:85%\">07:3000&nbsp;pmm–13312</span><br>苹**&^果每小时饮*&用水健康@#&*方的方的&&方的……<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br>……<br><br><span style=\"font-size:85%\">08:00&nbsp;p.m.–09:00&nbsp;p.m.</span><br>协助，处理，**的突发事件！！<br>能不能把那群疯子看住了！！竟然往走廊里跑！！<br><br><br><b>假期申请</b>：珊迪<br><b>时长</b>：<s>&nbsp;2&nbsp;&nbsp;</s>&nbsp;3天<br><b>事由</b>：精神创伤！！！","toastId":0},"31":{"id":31,"title":"欧洲树蛙","res":"","type":3,"content":"身体娇小而善于跳跃的小家伙，常出没于湖泊或树丛附近。<br>它们总能赶在雨水到来前藏匿于叶面的阴影之下。<br>细心的学生正是通过这种变化准确判断了它所在的方位，<br>并用自己的双手将其捕获。","toastId":0},"23":{"id":23,"title":"拗口的童谣","res":"fragmenticon_023","type":1,"content":"<br>乔治橡树，乔治橡树，<br>枝丫间的橡子，从高处坠落。<br>幼雀飞进了大理石笼，<br>小小的橡子啊，帮帮它们。<br><br>乔治橡树，乔治橡树，<br>袋子里的橡子，被孩子拾起。<br>白色的巨伞给予庇护，<br>高高的树冠啊，帮帮他们。<br><br>乔治橡树，乔治橡树，<br>埋起来的橡子，在土中沉睡。<br>微弱的萤火渐渐靠近，<br>深深的树洞啊，帮帮他们。<br><br>乔治橡树，乔治橡树，<br>橡子生了根，静待破土。<br>匣子化为了一尾孤舟，<br>自由的微风啊，帮帮他们。","toastId":0},"32":{"id":32,"title":"并非只有漆黑","res":"","type":3,"content":"饥饿，沉默，光线微弱，加上少许小麻烦。<br>除此外，禁闭室的设计还需同时满足两点：<br>选择孩子能够应付的魔精，提供摆脱困境所需的物品。<br>有专人负责评估禁闭室布置方案，<br>并每周对其进行清扫和维护。<br>出于某些原因、笔迹稚嫩的，写在皱巴巴的纸条上，<br>或悄悄刻在角落的提示，很少被彻底抹去。","toastId":0},"24":{"id":24,"title":"《神秘学军事图鉴：单兵载具篇》","res":"fragmenticon_024","type":1,"content":"<br>&nbsp;&nbsp;&nbsp;&nbsp;Su-01ве（女巫）系列战斗飞行扫帚，机动性高，攻击力强，续航强大，为空中优势战斗型单兵魔法载具。<br>&nbsp;&nbsp;&nbsp;&nbsp;该系列载具均由钛合金打造，采用气动外形设计，柳叶刀状的流线型构造使其在速度上具有先天优势。楔形进气道位于帚身下方，气动性能良好，最大平飞速度可达2500km/h。帚首中部装配神秘学探测器。帚身下部装配有ST-30-1&nbsp;30mm神秘术瞬发装置，该装置使用激光测距瞄准系统，精密度极佳。<br><br>&nbsp;&nbsp;&nbsp;&nbsp;Su-01ве（女巫）系列由苏霍伊设计局与■■■■合作研制，驾驶者需具备一定的神秘学道具操作经验。同时，因过强的机动性会导致飞行员身体严重过载，所以，参与飞行的驾驶员均需具有过人的抗过载体质。<br>&nbsp;&nbsp;&nbsp;&nbsp;目前，Su-01ве（女巫）系列全部隶属于芝诺军备学院，飞行员受其严格的系统性训练后才可驾驶，现已成为芝诺最主力的战术魔法载具。","toastId":0},"25":{"id":25,"title":"《基金会药事管理名册》附录-Ⅱ","res":"fragmenticon_025","type":0,"content":"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;<b><span style=\"font-size:121%\">苦哑巴药剂</span></b>&nbsp;-<br><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;注：附录-Ⅱ药剂为二类神秘学药物，持有机构须经圣洛夫基金会批准，无《基金会神秘学制剂持有许可》的机构，不得私自制作、储备该类药品。<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;该药剂为外用类洗剂浓缩液，使用时须以净水进行一定比例的稀释，浓度维持在45%～65%为佳，剂量可因情况调整。建议最高浓度不超过77%。<br><br>【主要成分】曼德拉的嚎叫根、飞鼠胆汁、蟾蜍肝脏（满月采）、双头蛇尾鳞研磨末、三年生颠茄（整株）、蚂蟥。<br>【制作注意】坩埚需采用铜质。<br>【外观性状】深蓝色至深褐色浓缩液，有刺鼻气味，味极苦。<br>【应&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;用】可使服用者精神稳定，或因苦味产生短暂的视觉障碍与语言障碍。因用量不同可致轻微麻痹，浓度过高有致幻效果。目前已废除其在刑罚中的使用。现今多应需装配予圣洛夫基金会巡查人员及基金会下属机构。日常巡逻或其它符合《基金会紧急防卫规范》的严重特殊事件发生时，可针对相关个人及群体进行有效镇压。","toastId":0},"26":{"id":26,"title":"减法","res":"fragmenticon_026","type":2,"content":"","toastId":0},"33":{"id":33,"title":"被遗落的赠礼","res":"","type":3,"content":"剔透，富有光泽，颜色各异的小饰品，<br>适于在十来岁的孩童手中<br>作为友谊的见证传递，分享朋友的耳语。<br>其持有者来自体面的神秘学家庭，且主动要求入学，<br>理应享有无伤大雅的特权，免于细致检查。<br>她将这些礼物藏于衣袋，等待着值得的时刻。<br>如此紧张，如此期待，以至于未能发觉一枚水晶悄然跌落。","toastId":0},"27":{"id":27,"title":"你所知的幼犬","res":"fragmenticon_027","type":1,"content":"<br>温暖的毛皮，小小的足，<br>光斑下的橘，纯白的纱。<br>永不可挣脱的忠诚的项环，<br>与一颗无需提防的，赤诚的心。<br><br>柔软，温驯，不带一丝反抗地<br>舔舐白岩，<br>忘却了青蛙，卵石，与阁楼上的脏袜。<br>却又如虔诚的信徒攀上峭壁，<br>在最近处，<br>窥探着那不可追溯的微风。<br><br>在石门的缝隙中，<br>是那无法面对的<br>湿漉漉的鼻子与眼睛。","toastId":0},"28":{"id":28,"title":"十四行诗的笔记本","res":"fragmenticon_028","type":1,"content":"第一章<br>第一节&nbsp;哺乳类&nbsp;四足种<br>1.&nbsp;pp.13–14，独角皮拉苏皮<br>&nbsp;&nbsp;&nbsp;&nbsp;<i>（印度种与英国本土种有较大差距）</i><br>2.&nbsp;独角的特殊三层结构——角质、棱柱、珍珠<br>3.&nbsp;<s>&nbsp;丿&nbsp;</s><br><br><b><i>抱歉，请看下页</i></b><br><br>第一章&nbsp;<br>第一节&nbsp;哺乳类<br>四足种分类鉴定（p.13）<br>1.&nbsp;独角皮拉苏皮：印度种体长约四十英寸，成年后毛发赤红<br>&nbsp;&nbsp;<b><i>（像是菲奥娜给过我的那颗糖果的颜色。虽然我没……但是以供参考）</b></i><br>&nbsp;&nbsp;&nbsp;英国本土种略小，体长一般在二十～三十五英寸，深褐色毛发<br>&nbsp;&nbsp;<b><i>（皮拉苏皮未来可能会被纳入鉴定考察，要记得：抚摸它后颈部向下三英寸左右的部位，但是抚摸次数务必不要超过四下，以免造成它的恐慌）</b></i><br><br>2.&nbsp;独角具有三层特殊结构：<b><i>（可参考巨蚌类外壳结构）</b></i><br>-&nbsp;&nbsp;角质层：最外层，主要成分为壳质素。一般为石灰色，会跟随皮拉苏皮的年龄的增长而生长<br>-&nbsp;&nbsp;棱柱层：中间层，主要成分为碳酸钙晶体<br>-&nbsp;&nbsp;珍珠层：最里层，具有光泽。由水平排列的碳酸钙薄片构成<b><i>（结构可以想象成二号食堂左侧窗口提供的烘烤鱼脆片）</b></i><br><br>3.&nbsp;……<br><br>…………<br><br><b><i>亲爱的同窗：</b></i><br>&nbsp;&nbsp;<b><i>愿早日康复。</b></i>","toastId":0},"29":{"id":29,"title":"巷尾传言","res":"fragmenticon_029","type":1,"content":"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;“嘿，小点声……总之，先别管那些重塑的高级信徒怎么说！就我所知——你知道杰瑞吗？对！！杰瑞·威尔逊！他被抓到了那栋奇怪建筑里……没错，据说那里的地板都是由灰白大理石铺成的……你想象不到他被抓进去的时候有多狼狈。要我说，变成老鼠这种神秘术，在咱们眼里也不是什么拿得出手的玩意儿。但我从别人那儿听说，他母亲每月都能拿到一笔小小的赡养金……就是杰瑞给的！重要的是，地址就是那个怪建筑！真是难以置信。”<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;“哈利说曾见过他——虽然后来又看不到了，但是他说他身上那些泥巴、脏东西、怪味道消失得一干二净！他们到底做了什么？如果几条消息能换来个好结果，我是说……万一呢？”","toastId":0},"35":{"id":35,"title":"破壳之卵","res":"","type":3,"content":"一段骇人的传闻，一个不好的兆头。一枚正在孕育的卵。<br>它诞生于泽西恶魔的磷火，并与恐惧和混乱形影不离。<br>在难以忘却的噩梦之中，多有它的轮廓。<br>基金会教员常借此警示那些惯于晚睡的孩子，<br>其作用与人类口中的大野狼类似。","toastId":0},"30":{"id":30,"title":"一张合影","res":"fragmenticon_030","type":2,"content":"","toastId":0},"34":{"id":34,"title":"绿植","res":"","type":3,"content":"从学生宿舍搬家到康复中心的窗台上，<br>这盆植物对此并无意见，生长状况良好。<br>宿舍保洁员曾悉心照料它，<br>并将花朵慷慨地赠送给好奇的学生。<br>年幼的治疗师领受过这份好意，<br>也深知康复中心的治疗手段向来高效。<br>她能做的仅是多加看护，仅此而已。","toastId":0}},"chapter_map_element_dialog":{"8":[{"id":8,"stepId":1,"type":"dialog","param":"","audio":610003400,"speaker":"？？？","content":"不，你还没醒。现在你还在这片粘稠的、流动的、黑色蝼蚁的冥想世界里。","res":""},{"id":8,"stepId":2,"type":"options","param":"1#2","audio":0,"speaker":"","content":"这里是哪儿？#我在记忆里？","res":""},{"id":8,"stepId":3,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":4,"type":"dialog","param":"","audio":610003401,"speaker":"？？？","content":"哪儿也不是，你这好奇心爆棚的潘朵拉。这儿可能是一片汪洋、一口井，是无名指的下缘……随便你怎么理解。","res":""},{"id":8,"stepId":5,"type":"dialog","param":"","audio":610003402,"speaker":"？？？","content":"在经历了一场“热烈邀请”后，你的腿上带了一点霉菌般的淤青——草履虫们觉得这能让你屈服。","res":""},{"id":8,"stepId":6,"type":"dialog","param":"","audio":610003403,"speaker":"？？？","content":"但对你来说，有些看不见的伤口比这严重得多。","res":""},{"id":8,"stepId":7,"type":"dialog","param":"","audio":610003404,"speaker":"？？？","content":"放心，尽管他们的手段并不温柔，你也未必温顺得像只羊羔。","res":""},{"id":8,"stepId":8,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":10,"type":"dialog","param":"","audio":610003405,"speaker":"？？？","content":"记忆？好想法！你引以为傲的逻辑思维仍旧维持着正常运转。好让你现在也能像个生物学家一样，冲着沼泽分析该死的驼背巨鱼。","res":""},{"id":8,"stepId":11,"type":"dialog","param":"","audio":610003406,"speaker":"？？？","content":"但是抱歉，让你失望了。这不过是一场梦，一场违背了你个人意愿的梦境——强人所难向来是他们的拿手好戏。","res":""},{"id":8,"stepId":12,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":13,"type":"options","param":"3","audio":0,"speaker":"","content":"他们是？","res":""},{"id":8,"stepId":14,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":15,"type":"dialog","param":"","audio":610003407,"speaker":"？？？","content":"一群穿着袍子的家伙。袍子由白色的聚酯纤维制成，长度大多在膝盖以下。白袍子一号到白袍子七号都来了。","res":""},{"id":8,"stepId":16,"type":"dialog","param":"","audio":610003408,"speaker":"？？？","content":"可能只有单数，又或许混进了四号或者六号——他*的，随便他们怎么样。","res":""},{"id":8,"stepId":17,"type":"dialog","param":"","audio":610003409,"speaker":"？？？","content":"重要的是，其中有与你同窗的小姑娘。不，不是那个温柔忠诚，总是站在你身边的那个。","res":""},{"id":8,"stepId":18,"type":"dialog","param":"","audio":610003410,"speaker":"？？？","content":"是另一位——一位边缘简洁冷硬，摸上去像是个精密机械的女孩儿。","res":""},{"id":8,"stepId":19,"type":"dialog","param":"","audio":610003411,"speaker":"？？？","content":"我们姑且先像大部分人一样忽略掉她的名字，只朝着那个最光鲜的姓氏望过去。","res":""},{"id":8,"stepId":20,"type":"dialog","param":"","audio":610003412,"speaker":"？？？","content":"酒鬼眼中的雪莉桶威士忌，烟鬼眼里被雪松盒盛着的厄普曼——以及神秘学界的梅斯梅尔。","res":""},{"id":8,"stepId":21,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":22,"type":"options","param":"4#5","audio":0,"speaker":"","content":"我明白了，高级货#梅斯梅尔……他们是做什么的？","res":""},{"id":8,"stepId":23,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":24,"type":"dialog","param":"","audio":610003413,"speaker":"？？？","content":"哈哈哈，你这烂鼻子的坏蛋。你的幽默感从来不会让我失望！没错，没错，高级货。","res":""},{"id":8,"stepId":25,"type":"dialog","param":"","audio":610003414,"speaker":"？？？","content":"很早以前，更早以前，在你或许有机会亲历的某个过去。","res":""},{"id":8,"stepId":26,"type":"dialog","param":"","audio":610003415,"speaker":"？？？","content":"从人类刚刚放弃了祷告的那个时期开始，拉普拉斯与他们——嘿，对了，那帮人更愿意自称为学者——达成了长久的合作。","res":""},{"id":8,"stepId":27,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":28,"type":"selector","param":"5","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":29,"type":"dialog","param":"","audio":610003416,"speaker":"？？？","content":"摆弄那种神叨叨怪把戏的。坐在那里，拿铁棒一指你便昏睡过去，在脖子上挂上铁圈儿你又会感到灼烧似的疼痛。","res":""},{"id":8,"stepId":30,"type":"dialog","param":"","audio":610003417,"speaker":"？？？","content":"你熟知这种怪把戏，毕竟你周围净是些会用怪把戏的家伙：用玻璃笔保护别人的小姑娘，以及那个飘来飘去的会跳舞的苹果。","res":""},{"id":8,"stepId":31,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":32,"type":"dialog","param":"","audio":610003418,"speaker":"？？？","content":"他们掐断意识的火焰，帮助你往自己的最深处下坠……就像现在这样。","res":""},{"id":8,"stepId":33,"type":"dialog","param":"","audio":610003419,"speaker":"？？？","content":"能熟练运用它的神秘学家一只手都数得过来。要知道，稀缺往往是一个悲剧故事的楔子。","res":""},{"id":8,"stepId":34,"type":"dialog","param":"","audio":610003420,"speaker":"？？？","content":"她的噩梦就是这样开的头：从儿童劳动保护法变成了用来包三明治的、皱巴巴的纸开始。","res":""},{"id":8,"stepId":35,"type":"dialog","param":"","audio":610003421,"speaker":"？？？","content":"十二岁的小姑娘被带领着走进了屋子。她早在门外就敏锐地感觉到了这里的磁场变成了一团杂乱的风滚草。","res":""},{"id":8,"stepId":36,"type":"dialog","param":"","audio":610003422,"speaker":"？？？","content":"神秘学家的精神比人类脆弱得多，用不了多少刺激就能让他们退行成一头恶兽。","res":""},{"id":8,"stepId":37,"type":"dialog","param":"","audio":610003423,"speaker":"？？？","content":"梅斯梅尔们仁慈、专业。他们欢迎每一位前来治疗癔症的客人。","res":""},{"id":8,"stepId":38,"type":"dialog","param":"","audio":610003424,"speaker":"？？？","content":"——这时你该意识到了，餐纸保护的从来都不是三明治，而是拿着它的手。","res":""},{"id":8,"stepId":39,"type":"dialog","param":"","audio":610003425,"speaker":"？？？","content":"那些品牌不明的芥末酱、被捏碎的肉排，边缘带着铁锈色的生菜从面包缝隙里流了出来。","res":""},{"id":8,"stepId":40,"type":"dialog","param":"","audio":610003426,"speaker":"？？？","content":"混沌、污秽以及刺耳的惨叫——小姑娘被这些东西淌了一手，沾湿了身上的白色的聚酯纤维。","res":""},{"id":8,"stepId":41,"type":"options","param":"6","audio":0,"speaker":"","content":"……","res":""},{"id":8,"stepId":42,"type":"selector","param":"6","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":43,"type":"dialog","param":"","audio":610003427,"speaker":"？？？","content":"嗯，的确是个沉默的好时候。","res":""},{"id":8,"stepId":44,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":8,"stepId":45,"type":"dialog","param":"","audio":610003428,"speaker":"？？？","content":"现在，你注意到了机器上那些裸露的伤口，注意到了那些像是反复盥洗、重复整理的痕迹。","res":""},{"id":8,"stepId":46,"type":"dialog","param":"","audio":610003429,"speaker":"？？？","content":"毕竟孩童时期经历的创伤总能给人留下深刻的印象。","res":""},{"id":8,"stepId":47,"type":"dialog","param":"","audio":610003430,"speaker":"？？？","content":"这些东西被细细篆刻在骨间，它们沿着脊髓拾级而上——最后在每一寸神经元上抹上恶臭的鼻涕。","res":""},{"id":8,"stepId":48,"type":"dialog","param":"","audio":610003431,"speaker":"？？？","content":"自此之后，每一次成长都是痛苦的延伸：新的骨头生出来就被腐蚀，旧的细胞代谢也于事无补。","res":""},{"id":8,"stepId":49,"type":"dialog","param":"","audio":610003432,"speaker":"？？？","content":"这种事，你和她都很熟悉。","res":""},{"id":8,"stepId":50,"type":"dialog","param":"","audio":610003433,"speaker":"？？？","content":"好了，箱子提稳，看看时间——你该从这儿滚蛋了。","res":""}],"9":[{"id":9,"stepId":1,"type":"dialog","param":"","audio":610003434,"speaker":"？？？","content":"简单到像是用线段构成的、纯白的床，上面有个看上去未必能让人做个好梦的白枕头，以及半屋子满满当当的光。","res":""},{"id":9,"stepId":2,"type":"options","param":"1#2","audio":0,"speaker":"","content":"我讨厌禁闭室#看上去不错","res":""},{"id":9,"stepId":3,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":9,"stepId":4,"type":"dialog","param":"","audio":610003435,"speaker":"？？？","content":"噢，你要是说得出喜欢，我就该建议你去瞧瞧脑子了。","res":""},{"id":9,"stepId":5,"type":"dialog","param":"","audio":610003436,"speaker":"？？？","content":"听着，我不知道你对艺术有多少了解，不过最好的情况是像我一样一窍不通——别他*的傻笑了！这毫无疑问是艺术，是60年代的又一场艺术革命。","res":""},{"id":9,"stepId":6,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":9,"stepId":7,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":9,"stepId":8,"type":"dialog","param":"","audio":610003437,"speaker":"？？？","content":"哦，棒极了！现在你开始爱上禁闭室了！等我开上瓶啤酒……恭喜你！你也成了个疯子，要么就是成了个艺术家——无论哪个都值得庆祝！","res":""},{"id":9,"stepId":9,"type":"dialog","param":"","audio":610003438,"speaker":"？？？","content":"你对此颇有造诣。想必现在已经等不及要和我解释下为何唐纳德·贾德不给自己的那些方盒子起名字了。","res":""},{"id":9,"stepId":10,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":9,"stepId":11,"type":"dialog","param":"","audio":610003439,"speaker":"？？？","content":"这一切都是人类那颗理性大脑做的好事——哲学与美学交织成一个螺旋，跌跌撞撞地往前迈着步子，一直到今天……一直到“过去”。","res":""},{"id":9,"stepId":12,"type":"dialog","param":"","audio":610003440,"speaker":"？？？","content":"简单变得复杂，文明吞噬着文明。而后突然有一天，他们回头向深处望去，见到了那副巨人观。","res":""},{"id":9,"stepId":13,"type":"dialog","param":"","audio":610003441,"speaker":"？？？","content":"好在一切都为时未晚。解决的方法非常简单——他们先是把形丢了出去，随后又扔掉了概念，现在又抛却了情绪与隐喻。一切开始变得纯粹……最后正方形又变回了正方形，并且除此之外它什么也不是。","res":""},{"id":9,"stepId":14,"type":"options","param":"3","audio":0,"speaker":"","content":"简单的数学问题","res":""},{"id":9,"stepId":15,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":9,"stepId":16,"type":"dialog","param":"","audio":610003442,"speaker":"？？？","content":"甚至是连三岁的小屁孩都做得了的减法！","res":""},{"id":9,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":9,"stepId":18,"type":"dialog","param":"","audio":610003443,"speaker":"？？？","content":"极简主义——不得不说，这是个好现象，它向宇宙证明了这些充满智慧的灵长类并非那么无药可救。","res":""},{"id":9,"stepId":19,"type":"dialog","param":"","audio":610003444,"speaker":"？？？","content":"用艺术来抵御痛苦与消费主义，这举动像你的新后妈一样温柔。","res":""},{"id":9,"stepId":20,"type":"dialog","param":"","audio":610003445,"speaker":"？？？","content":"再过几年，减到这颗星球重新长满树，猴子老老实实吃它们的果子——","res":""},{"id":9,"stepId":21,"type":"options","param":"4","audio":0,"speaker":"","content":"就会回到过去？","res":""},{"id":9,"stepId":22,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":9,"stepId":23,"type":"dialog","param":"","audio":610003446,"speaker":"？？？","content":"是前往新的未来，你个傻蛋。","res":""},{"id":9,"stepId":24,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"10":[{"id":10,"stepId":1,"type":"dialog","param":"","audio":610003447,"speaker":"？？？","content":"一张泛黄的，边缘焦脆的合影。即便它被如此小心地保存，仍旧免不了被时间腐坏的命运。","res":""},{"id":10,"stepId":2,"type":"dialog","param":"","audio":610003448,"speaker":"？？？","content":"相片里的人面目模糊，只瞧得出是一水儿的黑头发。相纸的最上方有一行小字，方块儿似的——或许是某种来自东方的文字。","res":""},{"id":10,"stepId":3,"type":"options","param":"1","audio":0,"speaker":"","content":"相片里的人是……？","res":""},{"id":10,"stepId":4,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":5,"type":"dialog","param":"","audio":610003449,"speaker":"？？？","content":"你对此毫无头绪，在自己记忆里找不到一点儿关于这些人的蛛丝马迹。从没见过他们——你笃定地给了自己这样一个结论。","res":""},{"id":10,"stepId":6,"type":"dialog","param":"","audio":610003450,"speaker":"？？？","content":"除了第二排，自右侧数的第三个。你认得她的面孔。","res":""},{"id":10,"stepId":7,"type":"dialog","param":"","audio":610003451,"speaker":"？？？","content":"她与你记忆里的样子相比显得年轻了一些。两股麻花辫藤蔓一样地垂在她面颊两侧，那双黑色镜框后的眼睛仿佛来自一头沉稳的鹿。","res":""},{"id":10,"stepId":8,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":9,"type":"options","param":"2","audio":0,"speaker":"","content":"相片上写着什么？","res":""},{"id":10,"stepId":10,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":11,"type":"dialog","param":"","audio":610003452,"speaker":"？？？","content":"“19**—19**伦敦帝国理工学院留学生纪念”——一行方正的文字，有烫金的痕迹。","res":""},{"id":10,"stepId":12,"type":"dialog","param":"","audio":610003453,"speaker":"？？？","content":"该有的信息都有了——我是说，好消息！年份在如今不是什么重要线索了！","res":""},{"id":10,"stepId":13,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":14,"type":"options","param":"3#4","audio":0,"speaker":"","content":"她从哪儿来？#照片从哪儿来？","res":""},{"id":10,"stepId":15,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":16,"type":"dialog","param":"","audio":610003454,"speaker":"？？？","content":"东方，太平洋西岸的一片广袤土地。载着她的渡轮曾穿过了直布罗陀海峡与苏伊士运河。","res":""},{"id":10,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":18,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":19,"type":"dialog","param":"","audio":610003455,"speaker":"？？？","content":"别这么刨根问底的，大家都更在意归处——要时刻告诫自己别落得和这照片一样的结果，变得有家不能回。","res":""},{"id":10,"stepId":20,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":21,"type":"options","param":"5","audio":0,"speaker":"","content":"说说吧，你都知道些什么","res":""},{"id":10,"stepId":22,"type":"selector","param":"5","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":23,"type":"dialog","param":"","audio":610003456,"speaker":"？？？","content":"客气点，小恶棍！这不是什么免费的睡前故事，我也不是你慈祥的好爷爷。","res":""},{"id":10,"stepId":24,"type":"dialog","param":"","audio":610003457,"speaker":"？？？","content":"你认识她，但算不上熟悉。你我之间没人熟悉——熟悉她的另有其人。","res":""},{"id":10,"stepId":25,"type":"dialog","param":"","audio":610003458,"speaker":"？？？","content":"如今的她剪短了头发，变成了白色百合花上的露珠，在花萼之下摇摇欲坠。","res":""},{"id":10,"stepId":26,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":27,"type":"options","param":"6#7","audio":0,"speaker":"","content":"那朵百合花是什么样子的？#她为什么来到这里？","res":""},{"id":10,"stepId":28,"type":"selector","param":"6","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":29,"type":"dialog","param":"","audio":610003459,"speaker":"？？？","content":"纯白色，花瓣光滑，花药是健康的浅色。摸上去——是冷的，而且坚硬，像锋利的大理石，时刻准备在你的手上留下一个窟窿。","res":""},{"id":10,"stepId":30,"type":"dialog","param":"","audio":610003460,"speaker":"？？？","content":"露珠是她带过来的，也是她培育的。毫无疑问，百合花是个优秀的教导者，露珠也是个难得一见的好苗子。","res":""},{"id":10,"stepId":31,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":32,"type":"selector","param":"7","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":33,"type":"dialog","param":"","audio":610003461,"speaker":"？？？","content":"这里？严格来说，她最初的目的地并不是“这里”，不是这幢灰白色建筑，不是伞下，也不是花萼。她是名理论物理学研究者——研究弦论。","res":""},{"id":10,"stepId":34,"type":"dialog","param":"","audio":610003462,"speaker":"？？？","content":"远渡重洋也只是为了重新回到那片蓄势待发的土地。","res":""},{"id":10,"stepId":35,"type":"dialog","param":"","audio":610003463,"speaker":"？？？","content":"但计划赶不上变化，那朵百合永远有办法让事情如她预期一般发展。","res":""},{"id":10,"stepId":36,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":37,"type":"options","param":"8","audio":0,"speaker":"","content":"露珠会不会变成百合花？","res":""},{"id":10,"stepId":38,"type":"selector","param":"8","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":39,"type":"dialog","param":"","audio":610003464,"speaker":"？？？","content":"好问题，她既无欲望，又没愿心，故土还在远方等着她——科学家又怎么会变成政治家！","res":""},{"id":10,"stepId":40,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":10,"stepId":41,"type":"dialog","param":"","audio":610003465,"speaker":"？？？","content":"我真想这么笃定地回答你……但是你也意识到了，对吧？你也感觉到了。","res":""},{"id":10,"stepId":42,"type":"dialog","param":"","audio":610003466,"speaker":"？？？","content":"现在——猫被重新关到了盒子里，始作俑者把盖子封得严严实实。你我只能在外面抓耳挠腮，像个足球流氓一样为自己的猜想下注。","res":""},{"id":10,"stepId":43,"type":"dialog","param":"","audio":610003467,"speaker":"？？？","content":"明天，或是后天——哈！等着赔个底儿掉吧！","res":""}]}}