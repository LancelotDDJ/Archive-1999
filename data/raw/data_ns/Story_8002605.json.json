","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——正是你的独裁，将所有人推向了毁灭的深渊！","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我告诉你——我非但不会退出，还要在科马拉，在美洲诗社中建立一个新的文学派别。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我……不，我们，会用我们的文学拯救身处苦难中的狱友们。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601759","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["至于你，理想家，我再也无法忍受你那狂妄而冷漠的诡辩了！我们之间没有什么可聊的，从此以后，希望我再也不会在科马拉见到你。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601760","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["兀尔德女士，我必须得赶紧带您离开这里……再跟这个满口“本能现实主义”的疯子待在一起，恐怕只会让我们都染上不幸！","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,97,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601761","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["只有狱医先生——这座监狱的实际管理者，只有他才能改变这种可怕的现状！","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["奥克塔维奥","","","","","","",""],"head_icon":"","audio":"612601762","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["德洛丝女士，请您加入我们的派别吧！让我们共同建筑一个崭新的诗社。","",""