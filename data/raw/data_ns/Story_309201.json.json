马黑亮又湿润的眼睛。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但它还没上过战场，害怕炮声吗？","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["将军，您怎么看出它没上过战场？","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["和人一样。上过战场的人，和没上过战场的人，眼神是不一样的。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"613302348","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["它让我想起以前的佩伦。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"7208321","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["佩伦？","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["伊戈尔吹了声口哨，高大的红马甩了甩头，来到他身边。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我战友起的名字，因为它跑起来势如雷霆。但这孩子以前连炮声都害怕。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":