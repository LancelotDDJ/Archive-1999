:"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我太小了，还不能划船，父亲也不划，就等河水把我们的船带到顿河中央。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["然后父亲往水里撒一把黑麦粒，放下鱼线。月亮升到头顶上的时候，钓竿头突然往下弯……","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["那时候河里的鱼力气大得像公牛，父亲在水里把它遛乏了，才抓上来。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"7208333","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["是一条金色的鲤鱼，还张着嘴喘气哩！","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["格里高利","","","","","","",""],"head_icon":"531501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["父亲把鲤鱼扔到篓子里让我背回去，说他明天要上战场了。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["河水泛起一圈涟漪，鱼儿听到说话声，不敢露出自己闪光的鳞片。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["伊戈尔","","Igor","","","","",""],"head_icon":"309201.png","audio":"613302345","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["今天在顿河抓鱼，明天就上战场，这就是哥萨克，孩子。","","","","","","",""],"bg":"story_bg/bg/hubian_ye.jpg","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_nam