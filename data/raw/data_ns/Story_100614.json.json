":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["卡卡尼亚高兴地旋转着钢笔，翻开诊疗本的一页。","","","","","","",""],"bg":"story_atcg/1_7/1_7_at_jingzizhenliao3.jpg","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016242","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["西格蒙德·弗洛伊德医生曾经写过，是我们内心对本能的遏制导致了歇斯底里症。","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016243","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["您需要一次解放。我将通过话语去引导您进行回忆，您只需信任我，将其倾诉出来。","","","","","","",""],"bg":"","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016244","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这可以一定程度上使压抑的欲望得到缓和，这样一来，您躯体上的昏厥与痉挛症状也能得到一些改善。","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016245","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["忘记所有束缚，并信任我——这便是治疗的第一步。","","","","","","",""],"bg":"","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016246","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我知道，家族内接连不断的悲剧让您深感痛苦。但请相信我，心理医生就是为了解决这些问题的。","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[94,96,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016247","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["如果您对开口述说感到困难，可以看着这面镜子。","","","","","","",""],"bg":"story_atcg/1_7/1_7_at_jingzizhenliao2.jpg","choice":[]},"96":{"step":[[96,97,""]],"type":1,"name":["卡卡尼亚","","","","","","",""],"head_icon":"308001.png","audio":"610016248",