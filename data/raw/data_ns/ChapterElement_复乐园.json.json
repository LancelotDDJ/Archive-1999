era":1,"showArrow":1,"type":4,"param":"50","paramCn":"","paramLang":"","title":"腮呼吸","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"0#0#-5","fragment":1010231,"retroReward":""},{"id":101023,"mapId":11023,"pos":"54#-12.9#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#2.21#-5","effect":"scenes/m_s08_hddt/prefab/chapter_2_8/hddt_front_icon_a_001.prefab","condition":"EpisodeFinish=11023","showCamera":1,"showArrow":1,"type":2801,"param":"2810105","paramCn":"","paramLang":"","title":"于洪流中","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"0#0#-5","fragment":0,"retroReward":""},{"id":101024,"mapId":11024,"pos":"54.2#-13.2#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=11024","showCamera":1,"showArrow":1,"type":4,"param":"51","paramCn":"","paramLang":"","title":"再度呼吸","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"0#0#-5","fragment":101024,"retroReward":""},{"id":101025,"mapId":11025,"pos":"62.9#-6.5#-5","offsetPos":"0.65#2.93","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_001.prefab","condition":"EpisodeFinish=11025","showCamera":1,"showArrow":1,"type":1,"param":"6","paramCn":"","paramLang":"","title":"失真","desc":"离国际无线电标准的发布还有几年，先忍一忍吧。","flagText":"","acceptText":"仔细辨别","finishText":"","dispatchingText":"","reward":"","rewardPoint":1,"permanentReward":"","holeSize":"0#0#-5","fragment":101025,"retroReward":""}],"chapter_map_fragment":{"101001":{"id":101001,"title":"南极登陆战","res":"v2a8_fragmenticon_001","type":2,"content":"","toastId":0},"101002":{"id":101002,"title":"幽灵电台","res":"v2a8_fragmenticon_002","type":1,"content":"“嘿，我昨天晚上扫到了一个非常诡异的短波台。”<br>“蜂鸣器？数字播报？也有可能是干扰音。”<br>“不，有个女声在拼读字母，但是没有任何意义。MYDA、SEVA……有时候还有一些很渗人的话。”<br>“你录下来了吗？”<br>“只有其中几段。我播给你听。”<br><br><i>“Mike，Yankee，Delta，Alpha……【电流声】”<br>“Sierra，Echo……Victor，<b>Abandon</b>……这里只剩下我了……这里真的只剩下我了吗？不、不能<b>放弃</b>，不……【电流声】逃走！”<br>“Mike……Yankee，Delta，呜，什么？【电流声】嗡嗡……在耳朵里的虫子……嗡嗡……<b>Buzz、Bless……Blasphemy</b>！我们触怒了魔鬼！这是<b>亵渎</b>！！”<br>“Starve，<b>好饿</b>……那东西能吃吗？”<br>“我已经离考【电流声】的结局不远。”<br>“一具冰尸、破烂的颅骨……我必……【电流声】……找到地母……引导……【电流声】”<br>“……”<br>“Hotel，Lima，Evil……<b>Providence</b>。电台坏了，电台……我要把电台扔掉。<b>地母保佑</b>。”</i>","toastId":0},"101009":{"id":101009,"title":"忠诚的尺度","res":"v2a8_fragmenticon_003","type":2,"content":"","toastId":0},"1010111":{"id":1010111,"title":"《创世纪》隐喻","res":"v2a8_fragmenticon_004","type":2,"content":"","toastId":0},"101015":{"id":101015,"title":"地母故事集","res":"v2a8_fragmenticon_005","type":1,"content":"<b>第一则故事</b><br>新生之时，孩子初次蒙受了地母的眷顾。<br>阳光从窗外照到枕边时，孩子停止了啼哭。透过未干的泪水，他看见地母赠予的礼物与祝福：洒在手上金黄色温暖的光辉，包裹着全身洁白而柔软的纱与棉，吸入肺腑间透明清冽的气息。<br>生命只有一次，地母如此向孩子教会珍惜。<br><br><b>第三则故事</b><br>孩子握着弓箭，在雪地中留下深深的脚印。这是属于他的狩猎之日。<br>但这片大地已经许久没有飞鸟与松鼠的踪迹了。春天迟迟没有降临，它在孩子的记忆中逐年模糊，如同一个虚幻的传说。<br>太阳快要下山的时候，孩子终于打到了一头牝鹿。合上那双湿润而善良的眼睛，用疲乏颤抖的手剖开血肉时，他知道，这是地母的第二次眷顾。<br>孩子望向冻得焦脆的树枝，决心向南出发。<br><br><b>第七则故事</b><br>太阳被寒冰封冻，不再燃烧，落在铺满苔藓的原野。游鱼在水中溺死，随后沉向河床，熔为刀剑。<br>棺木吱呀打开，干枯的指节向每一个路人寻求救赎。<br>孩子一步一步地穿过这片土地。血混着棉絮一同在皮肤上结痂，冻疮爬上指尖，又被锄头与镐磨破。只有声带，仍旧鲜活，好让他向地母祈祷。<br>请您梳理世界的规则。请您赐予我们新的春天。<br><br><b>第九则故事</b><br>迷途的孩童迎来了地母的第三次眷顾。<br>在极南之地，孩子穿越了地母的躯体，叩响了连接地母灵魂的大门。久违的温暖将他紧紧包裹，他重新成为了地母的孩子。<br>在地母怀中，他聆听了最后的讯息。<br>许多许多年后，树与花重新生发的大地上，孩子的孩子们围着营火，要他讲讲地母的事情。我拥抱了她，她也晓谕了我。那是一则好消息，他说。那是一则好消息。","toastId":0},"101018":{"id":101018,"title":"宗教辩论","res":"v2a8_fragmenticon_006","type":2,"content":"","toastId":0},"101019":{"id":101019,"title":"作战日","res":"v2a8_fragmenticon_007","type":1,"content":"03/30&nbsp;13:05<br>特里格拉夫号从22KM外进行了第一发试射。炮弹命中海岸冰架，四分钟后进行第二次跨射调准射击诸元。再四分钟后第三次跨射调整完毕。<br>批复：进攻开始。<br>03/30&nbsp;14:32<br>侦测到马格努斯触碰自航水雷，确认两艘驱逐舰遭到水下攻击，一艘已经丧失作战能力，行动受限。随后马格努斯浮水开始炮击，该舰用船体阻拦攻击。<br>批复：第二批五艘驱逐舰出动，配合清扫马格努斯。芝诺空军已派出十四人起飞侦测，注意配合。<br>03/30&nbsp;16:03<br>马格努斯已被击溃。舰队开始挺进，等待后勤舰队建造人工港。<br>批复：监视伊戈尔叛军，及时回传态势评估。<br>03/30&nbsp;19:25<br>特里格拉夫号深入战场。人工港初步完成。水下声呐侦测到巨大不明信号。暂无伊戈尔军动向。<br>批复：依托防御工事组织火力，继续监视敌主力动向。<br>03/31&nbsp;00:10<br>奥利图欧全数飞出，撤退的马格努斯突然转向进攻。两艘驱逐舰被马格努斯的平射火炮命中，丧失作战能力，请求重火力支援。伊戈尔军仍无参战意图。<br>批复：舰炮火力5分钟后覆盖你前方12海里区域，空中掩护20分钟后抵达。伊戈尔来到重塑必有所图，切勿放松警惕。<br>03/31&nbsp;02:34<br>利维坦浮出水面，特里格拉夫号受到利维坦重创，即将引爆神秘术阵。<br>批复：各舰船回避冰区，重新组织防线。","toastId":0},"1010231":{"id":1010231,"title":"腮呼吸","res":"v2a8_fragmenticon_009","type":2,"content":"","toastId":0},"101024":{"id":101024,"title":"再度呼吸","res":"v2a8_fragmenticon_010","type":2,"content":"","toastId":0},"101025":{"id":101025,"title":"电台旁的讨论","res":"v2a8_fragmenticon_011","type":1,"content":"“‘差分机’小队，这里是总部。东南城区已彻查，阿尔卡纳不在那里，请立即取消行动，与‘钨丝’小队会合并前往……喂？喂？‘差分机’小队、‘差分机’小队？听到请回答！天啊，这个年代的通信质量糟透了。如果我是这会儿出生的，一定不会选择无线电作为我的事业。”<br>“怎么样？你那儿有结论了吗？”<br>“委外合约小队还没来得及说什么信号就断了。不过刚才我的设备不停地串台，听到有一艘皇家邮轮遭遇了潜艇的突然袭击，正在请求协约国军舰救援。我猜是1917年。”<br>“但好些频段的广播都在提霍尔韦格，所以肯定还没到1917年。也许是1915年吧？”<br>“绝对不是1915年，我负责联络的小队提到凡尔登战役已经结束许久了。乐观点，也许我们来到了战争的尾巴，他们正在总结教训呢！”<br>“乐观不起来。从我这儿的消息看来，奥匈帝国还很顽强，奥斯曼也不遑多让。这里面恐怕有不少重塑之手的功劳。”<br>“是啊，也许神秘学家们在这场战争中……等等，‘差分机’小队！这里是总部。请讲！”<br>基金会通讯员抓起钢笔，碳素墨水险些溅到同僚的脸上。<br>笔尖摩擦纸面的沙沙声持续了一分钟才停下。<br>“他说什么？”<br>“两年前，贡比涅谈判失败了。现在是1920年。”","toastId":0}},"chapter_map_element_dialog":{"46":[{"id":46,"stepId":1,"type":"dialog","param":"","audio":922800001,"speaker":"？？？","content":"你做到了，从美利坚到巴西，再到澳大利亚。","res":""},{"id":46,"stepId":2,"type":"dialog","param":"","audio":922800002,"speaker":"？？？","content":"然后在南太平洋上畅游一番，途径阿根廷，现在你终于站在了这片土地上。","res":""},{"id":46,"stepId":3,"type":"dialog","param":"","audio":922800003,"speaker":"？？？","content":"你的敌人节节败退，避无可避，退守南极，而导致这一切的只是一个命令——","res":""},{"id":46,"stepId":4,"type":"dialog","param":"","audio":922800004,"speaker":"？？？","content":"“找到那个作家。”","res":""},{"id":46,"stepId":5,"type":"dialog","param":"","audio":922800005,"speaker":"？？？","content":"没有方案，没有地点，没有时限，支援人数不超过一个班。","res":""},{"id":46,"stepId":6,"type":"dialog","param":"","audio":922800006,"speaker":"？？？","content":"我不禁想要向你学习，是什么让你像刚入伍的年轻人一样富有行动力？","res":""},{"id":46,"stepId":7,"type":"options","param":"1#2","audio":0,"speaker":"","content":"我不知道#军人就是要遵守命令","res":""},{"id":46,"stepId":8,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":46,"stepId":9,"type":"dialog","param":"","audio":922800007,"speaker":"？？？","content":"那我有一个推测，或许这就是你的神秘术。","res":""},{"id":46,"stepId":10,"type":"dialog","param":"","audio":922800008,"speaker":"？？？","content":"永远自觉地遵守一本命中注定的行动纲领，以满足他者的窥视欲望。","res":""},{"id":46,"stepId":11,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":46,"stepId":12,"type":"dialog","param":"","audio":922800009,"speaker":"？？？","content":"我必须提醒你一声，你不是军人，你连童子军都不是。","res":""},{"id":46,"stepId":13,"type":"dialog","param":"","audio":922800010,"speaker":"？？？","content":"你不必用军人的标准要求自己。","res":""},{"id":46,"stepId":14,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":46,"stepId":15,"type":"dialog","param":"","audio":922800011,"speaker":"？？？","content":"这是一份个人建议，服从命令之前好好想想自己为什么要这么做。","res":""},{"id":46,"stepId":16,"type":"dialog","param":"","audio":922800012,"speaker":"？？？","content":"毕竟你接下来可能要闯入敌人的大本营。","res":""},{"id":46,"stepId":17,"type":"dialog","param":"","audio":922800013,"speaker":"？？？","content":"在这种情况下依然缺乏自我思考的人，往往会变成炮灰。","res":""},{"id":46,"stepId":18,"type":"dialog","param":"","audio":922800014,"speaker":"？？？","content":"所以把这个疑问放在心里吧——你究竟为什么要找那个作家？","res":""}],"47":[{"id":47,"stepId":1,"type":"dialog","param":"","audio":922800015,"speaker":"？？？","content":"回过头，捂住口鼻。","res":""},{"id":47,"stepId":2,"type":"dialog","param":"","audio":922800016,"speaker":"？？？","content":"如果你没有做好心理准备，我不建议你亲自检查这里。","res":""},{"id":47,"stepId":3,"type":"dialog","param":"","audio":922800017,"speaker":"？？？","content":"一群业余人士把这里弄得一团糟。","res":""},{"id":47,"stepId":4,"type":"options","param":"1#2","audio":0,"speaker":"","content":"为我描述这里#我必须亲眼看到","res":""},{"id":47,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":47,"stepId":6,"type":"dialog","param":"","audio":922800018,"speaker":"？？？","content":"隐喻并不是我的本行，不过算了。","res":""},{"id":47,"stepId":7,"type":"dialog","param":"","audio":922800019,"speaker":"？？？","content":"几块奶油蛋糕被糊在墙上，野狗撕碎的面包撒了满地。","res":""},{"id":47,"stepId":8,"type":"dialog","param":"","audio":922800020,"speaker":"？？？","content":"还有草莓果酱。草莓果酱和辣椒酱到处都是，该死，我好像踩到了一颗烂葡萄。","res":""},{"id":47,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":47,"stepId":10,"type":"dialog","param":"","audio":922800021,"speaker":"？？？","content":"那么如你所见，这里有过不止一个人。","res":""},{"id":47,"stepId":11,"type":"dialog","param":"","audio":922800022,"speaker":"？？？","content":"但现在谁也说不清到底有过几个人。","res":""},{"id":47,"stepId":12,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":47,"stepId":13,"type":"dialog","param":"","audio":922800023,"speaker":"？？？","content":"稍有正义感的人都不会允许这种事发生。","res":""},{"id":47,"stepId":14,"type":"options","param":"3","audio":0,"speaker":"","content":"你在讽刺谁？","res":""},{"id":47,"stepId":15,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":47,"stepId":16,"type":"dialog","param":"","audio":922800024,"speaker":"？？？","content":"我只是个服从命令的士兵，没资格用善恶观去讽刺谁，不过我可以就忠诚心发表些看法。","res":""},{"id":47,"stepId":17,"type":"dialog","param":"","audio":922800025,"speaker":"？？？","content":"保持忠诚在指挥官英明神武时并不难，大部分士兵都能做到。","res":""},{"id":47,"stepId":18,"type":"dialog","param":"","audio":922800026,"speaker":"？？？","content":"相对的，指挥官越是无能或难以理解，忠诚就越是难得。","res":""},{"id":47,"stepId":19,"type":"dialog","param":"","audio":922800027,"speaker":"？？？","content":"要炫耀自己的忠诚，就应当忠于一个疯狂、愚蠢、不可理喻的指挥官，并清楚自己的行为。","res":""},{"id":47,"stepId":20,"type":"dialog","param":"","audio":922800028,"speaker":"？？？","content":"而那名中尉，她离绝对忠诚还差得远。","res":""},{"id":47,"stepId":21,"type":"dialog","param":"","audio":922800029,"speaker":"？？？","content":"她看到这些时一