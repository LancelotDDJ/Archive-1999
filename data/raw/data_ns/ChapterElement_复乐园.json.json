:""},{"id":48,"stepId":15,"type":"dialog","param":"","audio":922800042,"speaker":"？？？","content":"整副身体都仰仗它来与外部交涉。","res":""},{"id":48,"stepId":16,"type":"dialog","param":"","audio":922800043,"speaker":"？？？","content":"所以决不能让它自行做主，不然祸端和疾病都会在这里汇聚。","res":""},{"id":48,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":48,"stepId":18,"type":"options","param":"3","audio":0,"speaker":"","content":"你该去当文学批评家","res":""},{"id":48,"stepId":19,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":48,"stepId":20,"type":"dialog","param":"","audio":922800044,"speaker":"？？？","content":"像文艺复兴时期的艺术家一样说话并非我的本意。","res":""},{"id":48,"stepId":21,"type":"dialog","param":"","audio":922800045,"speaker":"？？？","content":"可我必须如此隐晦地告知你，正如米开朗基罗的名作所暗示的一样。","res":""},{"id":48,"stepId":22,"type":"dialog","param":"","audio":922800046,"speaker":"？？？","content":"创造人的关键部位也许是智慧的栖息地，或者生命的诞生地……","res":""},{"id":48,"stepId":23,"type":"dialog","param":"","audio":922800047,"speaker":"？？？","content":"这下你应该稍微能看懂些艺术了。","res":""},{"id":48,"stepId":24,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"49":[{"id":49,"stepId":1,"type":"dialog","param":"","audio":0,"speaker":"？？？","content":"……","res":""},{"id":49,"stepId":2,"type":"dialog","param":"","audio":922800048,"speaker":"？？？","content":"好了，我的默哀结束了。","res":""},{"id":49,"stepId":3,"type":"dialog","param":"","audio":922800049,"speaker":"？？？","content":"我不是什么虔诚信徒，也算不上无神论者，但我尊重她的牺牲。","res":""},{"id":49,"stepId":4,"type":"dialog","param":"","audio":922800050,"speaker":"？？？","content":"虽然她的行为实际上愚蠢且不知所谓。","res":""},{"id":49,"stepId":5,"type":"dialog","param":"","audio":922800051,"speaker":"？？？","content":"可正如我之前所说，忠于一些愚蠢的意志恰恰能证明一个人的忠诚。","res":""},{"id":49,"stepId":6,"type":"dialog","param":"","audio":922800052,"speaker":"？？？","content":"不论是为了家族使命，还是探索精神，或者是那个睡前童话故事。她都死得其所。","res":""},{"id":49,"stepId":7,"type":"dialog","param":"","audio":922800053,"speaker":"？？？","content":"死得愚蠢但忠实。","res":""},{"id":49,"stepId":8,"type":"options","param":"1#2","audio":0,"speaker":"","content":"这一切发生得太快了#你是个冷血的家伙","res":""},{"id":49,"stepId":9,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":49,"stepId":10,"type":"dialog","param":"","audio":922800054,"speaker":"？？？","content":"你经历了这么多牺牲，居然还期望每一次都有充足的铺垫？","res":""},{"id":49,"stepId":11,"type":"dialog","param":"","audio":922800055,"speaker":"？？？","content":"抱歉，我可不会夸奖一位多愁善感的指挥官。","res":""},{"id":49,"stepId":12,"type":"dialog","param":"","audio":922800056,"speaker":"？？？","content":"如果我是你的上级，恐怕会要求你把心挖出来，给那些老兵做个榜样。","res":""},{"id":49,"stepId":13,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":49,"stepId":14,"type":"dialog","param":"","audio":922800057,"speaker":"？？？","content":"行了，你我都知道这里并非她的终点。","res":""},{"id":49,"stepId":15,"type":"dialog","param":"","audio":922800058,"speaker":"？？？","content":"对她这样忠于信念的人来说，赴死不过是实现永生。","res":""},{"id":49,"stepId":16,"type":"dialog","param":"","audio":922800059,"speaker":"？？？","content":"而且她可不是那群割掉舌头的盲信者，恐怕如今她正和自己的信念会谈。","res":""},{"id":49,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":49,"stepId":18,"type":"dialog","param":"","audio":922800060,"speaker":"？？？","content":"趁着门仍敞开，赶紧与她会合吧。","res":""},{"id":49,"stepId":19,"type":"dialog","param":"","audio":922800061,"speaker":"？？？","content":"否则你就要被她永远甩下了。","res":""}],"50":[{"id":50,"stepId":1,"type":"dialog","param":"","audio":922800062,"speaker":"？？？","content":"永不间断的大雨会导致大洪水，一个显而易见的结果。","res":""},{"id":50,"stepId":2,"type":"dialog","param":"","audio":922800063,"speaker":"？？？","content":"这是最后的报告了——人和飞鸟的时代已经结束，接下来将是鱼的时代。","res":""},{"id":50,"stepId":3,"type":"dialog","param":"","audio":922800064,"speaker":"？？？","content":"不过鱼还要再等等，因为你，世界毁灭被推迟了大约一小时。","res":""},{"id":50,"stepId":4,"type":"dialog","param":"","audio":922800065,"speaker":"？？？","content":"现在全世界的人都欠你一小时，直径多大的功勋章才配得上你？","res":""},{"id":50,"stepId":5,"type":"options","param":"1#2","audio":0,"speaker":"","content":"一定还有办法#快闭嘴吧","res":""},{"id":50,"stepId":6,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":50,"stepId":7,"type":"dialog","param":"","audio":922800066,"speaker":"？？？","content":"是的，就算雨伞不管用，你也还有一艘方舟。","res":""},{"id":50,"stepId":8,"type":"dialog","param":"","audio":922800067,"speaker":"？？？","content":"像以往保存有生力量时那样，让有资格的动物乘上方舟。","res":""},{"id":50,"stepId":9,"type":"dialog","param":"","audio":922800068,"speaker":"？？？","content":"你就还可以继续战斗下去。","res":""},{"id":50,"stepId":10,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":50,"stepId":11,"type":"dialog","param":"","audio":922800069,"speaker":"？？？","content":"请让我完成我最后的任务，即使你不愿意听。","res":""},{"id":50,"stepId":12,"type":"dialog","param":"","audio":922800070,"speaker":"？？？","content":"得益于万有引力，地势较高处的居民可以在洪水中存活久一些。","res":""},{"id":50,"stepId":13,"type":"dialog","param":"","audio":922800071,"speaker":"？？？","content":"你还有时间抱着橙色小狗叙叙旧，看着世界末日从一个极点漫向另一个极点。","res":""},{"id":50,"stepId":14,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":50,"stepId":15,"type":"dialog","param":"","audio":922800072,"speaker":"？？？","content":"或者……你可以像个军人一样，遵守命令直到最后一刻。","res":""},{"id":50,"stepId":16,"type":"dialog","param":"","audio":922800073,"speaker":"？？？","content":"“找到那个作家。”","res":""},{"id":50,"stepId":17,"type":"dialog","param":"","audio":922800074,"speaker":"？？？","content":"这个任务的重要性已经不言而喻了。","res":""}],"51":[{"id":51,"stepId":1,"type":"dialog","param":"","audio":922800075,"speaker":"？？？","content":"你又一次溺水了，真让人感到怀念。","res":""},{"id":51,"stepId":2,"type":"dialog","param":"","audio":922800076,"speaker":"？？？","content":"别激动，你还不能起身，就这样躺着听报告就行。","res":""},{"id":51,"stepId":3,"type":"options","param":"1#2","audio":0,"speaker":"","content":"哦？最后的报告怎么了？#我的脸颊有些温热感","res":""},{"id":51,"stepId":4,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":51,"stepId":5,"type":"dialog","param":"","audio":922800077,"speaker":"？？？","content":"呃……","res":""},{"id":51,"stepId":6,"type":"dialog","param":"","audio":922800078,"speaker":"？？？","content":"好吧，你成功挖苦到了我。","res":""},{"id":51,"stepId":7,"type":"dialog","param":"","audio":922800079,"speaker":"？？？","content":"你做到了，英明神武的救世主，你在最后一刻力挽狂澜拯救了世界。","res":""},{"id":51,"stepId":8,"type":"dialog","param":"","audio":922800080,"speaker":"？？？","content":"连我也没有预料到会这样，满意了么？我们来听报告吧。","res":""},{"id":51,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":51,"stepId":10,"type":"dialog","param":"","audio":922800081,"speaker":"？？？","content":"那是你忠实的橙色小狗在舔舐你的伤口，她正竭尽所能地唤醒你——这当然是隐喻，我想我不用多做解释。","res":""},{"id":51,"stepId":11,"type":"dialog","param":"","audio":922800082,"speaker":"？？？","content":"这也是你还不能醒来的原因之一，盐水会滴入你的眼睛。","res":""},{"id":51,"stepId":12,"type":"dialog","param":"","audio":922800083,"speaker":"？？？","content":"大家都会因此尴尬，所以静下心来听我说。","res":""},{"id":51,"stepId":13,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":51,"stepId":14,"type":"dialog","param":"","audio":922800084,"speaker":"？？？","content":"你会再度溺水的主要原因并不是你仍然不会游泳。","res":""},{"id":51,"stepId":15,"type":"dialog","param":"","audio":922800085,"speaker":"？？？","content":"而是你宁死也要抱着这台纺车导致的。","res":""},{"id":51,"stepId":16,"type":"dialog","param":"","audio":922800086,"speaker":"？？？","content":"纺车就是纺车，即使它能纺出金线，你也已经有一台了。","res":""},{"id":51,"stepId":17,"type":"dialog","param":"","audio":922800087,"speaker":"？？？","content":"可惜拥有两台纺车并不会提高工作效率，毕竟原材料有限，工人又只有你一个。","res":""},{"id":51,"stepId":18,"type":"dialog","param":"","audio":922800088,"speaker":"？？？","content":"就算拆掉它，这些烂木头零件也不适配你的纺车，外观相似并不代表是同一单位。","res":""},{"id":51,"stepId":19,"type":"dialog","param":"","audio":922800089,"speaker":"？？？","content":"不管是纺车，还是动物，又或者是父子母女，都是这样。","res":""},{"id":51,"stepId":20,"type":"options","param":"3#4","audio":0,"speaker":"","content":"我得起来了#我受够了，让我安静会儿","res":""},{"id":51,"stepId":21,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":51,"stepId":22,"type":"dialog","param":"","audio":922800090,"speaker":"？？？","content":"再等一会儿吧，橙色小狗正在捡回你的帽子。","res":""},{"id":51,"stepId":23,"type":"dialog","param":"","audio":922800091,"speaker":"？？？","content":"那是她在所有急救措施以外唯一能想到的办法。","res":""},{"id":51,"stepId":24,"type":"dialog","param":"","audio":922800092,"speaker":"？？？","content":"她会这么天真且迷信可是很难得的，你我都应该配合她。","res":""},{"id":51,"stepId":25,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":51,"stepId":26,"type":"dialog","param":"","audio":922800093,"speaker":"？？？","content":"你值得片刻的安息，尊贵的救世主。","res":""},{"id":51,"stepId":27,"type":"dialog","param":"","audio":922800094,"speaker":"？？？","content":"暂时忘记外面一片狼藉的战场，放松一下吧。","res":""},{"id":51,"stepId":28,"type":"dialog","param":"","audio":922800095,"speaker":"？？？","content":"不过也别睡太久，橙色小狗正在捡回你的帽子。","res":""},{"id":51,"stepId":29,"type":"dialog","param":"","audio":922800096,"speaker":"？？？","content":"如果到时候你还不醒，我不敢想象她会做出什么。","res":""},{"id":51,"stepId":30,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}]},"dialog_step":{"46":[{"groupId":46,"id":46001,"type":1,"content":"关于你的那枚“棋子”——","name":"刻雷乌斯","avatar":"523701","chessId":1},{"groupId":46,"id":46002,"type":2,"content":"她不参与此次的作战计划。","name":"康斯坦丁","avatar":"506810","chessId":2},{"groupId":46,"id":46003,"type":1,"content":"看来你对她另有安排。真是一颗耐用的棋子。","name":"刻雷乌斯","avatar":"523701","chessId":1},{"groupId":46,"id":46004,"type":2,"content":"她确实从黑暗中带回了许多有趣的消息，不是么？","name":"康斯坦丁","avatar":"506810","chessId":2},{"groupId":46,"id":46005,"type":2,"content":"可惜蛾子在大雨中飞不长久。","name":"康斯坦丁","avatar":"506810","chessId":2},{"groupId":46,"id":46006,"type":2,"content":"我已经把关于仪式的信息交给了维尔汀，她们会需要人接应的。","name":"康斯坦丁","avatar":"506810","chessId":2},{"groupId":46,"id":46007,"type":1,"content":"“飞蛾”一人负责接应？我可以额外派遣精锐小队支援司辰。","name":"刻雷乌斯","avatar":"523701","chessId":1},{"groupId":46,"id":46008,"type":2,"content":"我想你的人还没和司辰接触过？","name":"康斯坦丁","avatar":"506810","chessId":2},{"groupId":46,"id":46009,"type":1,"content":"很遗憾。","name":"刻雷乌斯","avatar":"523701","chessId":1},{"groupId":46,"id":46010,"type":2,"content":"呵呵……毕竟司辰一向喜欢更温情的作风。","name":"康斯坦丁","avatar":"506801","chessId":2},{"groupId":46,"id":46011,"type":2,"content":"不必了——和作战不同，开启关键之门总是需要一把小而轻的钥匙。","name":"康斯坦丁","avatar":"506810","chessId":2},{"groupId":46,"id":46012,"type":2,"content":"飞蛾也需要一盏时机合适的、扑向光明的灯。","name":"康斯坦丁","avatar":"506810","chessId":2},{"groupId":46,"id":46013,"type":2,"content":"恐怕这就是她的最后一次传递了。","name":"康斯坦丁","avatar":"506811","chessId":2},{"groupId":46,"id":46014,"type":3,"content":"对话结束","name":"","avatar":"","chessId":0}],"47":[{"groupId":47,"id":47001,"type":1,"content":"我不认得你。","name":"阿尼姆斯","avatar":"524001","chessId":1},{"groupId":47,"id":47002,"type":2,"content":"勿忘我先生委派我将不老泉送至神殿，并在此协助您筹备仪式。此前我并无荣幸前来朝拜圣地，阿尼姆斯女士。","name":"淑女格蕾丝","avatar":"624901","chessId":2},{"groupId":47,"id":47003,"type":1,"content":"怎么，高贵的“勿忘我先生”已经不屑于处理这些琐事了？","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47004,"type":1,"content":"他出了什么岔子？","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47005,"type":2,"content":"我无权过问勿忘我先生的行动，阿尼姆斯女士。","name":"淑女格蕾丝","avatar":"624910","chessId":2},{"groupId":47,"id":47006,"type":2,"content":"……但上次我面见他时，他的状态很令人担忧。","name":"淑女格蕾丝","avatar":"624910","chessId":2},{"groupId":47,"id":47007,"type":1,"content":"哼，炼制永生药的代价？我倒觉得是能力不足导致的反噬。","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47008,"type":1,"content":"这是仁慈的母赋予他的至高使命，他应该亲自回到圣所，感激复苏之母垂爱。区区肉体损伤就敢拒绝朝圣……","name":"阿尼姆斯","avatar":"524001","chessId":1},{"groupId":47,"id":47009,"type":1,"content":"你没有佩戴面具。他竟然让一个未受试炼的追随者护送仪式材料？","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47010,"type":2,"content":"我已向秘之教诲者献上信仰，阿尼姆斯女士，我有幸获得了祂的庇佑。","name":"淑女格蕾丝","avatar":"624910","chessId":2},{"groupId":47,"id":47011,"type":1,"content":"你是使徒？","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47012,"type":1,"content":"你是使徒。哈，复苏之母降下的恩泽被这些卑贱者大大滥用了，先是红发的骗子，再是你这么一个——","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47013,"type":1,"content":"算了，谁都一样，我不指望你这种人能为仪式做什么筹备。","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47014,"type":1,"content":"听我指示行动——我不管勿忘我给了你什么名号，你该知道谁是这儿的话事人。","name":"阿尼姆斯","avatar":"524010","chessId":1},{"groupId":47,"id":47015,"type":2,"content":"敬遵您教诲，阿尼姆斯女士。","name":"淑女格蕾丝","avatar":"624910","chessId":2},{"groupId":47,"id":47016,"type":3,"content":"对话结束","name":"","avatar":"","chessId":0}],"48":[{"groupId":48,"id":48001,"type":1,"content":"苏菲亚小姐……仇恨无法成为新的信仰。","name":"十四行诗","avatar":"524401","chessId":1},{"groupId":48,"id":48002,"type":2,"content":"你和维尔汀，你们经历过现象世界的许多次碎裂，对么？告诉我，你们如何在流溢中前行？","name":"苏菲亚","avatar":"516001","chessId":2},{"groupId":48,"id":48003,"type":1,"content":"我们会尽可能为所有人提供庇护。司辰——基金会接纳了星锑和37，还有更多人。苏菲亚小姐，你——","name":"十四行诗","avatar":"524401","chessId":1},{"groupId":48,"id":48004,"type":2,"content":"与此同时，你们必须扯开亲人与友伴的手臂，踩着熟识之人的残躯。你们必须对“生之巨轮”里的苦难视若无睹——","name":"苏菲亚","avatar":"516011","chessId":2},{"groupId":48,"id":48005,"type":2,"content":"因为你们所乘的舟楫只有小小一叶，无法承载所有人的重量。","name":"苏菲亚","avatar":"516011","chessId":2},{"groupId":48,"id":48006,"type":1,"content":"我们……但重塑之手不是解决一切的答案，他们只会带来更多苦难和争斗！","name":"十四行诗","avatar":"524412","chessId":1},{"groupId":48,"id":48007,"type":2,"content":"这只是世界原本的面目，不是吗？","name":"苏菲亚","avatar":"516011","chessId":2},{"groupId":48,"id":48008,"type":2,"content":"……智者已到达彼岸，幸运儿在木筏上喘息，余众在其下的漩涡中挣扎。","name":"苏菲亚","avatar":"516001","chessId":2},{"groupId":48,"id":48009,"type":1,"content":"重塑之手在杀人！苏菲亚小姐，你要将更多人卷入漩涡吗？！","name":"十四行诗","avatar":"524412","chessId":1},{"groupId":48,"id":48010,"type":2,"content":"即使没有那只将沙地搅乱的手，海浪也终会将涂鸦抹平。还是说，你已经找到了解答？","name":"苏菲亚","avatar":"516001","chessId":2},{"groupId":48,"id":48011,"type":1,"content":"“正因为沙地脆弱易朽，人们才追寻永恒”……","name":"十四行诗","avatar":"524401","chessId":1},{"groupId":48,"id":48012,"type":1,"content":"牺牲是痛苦的，但我身边的每一个人都如此坚持着，在正确的道路上前进。","name":"十四行诗","avatar":"524401","chessId":1},{"groupId":48,"id":48013,"type":2,"content":"……这就是你的答案吗。","name":"苏菲亚","avatar":"516001","chessId":2},{"groupId":48,"id":48014,"type":3,"content":"对话结束","name":"","avatar":"","chessId":0}]}}