，在极地都能用上的职场经验干货。","flagText":"","acceptText":"学习案例","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"0#0#-5","fragment":0,"retroReward":""},{"id":101009,"mapId":11009,"pos":"17.2#-4.9#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=1009","showCamera":1,"showArrow":1,"type":4,"param":"47","paramCn":"","paramLang":"","title":"忠诚的尺度","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"0#0#-5","fragment":101009,"retroReward":""},{"id":1010111,"mapId":11011,"pos":"16.8#-14.5#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=11011","showCamera":1,"showArrow":1,"type":4,"param":"48","paramCn":"","paramLang":"","title":"《创世纪》隐喻","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"0#0#-5","fragment":1010111,"retroReward":""},{"id":101012,"mapId":11012,"pos":"66.3#-13.9#-5","offsetPos":"0.65#2.33","res":"","resScale":0,"tipOffsetPos":"0#2.21#-5","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_002.prefab","condition":"EpisodeFinish=11012","showCamera":1,"showArrow":1,"type":2802,"param":"101039","paramCn":"","paramLang":"","title":"户外实验","desc":"建议每一位科研工作者坚持运动，或者要求单位配备外骨骼。","flagText":"","acceptText":"前往实验场","finishText":"","dispatchingText":"","reward":"4#3115#1","rewardPoint":0,"permanentReward":"","holeSize":"0#0#-5","fragment":0,"retroReward":""},{"id":101015,"mapId":11015,"pos":"7.7#-16.9#-5","offsetPos":"0.65#2.93","res":"","resScale":0,"tipOffsetPos":"0#0.83","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_a_001.prefab","condition":"EpisodeFinish=11015","showCamera":1,"showArrow":1,"type":1,"param":"6","paramCn":"",