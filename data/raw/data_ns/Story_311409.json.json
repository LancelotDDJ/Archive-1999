_4_bg_dixiasuidao.jpg","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["穴居人……说的是那些到处游荡的家伙们吗？","","","","","","",""],"bg":"story_bg/1.4/1_4_bg_dixiasuidao.jpg","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["真的看得见我吗？它们眼中分明是一片空白，我好像根本就没必要躲躲藏藏……","","","","","","",""],"bg":"story_bg/1.4/1_4_bg_dixiasuidao.jpg","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["穴居人Ⅰ","","","","","","",""],"head_icon":"502701.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["给予我……永生……！","","","","","","",""],"bg":"story_bg/1.4/1_4_bg_dixiasuidao.jpg","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["穴居人Ⅱ","","","","","","",""],"head_icon":"502701.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["给予我……荣耀……！","","","","","","",""],"bg":"story_bg/1.4/1_4_bg_dixiasuidao.jpg","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601693","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["呜啊！别过来！","","","","","","",""],"bg":"story_bg/1.4/1_4_bg_dixiasuidao.jpg","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["虚构集迈开了步子，不管不顾地向前跑去。","","","","","","",""],"bg":"story_bg/1.4/1_4_bg_dixiasuidao.jpg","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["穿过了不知其数的、一模一样的洞穴后，虚构集停下脚步，竖起耳朵。<br>除了那些来源不明的地下风的声息之外，四周没有任何脚步声。","","","","","","",""],"b