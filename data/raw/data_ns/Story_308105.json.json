,"","",""],"bg":"","choice":[]},"17":{"step":[[17,118,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["曲娘完全沉浸在说书先生的故事里，全然没听见，直到老板娘过来拉了她一下。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015555 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["曲娘，别听了，快倒酒。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["哦，好、好，倒酒。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["别见怪，曲娘是第一次听这说书，这几日都入迷了。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["酒诗人","","","","","","",""],"head_icon":"623301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["没事没事，这说书先生的故事从不重样儿，比起我们酒客间的几句陈年老谈资，可有趣多了。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["酒诗人","","","","","","",""],"head_icon":"623301.png","audio":"610015565 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["只可惜他总只在度朔节这几天来。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["说起度朔节，你瞧瞧，我们坊里这几天也在忙着布置，又是买灯笼的，又是买烛火彩绸的。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["幸好今年有个曲娘帮衬着我，细细数来，她这一年也做了不少活计，又是念书识字，又是送酒跑堂，还帮我给城里各处送饼子。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["虽然手上没那么利索，嘴上的口条儿也要学些，但腿脚快，都舍得花工夫，用跑的去做事。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["此时，坊间来了一位客人，见众人欢欣庆祝佳节，也面露微笑，找个位子坐下。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["来一碗郎官清。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["难得里正来我酒坊里做客，这碗酒得我许娘子请你喝。","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["新出的一缸郎官清，大人尝尝口味。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我平日里甚少饮酒，今日也是借岁除欢庆的由头，来你这里且坐一坐。不过也是有事要同你讲的。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["还记得那会儿，你非要去了职祠送祝酒的活儿，否则就不收下曲娘。","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"610015710 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["今度朔将近，岁除已至，这回得了闲，特意来问问，节上职祠的祝酒准备得如何了？","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["老早就备好了，往年照例，全在我酒坊院中，一列八缸，都是醇香的上等好酒。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这又是祝酒，又是用在节上的，我可不敢怠慢。要是有差错了，可不是砸了我酒坊的招牌。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["听闻此言，知许娘子对此极上心，里正满意地点头。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["往年都是执礼来瞧过，验过。我今日来，也只是兴起一看。","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["度朔节是沛城里最要紧的节日，这金市又是城中最大的坊市，我总要最后都过一遍，千万不能出差错。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["里正也是个爱做个威武的虎脸吓死人的，我刚才差点被唬了一跳。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我心说，职祠和府里的人早就来看过祝酒了，怎么这会儿又来兴师问罪了。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["见这儿说话其乐融融，旁边的酒客也来搭话。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["听说今年要重启结社抢彩大会，是什么时候举行？","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"610015524 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们这些粗人，看不懂节日里的祭礼问卜，就这结社抢彩好看，热热闹闹地跑上一次，全城都凑着能瞧瞧。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["依旧是朔日那几天，执礼还在算吉日，不过五色彩绸、旗杆儿这些东西都已备下了。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"610015532 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不知道今年头筹由谁家拿到。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["又是彩绸，又是旗杆，又是头筹，说了这么一大串东西。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["所以，结社抢彩到底是个什么？","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["就是那些人闲着跑来跑去，就是——","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,49,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一旁的老翁笑着摆摆手，接过话头。","","","","","","",""],"bg":"","choice":[]},"49":{"step":[[49,50,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["还是我沈阿翁来说吧，这结社抢彩就是在城里五个点，竖五支旗杆，每个旗杆上各一种颜色的彩绸子。","","","","","","",""],"bg":"","choice":[]},"50":{"step":[[50,51,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["到了抢彩这天，报了名的人就都从一处出发，路线不规定，谁先拿到五条彩绸子谁就赢了，不过最后一条必是拿的红绸子才行。","","","","","","",""],"bg":"","choice":[]},"51":{"step":[[51,52,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["那第一个拿到红绸子的，我们就叫“拔头筹”，此人可以让职祠给一个福愿来实现。","","","","","","",""],"bg":"","choice":[]},"52":{"step":[[52,53,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那……什么福愿都能实现吗？","","","","","","",""],"bg":"","choice":[]},"53":{"step":[[53,54,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["里正闻言，用手捋着胡须，面上带笑。","","","","","","",""],"bg":"","choice":[]},"54":{"step":[[54,55,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["若是摘星要月的，便给不了。大部分人要的多是米粮、油布之类的，不过也有要别的东西的，比如玉佩、棋谱、茶砖之类的。","","","","","","",""],"bg":"","choice":[]},"55":{"step":[[55,56,""]],"type":1,"name":["里正","","","","","","",""],"head_icon":"620201.png","audio":"","bool_1":false,"show_name":true,"show_na