me_en":false,"no_l2d":false,"text":["及至厨房，案上早已点上油灯，麦粉也堆在一旁。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这做糟饼子的诀窍自然就是比例。","","","","","","",""],"bg":"","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["两斤酒糟，八两麦子粉，不加一丁点儿水。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["酒糟要先用手把里面的酒挤出来，这样饼子面才劲道，烤出来的才香。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["麦子粉则要选当月新磨出来的，不能有粗粒，碾得要比胭脂粉还细。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["就这样，老板娘说一句，曲娘跟着做一步。把酒糟与麦子粉混了，又按特定的手法，耐心地将它们揉在一起。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["起初，酒糟的颗粒还和麦粉有所疏离，但渐渐地，两者便融在一起，又生出一股淡淡的香味，比酒糟柔和，比麦粉厚重。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["真有趣，软软的，白白的，接下来怎么做呢。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["排成饼子，放进炉里烤？","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不着急，还差一个东西，不过你要注意看，但别被吓到了。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["说罢，老板娘拿出一个四方四正的木板，抓了把麦粒撒在上面，又倒上一碗水，用手指沾了往麦粒上洒。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["只见老板娘口里念念有词，三两下间，那麦粒便开口发芽，又吃风似地往上长去。","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["曲娘见此景奇异，只盯着看，那案上的麦苗长到一掌多高，才将将停下。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,85,""]],"type":1,"name":["曲娘","","Jiu Niangzi","","","","",""],"head_icon":"308301.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你也会——老板娘你会法术？","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["就是些神秘术，小戏法，这城里的很多人都会。我这却没什么厉害，只能催发豆子，只不过能省去我不少时间。","","","","","","",""],"bg":"","choice":[]},"86":{"step":[[86,87,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["老板娘把刚长出的麦芽切了，细细剁碎，和揉好的面团混在一起。","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,88,""]],"type":1,"name":["许娘子"