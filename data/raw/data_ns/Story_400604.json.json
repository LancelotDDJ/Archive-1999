"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["只是，你为何如此惊讶？你不是早已看见了未来吗？","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"610015618","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我并不能预见未来。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["葛天闭上双眼，墙壁上的洞穴已然并合。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我族名为“灭蒙鸟”，可识骨辨相，改命游方。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我断言你与我还会相见，是预见你骨相中探知心重，且不轻易放弃。我只是一时忙乱，并无躲避你的意思，只要我们都还在城内，自然还能再见面。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["“骨相”是什么？根据你的意思，它似乎是一个人的……某种本质？","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"610015619","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你可以如此理解。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["骨为支撑，皮之下为血肉，血肉下为筋脉，筋脉盘踞于骨架。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["混沌的、柔软的东西之后，支撑与树立的根本，便是骨相。知得骨相，便可通晓万物。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["鸟儿宽阔的翅膀蜷缩在一起，信纸悬停其上。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"7208665","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这么一说，你也是一位鉴赏家。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我感知到的香气、介质、尺寸与形态，是我的鉴赏方式。而你摒弃其余，只凝视构架骨骼。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她审视着面前巨大的鸟儿，将银钗置于他的面前。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我恰好有一个问题，愿意与来自东方、通晓万物的鉴赏者洽谈。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"610015621","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这是，那支能够施展“穿墙术”的……","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"7208681","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是的，一支神奇的银质头饰。它工艺粗糙，但造型风趣，轻巧便于携带，是支难得的好术