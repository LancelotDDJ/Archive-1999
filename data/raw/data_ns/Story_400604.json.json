01.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你曾说过，你是一名采访者。","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你的采访追寻的是明确的答案吗？","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不，当然……不是。《UTTU》应当展现想法、思想与真正的本质。","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["白雪松","","","","","","",""],"head_icon":"562101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["它是先锋，是意识，而非教科书与工具。","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这正是我从你身上看到的，白雪松小姐。","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["执迷于细枝末节的分析会让前路失去方向。","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["葛天前进一步，将手中银钗向前轻轻抛出，叮当一声，钗尖正中墙壁。","","","","","","",""],"bg":"","choice":[]},"47":{"step":[[47,48,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["而那洞开的口诀他早已知晓。","","","","","","",""],"bg":"","choice":[]},"48":{"step":[[48,56,""]],"type":1,"name":["葛天","","Getian","","","","",""],"head_icon":"308401.png","audio":""