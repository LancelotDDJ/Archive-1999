]},"32":{"step":[[32,33,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["谢尔盖甩开姑父的手。一阵尴尬的愠怒染红了老人的脖子，他别过脸，斜眼看向一旁的梅蕾尔。","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"","audio":"613301102","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她是我朋友，你别在意她，说吧。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["姑父","","","","","","",""],"head_icon":"561101.png","audio":"613301205","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我们都在说，骑兵军不会管我们死活了，就算要管也管不了了。上游逃难过来的人说，匪军有好几万呢。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["姑父","","","","","","",""],"head_icon":"561101.png","audio":"613301206","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他们哪儿来这么多人啊？——这我倒不知道了，反正比你们骑兵军的人还多不少吧。你们拿什么打呢？","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["姑父","","","","","","",""],"head_icon":"561101.png","audio":"613301207","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我悄悄告诉你，在你们来之前的几天夜里，村里剩下的小巫师、小女巫都投匪军去了！","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["谢尔盖","","","","","","",""],"head_icon":"","audio":"613301103","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["什么？！","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["姑父","","","","","","",""],"head_icon":"561101.png","audio":"613301208","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["别喊这么大声！他们走之前都说，谁要和骑兵军站一边，等他们杀回来了，就烧谁家的屋子。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"