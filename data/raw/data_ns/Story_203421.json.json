"","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400617","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["都有，对吧？你之所以会晕倒，是因为你身上的“气”出现了亏空。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["惠姑","","","","","","",""],"head_icon":"642502.png","audio":"613401793","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["可……我确实也觉得近日身体轻快了不少，就连头脑也清晰了许多……","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400618","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["因为“调气”本就是休养生息之法，只是“调气”的话自然会强身健体。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400619","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["但“存元”需要你将体内的“气”与天道调和，若是你的身体不够强健，如何承载与天道相近的“气”？","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400620","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["因此你“存元”越深，对身体的负担就会越大，长此以往，自会亏空。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400621","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["而我们白马派的功法，注重的是磨炼身体，以身载“气”，因此会在“易筋”这一步耗费很长时间。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon"