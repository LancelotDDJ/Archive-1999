4_bg_05.jpg","choice":[]},"57":{"step":[[57,58,""]],"type":1,"name":["惠姑","","","","","","",""],"head_icon":"642502.png","audio":"613401808","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你随手在石头上的刻痕能残留一万年……而我只剩这两个月。你为什么要来阻止我呢？","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"58":{"step":[[58,59,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["鹭鸶剪沉默了，久久不再开口。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400633","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["给你在石头上刻字的时候，我并没有想那么多……","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400634","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那么，你想和石头一样长久吗？","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["惠姑","","","","","","",""],"head_icon":"642502.png","audio":"613401809","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["……像石头一样？","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["鹭鸶剪笑着点了点头，那笑容中却有着一丝悲哀。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400635","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["还有一种长生之法，这是白马派的秘密，也是在金丹术和任仙子的法门外的第三种长生。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400636","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["它不要求修炼者投入经年累月的时间，也不需要亏空先天俱来的气，只需失去一个门派，一把宝剑，在树中冰封近百年。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400637","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["时过境迁，故人与敌人都逝去了。而那求得长生的人孑然独活，食不知味，无悲无喜。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400638","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["虽然走遍了东坊西头，但再也吃不出桂花糯米糕和椒盐麻饼的区别。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400639","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["明明那杂耍的火焰让众人欢呼，但却感受不到那火应有的热度，亦不知众人欢呼的原因。","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400640","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["摸不到云雾的凉爽，亦触不到流水的清冽，冷热软硬，一概消失，仿佛一具活尸……","","","","","","",""],"bg":"story_bg/3_4/3_4_bg_05.jpg","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["鹭鸶剪","","Paper Heron","","","","",""],"head_icon":"314101.png","audio":"613400641","bool_1":false,"show_n