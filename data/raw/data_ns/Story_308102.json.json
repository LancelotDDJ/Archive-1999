":[[64,65,""]],"type":1,"name":["酒翁","","","","","","",""],"head_icon":"623401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["看，她多熟练，我说了是个聪慧的小人儿，过两年老板娘的位置可能就是她来当喽。","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015559","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["咯咯咯～那是最好了，我正好当个甩手掌柜，日日坐在后面享清福，也不用天天对着你们这一坊酒蒙子。","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["那坛土窟春一打开，便涌出股奇香。沛霖川绕着沛城而过，许娘子每每取这条河上游的水，只有这清冽的水才能酿出这奇香的酒。","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["老酒客正想象这坛中酒成线，盛满自己的瓷碗，但接着就看见那小娘子将两手伸入酒坛中，掬起一捧清冽美酒送至他跟前。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["小九","","","","","","",""],"head_icon":"623001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["客人喝酒～","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["小九","","","","","","",""],"head_icon":"623001.png","audio":"610015599 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["喝酒～请喝酒～","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["话还未说完，土窟春已顺着她的指缝流个精光，酒客的衣襟也被淋了个酒味扑鼻，香满身。","","","","","","",""],"bg":"story_atcg/1_6/1_6_at_cuyongqunianggai.jpg","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["坊内众人先是一愣，随即哄笑一堂。酒客爱酒，惜酒，但更爱喝酒时的活泛气氛。","","","","","","",""],"bg":"","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["酒到酣时，诸事皆乐。","","","","","","",""],"bg":"story_bg/1_6/1_6_bg_jiufangyuanzhong.jpg","choice":[]},"73":{"step":[[73,74,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015559","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["咯咯咯～莫怪罪，莫怪罪，这碗天下独一份的手心酿，是小九第一天上工，单请你一个人喝的。","","","","","","",""],"bg":"","choice":[]},"74":{"step":[[74,75,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我先给你赔不是了，今日请你两大碗西市腔，管保你晕着头回去。","","","","","","",""],"bg":"","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015543 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["只是这一坛上好的土窟春，被这小九一伸手，经了肉气，怕是要发酸变味儿，不能喝了。","","","","","","",""],"bg":"","choice":[]},"76":{"step":[[76,77,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["话是这样说，许娘子却并不怪罪，只是把她一双小手拉来看了又看，怕那烈酒烧了那肌肤，又去拿了巾子来收拾这满桌的美酒。","","","","","","",""],"bg":"","choice":[]},"77":{"step":[[77,78,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["老酒虫自然是不恼的，他白得了两大碗西市腔，自然乐在其中，换了张桌子又继续喝起来。","","","","","","",""],"bg":"","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["小九","","","","","","",""],"head_icon":"623001.png","audio":"610015593 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["多奇怪，大家不急也不恼，都接着喝起酒。","","","","","","",""],"bg":"","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["小九","","","","","","",""],"head_icon":"623001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["酒……到底是什么味儿呢？","","","","","","",""],"bg":"","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["酒呢，是世间上独一份的惬意，也是独一份的糊涂。","","","","","","",""],"bg":"","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不过到底是什么味儿，还得等你再长些年头，自己来尝尝了。","","","","","","",""],"bg":"","choice":[]},"82":{"step":[[82,83,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["听此，小九立刻就用手指沾了些桌上还未挥发干的酒液，要送入嘴里。","","","","","","",""],"bg":"","choice":[]},"83":{"step":[[83,84,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["还好许娘子眼疾手快地拦下了她。","","","","","","",""],"bg":"","choice":[]},"84":{"step":[[84,125,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015541 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["哎，哎——！我说的可是“再长些年头”……你身板尚小，年岁不大，动起手来却不含糊，倒真利利索索的。","","","","","","",""],"bg":"","choice":[]},"85":{"step":[[85,86,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["现下喝水，往后吃酒吃茶，都要用碗，这是礼法规矩，可乱不得。","","","","","","",""],"bg":"","choice":[]},"86":{"step":[[86,87,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["赶明儿我刻个有名字的碗给你，往后事事都要有教礼，不懂的就问人，切不能随了性子胡乱着来。","","","","","","",""],"bg":"","choice":[]},"87":{"step":[[87,126,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["话音落下，许娘子才再端起酒坛。只听得哗啦啦声响，那酒水泛出淡淡绿光，好似琉璃珠串落玉盘，顺流而下，盛满了一旁酒客的泥碗。","","","","","","",""],"bg":"","choice":[]},"88":{"step":[[88,89,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["而四周竟是无一人来得及阻止。霎时间，难以言说的味道在她唇舌间蔓延，和这小孩平日里吃过的任何东西都不一样。","","","","","","",""],"bg":"","choice":[]},"89":{"step":[[89,90,""]],"type":1,"name":["小九","","","","","","",""],"head_icon":"623001.png","audio":"610015606 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["——它是辣的，好烫，好烫，舌头上有火在烧。","","","","","","",""],"bg":"","choice":[]},"90":{"step":[[90,91,""]],"type":1,"name":["小九","","","","","","",""],"head_icon":"623001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不苦也不甜，好像有东西在鼻子里打转。","","","","","","",""],"bg":"","choice":[]},"91":{"step":[[91,92,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["登时，那喉咙都要烫起来，眼泪鼻涕皆要往外窜，小九脸面皱起，连连甩手咂舌。","","","","","","",""],"bg":"","choice":[]},"92":{"step":[[92,93,""]],"type":1,"name":["小九","","","","","","",""],"head_icon":"623001.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不喜欢，怎么会喜欢喝这么辣的东西？","","","","","","",""],"bg":"","choice":[]},"93":{"step":[[93,94,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"610015541 ","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你这孩子！罢了，以后可不许喝了，等到你再长些年岁，才会知晓这酒个中滋味。","","","","","","",""],"bg":"","choice":[]},"94":{"step":[[94,95,""]],"type":1,"name":["许娘子","","","","","","",""],"head_icon":"622901.png","audio":"","bool_1":false,"show_name":true,"show_na