":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["导员说不定是想让我去战场上试试他们新开发的玩意儿。","","","","","","",""],"bg":"","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["威力惊人的砰砰炸弹，里面塞着八十八只不稳定的伊芙灵，一颗巴掌大的手雷能把一整块岩石给炸成碎屑。","","","","","","",""],"bg":"","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["因为我能飞，所以他们才敢把那玩意儿交给我。","","","","","","",""],"bg":"","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["还有用76型试验虫改造的小雷达，能够接收预设好的频道信号，都是芝诺新开发的东西。","","","","","","",""],"bg":"","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["起初我很兴奋，想着要在那干几票大的。","","","","","","",""],"bg":"","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["最好再弄几枚亮闪闪的勋章回来，给学院的怂包们开开眼。","","","","","","",""],"bg":"","choice":[]},"15":{"step":[[15,150,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["要知道，只有最厉害的家伙才有资格被派往战区。","","","","","","",""],"bg":"","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["乌哈拉是座糟糕的城市。我下了飞机，又坐上卡车。","","","","","","",""],"bg":"","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["去之前，我以为那里是土黄色的，就像卡车轮胎上沾的泥。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["树比我想象中多一些。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["城外的山顶还闪着单调的白色，像弹片在太阳下反光。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“兴都库什高山，让雄鹰也望而生叹。”——这是去之前导员说过的话。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我还记得，车上每个人都不爱说话，可能是路上烟尘太大了吧。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["没多久，车停了，司机猛按喇叭，骂骂咧咧地赶我们下车。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["下车后，我们愣在原地，像群傻瓜，站在坝子上发呆。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,152,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["嗨？没人来接我们吗？把我们扔下车，然后就撂在这吗？","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,153,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["嗨，嗨，同志，你觉不觉得应该有点什么人来把我们带到基地去？","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507501.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["嗯……那个，伙计，你认识路吗？这儿，就是去这儿的路。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我跟好几个人都搭了话，还给他们看我兜里的地图，但很遗憾，没人搭理我。","","","","","","",""],"bg":"","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他们看我的眼神像看一只兔子，但你见哪个兔子能有隼一样的利爪呢？","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["好吧，我猜当地的同志一定很忙，毕竟在打仗，所以才忙得抽不出人手来接我们。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["但也可能就是忘了有这回事。总之我熬着耐心等了很久，很久很久……","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507514.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["足足有十分钟！等到乌哈拉的太阳把我晒得不耐烦了，我就不想再呆在那儿当个傻子了！","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["好吧，同志们，那就在这分别吧！祝你们好运！Всегохорошего！","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我兜里有报道信，也有地图，虽然都被水壶漏水浸湿了，但没关系，还看得清。","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我对着地图在城市里瞎转，事情很快又有了转机。","","","","","","",""],"bg":"story_bg/bg/yindujiedao_zhou.jpg","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["有个好心的当地人认出军装，在街上叫住我。","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["热情的当地人","","","","","","",""],"head_icon":"","audio":"7208558","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["芝诺的人？欢迎，欢迎，朋友！","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["热情的当地人","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你要去驻地吗？那得往前走，不远。先走一百二十步，然后拐进红墙的巷子，再走二百一十步。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["热情的当地人","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["接着向右转，看到有两棵菩提树的路口，面对树再右转，就是法鲁克老爷的茶铺了。从铺子旁边的台阶下去，左拐走五十步……","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["红弩箭","","","","","","",""],"head_icon":"507512.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["他像个热心的向导，讲得很细。","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["热情的当地人","","","","","","",""],"head_icon":"","audio":"7208566","bool_1":false,"show_name":true,"show_n