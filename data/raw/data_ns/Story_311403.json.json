.png","audio":"7208853","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":[" （缓缓开口）欢迎，旅人。你们的到来是命中注定，但穿越这片迷雾并非易事。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"59":{"step":[[59,60,""]],"type":1,"name":["牧童","","","","","","",""],"head_icon":"518901.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（低声却清晰）故乡不是一座房子，而是一段回忆。一头牛会在失去牧草的地方徘徊，但它总会找到回家的路。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"60":{"step":[[60,61,""]],"type":1,"name":["老者","","","","","","",""],"head_icon":"612901.png","audio":"7208838","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（喜出望外）天呐，原来是你们！你们终于来了，一切的始作俑者。我已经等待了你们足足一个世纪。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"61":{"step":[[61,62,""]],"type":1,"name":["老者","","","","","","",""],"head_icon":"612901.png","audio":"7208858","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（庄严而严肃）想要触碰到隐喻神庙的核心，你们必须解开一个谜题。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"62":{"step":[[62,63,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311416.png","audio":"612601626","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["噢？说来听听！","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"63":{"step":[[63,64,""]],"type":1,"name":["老者","","","","","","",""],"head_icon":"612901.png","audio":"7208849","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（故作神秘地絮絮叨叨）我不能直接告诉你，只有牧童知道那个谜题，但他也不会直接告诉你——这一切都是隐喻的一部分。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"64":{"step":[[64,65,""]],"type":1,"name":["老者","","","","","","",""],"head_icon":"612901.png","audio":"7208824","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（故作神秘地絮絮叨叨）瞧瞧他，你……你必须先哄这孩子开心才行。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["牧童","","","","","","",""],"head_icon":"518901.png","audio":"7208102","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（开心而欢快）对，对，对！你必须得哄我开心才行……","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["牧童","","","","","","",""],"head_icon":"518901.png","audio":"7208101","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（疑惑而狡黠）不对，不对！我为什么要听你的，老顽固？","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["牧童欢快地拍起了手，重新吹起了悠长的口哨。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["一头牛从阴影中走来，眼神中充满了智慧。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["牧童","","","","","","",""],"head_icon":"518901.png","audio":"7208169","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（天真地瞪大眼睛）姐姐，你好！这就是谜题。只有我的牛才能驮着你们上去。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["老者","","","","","","",""],"head_icon":"612901.png","audio":"7208833","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["（气急败坏、面部扭曲）你……你这顽童！这不符合咱们的规矩……","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["没等老者说完，身手敏捷的少女一个翻身便骑了上去。","","","","","","",""],"bg":"story_bg/bg/tianwentai.jpg","choice":[]},"72":{"step":[[72,73,""]],"type":1,"name":["","","","","","","