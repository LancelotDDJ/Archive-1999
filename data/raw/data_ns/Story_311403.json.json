ue,"show_name_en":false,"no_l2d":false,"text":["当然。在非工作时间，它是个十足的好东西。另外，房间里有点儿乱。不介意吧？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"9":{"step":[[9,10,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我不会在意的……倒不如说这明明就收拾得很干净。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"10":{"step":[[10,11,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["想到自己在手提箱的房间里到处乱扔的旧书、稿纸和衣服——她不禁有些心虚。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"11":{"step":[[11,12,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["随便坐——沙发、坐垫、凳子，甚至地上都行。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"12":{"step":[[12,13,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["编辑坐在床边，将玻璃壶放在堆满书的床头柜边上。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"13":{"step":[[13,14,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["对了，有个话题，我得跟你聊聊。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"14":{"step":[[14,15,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["你知道我为什么建议你去学习电影剧本的写作吗？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"15":{"step":[[15,16,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["难道不是为了让作品结构变得更好吗？就像海明威、沃尔夫和菲茨杰拉德的那位共同编辑——麦克斯威尔·珀金斯一样。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"16":{"step":[[16,17,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["听到那个名字，编辑抿起嘴，喉咙滚动了一下。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["不不不，你过誉了，虚构集。我……远远没有那么伟大。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["起初，我并不理解为什么像你这样年轻的作家会对文学充满执念。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我想让你自己意识到，电影为什么征服了90年代，而文学爆炸的火花又为何走向了熄灭。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我想让你自己碰壁，让你自己亲眼看见文学大陆的没落。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601623","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["嗯？怎么会呢？文学大陆是不会没落的，亨廷女士！它只是在季节的更迭中短暂地显得有些荒芜罢了。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["正是因为这份荒芜，我才要去写作。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我所仰慕的作家们是一群伟大的探索者、反抗者与叛逆者，他们从不会去思考时代的风浪往哪边涌去。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601624","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["这种反抗精神支撑着一批作家，而那一批作家又反过来重新建筑了这一类精神。那是多么酷的事情啊！","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["好吧……那的确很酷。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["我们换个话题。你觉得你真正了解当下的文学世界吗，虚构集？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["“连我自己对我真正的生活都知之甚少或一无所知。”<br>沃尔特·惠特曼尚且如此，我们又怎么能假定了解当下真正的文学世界呢？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"612601625","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["对我而言，写作本就是一种不亚于周游世界，或是坠入美梦的体验本身。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["呵，喜欢这样说的作家我见多了。既然你这么想，那……","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她想起了虚构集在隐喻神庙里罔顾一切的姿态。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["某种遥远的东西在刺挠她的心窝，就像一件许久不穿的旧毛衣。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["算了，没什么。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["看着虚构集意犹未尽的姿态，编辑意识到：该进入正题了。","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["编辑亨廷","","","","","","",""],"head_icon":"523801.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["行了，趁我没把这壶酒全都喝完，让我们干点儿正事吧！故事的后半部分呢？","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311401.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["好！虽然跟您聊天也很有意思，但我也想尽快把结局修改完。按照您上次的建议，我研读了一些电影的书籍，并加入了一些属于电影剧本形式的对话！","","","","","","",""],"bg":"story_bg/bg/woshi_ye.jpg","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"tex