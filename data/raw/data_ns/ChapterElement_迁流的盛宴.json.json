":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""},{"id":3210407,"mapId":3210119,"pos":"33.4#-22.8","offsetPos":"4#-1.5","res":"","resScale":0,"tipOffsetPos":"","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_004.prefab","condition":"EpisodeFinish=3210119","showCamera":1,"showArrow":1,"type":3203,"param":"3207","paramCn":"","paramLang":"","title":"虽然并非皆大欢喜","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""},{"id":3210501,"mapId":3210119,"pos":"35.6#-20.7","offsetPos":"4#-1.5","res":"","resScale":0,"tipOffsetPos":"","effect":"scenes/v3a2_m_s08_hddt/prefab/v3a2_m_s08_hddt_icon_b02.prefab","condition":"ChapterMapElement=3210301","showCamera":1,"showArrow":1,"type":3204,"param":"1","paramCn":"","paramLang":"","title":"书封之上","desc":"","flagText":"","acceptText":"","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""},{"id":3210106,"mapId":3210120,"pos":"73.7#-22.9","offsetPos":"4#-1.5","res":"","resScale":0,"tipOffsetPos":"","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_001.prefab","condition":"EpisodeFinish=3210120","showCamera":1,"showArrow":1,"type":1,"param":"","paramCn":"","paramLang":"","title":"敞开命运的门扉","desc":"有些预言遥遥无期，有些预言即刻兑现。","flagText":"","acceptText":"如你所见","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":3210106,"retroReward":""},{"id":3210107,"mapId":3210120,"pos":"79.2#-20.85","offsetPos":"4#-1.5","res":"","resScale":0,"tipOffsetPos":"","effect":"scenes/m_s08_hddt/prefab/hddt_front_icon_s_001.prefab","condition":"EpisodeFinish=3210120","showCamera":1,"showArrow":1,"type":18,"param":"52","paramCn":"","paramLang":"","title":"伪证的反义词","desc":"她面不改色，心率正常，证词没有丝毫矛盾之处。","flagText":"","acceptText":"查看档案","finishText":"","dispatchingText":"","reward":"","rewardPoint":0,"permanentReward":"","holeSize":"","fragment":0,"retroReward":""}],"chapter_map_fragment":{"3210101":{"id":3210101,"title":"欢迎来到巴黎","res":"v3a2_fragmenticon_001","type":1,"content":"&nbsp;&nbsp;&nbsp;&nbsp;在前不久刊载的“神秘学家最倾向定居的城市”评选中，巴黎位居榜首。受访者普遍表示，在以人类为主要居住群体的大城市中生活并非易事，神秘术往往会主动或被动地破坏既定的社会规则，这注定会造成不必要的混乱和麻烦。然而巴黎自古以来对于不同的族群和族裔都有着更大的包容度，这里的人类艺术团体甚至视神秘术为一种奇妙且浪漫的技艺，神秘学家也常成为沙龙的贵宾。对于人类而言，这里是艺术的苗圃，对于神秘学家而言，这里是创想的温床。<br>&nbsp;&nbsp;&nbsp;&nbsp;据悉今年已有诸多知名神秘学企业家在巴黎开设分店，他们对于巴黎的信任吸引了更多人的关注。这座历史名城正源源不断地吸收来自欧洲各地的神秘学资源，尽管人类对于神秘学盛行的隐忧仍不绝于耳，但我们相信，将会有越来越多的城市以巴黎为榜样。<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;——《神秘学家观察（半月刊）》","toastId":0},"3210201":{"id":3210201,"title":"午夜哀声","res":"v3a2_dungeonpanel_pic13","type":0,"content":"一位酒店安保人员指出，他在夜间巡逻时不止一次听到女人忧伤的话语声。然而屡次检查后他确认走廊和房间内并没有任何陌生人藏匿的迹象。","toastId":0},"3210202":{"id":3210202,"title":"异域面具","res":"v3a2_dungeonpanel_pic12","type":0,"content":"一位流浪汉提供情报，他在封闭的小巷内看见戴着螃蟹面具的人出没，其穿着并不像无家可归的人。据称那面具上的表情变化得十分生动，好像蟹壳上的纹路就是面庞本身一样。","toastId":0},"3210102":{"id":3210102,"title":"一通报案电话","res":"v3a2_fragmenticon_002","type":1,"content":"&nbsp;&nbsp;&nbsp;&nbsp;对……我要来报案，我的一个亲戚……她失踪了。<br>&nbsp;&nbsp;&nbsp;&nbsp;玛丽姨妈，她是家族里最年轻的长辈……她很安静，总是在阅读一些我们不感兴趣的诗集……从来不喝酒，会烘焙一些好吃的蛋糕给家里的孩子们……她现在不见了，我们所有人都找不到她，甚至连她的衣服、书籍和烘焙用品都不见了！怎么会有人把这些也都带走呢……<br>&nbsp;&nbsp;&nbsp;&nbsp;提供形象？噢是的，玛丽姨妈身形比较小，偏瘦，梳着整齐的褐色短发，右臂上有一块胎记……不……我们没有照片，我的家人翻遍了所有的相册，都找不到她的照片。但她就是我的家人呀，怎么会不在合照里呢，这太奇怪了……<br>&nbsp;&nbsp;&nbsp;&nbsp;等等，你说不受理是什么意思，什么叫没有存在证据的失踪者太多了？","toastId":0},"3210103":{"id":3210103,"title":"生人勿扰","res":"v3a2_fragmenticon_003","type":1,"content":"“再等下去天都要亮了，你确定咱们能捞到好东西？”<br>“要我说，保罗，咱们今天可是撞见大鱼了，我亲眼看那家伙从这里进去的。”<br>“进地下墓穴？然后呢，所有巴黎人都知道这里除了骨头什么都没有！”<br>“那家伙拿着好几个手提箱，他一定是想把好东西藏在这里。现在，只要我们等他出来，里面的东西就都是我们……”<br>“好像有动静。”<br>“嘘，他出来了！”<br>“等等……你看到的那个人，有这么高大吗……”<br>“绝对没有……他的头，不，手，他的手，不太对劲……”<br>“他好像看过来了……他是不是看过来了？他看到我们了！”<br>“跑！保罗！快跑！跑！”","toastId":0},"3210203":{"id":3210203,"title":"河畔幽光","res":"v3a2_dungeonpanel_pic14","type":0,"content":"一位船夫在夜间行船时目击到岸边有蓝色的火焰飘动，火焰在他靠近前迅速消失。船夫声称他在塞纳河上驾船二十年来从未遇见这种情况，并且确信附近不会有磷火现象出现。","toastId":0},"3210104":{"id":3210104,"title":"“太阳王的宠臣”","res":"v3a2_fragmenticon_004","type":0,"content":"&nbsp;&nbsp;&nbsp;&nbsp;佩剑贵族在路易十四的时代里大都过得不太舒服。他们被迫进驻凡尔赛宫，用繁复的贵族礼节向国王表示服从，倘若能够博得国王的些许恩宠，那么多些赏赐和年金也能抵挡不少债务。<br>&nbsp;&nbsp;&nbsp;&nbsp;饶是如此，他们也拒绝摘下佩剑、换上长袍，有神秘学家血统的老派贵族情愿继续卖弄他们“独一无二”的神秘术。巴隆家族就是其中一员，曾经在古代战场呼雷喝电的他们，也只能在宴会上耍一些把戏，好让他们在社交场上出点风头。<br>&nbsp;&nbsp;&nbsp;&nbsp;总有支撑不下去的时候。拿破仑时代之后，这些债台高筑的老爷们终于不得不穷尽一切手段获利。变卖家产已经是上流社会心照不宣的行径，投资小生意也不再是个下贱事。幸而其时铝价金贵，巴隆先生得以凭借神秘术在制铝业中获得一席之地，由此得以让家族维持体面。<br>&nbsp;&nbsp;&nbsp;&nbsp;可惜好景不长，在新秩序和新武器将过去的一切碾得粉碎的同时，人类飞速发展的技术也使得低产的神秘术又一次沦落到无用的境地。看看这些灯泡和电缆吧，电流已经不再是什么稀罕东西了，霍尔-埃鲁法的推广彻底摧毁了巴隆家族最后的营生。<br>&nbsp;&nbsp;&nbsp;&nbsp;多么可悲的荣耀往昔，多么可怜的高贵人儿。这些落寞的家族太需要一个机会，一双援手，一个能够改换时代、重现神秘学家荣光的可能……","toastId":0},"3210204":{"id":3210204,"title":"梦中小象","res":"v3a2_dungeonpanel_pic15","type":0,"content":"很多妇女反映，她们的孩子在公园玩耍时会尖叫着跑回母亲身边，并于当晚做严重的噩梦。在梦的开始，他们无一例外都会见到那只模糊的玩偶小象。","toastId":0},"3210105":{"id":3210105,"title":"一份记录","res":"v3a2_fragmenticon_005","type":0,"content":"&nbsp;&nbsp;&nbsp;&nbsp;一切事情都正在发生。<br>&nbsp;&nbsp;&nbsp;&nbsp;所有的占卜、预言、思想，以及那些似曾相识的感受，梦，都并非偶然。<br>&nbsp;&nbsp;&nbsp;&nbsp;打个比方，其实存在一个跨时间、跨空间的宝库。爱与恨，好运或者厄运，古老的原型和传说，都存放其中。我们本来永远没有机会踏入，但是，感谢引导之人与“暴雨”为我们带来的无数奇迹。这个真实存在的意象宝库，也就是现在被正式定名的“迷思海”，如今已经可以被我们观测到。<br>&nbsp;&nbsp;&nbsp;&nbsp;也感谢某位前人的研究和冒险，让我得以接触这些信息，她的牺牲和探究精神值得我们尊敬与效仿，希望各位都能向她学习。<br>&nbsp;&nbsp;&nbsp;&nbsp;……","toastId":0},"3210205":{"id":3210205,"title":"神来之笔","res":"v3a2_dungeonpanel_pic11","type":0,"content":"一位在广场写生的画家回忆，在他的画作“陷入巨大的瓶颈和迷茫时”，一个“具有特殊灵感气质的年轻人”帮助他完成了作品，其中“精妙的立体主义构成”“闪烁着新时代缪斯的光芒”，他相信这一定是“某种奇伟的艺术之神”显灵的结果。","toastId":0},"3210206":{"id":3210206,"title":"陆上鲸歌","res":"v3a2_dungeonpanel_pic16","type":0,"content":"本情报由特派调查员提供。该调查员行至战神广场时，其携带的声音测量装置显示收到了连绵不绝的次声波，其频率和节奏与鲸所发出的声波极为相似，而这是绝对不可能在巴黎出现的声音。该调查员尝试定位声源，未能寻得。","toastId":0},"3210106":{"id":3210106,"title":"即刻兑现的预言","res":"v3a2_fragmenticon_006","type":0,"content":"&nbsp;&nbsp;&nbsp;&nbsp;她一定预见过这个场景。<br>&nbsp;&nbsp;&nbsp;&nbsp;眼前的灰黑色大理石板，它们平直有序的线条和脑中的场景逐渐重合在一起。访客们的轮廓与水晶球中的预兆无比接近。黑框的眼镜，黑色的眼睛，她比印象中的更温和，也更坚定。蓝色的礼帽，冷漠的表情，早已在孩童时代就熟悉的朋友。<br>&nbsp;&nbsp;&nbsp;&nbsp;还有……还有一只小鸭子，正扑着翼，急匆匆地飞上台阶，小皮鞋啪嗒啪嗒响，撞到了人也不道歉……一层，两层，长长的走廊，她从没觉得基金会的楼有这么大……不需要问路，不需要打听，笃定地奔跑，气喘吁吁……<br><br>&nbsp;&nbsp;&nbsp;&nbsp;“不用关门，维尔汀，很快还会有人抵达。”她轻声提醒。<br>&nbsp;&nbsp;&nbsp;&nbsp;蓝礼帽将眼神投向黑眼镜，后者点头应允。<br><br>&nbsp;&nbsp;&nbsp;&nbsp;急促的脚步声由远及近，与喘息声一同到达，省去了擂鼓般敲门的步骤，虚掩的门被径直推开——<br>&nbsp;&nbsp;&nbsp;&nbsp;“哈！妈妈！呼……我就知道你在这儿！”","toastId":0}},"chapter_map_element_dialog":{"3201":[{"id":3201,"stepId":1,"type":"dialog","param":"","audio":922800237,"speaker":"？？？","content":"这件事大概发生在两年半前，或者说，约十六年后的未来……","res":"v3a2_dungeonpanel_pic17"},{"id":3201,"stepId":2,"type":"dialog","param":"","audio":922800238,"speaker":"？？？","content":"对我来说，它就像发生在昨天。但对你来说，这恐怕是未曾听闻的故事。","res":""},{"id":3201,"stepId":3,"type":"dialog","param":"","audio":922800239,"speaker":"？？？","content":"让我们从头讲起。","res":""},{"id":3201,"stepId":4,"type":"dialog","param":"","audio":922800240,"speaker":"？？？","content":"当时照常结束了大战的法国百废待兴，对和平的渴望达到史无前例的高度。","res":""},{"id":3201,"stepId":5,"type":"dialog","param":"","audio":922800241,"speaker":"？？？","content":"迟到的大萧条也为经济发展提供了缓冲期，各种人的涌入带来无数机遇。","res":""},{"id":3201,"stepId":6,"type":"dialog","param":"","audio":922800242,"speaker":"？？？","content":"但经济发展终究开始减速，困苦的生活令大量新思想抬头，巴黎的自由逐渐转变为混沌……","res":""},{"id":3201,"stepId":7,"type":"options","param":"1#2","audio":0,"speaker":"","content":"这些都和这次的故事有关？#我想主人翁就是那位出租车司机了","res":""},{"id":3201,"stepId":8,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":3201,"stepId":9,"type":"dialog","param":"","audio":922800243,"speaker":"？？？","content":"或许没有关系，即使不知道这些，也不妨碍你了解接下来的故事。","res":""},{"id":3201,"stepId":10,"type":"dialog","param":"","audio":922800244,"speaker":"？？？","content":"但我们总该弄清潜在的背景，以防你被一些不重要的细节夺走注意力。","res":""},{"id":3201,"stepId":11,"type":"dialog","param":"","audio":922800245,"speaker":"？？？","content":"因为我要讲的不是巴黎的社会与经济状况，而是一则传言——","res":""},{"id":3201,"stepId":12,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":3201,"stepId":13,"type":"dialog","param":"","audio":922800246,"speaker":"？？？","content":"是的，她被卷入了巴黎的混沌中。","res":""},{"id":3201,"stepId":14,"type":"dialog","param":"","audio":922800247,"speaker":"？？？","content":"一位英雄之后，带着宿命与诅咒出生，却甘于做一个普通市民。","res":""},{"id":3201,"stepId":15,"type":"dialog","param":"","audio":922800248,"speaker":"？？？","content":"不过命运终将找上她——","res":""},{"id":3201,"stepId":16,"type":"dialog","param":"","audio":922800249,"speaker":"？？？","content":"在经历一场冒险之后，留给她的只有未尽的遗憾。","res":""},{"id":3201,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3201,"stepId":18,"type":"options","param":"3","audio":0,"speaker":"","content":"这故事没有好结局？","res":""},{"id":3201,"stepId":19,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":3201,"stepId":20,"type":"dialog","param":"","audio":922800250,"speaker":"？？？","content":"它会有个结局的。有关“好”与“坏”……你很快就会明白。","res":""},{"id":3201,"stepId":21,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"3202":[{"id":3202,"stepId":1,"type":"dialog","param":"","audio":922800251,"speaker":"？？？","content":"当时我正在巴黎经营我的水晶生意。","res":"v3a2_dungeonpanel_pic18"},{"id":3202,"stepId":2,"type":"dialog","param":"","audio":922800252,"speaker":"？？？","content":"从简单的装饰品到有灵性的水晶，我都有卖，你的箱子中也有几位我的老主顾。","res":""},{"id":3202,"stepId":3,"type":"dialog","param":"","audio":922800253,"speaker":"？？？","content":"不过很多客人光顾我的店却不买水晶，而是想要一则预言。","res":""},{"id":3202,"stepId":4,"type":"options","param":"1#2","audio":0,"speaker":"","content":"很难有人不想要#您可以售卖预言","res":""},{"id":3202,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":3202,"stepId":6,"type":"dialog","param":"","audio":922800254,"speaker":"？？？","content":"命运全都是非卖品，谁能够得到什么早已注定，预言只是一份既定的礼品清单。","res":""},{"id":3202,"stepId":7,"type":"dialog","param":"","audio":922800255,"speaker":"？？？","content":"我并不想只售卖无用之物。","res":""},{"id":3202,"stepId":8,"type":"dialog","param":"","audio":922800256,"speaker":"？？？","content":"于是我定下了一条口头规定，只向熟客谈及将来。","res":""},{"id":3202,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":3202,"stepId":10,"type":"dialog","param":"","audio":922800257,"speaker":"？？？","content":"那可不行，预言应当是免费的。被提前知晓的、无法改变的内容毫无价值。","res":""},{"id":3202,"stepId":11,"type":"dialog","param":"","audio":922800258,"speaker":"？？？","content":"正如一部小说的内容不应该全部出现在封面和标题上，那些部分只能用作宣传。","res":""},{"id":3202,"stepId":12,"type":"dialog","param":"","audio":922800259,"speaker":"？？？","content":"所以我只在与真正来购物的客人闲谈时，偶尔提及一些预言……","res":""},{"id":3202,"stepId":13,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3202,"stepId":14,"type":"dialog","param":"","audio":922800260,"speaker":"？？？","content":"结果生意就变好了，很快我赚回了当时在巴黎的前期投入。","res":""},{"id":3202,"stepId":15,"type":"options","param":"3","audio":0,"speaker":"","content":"这并不意外","res":""},{"id":3202,"stepId":16,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":3202,"stepId":17,"type":"dialog","param":"","audio":922800261,"speaker":"？？？","content":"是的，每次都这样，毫无悬念……","res":""},{"id":3202,"stepId":18,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"3203":[{"id":3203,"stepId":1,"type":"dialog","param":"","audio":922800262,"speaker":"？？？","content":"灰调蓝小姐最初的态度并不令我意外，占卜师常常遭到怀疑。","res":"v3a2_dungeonpanel_pic19"},{"id":3203,"stepId":2,"type":"dialog","param":"","audio":922800263,"speaker":"？？？","content":"有的人把我当作阴谋家和诈骗犯，比如夜巡特遣管理局，或许你和我的对话正处于他们的监听之下。","res":""},{"id":3203,"stepId":3,"type":"dialog","param":"","audio":922800264,"speaker":"？？？","content":"也有人相信预言却畏惧它，于是对我敬而远之，可又抑制不住好奇心。","res":""},{"id":3203,"stepId":4,"type":"dialog","param":"","audio":922800265,"speaker":"？？？","content":"而那些干脆对预言嗤之以鼻的人，我尊重他们的勇气。","res":""},{"id":3203,"stepId":5,"type":"dialog","param":"","audio":922800266,"speaker":"？？？","content":"灰调蓝小姐则属于第四种人，她试图通过无视来摆脱宿命，结果回避得太刻意，反而显得过于重视了。","res":""},{"id":3203,"stepId":6,"type":"options","param":"1#2","audio":0,"speaker":"","content":"夜巡特遣管理局？#在您看来，我属于哪一类？","res":""},{"id":3203,"stepId":7,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":3203,"stepId":8,"type":"dialog","param":"","audio":922800267,"speaker":"？？？","content":"哦？我提到他们了么？","res":""},{"id":3203,"stepId":9,"type":"dialog","param":"","audio":922800268,"speaker":"？？？","content":"是的，我在前不久擅自取走了五件神秘学藏品，他们一直在追究我的盗窃罪。","res":""},{"id":3203,"stepId":10,"type":"dialog","param":"","audio":922800269,"speaker":"？？？","content":"但其实我已经支付了足够的赔偿金，也接受了应有的处罚。","res":""},{"id":3203,"stepId":11,"type":"dialog","param":"","audio":922800270,"speaker":"？？？","content":"现在的我在他们眼中恐怕是知晓了不为人知的秘密，且酝酿着恐怖阴谋的预言家。","res":""},{"id":3203,"stepId":12,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":3203,"stepId":13,"type":"dialog","param":"","audio":922800271,"speaker":"？？？","content":"这对我来说也是个问题。","res":""},{"id":3203,"stepId":14,"type":"dialog","param":"","audio":922800272,"speaker":"？？？","content":"像你这样，行走在雨与故事间的人，究竟站在什么角度，以什么方式对待着命运？","res":""},{"id":3203,"stepId":15,"type":"dialog","param":"","audio":922800273,"speaker":"？？？","content":"全世界中能与你换位思考的人恐怕不超过三个，多么希望我也是其中一人。","res":""},{"id":3203,"stepId":16,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3203,"stepId":17,"type":"dialog","param":"","audio":922800274,"speaker":"？？？","content":"但我不过是命运的奴隶，只能基于有限的认知去行动。","res":""},{"id":3203,"stepId":18,"type":"dialog","param":"","audio":922800275,"speaker":"？？？","content":"即使所见和所闻比常人多一些，也改变不了我无能为力的事实。","res":""},{"id":3203,"stepId":19,"type":"options","param":"3","audio":0,"speaker":"","content":"意思是您身不由己？","res":""},{"id":3203,"stepId":20,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":3203,"stepId":21,"type":"dialog","param":"","audio":922800276,"speaker":"？？？","content":"我早就过了和命运唱反调的叛逆期。","res":""},{"id":3203,"stepId":22,"type":"dialog","param":"","audio":922800277,"speaker":"？？？","content":"我会做的事与我实际想做的事早已并无任何差别，一切都合乎逻辑与情理。","res":""},{"id":3203,"stepId":23,"type":"dialog","param":"","audio":922800278,"speaker":"？？？","content":"说到这儿，还有一个有趣的问题。究竟是命运注定了我会这么做，还是我的性格决定了这一段命运？","res":""},{"id":3203,"stepId":24,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"3204":[{"id":3204,"stepId":1,"type":"dialog","param":"","audio":922800279,"speaker":"？？？","content":"接着灰调蓝小姐就这样对着空无一物的副驾驶发话，大吼，冲着她那位不存在的朋友。","res":"v3a2_dungeonpanel_pic20"},{"id":3204,"stepId":2,"type":"dialog","param":"","audio":922800280,"speaker":"？？？","content":"我记得是叫……弗里西亚？不对，好像是费利西安？","res":""},{"id":3204,"stepId":3,"type":"dialog","param":"","audio":922800281,"speaker":"？？？","content":"嗯，是费利西安。我记得这个名字怎么拼，正好我也和一位同名之人有过往来。","res":""},{"id":3204,"stepId":4,"type":"options","param":"1#2","audio":0,"speaker":"","content":"是同一个人么？#法国人都会认识费利西安？","res":""},{"id":3204,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":6,"type":"dialog","param":"","audio":922800282,"speaker":"？？？","content":"和贝丽尔、阿黛拉比起来，叫费利西安的人确实少见。","res":""},{"id":3204,"stepId":7,"type":"dialog","param":"","audio":922800283,"speaker":"？？？","content":"可命运再敷衍也不至于如此。","res":""},{"id":3204,"stepId":8,"type":"dialog","param":"","audio":922800284,"speaker":"？？？","content":"它不会用如此枯燥的理由联系起我与灰调蓝，除非它急于证明自己有多荒诞。","res":""},{"id":3204,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":10,"type":"dialog","param":"","audio":922800285,"speaker":"？？？","content":"呵呵呵，你很会说笑，这个说法也很有趣。","res":""},{"id":3204,"stepId":11,"type":"dialog","param":"","audio":922800286,"speaker":"？？？","content":"可惜费利西安并不是什么属于法国人的共同记忆。","res":""},{"id":3204,"stepId":12,"type":"dialog","param":"","audio":922800287,"speaker":"？？？","content":"或许是之前的故事内容让你有了这种想法，但现在下定论还为时尚早。","res":""},{"id":3204,"stepId":13,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":14,"type":"dialog","param":"","audio":922800288,"speaker":"？？？","content":"而且我认识的那位费利西安，并不乐于被当作随处可见的费利西安。","res":""},{"id":3204,"stepId":15,"type":"dialog","param":"","audio":922800289,"speaker":"？？？","content":"因为她的血可不是一般人的血，恐怕直到第二次工业革命之前，那血脉都昂贵得无以复加……","res":""},{"id":3204,"stepId":16,"type":"options","param":"3#4","audio":0,"speaker":"","content":"她似乎是名贵族#她一定有强大的神秘术","res":""},{"id":3204,"stepId":17,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":18,"type":"dialog","param":"","audio":922800290,"speaker":"？？？","content":"是的，她以家族流传的雷电神秘术为傲，可怜她的家族在发电机诞生后彻底没落，早就失去了在社交界的话语权。","res":""},{"id":3204,"stepId":19,"type":"dialog","param":"","audio":922800291,"speaker":"？？？","content":"不过即便如此，家族的遗产也不是两百年内能用尽的，足够她一个人维持贵族生活到晚年了……","res":""},{"id":3204,"stepId":20,"type":"selector","param":"4","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":21,"type":"dialog","param":"","audio":922800292,"speaker":"？？？","content":"她把自己比作战士、英雄，乃至雷电的祭司，这些都是她的家族在各个时代依靠神秘术赢得的头衔。","res":""},{"id":3204,"stepId":22,"type":"dialog","param":"","audio":922800293,"speaker":"？？？","content":"就算家族最后一份制铝的工作被发电机夺走已有百年，她仍没有忘记任何一段家族史。","res":""},{"id":3204,"stepId":23,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":24,"type":"options","param":"5","audio":0,"speaker":"","content":"所以她是“暴雨”之前的人","res":""},{"id":3204,"stepId":25,"type":"selector","param":"5","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":26,"type":"dialog","param":"","audio":922800294,"speaker":"？？？","content":"你的推测完全正确，她出生时“暴雨”仍未发生。","res":""},{"id":3204,"stepId":27,"type":"dialog","param":"","audio":922800295,"speaker":"？？？","content":"但这并不是问题的关键，“暴雨”前的人仍可以认识不同时代的人，就像你与你的朋友们，以及我与灰调蓝。","res":""},{"id":3204,"stepId":28,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":29,"type":"options","param":"6","audio":0,"speaker":"","content":"她被回溯了","res":""},{"id":3204,"stepId":30,"type":"selector","param":"6","audio":0,"speaker":"","content":"","res":""},{"id":3204,"stepId":31,"type":"dialog","param":"","audio":922800296,"speaker":"？？？","content":"是的，我所认识的费利西安，早就在“暴雨”落下时消失不见了。","res":""},{"id":3204,"stepId":32,"type":"dialog","param":"","audio":922800297,"speaker":"？？？","content":"所以除非奇迹发生，否则谁也见不到她了。","res":""},{"id":3204,"stepId":33,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"3205":[{"id":3205,"stepId":1,"type":"dialog","param":"","audio":922800298,"speaker":"？？？","content":"是的，我确实向你隐瞒了很多信息。","res":"v3a2_dungeonpanel_pic21"},{"id":3205,"stepId":2,"type":"dialog","param":"","audio":922800299,"speaker":"？？？","content":"其实我早就知道费利西安与灰调蓝的关系，劳伦·罗西的阴谋对我也并非秘密。","res":""},{"id":3205,"stepId":3,"type":"dialog","param":"","audio":922800300,"speaker":"？？？","content":"请理解，我明白未知是构成趣味性的重要元素，这都是为了你的故事体验。","res":""},{"id":3205,"stepId":4,"type":"options","param":"1#2#3","audio":0,"speaker":"","content":"您骗了所有人#我需要一个解释#其实我更关心玛蒂尔达的部分","res":""},{"id":3205,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":3205,"stepId":6,"type":"dialog","param":"","audio":922800301,"speaker":"？？？","content":"说出口的预言改变不了任何事，没有说出口的也一样。","res":""},{"id":3205,"stepId":7,"type":"dialog","param":"","audio":922800302,"speaker":"？？？","content":"我一直在努力维持作为商人的中立立场，所有与我接触的人都清楚这一点。","res":""},{"id":3205,"stepId":8,"type":"dialog","param":"","audio":922800303,"speaker":"？？？","content":"我绝对没有偏袒哪一方，只是有时某一方更加有利可图。","res":""},{"id":3205,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":3205,"stepId":10,"type":"dialog","param":"","audio":922800304,"speaker":"？？？","content":"“暴雨”导致了很多变数，其中就包括迷思海，劳伦·罗西在一次意外中目睹了迷思海的泄露，之后他一心扑在了上面。","res":""},{"id":3205,"stepId":11,"type":"dialog","param":"","audio":922800305,"speaker":"？？？","content":"而费利西安也是因意外被困于迷思海的亡灵，二者因荒谬的命运达成了合作。","res":""},{"id":3205,"stepId":12,"type":"dialog","param":"","audio":922800306,"speaker":"？？？","content":"最终反派各自就位，灰调蓝命中的剧本至此完备。","res":""},{"id":3205,"stepId":13,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":3205,"stepId":14,"type":"dialog","param":"","audio":922800307,"speaker":"？？？","content":"呵呵呵，这很正常，玛蒂尔达是我可爱的女儿。她继承了我的优点，又比我更有活力，遇见她的人都会露出笑容。","res":""},{"id":3205,"stepId":15,"type":"dialog","param":"","audio":922800308,"speaker":"？？？","content":"但我不会就这样和你分享她的经历，那太可惜了。","res":""},{"id":3205,"stepId":16,"type":"dialog","param":"","audio":922800309,"speaker":"？？？","content":"她的故事值得让人抱有期待。","res":""},{"id":3205,"stepId":17,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"3206":[{"id":3206,"stepId":1,"type":"dialog","param":"","audio":922800310,"speaker":"？？？","content":"多么不讲道理的雨。","res":"v3a2_dungeonpanel_pic22"},{"id":3206,"stepId":2,"type":"dialog","param":"","audio":922800311,"speaker":"？？？","content":"这故事至今都恪守传统，灰调蓝实现了一场完美的英雄之旅。","res":""},{"id":3206,"stepId":3,"type":"dialog","param":"","audio":922800312,"speaker":"？？？","content":"我们都等着那墨守成规的结尾时，一场雨摧毁了他们的故事。","res":""},{"id":3206,"stepId":4,"type":"dialog","param":"","audio":922800313,"speaker":"？？？","content":"这就是命运对我的第五次恶作剧。","res":""},{"id":3206,"stepId":5,"type":"options","param":"1#2","audio":0,"speaker":"","content":"我也不喜欢这雨#抱歉，我已经猜到了这结局","res":""},{"id":3206,"stepId":6,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":3206,"stepId":7,"type":"dialog","param":"","audio":922800314,"speaker":"？？？","content":"不，你可能误会了。我并不讨厌它。","res":""},{"id":3206,"stepId":8,"type":"dialog","param":"","audio":922800315,"speaker":"？？？","content":"未来失控的感觉固然可怕，但我更爱这前路未定的滋味。","res":""},{"id":3206,"stepId":9,"type":"dialog","param":"","audio":922800316,"speaker":"？？？","content":"其他人生来抱有的希望、梦想、期许，我在这短暂的生命中只体验了寥寥几次……","res":""},{"id":3206,"stepId":10,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":3206,"stepId":11,"type":"dialog","param":"","audio":922800317,"speaker":"？？？","content":"是的，你了解每一场雨。","res":""},{"id":3206,"stepId":12,"type":"dialog","param":"","audio":922800318,"speaker":"？？？","content":"可能当我说出故事何时发生时，你就猜到了结局。","res":""},{"id":3206,"stepId":13,"type":"dialog","param":"","audio":922800319,"speaker":"？？？","content":"但我不一样，每一场雨于我都是惊喜。","res":""},{"id":3206,"stepId":14,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3206,"stepId":15,"type":"options","param":"3","audio":0,"speaker":"","content":"您渴望命运被雨打破","res":""},{"id":3206,"stepId":16,"type":"selector","param":"3","audio":0,"speaker":"","content":"","res":""},{"id":3206,"stepId":17,"type":"dialog","param":"","audio":922800320,"speaker":"？？？","content":"即便这需要付出巨大的代价。","res":""},{"id":3206,"stepId":18,"type":"dialog","param":"","audio":922800321,"speaker":"？？？","content":"……噢！我想这就是夜巡特遣管理局乃至基金会警惕我的原因。","res":""},{"id":3206,"stepId":19,"type":"dialog","param":"","audio":922800322,"speaker":"？？？","content":"他们怀疑我是渴望“暴雨”的狂热分子。","res":""},{"id":3206,"stepId":20,"type":"dialog","param":"","audio":922800323,"speaker":"？？？","content":"怎么会呢？我不曾主动追求过它。我只是想更了解它。","res":""},{"id":3206,"stepId":21,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""}],"3207":[{"id":3207,"stepId":1,"type":"dialog","param":"","audio":922800324,"speaker":"？？？","content":"于是我决定在最后再帮灰调蓝一次。","res":"v3a2_dungeonpanel_pic23"},{"id":3207,"stepId":2,"type":"dialog","param":"","audio":922800325,"speaker":"？？？","content":"那真的是一场豪赌，当时连我也不确定结果会如何。","res":""},{"id":3207,"stepId":3,"type":"dialog","param":"","audio":922800326,"speaker":"？？？","content":"结果我受益颇丰，使得更多人怀疑我早有图谋，这就是占卜师的处境。","res":""},{"id":3207,"stepId":4,"type":"options","param":"1#2","audio":0,"speaker":"","content":"您让一个反派活了下来#您的眼睛还好么？","res":""},{"id":3207,"stepId":5,"type":"selector","param":"1","audio":0,"speaker":"","content":"","res":""},{"id":3207,"stepId":6,"type":"dialog","param":"","audio":922800327,"speaker":"？？？","content":"但我也给足了她应有的处罚？","res":""},{"id":3207,"stepId":7,"type":"dialog","param":"","audio":922800328,"speaker":"？？？","content":"她不想消失，却没有想过或许余生都将在一枚仿钻中度过。","res":""},{"id":3207,"stepId":8,"type":"dialog","param":"","audio":922800329,"speaker":"？？？","content":"而且我确实把她交到了灰调蓝手中，她的生死并未由我决定。","res":""},{"id":3207,"stepId":9,"type":"selector","param":"2","audio":0,"speaker":"","content":"","res":""},{"id":3207,"stepId":10,"type":"dialog","param":"","audio":922800330,"speaker":"？？？","content":"请放心，我看得还算清楚，虽然暂时看不到太远的将来。","res":""},{"id":3207,"stepId":11,"type":"dialog","param":"","audio":922800331,"speaker":"？？？","content":"但看不到雨后的部分，在当下根本不算损失。","res":""},{"id":3207,"stepId":12,"type":"dialog","param":"","audio":922800332,"speaker":"？？？","content":"我甚至可以带着些许期待，去观察我女儿的未来能否有所改变，真是未曾有的体验。","res":""},{"id":3207,"stepId":13,"type":"selectorend","param":"","audio":0,"speaker":"","content":"","res":""},{"id":3207,"stepId":14,"type":"dialog","param":"","audio":922800333,"speaker":"？？？","content":"现在来为这个故事点出一些寓意吧，这是我从灰调蓝身上学到的道理——","res":""},{"id":3207,"stepId":15,"type":"dialog","param":"","audio":922800334,"speaker":"？？？","content":"当个笨蛋瞎子也不错。","res":""},{"id":3207,"stepId":16,"type":"dialog","param":"","audio":922800335,"speaker":"？？？","content":"从一无所知开始认清自我和世界，最后意识到自己仍然一无所知……是如此充满乐趣。","res":""}]},"dialog_step":{"52":[{"groupId":52,"id":52001,"type":1,"content":"很少有这么高规格的问话，有大人物专门调来了最新的测谎仪。现在，让我们第三次确认你所提供的内容。","name":"执夜人","avatar":"631501","chessId":1},{"groupId":52,"id":52002,"type":2,"content":"我会如实回答。","name":"灰调蓝","avatar":"313529","chessId":2},{"groupId":52,"id":52003,"type":1,"content":"重塑之手的成员罗西诱骗了他的学生，包括你的好友西莉亚。","name":"执夜人","avatar":"631501","chessId":1},{"groupId":52,"id":52004,"type":2,"content":"是的。","name":"灰调蓝","avatar":"313529","chessId":2},{"groupId":52,"id":52005,"type":1,"content":"你被迫参与到了重塑之手的活动中，他们控制了你。","name":"执夜人","avatar":"631501","chessId":1},{"groupId":52,"id":52006,"type":2,"content":"是的，我的意识被驱逐了。","name":"灰调蓝","avatar":"313529","chessId":2},{"groupId":52,"id":52007,"type":1,"content":"贝丽尔帮助你重新控制身体，并带你逃离了迷思海的溢流。","name":"执夜人","avatar":"631501","chessId":1},{"groupId":52,"id":52008,"type":2,"content":"是的，她救了我。","name":"灰调蓝","avatar":"313529","chessId":2},{"groupId":52,"id":52009,"type":1,"content":"整个过程中，你没有发现任何贝丽尔·布翁尼和重塑之手一起行动的情况。","name":"执夜人","avatar":"631501","chessId":1},{"groupId":52,"id":52010,"type":2,"content":"没有。","name":"灰调蓝","avatar":"313529","chessId":2},{"groupId":52,"id":52011,"type":1,"content":"此后直到现在，你没有发现贝丽尔·布翁尼与重塑之手以任何形式联络的迹象。","name":"执夜人","avatar":"631501","chessId":1},{"groupId":52,"id":52012,"type":2,"content":"我确信，没有。","name":"灰调蓝","avatar":"313529","chessId":2}]}}