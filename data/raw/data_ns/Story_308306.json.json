[[64,65,""]],"type":1,"name":["翠斯特","","","","","","",""],"head_icon":"308101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["后续那个“剧作家”不是已经讲过了吗？这之后很快，快到我父亲还没被下葬，我的母亲就溺死在了浅浅的景观池塘里。","","","","","","",""],"bg":"","choice":[]},"65":{"step":[[65,66,""]],"type":1,"name":["翠斯特","","","","","","",""],"head_icon":"308101.png","audio":"610017839","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["是……是，她的精神已经癫狂，没错，她认为死亡才是真正解脱的方法……","","","","","","",""],"bg":"","choice":[]},"66":{"step":[[66,67,""]],"type":1,"name":["翠斯特","","","","","","",""],"head_icon":"308101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她已经厌倦了这个无比痛苦，随时随地都在点评与挑剔她的世界。西奥菲尔当然已经派遣女仆守夜，紧密地看守……","","","","","","",""],"bg":"","choice":[]},"67":{"step":[[67,68,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["翠斯特跳下桌子，向前走去。","","","","","","",""],"bg":"","choice":[]},"68":{"step":[[68,69,""]],"type":1,"name":["翠斯特","","","","","","",""],"head_icon":"308101.png","audio":"610017828","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["但伊文洁琳不只是个疯子，她还是最好的演员。","","","","","","",""],"bg":"","choice":[]},"69":{"step":[[69,70,""]],"type":1,"name":["翠斯特","","","","","","",""],"head_icon":"308101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她在那晚深夜醒来，看起来温和而又迷惑。","","","","","","",""],"bg":"","choice":[]},"70":{"step":[[70,71,""]],"type":1,"name":["翠斯特","","","","","","",""],"head_icon":"308101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["她什么都不记得了，她想要一杯加了蜂蜜的热牛奶，她想知道为什么她的嗓子这样痛，为什么她的双手上有割伤……","","","","","","",""],"bg":"","choice":[]},"71":{"step":[[71,72,""]],"type":1,"name":["翠斯特","","","","","","",""],"head_icon":"308101.png","audio":"610017835","bool_1":false,"show_name":true,"show_name_en":