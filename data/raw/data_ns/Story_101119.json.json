name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["保罗从外套内取出一只揉皱的信封。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["保罗","","","","","","",""],"head_icon":"","audio":"613000368","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["这是我从蒙佩替你取来的包裹，还没有来得及给你，里面只有这一封信件。是穆伦贝格先生写给三班学生的。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["艾伯哈特","","","","","","",""],"head_icon":"","audio":"613001484","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["穆伦贝格……在假期里我准备去亲自探望他，但在家乡发生的事情，你也已经知道了。我没有来得及见他。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["艾伯哈特","","","","","","",""],"head_icon":"","audio":"613001485","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["他从来不知道前线发生了什么，打下蒙佩之后，三班的学生只剩下你和我了。他还在给谁写信呢？","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["艾伯哈特","","","","","","",""],"head_icon":"","audio":"613001486","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["打开它吧，保罗，你念给我听。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["保罗深沉地换了一口气，随后撕开信封。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["他展开信纸。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["保罗","","","","",""