y_atcg/1.4/1_4_at_bolatushiyuyan.jpg","choice":[]},"13":{"step":[[13,14,""]],"type":6,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010318","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["直到一个人逃出了洞穴，他才第一次见到了真正的世界。","","","","","","",""],"bg":"story_atcg/1.4/1_4_at_bolatushiyuyan.jpg","choice":[]},"14":{"step":[[14,15,""]],"type":6,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010319","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["原来他此前所见的一切，都是墙上虚假的火光。","","","","","","",""],"bg":"story_atcg/1.4/1_4_at_bolatushiyuyan.jpg","choice":[]},"15":{"step":[[15,16,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"0","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["场景-岛屿-传道者之厅","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"16":{"step":[[16,17,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010320","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我们的世界无异于垃圾，维尔汀小姐。","","","","","","",""],"bg":"story_bg/1.4/1_4_bg_chuandaozhezhitingnei2.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010321","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["现象世界如同这个寓言故事里的洞穴，万物皆为墙上残缺的倒影。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010322","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["它丑陋、轻浮、易朽、肮脏、衰败，充斥着毫无意义的欲望和符号斗争。","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010323","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["而真正的智者能够走出洞穴，得见真实的世界。","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010324","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["那个永恒超验的完美王国，一切事物都是它们最美好的模样。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010325","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["因此我恳请你们——圣洛夫基金会的代表，维尔汀小姐，以及重塑之手的代表，阿尔卡纳小姐。","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010326","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["你们所在乎的一切，于我们而言都是毫无意义的残渣，不值一提的碎屑。","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010327","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["唯有一件事值得我们去做。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010328","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["就是追寻更高的智慧，谋求自身的提升，这是我们生而非凡的使命。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010329","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我们从未踏足“暴雨”落下的土壤，也不曾涉入时代洪流的纠纷。","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["6","","Six","","","","",""],"head_icon":"307901.png","audio":"610010330","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["因此我希望你们也永远不要把现象世界的派系斗争带到真理的王国。","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["阿尔卡纳","","Arcana","","アルカナ","","",""],"head_icon":"501901.png","audio":"610010582","bool