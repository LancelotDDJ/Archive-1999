_en":false,"no_l2d":false,"text":["该死的，什么东西？","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_juzhuqu2_zone.png","choice":[]},"136":{"step":[[136,137,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["这一次，金伯利捡起铝罐，气冲冲地扔向那小伙子的脑袋。","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_juzhuqu2_zone.png","choice":[]},"137":{"step":[[137,138,""]],"type":1,"name":["贫民区少年","","","","","","",""],"head_icon":"519301.png","audio":"612201526","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你敢朝我扔东西？","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_juzhuqu2_zone.png","choice":[]},"138":{"step":[[138,139,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["面对“还击”，好勇斗狠的少年挨了痛，却首先环顾自己周围的小伙计——和他一样茫然，一样不知所措。","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_juzhuqu2_zone.png","choice":[]},"139":{"step":[[139,140,""]],"type":1,"name":["贫民区少年","","","","","","",""],"head_icon":"519301.png","audio":"612201527","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你敢对我们天使兄弟会的人动手！","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_juzhuqu2_zone.png","choice":[]},"140":{"step":[[140,141,""]],"type":1,"name":["贫民区少年","","","","","","",""],"head_icon":"519301.png","audio":"612201528","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["桑托斯大人回来了！你完了！","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_juzhuqu2_zone.png","choice":[]},"141":{"type":1,"name":["白朗姆","","White Rum","","","","",""],"head_icon":"310101.png","audio":"612201249","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["刀？小家伙们，这可不明智呀，嘿——","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_juzhuqu2_zone.png","choice":[]},"info":{"title":"第八章8-09.1","start":1}}