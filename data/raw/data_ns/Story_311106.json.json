，多谢！","","","","","","",""],"bg":"story_bg/2_5/2_5_bg_wutai.jpg","choice":[]},"75":{"step":[[75,76,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["菲林士多驱使着轮椅登上了领奖台，颁奖嘉宾还没来得及调整麦克风，因此菲林士多的前两句话收音不是很好。","","","","","","",""],"bg":"story_bg/2_5/2_5_bg_wutai.jpg","choice":[]},"76":{"step":[[76,77,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["氛围图","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_huojiang.jpg","choice":[]},"77":{"step":[[77,78,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["移动","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_huojiang.jpg","choice":[]},"78":{"step":[[78,79,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"311101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["多谢各位评委，多谢剧组的工作人员，这不是我自己一个人的奖项，有大家的齐心协力，《影留长街外》才能获得这样的荣誉。","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_huojiang.jpg","choice":[]},"79":{"step":[[79,80,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["言罢，菲林士多向剧组坐着的方向欠身致意，台下再次为她欢呼起来。","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_huojiang.jpg","choice":[]},"80":{"step":[[80,81,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"311101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我回来了。","","","","","","",""],"bg":"story_atcg/2_5/2_5_at_huojiang.jpg","choice":[]},"81":{"step":[[81,82,""]],"type":1,"name":["菲林士多","","Noire","","","","",""],"head_icon":"311101.png","audio":"","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["和第一次登上这个颁奖台相比，我收获了很多东西，最显眼的就是这个。","","","","","","",