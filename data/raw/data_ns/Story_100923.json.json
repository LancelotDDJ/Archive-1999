"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/2_0/2_0_bg_dixiasushefangjian.jpg","choice":[]},"17":{"step":[[17,18,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["敲门声打断了女孩在领奖台上发言的美梦。","","","","","","",""],"bg":"","choice":[]},"18":{"step":[[18,19,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600736","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["……房东先生！","","","","","","",""],"bg":"","choice":[]},"19":{"step":[[19,20,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600737","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["请放心，我保证下个月一定补齐房租！要我说，您这破烂公寓还真不值这价钱，墙上这些裂缝就像是从上个世纪遗留下来的……","","","","","","",""],"bg":"","choice":[]},"20":{"step":[[20,21,""]],"type":1,"name":["房东","","","","","","",""],"head_icon":"626301.png","audio":"612601090","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["哼，我一点儿也不急。反正你要是交不出房租，我就得请你搬到街角那座随时会坍塌的殖民公寓去住，或者去圣特尔莫市场的地摊上卖橘子。","","","","","","",""],"bg":"","choice":[]},"21":{"step":[[21,22,""]],"type":1,"name":["房东","","","","","","",""],"head_icon":"626301.png","audio":"612601091","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["对了，听胡丽娅太太说，你又从纺织厂辞工了？","","","","","","",""],"bg":"","choice":[]},"22":{"step":[[22,23,""]],"type":1,"name":["房东","","","","","","",""],"head_icon":"626301.png","audio":"612601092","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你这小姑娘，活像是被咒语附身似的！难不成世上真有“在同一个地方工作超过三个月就会身亡”的咒语吗？","","","","","","",""],"bg":"","choice":[]},"23":{"step":[[23,24,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600738","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["您不知道那间纺织厂里头发生了什么可怕的事情。我只不过是为受到压榨的工人们提供一些协助罢了。","","","","","","",""],"bg":"","choice":[]},"24":{"step":[[24,25,""]],"type":1,"name":["房东","","","","","","",""],"head_icon":"626301.png","audio":"612601093","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["你和那些满嘴胡话的大学生一个模样——算了，我今天来不是为了说这个的。","","","","","","",""],"bg":"","choice":[]},"25":{"step":[[25,26,""]],"type":1,"name":["房东","","","","","","",""],"head_icon":"626301.png","audio":"612601094","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["前段时间，你刚从国外回来的时候，不是一直念叨着让我注意你的信件吗？","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["房东","","","","","","",""],"head_icon":"626301.png","audio":"612601095","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["喏，你的信——","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,28,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["女孩愣住片刻后，她飞速地抢过信，一把摔上房门，颤抖着展开信件。","","","","","","",""],"bg":"story_bg/2_0/2_0_bg_dixiasushefangjian.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600739","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["哦，天啊，竟然真的会有人给我回信——我是说，谢谢您，房东先生！","","","","","","",""],"bg":"","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她飞速地裁开了那封漂洋过海的信件。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311410.png","audio":"612600740","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“敬爱的虚构集小姐……”","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":6,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"311410.png","audio":"612600741","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["让我看看……回信的作家，是一位名叫阿莱夫的先生！","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":0,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["","","","","","","",""],"bg":"story_bg/2_2/2_2_bg_jishi.jpg","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_icon":"523501.png","audio":"612601528","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["嘿，我留意你很久了。你不是本地人吧？你一直在这儿写什么？","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600742","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["噢，你好！事实上，我三天前才到布宜诺斯艾利斯——中间的故事长得像一段探戈，曲折但没什么值得一说的。","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600743","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["至于现在，我正在给我的笔友写回信！说来有些话长，但我给他寄去了小说的复件，没想到他竟然真的回信了……","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600744","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["总之，这听起来很奇妙对吧！","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600745","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["最新的来信中，我们正讨论到这部小说缺少了一个更为重要的角色，因此它无法得到一个决定性的结局。","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600746","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["于是，我们正在商量是否需要引入一个新的幽灵，作为故事的转折。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,103,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_icon":"523501.png","audio":"612601529","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这么说来，你是个作家？嘿，潘乔，过来看看！我遇到一位真正的作家！","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["同行青年Ⅱ","","","","","","",""],"head_icon":"523601.png","audio":"612601549","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["这有什么可大惊小怪的，作家有什么稀奇的？我初中的时候写过不少诗呢！","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600747","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["噢，这么说来，你也是一位诗人了！","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600748","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["我有预感，我们会共同开启一场不可思议的冒险故事！你们有兴趣参加本能现实主义派的运动吗？","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_icon":"523501.png","audio":"612601530","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["我从来没听说过这本能……什么的派系。但这好像很有意思！","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,104,""]],"type":1,"name":["虚构集","","Recoleta","","","","",""],"head_icon":"","audio":"612600749","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["太好了！事不宜迟，等我写完这封回信，两位就与我一起前往乌斯怀亚吧！","","","","","","",""],"bg":"","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["同行青年Ⅱ","","","","","","",""],"head_icon":"523601.png","audio":"612601550","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["乌斯怀亚？那不是世界尽头吗？咱们跑到那个冻得要命的鬼地方干什么？","","","","","","",""],"bg":"","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["同行青年Ⅰ","","","","","","",""],"head_ico