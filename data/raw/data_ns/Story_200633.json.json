25,26,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013934","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":false,"text":["嗯？您想好名字了？","","","","","","",""],"bg":"","choice":[]},"26":{"step":[[26,27,""]],"type":1,"name":["别斯米尔","","","","","","",""],"head_icon":"619901.png","audio":"610014975","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":false,"text":["没错。我想，我会叫它——","","","","","","",""],"bg":"","choice":[]},"27":{"step":[[27,79,""]],"type":6,"name":["别斯米尔","","","","","","",""],"head_icon":"619915.png","audio":"610014976","bool_1":false,"show_name":true,"show_name_en":false,"no_l2d":true,"text":["“朔日手记”。","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"28":{"step":[[28,29,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013935","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["《朔日手记》……","","","","","","",""],"bg":"story_atcg/1_6/1_6_at_xinjian.jpg","choice":[]},"29":{"step":[[29,30,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013936","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["是的，是这个名字。","","","","","","",""],"bg":"","choice":[]},"30":{"step":[[30,31,""]],"type":1,"name":["","","","","","","",""],"head_icon":"","audio":"","bool_1":false,"show_name":false,"show_name_en":false,"no_l2d":false,"text":["她将手稿翻过一页，继续读着。","","","","","","",""],"bg":"","choice":[]},"31":{"step":[[31,32,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013937","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“这名字对一本以地理探索与发现为主要内容的书籍来说，其实算不上一个良好的选择。”","","","","","","",""],"bg":"","choice":[]},"32":{"step":[[32,33,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013938","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“一方面，‘朔日’对本书未来潜在的读者来说，实在是一个晦涩难懂的名词。”","","","","","","",""],"bg":"","choice":[]},"33":{"step":[[33,34,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013939","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“而另一方面，‘手记’常见于称呼随笔性质的文章合集。这种合集常常是职业作家夜话笔录的结果，其中饱含思想的碰撞与灵感的曙光。”","","","","","","",""],"bg":"","choice":[]},"34":{"step":[[34,35,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013940","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“作为并不专精文字的地理研究者，我的文学素养显然还没有到达那样高深的程度。更遗憾的是，负责为我记录文字的助手同样如此……”","","","","","","",""],"bg":"","choice":[]},"35":{"step":[[35,36,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308215.png","audio":"610013941","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["哈哈……","","","","","","",""],"bg":"","choice":[]},"36":{"step":[[36,37,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013942","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“……但无论如何，我们还是定下了这个名字。批注：这一决定，也见于寄给《祖国纪实》月刊编辑和书报审查部门的初稿中。”","","","","","","",""],"bg":"","choice":[]},"37":{"step":[[37,38,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013943","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["缺页。之后是——","","","","","","",""],"bg":"","choice":[]},"38":{"step":[[38,39,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013944","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["找到了。","","","","","","",""],"bg":"","choice":[]},"39":{"step":[[39,40,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013945","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“六月四日，天气晴。我从未想过，在与助手从叶堡出发后，竟然直到次年六月才终于回到鄂木斯克……”","","","","","","",""],"bg":"","choice":[]},"40":{"step":[[40,41,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013946","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“在那里，我们与总督再次面谈，为感谢当地科学研究协会的帮助，我留下了一部分《朔日手记》的草稿供他们使用。”","","","","","","",""],"bg":"","choice":[]},"41":{"step":[[41,42,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013947","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“其中包含大部分鄂木河周边草原生态的详细记录，例如在抵达鄂木斯克以前，我们曾跟随一群尾部有显著毛绒结团症状的绵羊涉水渡河。”","","","","","","",""],"bg":"","choice":[]},"42":{"step":[[42,43,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013948","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“之所以着重记述这一点，是因为那简直是种神迹似的景象。众所周知，绵羊极易溺水，它们厚重的毛在遇水时只是负担。”","","","","","","",""],"bg":"","choice":[]},"43":{"step":[[43,44,""]],"type":1,"name":["小叶尼塞","","Енисей","","","","",""],"head_icon":"308201.png","audio":"610013949","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“然而这群绵羊却与众不同。在当地牧民的训练下，它们渡河的动作极快且轻，几乎像是漂在河上的数团棉花一样自在，甚至……”","","","","","","",""],"bg":"","choice":[]},"44":{"step":[[44,45,""]],"type":6,"name":["无线电小姐","","Ms. Radio","","","","",""],"head_icon":"302701.png","audio":"610013427","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["“……甚至直到它们靠岸，你才会发现，原来它们还长着被切掉一块的蛋糕似的蹄子。”","","","","","","",""],"bg":"story_bg/bg/0xiangzinei.jpg","choice":[]},"45":{"step":[[45,46,""]],"type":1,"name":["维尔汀","","Vertin","","","","",""],"head_icon":"300101.png","audio":"610014540","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d":true,"text":["……唔……","","","","","","",""],"bg":"story_bg/bg/heiping.jpg","choice":[]},"46":{"step":[[46,47,""]],"type":1,"name":["无线电小姐","","Ms. Radio","","","","",""],"head_icon":"302701.png","audio":"610013428","bool_1":false,"show_name":true,"show_name_en":true,"no_l2d"